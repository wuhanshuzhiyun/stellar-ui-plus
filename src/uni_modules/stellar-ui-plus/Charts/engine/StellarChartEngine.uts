/**
 * @file StellarChartEngine.uts
 * @description Stellar UI Plus 纯 UTS 统一图表渲染引擎总调度器
 * 采用策略模式与分层架构，统管画布生命周期、DPR 缩放、补间动画、坐标映射、图例及手势 Tooltip 拾取
 */

import {
	ChartEngineOptions,
	ChartSeriesItem,
	ChartRect,
	ChartLegendItem,
	ChartTooltipState,
	ChartExtra,
	TooltipItem
} from '../types/uts-types.uts'

import { ContextManager } from './ContextManager.uts'
import { AnimationController } from './Animation.uts'
import { TouchHandler, HitTestResult } from './TouchHandler.uts'
import { Axis, AxisScale } from '../components/Axis.uts'
import { Legend } from '../components/Legend.uts'
import { Tooltip } from '../components/Tooltip.uts'

import { LineRenderer } from '../renderers/LineRenderer.uts'
import { AreaRenderer } from '../renderers/AreaRenderer.uts'
import { ColumnRenderer } from '../renderers/ColumnRenderer.uts'
import { BarRenderer } from '../renderers/BarRenderer.uts'
import { PieRenderer, PieRenderResult } from '../renderers/PieRenderer.uts'
import { RingRenderer } from '../renderers/RingRenderer.uts'
import { FunnelRenderer, FunnelLayer } from '../renderers/FunnelRenderer.uts'
import { ArcbarRenderer } from '../renderers/ArcbarRenderer.uts'

/**
 * 默认调色板规范
 */
const DEFAULT_COLORS: string[] = [
	'#165DFF',
	'#14C9C9',
	'#F7BA1E',
	'#3491FA',
	'#722ED1',
	'#9FDB1D',
	'#F53F3F',
	'#FF7D00'
];

/**
 * Stellar UI Plus 图表统一渲染引擎主类
 */
export class StellarChartEngine {
	/** 引擎初始配置选项 */
	public options: ChartEngineOptions;
	/** 画布上下文管理器 */
	public contextManager: ContextManager;
	/** 补间动画控制器 */
	public animationController: AnimationController;

	/** 当前数据序列 */
	public series: ChartSeriesItem[] = [];
	/** 当前分类维度 */
	public categories: string[] = [];
	/** 当前调色板 */
	public colors: string[] = DEFAULT_COLORS;
	/** 扩展配置 */
	public extra: ChartExtra | null = null;

	/** 图例项布局集合 */
	private legendItems: ChartLegendItem[] = [];
	/** 提示框当前激活状态 */
	private tooltipState: ChartTooltipState = {
		visible: false,
		x: 0,
		y: 0,
		title: '',
		items: []
	};

	/** 当前动画进度 (0.0 ~ 1.0) */
	private currentProgress: number = 1.0;
	/** 绘图区域几何矩形 */
	private plotArea: ChartRect = { left: 0, top: 0, right: 0, bottom: 0, width: 0, height: 0 };
	/** 直角坐标轴比例尺数据 */
	private axisScale: AxisScale = { min: 0, max: 10, splitNumber: 4, step: 2.5, ticks: [] };

	/** 饼图/环形图的极坐标扇区角度缓存 */
	private pieSectorAngles: number[][] = [];
	/** 漏斗图各层几何数据缓存 */
	private funnelLayers: FunnelLayer[] = [];

	/**
	 * 构造函数
	 * @param options 引擎初始化参数
	 */
	constructor(options: ChartEngineOptions) {
		this.options = options;
		this.series = options.series;
		this.categories = options.categories != null ? options.categories! : [];
		if (options.colors != null && options.colors!.length > 0) {
			this.colors = options.colors!;
		}
		this.extra = options.extra != null ? options.extra : null;

		this.contextManager = new ContextManager(options.canvasId, options.width, options.height);
		// 动画时长计算：禁用动画时时长为 0；使用 == 避免 Kotlin 端 Boolean? 与 Boolean 隐式装箱的引用相等性 (===) 警告
		const duration = options.animation == false ? 0 : (options.duration != null ? options.duration! : 600);
		this.animationController = new AnimationController(duration);
	}

	/**
	 * 挂载引擎并启动初始化绘制与入场动画
	 */
	public mount() {
		this.contextManager.init((ctx: CanvasRenderingContext2D) => {
			this.startAnimation();
		});
	}

	/**
	 * 启动入场或数据更新补间动画
	 */
	private startAnimation() {
		this.animationController.start((progress: number) => {
			this.currentProgress = progress;
			this.drawFrame();
		}, null);
	}

	/**
	 * 核心管线：绘制单帧画面
	 */
	public drawFrame() {
		const ctx = this.contextManager.ctx;
		if (ctx == null || !this.contextManager.isReady) return;

		// 1. 清空画布
		this.contextManager.clear();

		const width = this.contextManager.width;
		const height = this.contextManager.height;
		if (width <= 0 || height <= 0) return;

		// 2. 计算边距与图例布局
		const p = this.options.padding != null && this.options.padding!.length >= 4
			? this.options.padding!
			: [15, 15, 15, 15];
		const padTop = p[0];
		const padRight = p[1];
		const padBottom = p[2];
		const padLeft = p[3];

		const showLegend = this.options.showLegend != null ? this.options.showLegend! : true;
		let legendHeight = 0;

		if (showLegend && this.series.length > 0) {
			// 在画布底部预先排版图例
			const layoutResult = Legend.layout(ctx, this.series, width, height - padBottom - 18, this.colors);
			this.legendItems = layoutResult.items;
			legendHeight = layoutResult.totalHeight;
		} else {
			this.legendItems = [];
		}

		// 3. 计算绘图有效区 (PlotArea)
		const isBar = this.options.type === 'bar';
		const leftOffset = isBar ? Math.max(padLeft, 45) : Math.max(padLeft, 35);
		const bottomOffset = padBottom + (legendHeight > 0 ? legendHeight + 8 : 0);

		this.plotArea = {
			left: leftOffset,
			top: padTop,
			right: width - padRight,
			bottom: height - bottomOffset - (isBar ? 15 : 20),
			width: width - leftOffset - padRight,
			height: height - padTop - bottomOffset - (isBar ? 15 : 20)
		};

		// 4. 计算直角坐标系极值与刻度
		if (
			this.options.type === 'line' ||
			this.options.type === 'area' ||
			this.options.type === 'column' ||
			this.options.type === 'bar'
		) {
			this.calculateScales();
		}

		// 5. 绘制坐标轴或背景
		if (isBar) {
			Axis.drawBarAxes(ctx, this.plotArea, this.axisScale, this.categories);
		} else if (
			this.options.type === 'line' ||
			this.options.type === 'area' ||
			this.options.type === 'column'
		) {
			Axis.drawCartesianAxes(ctx, this.plotArea, this.axisScale, this.categories);
		}

		// 6. 根据图表类型分发至各专用渲染策略
		const dataLabel = this.options.dataLabel != null ? this.options.dataLabel! : true;

		switch (this.options.type) {
			case 'line':
				LineRenderer.render(
					ctx,
					this.series,
					this.categories,
					this.plotArea,
					this.axisScale,
					this.colors,
					this.currentProgress,
					this.extra?.line,
					dataLabel
				);
				break;
			case 'area':
				AreaRenderer.render(
					ctx,
					this.series,
					this.categories,
					this.plotArea,
					this.axisScale,
					this.colors,
					this.currentProgress,
					this.extra?.area,
					dataLabel
				);
				break;
			case 'column':
				ColumnRenderer.render(
					ctx,
					this.series,
					this.categories,
					this.plotArea,
					this.axisScale,
					this.colors,
					this.currentProgress,
					this.extra?.column,
					dataLabel
				);
				break;
			case 'bar':
				BarRenderer.render(
					ctx,
					this.series,
					this.categories,
					this.plotArea,
					this.axisScale,
					this.colors,
					this.currentProgress,
					this.extra?.bar,
					dataLabel
				);
				break;
			case 'pie': {
				const pieRes = PieRenderer.render(
					ctx,
					this.series,
					this.plotArea,
					this.colors,
					this.currentProgress,
					this.extra?.pie,
					dataLabel
				);
				this.pieSectorAngles = pieRes.sectorAngles;
				break;
			}
			case 'ring': {
				const ringRes = RingRenderer.render(
					ctx,
					this.series,
					this.plotArea,
					this.colors,
					this.currentProgress,
					this.extra?.ring,
					dataLabel
				);
				this.pieSectorAngles = ringRes.sectorAngles;
				break;
			}
			case 'funnel':
				this.funnelLayers = FunnelRenderer.render(
					ctx,
					this.series,
					this.plotArea,
					this.colors,
					this.currentProgress,
					this.extra?.funnel,
					dataLabel
				);
				break;
			case 'arcbar':
				ArcbarRenderer.render(
					ctx,
					this.series,
					this.plotArea,
					this.colors,
					this.currentProgress,
					this.extra?.arcbar,
					dataLabel
				);
				break;
		}

		// 7. 绘制图例列表
		if (showLegend && this.legendItems.length > 0) {
			Legend.draw(ctx, this.legendItems);
		}

		// 8. 绘制手势激活的 Tooltip 浮层与十字准星
		if (this.tooltipState.visible) {
			if (
				this.options.type === 'line' ||
				this.options.type === 'area' ||
				this.options.type === 'column'
			) {
				Tooltip.drawCrosshair(ctx, this.tooltipState.x, this.plotArea);
			}
			Tooltip.drawCard(ctx, this.tooltipState, width, height);
		}
	}

	/**
	 * 计算直角坐标系极值与 Nice Numbers 刻度
	 */
	private calculateScales() {
		let minVal = 0;
		let maxVal = 0;
		let hasData = false;

		for (let s = 0; s < this.series.length; s++) {
			const item = this.series[s];
			if (item.show != null && !item.show!) continue;

			for (let i = 0; i < item.data.length; i++) {
				const val = item.data[i];
				if (!hasData) {
					minVal = val;
					maxVal = val;
					hasData = true;
				} else {
					if (val < minVal) minVal = val;
					if (val > maxVal) maxVal = val;
				}
			}
		}

		if (!hasData) {
			minVal = 0;
			maxVal = 10;
		}

		this.axisScale = Axis.calculateNiceScale(minVal, maxVal, 4);
	}

	/**
	 * 处理触控事件 (touchstart / touchmove / tap)
	 * @param e 原生触控事件
	 */
	public handleTouch(e: TouchEvent) {
		const point = TouchHandler.getTouchPoint(e);

		// 1. 优先检测是否点击在图例区域
		if (this.legendItems.length > 0) {
			const hitLegendIdx = TouchHandler.hitTestLegend(point, this.legendItems);
			if (hitLegendIdx >= 0) {
				const hitItem = this.legendItems[hitLegendIdx];
				const sIdx = hitItem.seriesIndex;
				if (sIdx >= 0 && sIdx < this.series.length) {
					const curShow = this.series[sIdx].show != null ? this.series[sIdx].show! : true;
					this.series[sIdx].show = !curShow;
					// 隐藏 Tooltip 并触发重绘
					this.tooltipState.visible = false;
					this.startAnimation();
					return;
				}
			}
		}

		// 2. 检测数据点拾取与 Tooltip 呈现
		if (
			this.options.type === 'line' ||
			this.options.type === 'area' ||
			this.options.type === 'column'
		) {
			const catIdx = TouchHandler.hitTestCartesianCategory(point, this.plotArea, this.categories.length);
			if (catIdx >= 0 && catIdx < this.categories.length) {
				const catTitle = this.categories[catIdx];
				const items: TooltipItem[] = [];

				for (let sIdx = 0; sIdx < this.series.length; sIdx++) {
					const s = this.series[sIdx];
					if (s.show != null && !s.show!) continue;
					const val = catIdx < s.data.length ? s.data[catIdx] : 0;
					const color = s.color != null && s.color != '' ? s.color! : this.colors[sIdx % this.colors.length];
					items.push({
						name: s.name,
						value: val.toString(),
						color: color
					});
				}

				const step = this.plotArea.width / this.categories.length;
				const snapX = this.plotArea.left + (catIdx + 0.5) * step;

				this.tooltipState = {
					visible: true,
					x: snapX,
					y: point.y,
					title: catTitle,
					items: items
				};
				this.drawFrame();
			}
		} else if (this.options.type === 'bar') {
			const catIdx = TouchHandler.hitTestBarCategory(point, this.plotArea, this.categories.length);
			if (catIdx >= 0 && catIdx < this.categories.length) {
				const catTitle = this.categories[catIdx];
				const items: TooltipItem[] = [];

				for (let sIdx = 0; sIdx < this.series.length; sIdx++) {
					const s = this.series[sIdx];
					if (s.show != null && !s.show!) continue;
					const val = catIdx < s.data.length ? s.data[catIdx] : 0;
					const color = s.color != null && s.color != '' ? s.color! : this.colors[sIdx % this.colors.length];
					items.push({
						name: s.name,
						value: val.toString(),
						color: color
					});
				}

				this.tooltipState = {
					visible: true,
					x: point.x,
					y: point.y,
					title: catTitle,
					items: items
				};
				this.drawFrame();
			}
		} else if (this.options.type === 'pie' || this.options.type === 'ring') {
			const cx = this.plotArea.left + this.plotArea.width / 2;
			const cy = this.plotArea.top + this.plotArea.height / 2;
			const r = Math.min(this.plotArea.width, this.plotArea.height) / 2 - 10;
			const innerR = this.options.type === 'ring' ? r * 0.6 : 0;

			const sIdx = TouchHandler.hitTestPolarSector(point, cx, cy, r, innerR, this.pieSectorAngles);
			if (sIdx >= 0 && sIdx < this.series.length) {
				const s = this.series[sIdx];
				const val = s.value != null ? s.value! : (s.data.length > 0 ? s.data[0] : 0);
				const color = s.color != null && s.color != '' ? s.color! : this.colors[sIdx % this.colors.length];

				this.tooltipState = {
					visible: true,
					x: point.x,
					y: point.y,
					title: s.name,
					items: [{
						name: '数值',
						value: val.toString(),
						color: color
					}]
				};
				this.drawFrame();
			}
		}
	}

	/**
	 * 手势触控离开时隐藏 Tooltip
	 */
	public handleTouchEnd() {
		if (this.tooltipState.visible) {
			// 延迟 1.5 秒淡出提示框，改善移动端阅读体验
			setTimeout(() => {
				this.tooltipState.visible = false;
				this.drawFrame();
			}, 1500);
		}
	}

	/**
	 * 更新图表数据与扩展配置，并触发平滑更新动效
	 * @param series 新的数据序列
	 * @param categories 新的维度分类 (可选)
	 * @param extra 新的图表扩展配置 (可选，包含 arcbar/ring 的 title 与 subtitle 等)
	 */
	public updateData(
		series: ChartSeriesItem[],
		categories: string[] | null = null,
		extra: ChartExtra | null = null
	) {
		this.series = series;
		if (categories != null) {
			this.categories = categories!;
		}
		if (extra != null) {
			this.extra = extra;
		}
		this.tooltipState.visible = false;
		this.startAnimation();
	}

	/**
	 * 画布逻辑尺寸变更适配
	 * @param width 逻辑宽度
	 * @param height 逻辑高度
	 */
	public resize(width: number, height: number) {
		this.contextManager.resize(width, height);
		this.drawFrame();
	}

	/**
	 * 销毁引擎实例并释放相关资源
	 */
	public destroy() {
		this.animationController.stop();
		this.contextManager.destroy();
	}
}
