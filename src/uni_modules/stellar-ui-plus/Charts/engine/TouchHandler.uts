/**
 * @file TouchHandler.uts
 * @description 图表手势触控与命中检测 (Hit-test) 调度器
 * 负责解析触控事件坐标，并在直角坐标系、极坐标系及图例区域中进行碰撞与最近点拾取
 */

import { ChartPoint, ChartRect, ChartLegendItem } from '../types/uts-types.uts'

/**
 * 触控检测结果结构
 */
export type HitTestResult = {
	/** 是否命中了图例项 */
	isLegendHit: boolean;
	/** 命中的图例索引（若命中） */
	legendIndex: number;
	/** 命中的分类维度索引（针对直角坐标系） */
	categoryIndex: number;
	/** 命中的数据序列索引（针对饼图/环形图/漏斗图） */
	seriesIndex: number;
	/** 触控点坐标 */
	point: ChartPoint;
}

/**
 * 手势调度处理器
 */
export class TouchHandler {
	/**
	 * 从标准原生触控事件中提取相对于 Canvas 的逻辑坐标
	 * @param e 触控事件对象
	 * @returns 相对坐标点 (px)
	 */
	public static getTouchPoint(e: TouchEvent): ChartPoint {
		let x = 0;
		let y = 0;

		if (e.touches.length > 0) {
			const touch = e.touches[0];
			x = touch.clientX;
			y = touch.clientY;
		} else if (e.changedTouches.length > 0) {
			const touch = e.changedTouches[0];
			x = touch.clientX;
			y = touch.clientY;
		}

		return { x, y };
	}

	/**
	 * 检测触控点是否落在某个图例项的点击矩形范围内
	 * @param point 触控点坐标
	 * @param legends 图例列表
	 * @returns 命中的图例索引，未命中返回 -1
	 */
	public static hitTestLegend(point: ChartPoint, legends: ChartLegendItem[]): number {
		for (let i = 0; i < legends.length; i++) {
			const item = legends[i];
			// 增加适量手势外扩触控热区 (+8px)
			const pad = 8;
			if (
				point.x >= item.x - pad &&
				point.x <= item.x + item.width + pad &&
				point.y >= item.y - pad &&
				point.y <= item.y + item.height + pad
			) {
				return i;
			}
		}
		return -1;
	}

	/**
	 * 直角坐标系分类拾取（折线图、柱状图、面积图）
	 * 根据 X 轴触点位置反算最近的 Category 索引
	 * @param point 触控坐标
	 * @param plotArea 绘图区域几何尺寸
	 * @param categoryCount 分类总数
	 * @returns 分类索引下标 (0 ~ categoryCount - 1)
	 */
	public static hitTestCartesianCategory(point: ChartPoint, plotArea: ChartRect, categoryCount: number): number {
		if (categoryCount <= 0 || plotArea.width <= 0) return -1;

		// 约束在绘图区内
		if (point.x < plotArea.left || point.x > plotArea.right) {
			return -1;
		}

		const step = plotArea.width / categoryCount;
		const offset = point.x - plotArea.left;
		let index = Math.floor(offset / step);

		if (index < 0) index = 0;
		if (index >= categoryCount) index = categoryCount - 1;

		return index;
	}

	/**
	 * 横向条形图分类拾取（BarChart）
	 * 根据 Y 轴触点位置反算最近的 Category 索引
	 * @param point 触控坐标
	 * @param plotArea 绘图区域
	 * @param categoryCount 分类总数
	 * @returns 分类索引下标
	 */
	public static hitTestBarCategory(point: ChartPoint, plotArea: ChartRect, categoryCount: number): number {
		if (categoryCount <= 0 || plotArea.height <= 0) return -1;

		if (point.y < plotArea.top || point.y > plotArea.bottom) {
			return -1;
		}

		const step = plotArea.height / categoryCount;
		const offset = point.y - plotArea.top;
		let index = Math.floor(offset / step);

		if (index < 0) index = 0;
		if (index >= categoryCount) index = categoryCount - 1;

		return index;
	}

	/**
	 * 极坐标系扇区拾取（饼图、环形图）
	 * 根据圆心与触控夹角计算命中的扇区
	 * @param point 触控坐标
	 * @param centerX 圆心 X
	 * @param centerY 圆心 Y
	 * @param radius 外圆半径
	 * @param innerRadius 内圆半径 (环形图)
	 * @param sectorAngles 各扇区起始与终止弧度数组 [[start, end]]
	 * @returns 命中的扇区索引，未命中返回 -1
	 */
	public static hitTestPolarSector(
		point: ChartPoint,
		centerX: number,
		centerY: number,
		radius: number,
		innerRadius: number,
		sectorAngles: number[][]
	): number {
		const dx = point.x - centerX;
		const dy = point.y - centerY;
		const dist = Math.sqrt(dx * dx + dy * dy);

		// 判断是否在同心圆环范围内
		if (dist < innerRadius || dist > radius) {
			return -1;
		}

		// 计算极角 (0 ~ 2*PI)，以 12 点钟方向 (-PI/2) 为基准
		let angle = Math.atan2(dy, dx);
		// 转换到 [0, 2*PI)
		if (angle < 0) {
			angle += 2 * Math.PI;
		}

		for (let i = 0; i < sectorAngles.length; i++) {
			const pair = sectorAngles[i];
			const start = pair[0];
			const end = pair[1];
			if (angle >= start && angle <= end) {
				return i;
			}
		}

		return -1;
	}
}
