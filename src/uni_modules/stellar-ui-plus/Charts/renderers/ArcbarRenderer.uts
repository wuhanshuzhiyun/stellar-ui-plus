/**
 * @file ArcbarRenderer.uts
 * @description 弧形进度环/柱状图渲染策略器 (uni-app x / UTS 纯原生实现)
 * 基于 Canvas 2D arc() 绘制中空弧形进度条底轨与激活圆弧段，支持中心标题、圆角端点与展开动效
 */

import { ChartRect, ChartSeriesItem, ArcbarExtraConfig } from '../types/uts-types.uts'

/**
 * 弧形图渲染策略类
 */
export class ArcbarRenderer {
	/**
	 * 执行弧形进度图绘制
	 * @param ctx 渲染上下文
	 * @param series 数据序列
	 * @param plotArea 绘图区矩形
	 * @param colors 调色板
	 * @param progress 补间动画进度 (0.0 ~ 1.0)
	 * @param extra 额外配置（弧形宽度、起止角度、底轨颜色、中心标题）
	 * @param dataLabel 是否显示标签
	 */
	public static render(
		ctx: CanvasRenderingContext2D,
		series: ChartSeriesItem[],
		plotArea: ChartRect,
		colors: string[],
		progress: number,
		extra: ArcbarExtraConfig | null = null,
		dataLabel: boolean = true
	) {
		const cx = plotArea.left + plotArea.width / 2.0;
		const cy = plotArea.top + plotArea.height / 2.0;
		const minSide = Math.min(plotArea.width, plotArea.height);
		const arcWidth = extra?.width != null ? extra?.width! : 12.0;
		const radius = minSide / 2.0 - arcWidth;

		if (radius <= 5.0) return;

		// 默认起始弧度 0.75 * PI (约 135度，左下角)，终止弧度 0.25 * PI (约 45度，右下角)
		// 扫过角为 1.5 * PI (270度)
		const startAngle = extra?.startAngle != null ? extra?.startAngle! : 0.75 * Math.PI;
		const endAngle = extra?.endAngle != null ? extra?.endAngle! : 0.25 * Math.PI;
		const lineCap = extra?.lineCap != null && extra?.lineCap != '' ? extra?.lineCap! : 'round';
		const bgColor = extra?.backgroundColor != null && extra?.backgroundColor != '' ? extra?.backgroundColor! : '#E9E9E9';

		let totalSpan = endAngle - startAngle;
		if (totalSpan <= 0.0) {
			totalSpan += Math.PI * 2.0;
		}

		ctx.save();

		// 1. 绘制底轨全长圆弧
		ctx.beginPath();
		ctx.arc(cx, cy, radius, startAngle, endAngle, false);
		ctx.strokeStyle = bgColor;
		ctx.lineWidth = arcWidth;
		ctx.lineCap = lineCap;
		ctx.stroke();

		// 2. 绘制各 series 激活圆弧进度
		for (let i = 0; i < series.length; i++) {
			const s = series[i];
			if (s.show != null && !s.show!) continue;

			const val = s.value != null ? s.value! : (s.data.length > 0 ? s.data[0] : 0.0);
			// 数值 0.0 ~ 1.0 (或 > 1 则作为百分比 0 ~ 100)
			let ratio = val > 1.0 ? (val / 100.0) : val;
			ratio = Math.max(0.0, Math.min(1.0, ratio));

			const sweep = totalSpan * ratio * progress;
			const arcEnd = startAngle + sweep;

			const color = s.color != null && s.color != '' ? s.color! : colors[i % colors.length];

			ctx.beginPath();
			ctx.arc(cx, cy, radius, startAngle, arcEnd, false);
			ctx.strokeStyle = color;
			ctx.lineWidth = arcWidth;
			ctx.lineCap = lineCap;
			ctx.stroke();
		}

		// 3. 绘制中心主标题与副标题
		const title = extra?.title != null ? extra?.title! : '';
		const subtitle = extra?.subtitle != null ? extra?.subtitle! : '';

		if (title != '' || subtitle != '') {
			ctx.textAlign = 'center';
			ctx.textBaseline = 'middle';

			if (title != '' && subtitle != '') {
				ctx.font = 'bold 22px sans-serif';
				ctx.fillStyle = '#181818';
				ctx.fillText(title, cx, cy - 8.0);

				ctx.font = '12px sans-serif';
				ctx.fillStyle = '#8c8c8c';
				ctx.fillText(subtitle, cx, cy + 16.0);
			} else if (title != '') {
				ctx.font = 'bold 24px sans-serif';
				ctx.fillStyle = '#181818';
				ctx.fillText(title, cx, cy);
			} else {
				ctx.font = '14px sans-serif';
				ctx.fillStyle = '#8c8c8c';
				ctx.fillText(subtitle, cx, cy);
			}
		}

		ctx.restore();
	}
}
