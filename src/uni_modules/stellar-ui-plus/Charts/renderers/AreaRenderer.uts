/**
 * @file AreaRenderer.uts
 * @description 面积图渲染策略器
 * 继承折线趋势表达，通过下沉闭合区间填充自然通透的线性半透明渐变，直观反映数据量级累计与对比
 */

import { ChartRect, ChartSeriesItem, AreaExtraConfig, ChartPoint } from '../types/uts-types.uts'
import { Axis, AxisScale } from '../components/Axis.uts'

/**
 * 面积图渲染策略类
 */
export class AreaRenderer {
	/**
	 * 执行面积图绘制
	 * @param ctx 渲染上下文
	 * @param series 数据序列列表
	 * @param categories X 轴分类维度
	 * @param plotArea 绘图区域矩形
	 * @param scale Y 轴刻度比例
	 * @param colors 主题调色板
	 * @param progress 补间动画进度 (0.0 ~ 1.0)
	 * @param extra 额外配置
	 * @param dataLabel 是否显示数据标注
	 */
	public static render(
		ctx: CanvasRenderingContext2D,
		series: ChartSeriesItem[],
		categories: string[],
		plotArea: ChartRect,
		scale: AxisScale,
		colors: string[],
		progress: number,
		extra: AreaExtraConfig | null = null,
		dataLabel: boolean = true
	) {
		if (series.length == 0 || categories.length == 0) return;

		const isCurve = extra?.type === 'curve';
		const lineWidth = extra?.width != null && extra?.width! > 0 ? extra?.width! : 2;
		const opacity = extra?.opacity != null ? extra?.opacity! : 0.35;
		const step = plotArea.width / categories.length;

		ctx.save();

		for (let sIdx = 0; sIdx < series.length; sIdx++) {
			const s = series[sIdx];
			if (s.show != null && !s.show!) continue;

			const baseColor = s.color != null && s.color != '' ? s.color! : colors[sIdx % colors.length];

			// 1. 计算点坐标
			const points: ChartPoint[] = [];
			for (let i = 0; i < categories.length; i++) {
				const x = plotArea.left + (i + 0.5) * step;
				const rawVal = i < s.data.length ? s.data[i] : 0;
				const targetY = Axis.valueToY(rawVal, scale, plotArea);
				const animatedY = plotArea.bottom - (plotArea.bottom - targetY) * progress;
				points.push({ x, y: animatedY });
			}

			if (points.length == 0) continue;

			// 2. 绘制渐变闭合填充区域
			ctx.beginPath();
			ctx.moveTo(points[0].x, points[0].y);

			if (!isCurve || points.length <= 2) {
				for (let i = 1; i < points.length; i++) {
					ctx.lineTo(points[i].x, points[i].y);
				}
			} else {
				for (let i = 0; i < points.length - 1; i++) {
					const p0 = i > 0 ? points[i - 1] : points[i];
					const p1 = points[i];
					const p2 = points[i + 1];
					const p3 = i < points.length - 2 ? points[i + 2] : p2;

					const factor = 0.2;
					const cp1x = p1.x + (p2.x - p0.x) * factor;
					const cp1y = p1.y + (p2.y - p0.y) * factor;
					const cp2x = p2.x - (p3.x - p1.x) * factor;
					const cp2y = p2.y - (p3.y - p1.y) * factor;

					ctx.bezierCurveTo(cp1x, cp1y, cp2x, cp2y, p2.x, p2.y);
				}
			}

			// 向 X 轴基线闭合路径
			ctx.lineTo(points[points.length - 1].x, plotArea.bottom);
			ctx.lineTo(points[0].x, plotArea.bottom);
			ctx.closePath();

			// 采用纵向线性半透明渐变
			try {
				const gradient = ctx.createLinearGradient(0, plotArea.top, 0, plotArea.bottom);
				gradient.addColorStop(0, baseColor);
				gradient.addColorStop(1, 'rgba(255, 255, 255, 0.05)');
				ctx.fillStyle = gradient;
			} catch (e) {
				ctx.fillStyle = baseColor;
			}

			ctx.globalAlpha = opacity;
			ctx.fill();
			ctx.globalAlpha = 1.0;

			// 3. 绘制顶部折线轮廓
			ctx.strokeStyle = baseColor;
			ctx.lineWidth = lineWidth;
			ctx.beginPath();
			ctx.moveTo(points[0].x, points[0].y);

			if (!isCurve || points.length <= 2) {
				for (let i = 1; i < points.length; i++) {
					ctx.lineTo(points[i].x, points[i].y);
				}
			} else {
				for (let i = 0; i < points.length - 1; i++) {
					const p0 = i > 0 ? points[i - 1] : points[i];
					const p1 = points[i];
					const p2 = points[i + 1];
					const p3 = i < points.length - 2 ? points[i + 2] : p2;

					const factor = 0.2;
					const cp1x = p1.x + (p2.x - p0.x) * factor;
					const cp1y = p1.y + (p2.y - p0.y) * factor;
					const cp2x = p2.x - (p3.x - p1.x) * factor;
					const cp2y = p2.y - (p3.y - p1.y) * factor;

					ctx.bezierCurveTo(cp1x, cp1y, cp2x, cp2y, p2.x, p2.y);
				}
			}
			ctx.stroke();

			// 4. 拐点圆圈与数据标签
			ctx.fillStyle = '#ffffff';
			ctx.textAlign = 'center';
			ctx.textBaseline = 'bottom';
			ctx.font = '10px sans-serif';

			for (let i = 0; i < points.length; i++) {
				const pt = points[i];

				ctx.fillStyle = baseColor;
				ctx.beginPath();
				ctx.arc(pt.x, pt.y, 3, 0, Math.PI * 2);
				ctx.fill();

				if (dataLabel && progress >= 0.8) {
					const val = i < s.data.length ? s.data[i] : 0;
					ctx.fillText(val.toString(), pt.x, pt.y - 5);
				}
			}
		}

		ctx.restore();
	}
}
