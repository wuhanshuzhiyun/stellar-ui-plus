/**
 * @file BarRenderer.uts
 * @description 横向条形图渲染策略器
 * Y 轴排列分类维度，条柱向右自然伸展，极佳适配移动端竖屏长文本排行榜与横向对比场景
 */

import { ChartRect, ChartSeriesItem, BarColumnExtraConfig } from '../types/uts-types.uts'
import { Axis, AxisScale } from '../components/Axis.uts'

/**
 * 横向条状图渲染策略类
 */
export class BarRenderer {
	/**
	 * 执行横向条状图绘制
	 * @param ctx 渲染上下文
	 * @param series 数据序列列表
	 * @param categories Y 轴分类维度
	 * @param plotArea 绘图有效区
	 * @param scale X 轴刻度比例
	 * @param colors 调色板
	 * @param progress 补间动画进度 (0.0 ~ 1.0)
	 * @param extra 额外配置
	 * @param dataLabel 是否显示数据文案
	 */
	public static render(
		ctx: CanvasRenderingContext2D,
		series: ChartSeriesItem[],
		categories: string[],
		plotArea: ChartRect,
		scale: AxisScale,
		colors: string[],
		progress: number,
		extra: BarColumnExtraConfig | null = null,
		dataLabel: boolean = true
	) {
		if (series.length == 0 || categories.length == 0) return;

		const activeSeriesIndices: number[] = [];
		for (let i = 0; i < series.length; i++) {
			if (series[i].show == null || series[i].show!) {
				activeSeriesIndices.push(i);
			}
		}
		if (activeSeriesIndices.length == 0) return;

		const activeCount = activeSeriesIndices.length;
		const categoryHeight = plotArea.height / categories.length;

		let barHeight = extra?.width != null && extra?.width! > 0 ? extra?.width! : 0;
		const seriesGapRatio = extra?.seriesGap != null ? extra?.seriesGap! : 0.2;
		const categoryGapRatio = extra?.categoryGap != null ? extra?.categoryGap! : 0.3;

		if (barHeight <= 0) {
			const usableCatHeight = categoryHeight * (1 - categoryGapRatio);
			barHeight = usableCatHeight / (activeCount + (activeCount - 1) * seriesGapRatio);
			if (barHeight < 6) barHeight = 6;
			if (barHeight > 28) barHeight = 28;
		}

		const seriesGap = barHeight * seriesGapRatio;
		const totalGroupHeight = activeCount * barHeight + (activeCount - 1) * seriesGap;
		const groupStartOffset = (categoryHeight - totalGroupHeight) / 2;

		const borderRadius = extra?.borderRadius != null ? extra?.borderRadius! : 3;

		ctx.save();
		ctx.font = '10px sans-serif';
		ctx.textAlign = 'left';
		ctx.textBaseline = 'middle';

		for (let cIdx = 0; cIdx < categories.length; cIdx++) {
			const catTop = plotArea.top + cIdx * categoryHeight;

			for (let aIdx = 0; aIdx < activeCount; aIdx++) {
				const sIdx = activeSeriesIndices[aIdx];
				const s = series[sIdx];
				const color = s.color != null && s.color != '' ? s.color! : colors[sIdx % colors.length];

				const rawVal = cIdx < s.data.length ? s.data[cIdx] : 0;
				const targetX = Axis.valueToX(rawVal, scale, plotArea);
				const fullWidth = targetX - plotArea.left;
				const animatedWidth = Math.max(0, fullWidth * progress);

				const y = catTop + groupStartOffset + aIdx * (barHeight + seriesGap);
				const x = plotArea.left;

				if (animatedWidth > 0) {
					// 绘制右侧带圆角的矩形条
					ctx.fillStyle = color;
					const r = Math.min(borderRadius, barHeight / 2, animatedWidth / 2);

					ctx.beginPath();
					ctx.moveTo(x, y);
					ctx.lineTo(x + animatedWidth - r, y);
					if (r > 0) {
						ctx.arc(x + animatedWidth - r, y + r, r, -Math.PI / 2, 0);
					}
					ctx.lineTo(x + animatedWidth, y + barHeight - r);
					if (r > 0) {
						ctx.arc(x + animatedWidth - r, y + barHeight - r, r, 0, Math.PI / 2);
					}
					ctx.lineTo(x, y + barHeight);
					ctx.closePath();
					ctx.fill();

					// 数据文案标注在条柱右端
					if (dataLabel && progress >= 0.8) {
						ctx.fillStyle = color;
						ctx.fillText(rawVal.toString(), x + animatedWidth + 6, y + barHeight / 2);
					}
				}
			}
		}

		ctx.restore();
	}
}
