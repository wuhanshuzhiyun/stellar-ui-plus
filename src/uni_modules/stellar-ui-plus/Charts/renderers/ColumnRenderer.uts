/**
 * @file ColumnRenderer.uts
 * @description 纵向柱状图渲染策略器
 * 支持多数据系列分列对比、微圆角质感、动态向上拔高入场动效及自适应间隙排版
 */

import { ChartRect, ChartSeriesItem, BarColumnExtraConfig } from '../types/uts-types.uts'
import { Axis, AxisScale } from '../components/Axis.uts'

/**
 * 纵向柱状图渲染策略类
 */
export class ColumnRenderer {
	/**
	 * 执行纵向柱状图绘制
	 * @param ctx 渲染上下文
	 * @param series 数据序列列表
	 * @param categories X 轴分类维度
	 * @param plotArea 绘图有效区
	 * @param scale Y 轴刻度
	 * @param colors 调色板
	 * @param progress 补间动画进度 (0.0 ~ 1.0)
	 * @param extra 扩展配置
	 * @param dataLabel 是否绘制数据文案
	 */
	public static render(
		ctx: CanvasRenderingContext2D,
		series: ChartSeriesItem[],
		categories: string[],
		plotArea: ChartRect,
		scale: AxisScale,
		colors: string[],
		progress: number,
		extra: BarColumnExtraConfig | null = null,
		dataLabel: boolean = true
	) {
		if (series.length == 0 || categories.length == 0) return;

		// 过滤出当前显示的序列
		const activeSeriesIndices: number[] = [];
		for (let i = 0; i < series.length; i++) {
			if (series[i].show == null || series[i].show!) {
				activeSeriesIndices.push(i);
			}
		}
		if (activeSeriesIndices.length == 0) return;

		const activeCount = activeSeriesIndices.length;
		const categoryWidth = plotArea.width / categories.length;

		// 柱体宽度与间距自适应计算
		let colWidth = extra?.width != null && extra?.width! > 0 ? extra?.width! : 0;
		const seriesGapRatio = extra?.seriesGap != null ? extra?.seriesGap! : 0.2;
		const categoryGapRatio = extra?.categoryGap != null ? extra?.categoryGap! : 0.3;

		// 若未指定绝对宽度，则按可用空间动态均分
		if (colWidth <= 0) {
			const usableCatWidth = categoryWidth * (1 - categoryGapRatio);
			colWidth = usableCatWidth / (activeCount + (activeCount - 1) * seriesGapRatio);
			// 限制合理范围 (8px ~ 36px)
			if (colWidth < 8) colWidth = 8;
			if (colWidth > 36) colWidth = 36;
		}

		const seriesGap = colWidth * seriesGapRatio;
		const totalGroupWidth = activeCount * colWidth + (activeCount - 1) * seriesGap;
		const groupStartOffset = (categoryWidth - totalGroupWidth) / 2;

		const borderRadius = extra?.borderRadius != null ? extra?.borderRadius! : 3;

		ctx.save();
		ctx.font = '10px sans-serif';
		ctx.textAlign = 'center';
		ctx.textBaseline = 'bottom';

		// 遍历每个分类维度
		for (let cIdx = 0; cIdx < categories.length; cIdx++) {
			const catLeft = plotArea.left + cIdx * categoryWidth;

			// 遍历该分类下的各有效序列
			for (let aIdx = 0; aIdx < activeCount; aIdx++) {
				const sIdx = activeSeriesIndices[aIdx];
				const s = series[sIdx];
				const color = s.color != null && s.color != '' ? s.color! : colors[sIdx % colors.length];

				const rawVal = cIdx < s.data.length ? s.data[cIdx] : 0;
				const targetY = Axis.valueToY(rawVal, scale, plotArea);
				const fullHeight = plotArea.bottom - targetY;
				const animatedHeight = Math.max(0, fullHeight * progress);

				const x = catLeft + groupStartOffset + aIdx * (colWidth + seriesGap);
				const y = plotArea.bottom - animatedHeight;

				if (animatedHeight > 0) {
					// 绘制顶部带圆角的矩形柱
					ctx.fillStyle = color;
					const r = Math.min(borderRadius, colWidth / 2, animatedHeight / 2);

					ctx.beginPath();
					ctx.moveTo(x, plotArea.bottom);
					ctx.lineTo(x, y + r);
					if (r > 0) {
						ctx.arc(x + r, y + r, r, Math.PI, Math.PI * 1.5);
					}
					ctx.lineTo(x + colWidth - r, y);
					if (r > 0) {
						ctx.arc(x + colWidth - r, y + r, r, Math.PI * 1.5, Math.PI * 2);
					}
					ctx.lineTo(x + colWidth, plotArea.bottom);
					ctx.closePath();
					ctx.fill();

					// 数据标注
					if (dataLabel && progress >= 0.8) {
						ctx.fillStyle = color;
						ctx.fillText(rawVal.toString(), x + colWidth / 2, y - 4);
					}
				}
			}
		}

		ctx.restore();
	}
}
