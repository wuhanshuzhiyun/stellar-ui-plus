/**
 * @file LineRenderer.uts
 * @description 折线图渲染策略器
 * 支持多数据序列并列渲染、直线折线与三次贝塞尔平滑曲线模式、入场生长动画及拐点标注
 */

import { ChartRect, ChartSeriesItem, LineExtraConfig, ChartPoint } from '../types/uts-types.uts'
import { Axis, AxisScale } from '../components/Axis.uts'

/**
 * 折线渲染策略类
 */
export class LineRenderer {
	/**
	 * 执行折线图绘制
	 * @param ctx 渲染上下文
	 * @param series 数据序列列表
	 * @param categories X 轴分类维度
	 * @param plotArea 绘图区域矩形
	 * @param scale Y 轴刻度比例
	 * @param colors 主题调色板
	 * @param progress 补间动画进度 (0.0 ~ 1.0)
	 * @param extra 额外配置
	 * @param dataLabel 是否显示数据标注文案
	 */
	public static render(
		ctx: CanvasRenderingContext2D,
		series: ChartSeriesItem[],
		categories: string[],
		plotArea: ChartRect,
		scale: AxisScale,
		colors: string[],
		progress: number,
		extra: LineExtraConfig | null = null,
		dataLabel: boolean = true
	) {
		if (series.length == 0 || categories.length == 0) return;

		const isCurve = extra?.type === 'curve';
		const lineWidth = extra?.width != null && extra?.width! > 0 ? extra?.width! : 2;
		const showPoint = extra?.showPoint != null ? extra?.showPoint! : true;
		const pointRadius = extra?.pointRadius != null ? extra?.pointRadius! : 3;

		const step = plotArea.width / categories.length;

		ctx.save();

		for (let sIdx = 0; sIdx < series.length; sIdx++) {
			const s = series[sIdx];
			// 检查序列是否被图例置灰隐藏
			if (s.show != null && !s.show!) continue;

			const strokeColor = s.color != null && s.color != '' ? s.color! : colors[sIdx % colors.length];

			// 1. 计算每个数据点的实际物理像素坐标 (X, Y)
			const points: ChartPoint[] = [];
			for (let i = 0; i < categories.length; i++) {
				const x = plotArea.left + (i + 0.5) * step;
				const rawVal = i < s.data.length ? s.data[i] : 0;

				// 补间动画映射：从底部基线平滑生长到目标 Y
				const targetY = Axis.valueToY(rawVal, scale, plotArea);
				const animatedY = plotArea.bottom - (plotArea.bottom - targetY) * progress;

				points.push({ x, y: animatedY });
			}

			if (points.length == 0) continue;

			// 2. 绘制折线线条
			ctx.strokeStyle = strokeColor;
			ctx.lineWidth = lineWidth;
			ctx.lineCap = 'round';
			ctx.lineJoin = 'round';
			ctx.beginPath();

			if (!isCurve || points.length <= 2) {
				// 普通直线模式
				ctx.moveTo(points[0].x, points[0].y);
				for (let i = 1; i < points.length; i++) {
					ctx.lineTo(points[i].x, points[i].y);
				}
			} else {
				// 三次贝塞尔平滑曲线模式 (Cubic Bezier Smoothing)
				ctx.moveTo(points[0].x, points[0].y);
				for (let i = 0; i < points.length - 1; i++) {
					const p0 = i > 0 ? points[i - 1] : points[i];
					const p1 = points[i];
					const p2 = points[i + 1];
					const p3 = i < points.length - 2 ? points[i + 2] : p2;

					// 曲线张力因子 0.2
					const factor = 0.2;
					const cp1x = p1.x + (p2.x - p0.x) * factor;
					const cp1y = p1.y + (p2.y - p0.y) * factor;
					const cp2x = p2.x - (p3.x - p1.x) * factor;
					const cp2y = p2.y - (p3.y - p1.y) * factor;

					ctx.bezierCurveTo(cp1x, cp1y, cp2x, cp2y, p2.x, p2.y);
				}
			}
			ctx.stroke();

			// 3. 绘制拐点圆环与数据标注
			ctx.fillStyle = '#ffffff';
			ctx.textAlign = 'center';
			ctx.textBaseline = 'bottom';
			ctx.font = '10px sans-serif';

			for (let i = 0; i < points.length; i++) {
				const pt = points[i];

				if (showPoint) {
					// 外部圆
					ctx.fillStyle = strokeColor;
					ctx.beginPath();
					ctx.arc(pt.x, pt.y, pointRadius + 1, 0, Math.PI * 2);
					ctx.fill();

					// 内部空心白圆
					ctx.fillStyle = '#ffffff';
					ctx.beginPath();
					ctx.arc(pt.x, pt.y, pointRadius - 1, 0, Math.PI * 2);
					ctx.fill();
				}

				// 数据上方数值文案
				if (dataLabel && progress >= 0.8) {
					const val = i < s.data.length ? s.data[i] : 0;
					ctx.fillStyle = strokeColor;
					ctx.fillText(val.toString(), pt.x, pt.y - 6);
				}
			}
		}

		ctx.restore();
	}
}
