/**
 * @file PieRenderer.uts
 * @description 饼图渲染策略器
 * 基于极坐标系计算各数据类目所占扇形比例弧度，支持顺时针弧度展开补间动画与引线数据百分比呈现
 */

import { ChartRect, ChartSeriesItem, PieRingExtraConfig } from '../types/uts-types.uts'

/**
 * 饼图渲染结果
 */
export type PieRenderResult = {
	/** 各扇区起始与终止极角 [startAngle, endAngle] 集合，供手势命中拾取 */
	sectorAngles: number[][];
	/** 圆心与半径 */
	centerX: number;
	centerY: number;
	radius: number;
}

/**
 * 饼图渲染策略类
 */
export class PieRenderer {
	/**
	 * 执行饼图绘制
	 * @param ctx 渲染上下文
	 * @param series 数据项列表
	 * @param plotArea 绘图可用区
	 * @param colors 调色板
	 * @param progress 补间动画进度 (0.0 ~ 1.0)
	 * @param extra 扩展配置
	 * @param dataLabel 是否显示标签
	 * @returns 扇区极角与几何参数
	 */
	public static render(
		ctx: CanvasRenderingContext2D,
		series: ChartSeriesItem[],
		plotArea: ChartRect,
		colors: string[],
		progress: number,
		extra: PieRingExtraConfig | null = null,
		dataLabel: boolean = true
	): PieRenderResult {
		const result: PieRenderResult = {
			sectorAngles: [],
			centerX: plotArea.left + plotArea.width / 2,
			centerY: plotArea.top + plotArea.height / 2,
			radius: Math.min(plotArea.width, plotArea.height) / 2 - 10
		};

		if (series.length == 0 || result.radius <= 10) return result;

		// 1. 计算有效总和
		let total = 0;
		for (let i = 0; i < series.length; i++) {
			const s = series[i];
			if (s.show == null || s.show!) {
				const val = s.value != null ? s.value! : (s.data.length > 0 ? s.data[0] : 0);
				if (val > 0) total += val;
			}
		}

		if (total <= 0) return result;

		const cx = result.centerX;
		const cy = result.centerY;
		const r = result.radius;

		// 起始角度从 12 点钟方向 (-PI/2) 开始
		let currentAngle = -Math.PI / 2;

		ctx.save();
		ctx.font = '10px sans-serif';
		ctx.textBaseline = 'middle';

		for (let i = 0; i < series.length; i++) {
			const s = series[i];
			if (s.show != null && !s.show!) {
				result.sectorAngles.push([0, 0]);
				continue;
			}

			const val = s.value != null ? s.value! : (s.data.length > 0 ? s.data[0] : 0);
			const ratio = val / total;
			// 乘算动画进度
			const sweepAngle = Math.PI * 2 * ratio * progress;
			const startAngle = currentAngle;
			const endAngle = startAngle + sweepAngle;

			// 记录触控命中角度（映射到 [0, 2*PI)）
			let normStart = startAngle;
			let normEnd = endAngle;
			while (normStart < 0) normStart += Math.PI * 2;
			while (normEnd < 0) normEnd += Math.PI * 2;
			result.sectorAngles.push([normStart, normEnd]);

			const color = s.color != null && s.color != '' ? s.color! : colors[i % colors.length];

			// 2. 绘制实心扇形
			ctx.fillStyle = color;
			ctx.strokeStyle = '#ffffff';
			ctx.lineWidth = 1.5;

			ctx.beginPath();
			ctx.moveTo(cx, cy);
			ctx.arc(cx, cy, r, startAngle, endAngle);
			ctx.closePath();
			ctx.fill();
			ctx.stroke();

			// 3. 绘制百分比标签文案
			if (dataLabel && progress >= 0.8 && ratio >= 0.05) {
				const midAngle = startAngle + sweepAngle / 2;
				// 放在扇区半径 0.65 处
				const textRadius = r * 0.65;
				const tx = cx + Math.cos(midAngle) * textRadius;
				const ty = cy + Math.sin(midAngle) * textRadius;

				const percentText = (ratio * 100).toFixed(1) + '%';
				ctx.fillStyle = '#ffffff';
				ctx.textAlign = 'center';
				ctx.fillText(percentText, tx, ty);
			}

			currentAngle = endAngle;
		}

		ctx.restore();
		return result;
	}
}
