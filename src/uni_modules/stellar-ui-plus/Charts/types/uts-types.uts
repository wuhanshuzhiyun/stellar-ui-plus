/**
 * @file uts-types.uts
 * @description Stellar UI Plus 图表统一渲染引擎强静态类型声明体系
 * 严格遵循 uni-app x (UTS) 静态类型规范，为各图表组件与渲染策略提供完备的类型契约
 */

/**
 * 二维平面坐标点接口
 */
export type ChartPoint = {
	/** X 轴逻辑像素坐标 */
	x: number;
	/** Y 轴逻辑像素坐标 */
	y: number;
}

/**
 * 二维矩形区域尺寸接口
 */
export type ChartRect = {
	/** 区域左上角 X 轴坐标 */
	left: number;
	/** 区域左上角 Y 轴坐标 */
	top: number;
	/** 区域宽度 */
	width: number;
	/** 区域高度 */
	height: number;
	/** 区域右侧边界 X 坐标 */
	right: number;
	/** 区域底部边界 Y 坐标 */
	bottom: number;
}

/**
 * 边距外衬 (Padding) 结构
 */
export type ChartPadding = {
	/** 顶部边距 */
	top: number;
	/** 右侧边距 */
	right: number;
	/** 底部边距 */
	bottom: number;
	/** 左侧边距 */
	left: number;
}

/**
 * 图表数据序列基础项接口
 */
export type ChartSeriesItem = {
	/** 序列名称，用于图例与提示框展示 */
	name: string;
	/** 数值数据列表（针对折线图、柱状图、条状图、面积图） */
	data: number[];
	/** 单一标量数据（针对饼图、环形图、漏斗图，每一项即一个分类） */
	value?: number | null;
	/** 自定义序列渲染主色调，未指定时由引擎按主题调色板分配 */
	color?: string | null;
	/** 图例图形类型：rect | circle | line */
	legendShape?: string | null;
	/** 当前序列是否在图例中被激活（未被点击隐藏） */
	show?: boolean | null;
}

/**
 * 图例渲染元数据对象
 */
export type ChartLegendItem = {
	/** 图例名称 */
	name: string;
	/** 图例对应的色值 */
	color: string;
	/** 图例图形标识 */
	shape: string;
	/** 是否处于显示状态 */
	show: boolean;
	/** 对应原始 series 的索引下标 */
	seriesIndex: number;
	/** 图例绘制的 X 起始坐标 */
	x: number;
	/** 图例绘制的 Y 起始坐标 */
	y: number;
	/** 整个图例项的测量宽度 */
	width: number;
	/** 整个图例项的测量高度 */
	height: number;
}

/**
 * 触控提示框单项明细数据
 */
export type TooltipItem = {
	/** 对应序列或分类名称 */
	name: string;
	/** 数值文案 */
	value: string;
	/** 对应图例色标 */
	color: string;
}

/**
 * 提示框状态与数据
 */
export type ChartTooltipState = {
	/** 提示框是否当前处于激活显示状态 */
	visible: boolean;
	/** 提示框吸附的目标逻辑坐标 */
	x: number;
	y: number;
	/** 选中的分类名称或数据标题 */
	title: string;
	/** 关联的数据序列明细集合 */
	items: TooltipItem[];
}

/**
 * 折线图特有扩展配置
 */
export type LineExtraConfig = {
	/** 折线形态：straight (直线折线) | curve (贝塞尔平滑曲线) */
	type?: string | null;
	/** 折线线条粗细 (px) */
	width?: number | null;
	/** 是否在数据拐点处绘制小圆点 */
	showPoint?: boolean | null;
	/** 拐点圆半径 (px) */
	pointRadius?: number | null;
}

/**
 * 面积图特有扩展配置
 */
export type AreaExtraConfig = {
	/** 面积折线形态：straight | curve */
	type?: string | null;
	/** 面积折线宽度 */
	width?: number | null;
	/** 面积填充渐变透明度开始比例 (0.0 ~ 1.0) */
	opacity?: number | null;
}

/**
 * 柱状图/条状图特有扩展配置
 */
export type BarColumnExtraConfig = {
	/** 柱体宽度或高度 (px) */
	width?: number | null;
	/** 柱体顶角圆角半径 (px) */
	borderRadius?: number | null;
	/** 同一分类下多根柱体之间的间距比例 */
	seriesGap?: number | null;
	/** 分类与分类之间的间距比例 */
	categoryGap?: number | null;
}

/**
 * 饼图/环形图特有扩展配置
 */
export type PieRingExtraConfig = {
	/** 环形图空心内圆半径比例 (0.0 ~ 0.9，如 0.6 表示中空 60%) */
	ringRadiusRatio?: number | null;
	/** 中心中空标题文案 */
	title?: string | null;
	/** 中心中空副标题文案 */
	subtitle?: string | null;
	/** 标签引线与占比文案是否显示 */
	showLabel?: boolean | null;
}

/**
 * 漏斗图特有扩展配置
 */
export type FunnelExtraConfig = {
	/** 漏斗顶部最大宽度占比 (0.0 ~ 1.0) */
	maxWidthRatio?: number | null;
	/** 漏斗底部最小宽度占比 (0.0 ~ 1.0) */
	minWidthRatio?: number | null;
	/** 每层梯形之间的垂直缝隙高度 (px) */
	gap?: number | null;
}

/**
 * 弧形图特有扩展配置
 */
export type ArcbarExtraConfig = {
	/** 圆弧起始弧度 (默认 0.75 * Math.PI) */
	startAngle?: number | null;
	/** 圆弧终止弧度 (默认 0.25 * Math.PI) */
	endAngle?: number | null;
	/** 弧形线条宽度 (px) */
	width?: number | null;
	/** 底轨背景色 */
	backgroundColor?: string | null;
	/** 线条端点样式：round (圆角) | butt (平角) */
	lineCap?: string | null;
	/** 中心主标题文本 */
	title?: string | null;
	/** 中心副标题文本 */
	subtitle?: string | null;
}

/**
 * 图表扩展配置聚合体
 */
export type ChartExtra = {
	line?: LineExtraConfig | null;
	area?: AreaExtraConfig | null;
	column?: BarColumnExtraConfig | null;
	bar?: BarColumnExtraConfig | null;
	pie?: PieRingExtraConfig | null;
	ring?: PieRingExtraConfig | null;
	funnel?: FunnelExtraConfig | null;
	arcbar?: ArcbarExtraConfig | null;
}

/**
 * 图表初始化完整选项
 */
export type ChartEngineOptions = {
	/** 绑定的原生 Canvas 节点 ID */
	canvasId: string;
	/** 图表类型标识 */
	type: string;
	/** 逻辑宽度 (px) */
	width: number;
	/** 逻辑高度 (px) */
	height: number;
	/** X 轴分类维度标签集（用于直角坐标系图表） */
	categories?: string[] | null;
	/** 核心数据序列列表 */
	series: ChartSeriesItem[];
	/** 全局预设调色板 */
	colors?: string[] | null;
	/** 外衬内边距 [上, 右, 下, 左] */
	padding?: number[] | null;
	/** 是否开启入场过渡补间动画 */
	animation?: boolean | null;
	/** 动画持续时长 (ms) */
	duration?: number | null;
	/** 是否显示图例文案 */
	showLegend?: boolean | null;
	/** 是否显示数据点上方数值标注 */
	dataLabel?: boolean | null;
	/** 扩展特有配置 */
	extra?: ChartExtra | null;
}

/**
 * 图例排版计算返回结果结构
 */
export type LegendLayoutResult = {
	items: ChartLegendItem[];
	totalHeight: number;
}

/**
 * 环形图几何尺寸与扇区返回结构
 */
export type RingRenderResult = {
	sectorAngles: number[][];
	centerX: number;
	centerY: number;
	radius: number;
	innerRadius: number;
}

/**
 * 漏斗图有效层级中间数据项
 */
export type FunnelActiveSeriesItem = {
	item: ChartSeriesItem;
	originalIndex: number;
	val: number;
}

