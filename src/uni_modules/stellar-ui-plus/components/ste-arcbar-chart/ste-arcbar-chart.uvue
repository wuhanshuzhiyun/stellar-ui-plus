<template>
	<!-- 弧形进度环/柱状图根容器 -->
	<view class="ste-arcbar-chart-root" :style="[cmpRootStyle]">
		<canvas
			:id="canvasId"
			class="ste-chart-canvas"
			:style="[cmpCanvasStyle]"
			:disable-scroll="true"
			type="2d"
			@touchstart="onTouch"
			@touchmove="onTouch"
			@touchend="onTouchEnd"
		></canvas>
	</view>
</template>

<script setup lang="uts">
/**
 * @file ste-arcbar-chart.uvue
 * @description ArcbarChart 弧形进度条/弧形柱状图组件 (uni-app x / UTS 纯原生实现)
 * 基于统一图表渲染引擎 StellarChartEngine 与 ArcbarRenderer 驱动，
 * 支持圆弧进度展开动效、圆角端点、底轨样式定制及中心主副指标文字展示。
 */

import { StellarChartEngine } from '../../Charts/engine/StellarChartEngine.uts'
import { ChartSeriesItem, ChartExtra, ArcbarExtraConfig } from '../../Charts/types/uts-types.uts'
import { Color } from '../../utils/Color.uts'

// 1. Props 入参定义
const props = defineProps({
	/** 图表宽度，支持数值 (默认 rpx) 或带单位字符串 (如 '200px') */
	width: {
		type: [Number, String],
		default: '200'
	},
	/** 图表高度 */
	height: {
		type: [Number, String],
		default: '200'
	},
	/** 图表数据序列，data 取值 0.0 ~ 1.0 (或百分比 0 ~ 100) */
	series: {
		type: Array as PropType<Array<UTSJSONObject>>,
		default: (): UTSJSONObject[] => [] as UTSJSONObject[]
	},
	/** 中心主标题文案 */
	title: {
		type: String,
		default: ''
	},
	/** 中心副标题文案 */
	subtitle: {
		type: String,
		default: ''
	},
	/** 自定义调色板色值数组 */
	color: {
		type: Array as PropType<Array<string>>,
		default: (): string[] => [] as string[]
	},
	/** 是否开启展开补间动画 */
	animation: {
		type: Boolean,
		default: true
	},
	/** 动画过渡时长 (毫秒) */
	duration: {
		type: Number,
		default: 600
	},
	/** 是否显示数据文本标签 */
	dataLabel: {
		type: Boolean,
		default: false
	},
	/** 高亮选中的圆弧索引（对应 series 下标，-1 为不高亮） */
	activeIndex: {
		type: Number,
		default: -1
	},
	/** 高亮时非激活圆弧的不透明度 */
	inactiveOpacity: {
		type: Number,
		default: 0.3
	},
	/** 图表额外自定义配置 */
	extra: {
		type: Object as PropType<UTSJSONObject>,
		default: (): UTSJSONObject => ({} as UTSJSONObject)
	}
});

// 2. 状态与实例管理
const canvasId = 'ste-arcbar-chart-' + Math.floor(Math.random() * 1000000).toString();
let engine: StellarChartEngine | null = null;

/**
 * 单位安全换算解析 (rpx / px -> 物理逻辑像素)
 * @param val 传入宽度或高度
 * @param isWidth 是否为宽度维度
 */
function parsePx(val: any, isWidth: boolean): number {
	if (typeof val === 'number') {
		const win = uni.getWindowInfo();
		return (parseFloat(val.toString()) * win.windowWidth) / 750;
	}
	const str = val.toString().trim();
	if (str.endsWith('px')) {
		return parseFloat(str);
	}
	if (str.endsWith('rpx')) {
		const win = uni.getWindowInfo();
		return (parseFloat(str) * win.windowWidth) / 750;
	}
	const num = parseFloat(str);
	if (!isNaN(num)) {
		const win = uni.getWindowInfo();
		return (num * win.windowWidth) / 750;
	}
	return isWidth ? uni.getWindowInfo().windowWidth : 200;
}

/** 根容器计算样式 */
const cmpRootStyle = computed((): UTSJSONObject => {
	const w = parsePx(props.width, true);
	const h = parsePx(props.height, false);
	return {
		width: w.toString() + 'px',
		height: h.toString() + 'px'
	};
});

/** 画布计算样式 */
const cmpCanvasStyle = computed((): UTSJSONObject => {
	const w = parsePx(props.width, true);
	const h = parsePx(props.height, false);
	return {
		width: w.toString() + 'px',
		height: h.toString() + 'px'
	};
});

/**
 * 规范化 series 数据并映射 activeIndex 高亮半透明
 * @param rawList 外部传入的 UTSJSONObject 数据序列
 */
function normalizeSeries(rawList: UTSJSONObject[]): ChartSeriesItem[] {
	const list: ChartSeriesItem[] = [];
	const active = props.activeIndex;

	for (let i = 0; i < rawList.length; i++) {
		const item = rawList[i];
		const name = item.getString('name') != null ? item.getString('name')! : '';
		let val = item.getNumber('value');
		if (val == null) {
			const dataRaw = item.getArray('data');
			if (dataRaw != null && dataRaw.length > 0) {
				const firstVal = dataRaw[0];
				if (firstVal != null) {
					val = parseFloat(firstVal.toString());
				}
			}
		}
		if (val == null) val = 0.0;

		let color = item.getString('color');
		if (color == null || color == '') {
			if (props.color.length > 0) {
				color = props.color[i % props.color.length];
			} else {
				color = '#165DFF';
			}
		}

		// 处理非高亮项的淡化效果
		if (active >= 0 && active < rawList.length && i !== active) {
			// 若非激活项，适度降低透明度
			color = Color.formatColor(color!, props.inactiveOpacity);
		}

		const shape = item.getString('legendShape');
		const show = item.getBoolean('show');

		list.push({
			name: name,
			data: [val!],
			value: val,
			color: color,
			legendShape: shape != null ? shape : 'circle',
			show: show
		});
	}
	return list;
}

/**
 * 提取并组合图表 arcbar 特有扩展配置
 */
function normalizeExtra(): ChartExtra {
	const extra: ChartExtra = {};
	let centerTitle = props.title;
	let centerSub = props.subtitle;
	let startAngle: number | null = null;
	let endAngle: number | null = null;
	let arcWidth: number | null = 10.0;
	let lineCap = 'round';
	let bgColor = '#E9E9E9';

	if (props.extra != null) {
		const arcObj = props.extra.getJSON('arcbar');
		if (arcObj != null) {
			if (centerTitle == '' && arcObj.getString('title') != null) {
				centerTitle = arcObj.getString('title')!;
			}
			if (centerSub == '' && arcObj.getString('subtitle') != null) {
				centerSub = arcObj.getString('subtitle')!;
			}
			if (arcObj.getNumber('startAngle') != null) {
				startAngle = arcObj.getNumber('startAngle');
			}
			if (arcObj.getNumber('endAngle') != null) {
				endAngle = arcObj.getNumber('endAngle');
			}
			if (arcObj.getNumber('width') != null) {
				arcWidth = arcObj.getNumber('width');
			}
			if (arcObj.getString('lineCap') != null) {
				lineCap = arcObj.getString('lineCap')!;
			}
			if (arcObj.getString('backgroundColor') != null) {
				bgColor = arcObj.getString('backgroundColor')!;
			}
		}
	}

	extra.arcbar = {
		title: centerTitle,
		subtitle: centerSub,
		startAngle: startAngle,
		endAngle: endAngle,
		width: arcWidth,
		lineCap: lineCap,
		backgroundColor: bgColor
	} as ArcbarExtraConfig;

	return extra;
}

// 3. 生命周期与引擎挂载
onMounted(() => {
	const width = parsePx(props.width, true);
	const height = parsePx(props.height, false);

	engine = new StellarChartEngine({
		canvasId: canvasId,
		type: 'arcbar',
		width: width,
		height: height,
		series: normalizeSeries(props.series),
		colors: props.color.length > 0 ? props.color : null,
		animation: props.animation,
		duration: props.duration,
		dataLabel: props.dataLabel,
		showLegend: false,
		extra: normalizeExtra()
	});

	engine?.mount();
});

// 监听 series、中心主副标题、高亮索引及扩展配置的变动并同步重绘
watch((): any => [
	props.series,
	props.title,
	props.subtitle,
	props.activeIndex,
	props.inactiveOpacity,
	props.extra
], () => {
	if (engine != null) {
		engine?.updateData(
			normalizeSeries(props.series),
			null,
			normalizeExtra()
		);
	}
});

function onTouch(e: TouchEvent) {
	engine?.handleTouch(e);
}

function onTouchEnd() {
	engine?.handleTouchEnd();
}

onUnmounted(() => {
	engine?.destroy();
	engine = null;
});
</script>

<style>
.ste-arcbar-chart-root {
	position: relative;
	overflow: hidden;
}
.ste-chart-canvas {
	position: absolute;
	left: 0;
	top: 0;
}
</style>
