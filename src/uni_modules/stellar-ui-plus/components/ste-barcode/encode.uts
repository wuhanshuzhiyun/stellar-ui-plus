// encode.uts - uni-app x 版本
// Code128 条形码编码逻辑
// 将原 encode.ts 转换为 UTS 强类型版本

// ============== Code128 控制字符 ==============
const CHAR_TILDE: number = 126
const SET_STARTA: number = 103
const SET_STARTB: number = 104
const SET_STARTC: number = 105
const SET_SHIFT: number = 98
const SET_CODEA: number = 101
const SET_CODEB: number = 100
const SET_STOP: number = 106

// 码制集合常量（用普通常量代替对象字面量，UTS 不支持 const obj.key 访问）
const CODESET_ANY: number = 1
const CODESET_AB: number = 2
const CODESET_A: number = 3
const CODESET_B: number = 4
const CODESET_C: number = 5

// ============== Code128 条形图样 ==============
// 每个值包含黑白条宽度 [b1, w1, b2, w2, b3, w3, ...]
// 这里使用 8 元素数组表示一个字符的 6 个条（含 3 段黑白交替）
const PATTERNS: number[][] = [
	[2, 1, 2, 2, 2, 2, 0, 0], // 0
	[2, 2, 2, 1, 2, 2, 0, 0], // 1
	[2, 2, 2, 2, 2, 1, 0, 0], // 2
