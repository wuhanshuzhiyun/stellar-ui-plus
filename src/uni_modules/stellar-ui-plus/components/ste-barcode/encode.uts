// ============== 内部辅助函数 ==============

// 获取字符串的字节码数组
function getBytes(str: string): number[] {
	const bytes: number[] = []
	for (let i: number = 0; i < str.length; i++) {
		// UTS 中 String 是 Kotlin 的 String，charCodeAt 返回 Number?，需要 null 断言
		const c: number = str.charCodeAt(i) as number
		bytes.push(c)
	}
	return bytes
}

// 判断字符可用的码制集
function codeSetAllowedFor(chr: number): number {
	if (chr >= 48 && chr <= 57) {
		// 0-9 数字
		return CODESET_ANY
	} else if (chr >= 32 && chr <= 95) {
		// 可打印 ASCII 字符
		return CODESET_AB
	} else {
		// 非可打印字符
		return chr < 32 ? CODESET_A : CODESET_B
	}
}

// 判断字符是否兼容指定码制
function charCompatible(chr: number, codeset: number): boolean {
	const csa: number = codeSetAllowedFor(chr)
	if (csa == CODESET_ANY) return true
	if (csa == CODESET_AB) return true
	if (csa == CODESET_A && codeset == CODESET_A) return true
	if (csa == CODESET_B && codeset == CODESET_B) return true
	return false
}

// 将 ASCII 码转换为 Code128 字符值
function codeValue(chr1: number, chr2: number): number {
	if (chr2 < 0) {
		return chr1 >= 32 ? chr1 - 32 : chr1 + 64
	}
	// Code C 模式下，两个数字组合成一个值
	const s1: string = String.fromCharCode(chr1)
	const s2: string = String.fromCharCode(chr2)
	return parseInt(s1 + s2)
}

// 编码结果类型：codes 数组 + 新的码制
class CodesResult {
	codes: number[]
	currcs: number

	constructor(codes: number[], currcs: number) {
		this.codes = codes
		this.currcs = currcs
	}
}

// ============== Code128 编码主函数 ==============

// 将字符串编码为 Code128 条码数值数组
export function stringToCode128(text: string): number[] {
	if (text.length == 0) {
		return []
	}

	const bytes: number[] = getBytes(text)

	// 决定起始码制
	let currcs: number = CODESET_B

	// 如果全是数字，使用 C 码制压缩
	let allDigits: boolean = true
	for (let i: number = 0; i < bytes.length; i++) {
		const b: number = bytes[i]
		if (b < 48 || b > 57) {
			allDigits = false
			break
		}
	}
	if (allDigits) {
		currcs = CODESET_C
	}

	// 构建编码数组
	const codes: number[] = []

	// 添加起始码
	if (currcs == CODESET_A) {
		codes.push(SET_STARTA)
	} else if (currcs == CODESET_B) {
		codes.push(SET_STARTB)
	} else {
		codes.push(SET_STARTC)
	}

	// 逐字符编码
	let i: number = 0
	while (i < bytes.length) {
		const b1: number = bytes[i]
		const b2: number = (i + 1) < bytes.length ? bytes[i + 1] : -1

		const result: CodesResult = codesForChar(b1, b2, currcs)
		for (let k: number = 0; k < result.codes.length; k++) {
			codes.push(result.codes[k])
		}

		// 更新当前码制
		currcs = result.currcs

		// Code C 每次处理 2 个字符
		if (currcs == CODESET_C) {
			i = i + 2
		} else {
			i = i + 1
		}
	}

	// 计算校验码
	let checksum: number = codes[0]
	for (let weight: number = 1; weight < codes.length; weight++) {
		checksum += weight * codes[weight]
	}
	codes.push(checksum % 103)

	// 添加终止码
	codes.push(SET_STOP)

	return codes
}

// 处理单个字符的编码
function codesForChar(chr1: number, chr2: number, currentCs: number): CodesResult {
	const result: number[] = []
	let shifter: number = -1
	let currcs: number = currentCs

	if (charCompatible(chr1, currcs)) {
		// 字符兼容当前码制
		if (currcs == CODESET_C) {
			if (chr2 == -1) {
				// 最后一个字符，需要切换到 B
				shifter = SET_CODEB
				currcs = CODESET_B
			} else if (!charCompatible(chr2, currcs)) {
				// 下一个字符不兼容，需要切换
				if (charCompatible(chr2, CODESET_A)) {
					shifter = SET_CODEA
					currcs = CODESET_A
				} else {
					shifter = SET_CODEB
					currcs = CODESET_B
				}
			}
		}
	} else {
		// 字符不兼容当前码制
		if (chr2 != -1 && !charCompatible(chr2, currcs)) {
			// 下一个字符也不兼容，需要切换码制
			if (currcs == CODESET_A) {
				shifter = SET_CODEB
				currcs = CODESET_B
			} else if (currcs == CODESET_B) {
				shifter = SET_CODEA
				currcs = CODESET_A
			}
		} else {
			// 使用 SHIFT 临时切换
			shifter = SET_SHIFT
		}
	}

	if (shifter != -1) {
		result.push(shifter)
		result.push(codeValue(chr1, -1))
	} else {
		if (currcs == CODESET_C) {
			result.push(codeValue(chr1, chr2))
		} else {
			result.push(codeValue(chr1, -1))
		}
	}

	return new CodesResult(result, currcs)
}

// 将 PATTERNS 码序列转换为二进制序列
// 1 表示黑色条，0 表示白色空隙
export function patternsToBinary(codes: number[]): string {
	let binary: string = ''
	for (let i: number = 0; i < codes.length; i++) {
		const idx: number = codes[i]
		if (idx < 0 || idx >= PATTERNS.length) continue
		const pattern: number[] = PATTERNS[idx]
		for (let j: number = 0; j < pattern.length; j += 2) {
			// 添加黑色条
			const bWidth: number = pattern[j]
			for (let bi: number = 0; bi < bWidth; bi++) {
				binary += '1'
			}
			// 添加白色空隙
			if (j + 1 < pattern.length) {
				const wWidth: number = pattern[j + 1]
				for (let wi: number = 0; wi < wWidth; wi++) {
					binary += '0'
				}
			}
		}
	}
	return binary
}
