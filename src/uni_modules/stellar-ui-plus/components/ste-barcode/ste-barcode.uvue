<template>
	<view class="ste-barcode" :style="[cmpRootStyle]">
		<!-- 动态生成 canvas id，uvue 中使用 id 而非 canvas-id -->
		<view class="ste-barcode-canvas-wrap">
			<canvas :id="canvasId" class="ste-barcode-canvas" :style="[cmpCanvasStyle]"
				:disable-scroll="true" type="2d"></canvas>
		</view>
		<!-- 文字区域 -->
		<view v-if="showText" class="ste-barcode-text-wrap">
			<text class="ste-barcode-text" :style="[cmpTextStyle]">{{ _text }}</text>
		</view>
	</view>
</template>

<script setup>
	// ============== 导入依赖 ==============
	// 引入编码函数（uvue 支持 ES Module 导入）
	import { stringToCode128, patternsToBinary } from './encode.uts'

	// ============== 类型定义 ==============
	// 条形码组件的 props 类型定义
	type BarcodeProps = {
		// 条形码内容（必填）
		content : string;
		// 背景色
		background ?: string | null;
		// 前景色（线条颜色）
		lineColor ?: string | null;
		// 是否显示文字
		showText ?: boolean | null;
		// 文字大小（rpx）
		textSize ?: number | null;
		// 文字颜色
		textColor ?: string | null;
		// 文字与条码间距（rpx）
		textMargin ?: number | null;
		// 文字对齐方式：left | center | right
		textAlign ?: string | null;
		// 条码宽度（rpx）
		width ?: number | null;
		// 条码高度（rpx）
		height ?: number | null;
		// 边框宽度（rpx）
		borderWidth ?: number | null;
		// 边框颜色
		borderColor ?: string | null;
		// 圆角（rpx）
		borderRadius ?: number | null;
	}

	// ============== 工具函数 ==============
	// 生成随机 id，用于 canvas 元素
	function guid() : string {
		return 'ste-barcode-canvas-' + Math.floor(Math.random() * 1000000).toString()
	}

	// 数字转 rpx 字符串
	function addUnit(value : number | null | undefined) : string {
		if (value == null) return '0rpx'
		return value.toString() + 'rpx'
	}

	// ============== Props 定义 ==============
	// 使用字面量定义 props，uvue 不支持 import 的变量
	const props = defineProps({
		content: {
			type: String,
			default: '12345678'
		},
		background: {
			type: String,
			default: '#FFFFFF'
		},
		lineColor: {
			type: String,
			default: '#000000'
		},
		showText: {
			type: Boolean,
			default: true
		},
		textSize: {
			type: Number,
			default: 28
		},
		textColor: {
			type: String,
			default: '#000000'
		},
		textMargin: {
			type: Number,
			default: 8
		},
		textAlign: {
			type: String,
			default: 'center'
		},
		width: {
			type: Number,
			default: 480
		},
		height: {
			type: Number,
			default: 120
		},
		borderWidth: {
			type: Number,
			default: 0
		},
		borderColor: {
			type: String,
			default: '#000000'
		},
		borderRadius: {
			type: Number,
			default: 0
		}
	})

	// ============== 响应式状态 ==============
	// canvas 的唯一 id
	const canvasId = ref<string>(guid())

	// ============== 默认值处理 ==============
	// 手动处理默认值（uvue 中 withDefaults 可能不稳定）
	const _text = computed((): string => props.content)
	const _background = computed((): string => props.background != null ? props.background : '#FFFFFF')
	const _lineColor = computed((): string => props.lineColor != null ? props.lineColor : '#000000')
	const _showText = computed((): boolean => props.showText == true)
	const _textSize = computed((): number => props.textSize != null ? props.textSize : 28)
	const _textColor = computed((): string => props.textColor != null ? props.textColor : '#000000')
	const _textMargin = computed((): number => props.textMargin != null ? props.textMargin : 8)
	const _textAlign = computed((): string => props.textAlign != null ? props.textAlign : 'center')
	const _width = computed((): number => props.width != null ? props.width : 480)
	const _height = computed((): number => props.height != null ? props.height : 120)
	const _borderWidth = computed((): number => props.borderWidth != null ? props.borderWidth : 0)
	const _borderColor = computed((): string => props.borderColor != null ? props.borderColor : '#000000')
	const _borderRadius = computed((): number => props.borderRadius != null ? props.borderRadius : 0)

	// ============== 计算样式 ==============
	// 容器根样式
	const cmpRootStyle = computed((): UTSJSONObject => {
		const style : UTSJSONObject = {
			'background-color': _background.value
		}
		if (_borderWidth.value > 0) {
			style['border'] = addUnit(_borderWidth.value) + ' solid ' + _borderColor.value
		}
		if (_borderRadius.value > 0) {
			style['border-radius'] = addUnit(_borderRadius.value)
		}
		return style
	})

	// canvas 样式
	const cmpCanvasStyle = computed((): UTSJSONObject => {
		return {
			'width': addUnit(_width.value),
			'height': addUnit(_height.value)
		}
	})

	// 文字样式
	const cmpTextStyle = computed((): UTSJSONObject => {
		const style : UTSJSONObject = {
			'font-size': addUnit(_textSize.value),
			'color': _textColor.value,
			'margin-top': addUnit(_textMargin.value),
			'text-align': _textAlign.value
		}
		return style
	})

	// ============== 绘制条形码 ==============
	// 在 canvas 上绘制条形码
	function drawBarcode() {
		console.log('[ste-barcode] drawBarcode 开始，canvasId=' + canvasId.value + ', text=' + _text.value)

		const text = _text.value
		if (text == '') {
			console.warn('[ste-barcode] text is empty')
			return
		}

		// 先验证 canvas 元素是否存在
		const el = uni.getElementById(canvasId.value)
		console.log('[ste-barcode] uni.getElementById 结果:', el != null ? '找到元素' : '元素为 null')

		// 使用 uni.createCanvasContextAsync 获取 CanvasContext
		// 这是 uvue 官方推荐的方式（同时支持 APP/H5/MP-WEIXIN）
		uni.createCanvasContextAsync({
			id: canvasId.value,
			success: (context: CanvasContext) => {
				console.log('[ste-barcode] createCanvasContextAsync success')

				// 通过 context.getContext('2d') 获取 W3C 标准的 2D 渲染上下文
				const ctx = context.getContext('2d') as CanvasRenderingContext2D
				if (ctx == null) {
					console.error('[ste-barcode] 获取 2D 上下文失败')
					return
				}
				console.log('[ste-barcode] 获取 2D 上下文成功')

				// 获取 canvas 元素（在 ctx.canvas 上）
				const canvas = ctx.canvas
				console.log('[ste-barcode] canvas.offsetWidth=' + canvas.offsetWidth + ', offsetHeight=' + canvas.offsetHeight)

				// 获取设备像素比，处理高清屏
				const dpr: number = (uni.getDeviceInfo().devicePixelRatio ?? 1) > 0 ? (uni.getDeviceInfo().devicePixelRatio ?? 1) : 1
				console.log('[ste-barcode] dpr=' + dpr)

				// 设置 canvas 实际尺寸（物理像素）
				canvas.width = canvas.offsetWidth * dpr
				canvas.height = canvas.offsetHeight * dpr
				console.log('[ste-barcode] canvas 尺寸: ' + canvas.width + 'x' + canvas.height)

				// 缩放坐标系到逻辑尺寸
				ctx.scale(dpr, dpr)

				// 逻辑尺寸
				const widthPx: number = canvas.offsetWidth
				const heightPx: number = canvas.offsetHeight
				console.log('[ste-barcode] 逻辑尺寸: ' + widthPx + 'x' + heightPx)

				if (widthPx <= 0 || heightPx <= 0) {
					console.error('[ste-barcode] canvas 尺寸为 0，请检查 CSS')
					return
				}

				// 填充背景
				ctx.fillStyle = _background.value
				ctx.fillRect(0, 0, widthPx, heightPx)
				console.log('[ste-barcode] 背景填充完成，颜色=' + _background.value)

				// Code128 编码
				const codes = stringToCode128(text)
				console.log('[ste-barcode] 编码完成，codes.length=' + codes.length)
				if (codes.length == 0) {
					console.warn('[ste-barcode] 编码结果为空')
					return
				}

				// 计算总宽度比例
				// Code128 每个字符 11 个模块宽度（不含终止符的最终条 2）
				const totalModules: number = (codes.length - 1) * 11 + 13
				const moduleWidth: number = widthPx / totalModules
				console.log('[ste-barcode] totalModules=' + totalModules + ', moduleWidth=' + moduleWidth)

				// 绘制各条码
				ctx.fillStyle = _lineColor.value
				let x: number = 0
				const patterns = patternsToBinary(codes)
				console.log('[ste-barcode] patternsToBinary 完成，patterns.length=' + patterns.length + ', 颜色=' + _lineColor.value)

				// patterns 字符串中 1 表示黑条，0 表示白条
				// patterns[i] 是 Char 类型，转 String 后再比较
				let drawCount: number = 0
				for (let i: number = 0; i < patterns.length; i++) {
					if (patterns[i].toString() == '1') {
						ctx.fillRect(x, 0, moduleWidth, heightPx)
						drawCount++
					}
					x += moduleWidth
				}
				console.log('[ste-barcode] 绘制完成，绘制了 ' + drawCount + ' 个黑条，text=' + text)
			},
			fail: (err) => {
				console.error('[ste-barcode] createCanvasContextAsync 失败:', JSON.stringify(err))
			}
		} as CreateCanvasContextAsyncOptions)
	}

	// ============== 生命周期 ==============
	// 组件就绪后绘制条形码
	// 注意：必须使用 onReady，不能在 onMounted 中执行（Canvas 元素可能未渲染）

	// 同时使用多个时机触发，最大化兼容性
	onMounted(() => {
		console.log('[ste-barcode] onMounted 触发')
		// 延迟确保 canvas 元素挂载完成
		setTimeout(() => {
			console.log('[ste-barcode] onMounted setTimeout 回调')
			drawBarcode()
		}, 100)
	})

	onReady(() => {
		console.log('[ste-barcode] onReady 触发')
		// 延迟一帧确保 canvas 元素完全挂载
		setTimeout(() => {
			console.log('[ste-barcode] onReady setTimeout 回调')
			drawBarcode()
		}, 50)
	})

	// 监听 content 变化，重新绘制
	watch((): string => props.content, (val: string) => {
		console.log('[ste-barcode] watch 触发，新值=' + val)
		if (val != null) {
			setTimeout(() => {
				drawBarcode()
			}, 50)
		}
	})

	// 监听其他可能影响显示的属性
	watch((): number => props.width, () => {
		console.log('[ste-barcode] width 变化')
		setTimeout(() => drawBarcode(), 50)
	})
	watch((): number => props.height, () => {
		console.log('[ste-barcode] height 变化')
		setTimeout(() => drawBarcode(), 50)
	})
</script>

<style>
	.ste-barcode {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 0;
		box-sizing: border-box;
	}

	.ste-barcode-canvas-wrap {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.ste-barcode-canvas {
		display: flex;
	}

	.ste-barcode-text-wrap {
		display: flex;
		flex-direction: row;
		width: 100%;
		justify-content: center;
	}

	.ste-barcode-text {
		/* 文字颜色和大小由内联样式控制 */
	}
</style>
