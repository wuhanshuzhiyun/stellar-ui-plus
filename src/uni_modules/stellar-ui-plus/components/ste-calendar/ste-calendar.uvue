<template>
	<view class="ste-calendar-root" :style="cmpRootStyle">
		<view v-if="showTitle" class="calendar-title">
			<text class="calendar-title-text">{{ title }}</text>
		</view>
		<view class="week-head" :style="weekHeadStyle">
			<view class="week-row">
				<view v-for="(w, index) in weekTexts" :key="index" class="week-item">
					<text class="week-item-text" :style="getWeekTextStyle(index)">{{ w }}</text>
				</view>
			</view>
		</view>
		<!-- 标准成熟的 scroll-view 滚动容器，耗时 < 5ms，保障秒级唤起与原生满帧手感 -->
		<scroll-view class="date-content" :style="dateContentStyle" scroll-y="true"
			:scroll-into-view="scrollIntoView" @scroll="onScroll" :show-scrollbar="showScrollbar">
			<view v-for="m in displayMonths" :key="m.key" class="month-item" :id="`month-${m.key}`">
				<view v-if="showMark" class="month-bg" :style="monthBgStyle">
					<text class="month-bg-text" :style="monthBgTextStyle">{{ m.bgText }}</text>
				</view>
				<view class="month-text">
					<text class="month-text-text">{{ m.monthText }}</text>
				</view>
				<view v-for="(w, index) in m.weeks" :key="index" class="week-row day-week-row" :style="weekRowStyle">
					<view v-for="d in w" :key="d.key" class="week-item day-item"
						:style="getDayItemStyle(d)" @click="onSelect(d)">
						<template v-if="d.dayText.length > 0">
							<view v-if="mode == 'range' && cmpShowRangeText" class="day-range-head">
								<text v-if="startDate == d.key && endDate == d.key" class="day-range-text" :style="dayRangeTextStyle">{{ startText }}</text>
							</view>
							<view class="day-content" :style="getDayContentStyle(d)">
								<text class="day-content-text" :style="getDayTextStyle(d)">{{ d.dayText }}</text>
							</view>
							<view v-if="mode == 'range' && cmpShowRangeText" class="day-range-foot">
								<text v-if="endDate == d.key" class="day-range-text" :style="dayRangeTextStyle">{{ endText }}</text>
								<text v-else-if="startDate == d.key" class="day-range-text" :style="dayRangeTextStyle">{{ startText }}</text>
							</view>
							<view v-if="cmpShowSigns" class="day-signs">
								<view v-for="(sign, sIdx) in getDaySigns(d)" :key="sIdx" class="day-sign" :style="getSignStyle(sign)" :class="getSignClass(sign)">
									<text class="day-sign-text" :style="getSignTextStyle(sign)">{{ sign.content }}</text>
								</view>
							</view>
						</template>
					</view>
				</view>
			</view>
		</scroll-view>
		<view v-if="cmpShowConfirm" class="confirm-button" :style="confirmButtonStyle" @click="confirm">
			<text class="confirm-button-text">确定</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, watch, onMounted, onUnmounted, nextTick, getCurrentInstance } from 'vue'
	import { useColorStore } from '../../store/color.uts'
	import { formatDate, toDate, generateMonthMetas, generateSingleMonthData, findMonthIndexByScrollTop } from './date.uts'
	import type { WeekType, DateType, CalendarData, SignItem, MonthMeta, MonthType, MonthMetasResult } from './date.uts'
	import { Color } from '../../utils/Color.uts'
	import { formatPx } from '../../utils/utils.uts'
	import { normalizeFontSize } from '../../config/index.uts'

	defineOptions({ name: 'ste-calendar', options: { virtualHost: true } })

	type CalendarProps = {
		title ?: string,
		showTitle ?: boolean,
		list ?: any[],
		mode ?: string,
		startText ?: string,
		endText ?: string,
		color ?: string,
		minDate ?: string | number,
		maxDate ?: string | number,
		viewStart ?: string | number,
		viewEnd ?: string | number,
		maxCount ?: number | string,
		formatter ?: string,
		showMark ?: boolean,
		readonly ?: boolean,
		maxRange ?: number | string,
		rangePrompt ?: string,
		showRangePrompt ?: boolean,
		allowSameDay ?: boolean,
		showConfirm ?: boolean,
		width ?: string | number,
		height ?: string | number,
		signs ?: UTSJSONObject,
		defaultDate ?: string | number,
		monthCount ?: number,
		weekendColor ?: string,
		showScrollbar ?: boolean,
		/** 是否展示范围选择器的起止文案（如“开始”、“结束”），默认为 true。若为 false 则隐藏文案并释放上下预留占位 */
		showRangeText ?: boolean,
		/** 范围选择器中间区间的背景色（不含起止日期，起止日期仍使用 color 主题色）。无值时自动取主题色 0.2 透明度 */
		rangeColor ?: string,
		/** 月份标题展示格式化配置，默认 'YYYY年MM月' */
		monthFormatter ?: string,
		/** 是否开启前后无限滚动模式 */
		infinite ?: boolean,
		/** 无限滚动模式下预设的单向年份跨度（默认 10 年） */
		infiniteYears ?: number,
		/** 虚拟列表可视区域上下预渲染的月份缓冲区数量（默认 3） */
		bufferCount ?: number,
	}

	const props = withDefaults(defineProps<CalendarProps>(), {
		showTitle: true,
		showMark: true,
		showRangePrompt: true,
		showConfirm: true,
		showScrollbar: true,
		showRangeText: true,
		rangeColor: '',
		monthFormatter: 'YYYY年MM月',
		infinite: false,
		infiniteYears: 10,
		bufferCount: 4,
	})
	const emits = defineEmits(['select', 'confirm', 'view-month'])

	// ============== 常量 ==============
	const ROW_HEIGHT_WITH_SIGN = 180
	const ROW_HEIGHT_WITHOUT_SIGN = 126
	const MONTH_HEADER_HEIGHT = 80
	const VIEW_MONTH_DELAY = 50
	const SHOW_MONTH_DELAY = 100

	// ============== 颜色 store ==============
	const colorStore = useColorStore()
	const colorData = colorStore.getColor()

	// ============== 内部状态（原 useData，直接内联避免 UTS 对象属性访问问题） ==============
	const initing = ref(true)
	const startDate = ref<string | null>(null)
	const endDate = ref<string | null>(null)
	const dataList = ref<string[]>([])
	const contentScrollTop = ref(0)
	const scrollTop = ref(0)

	/** 计算首帧目标月份 ID 锚点，确保原生 scroll-view 在第一帧直接对齐当前目标月 */
	function getInitialScrollTarget() : string {
		let d = new Date()
		if (props.defaultDate != null && props.defaultDate != '') {
			d = toDate(props.defaultDate!)
		}
		return 'month-' + formatDate(d, 'YYYY-MM')
	}

	const scrollIntoView = ref(getInitialScrollTarget())
	const viewDate = ref<Date>(new Date())
	const viewMonth = ref<string>(formatDate(new Date(), 'YYYY-MM'))

	const setStartDate = (val : string | null) => { startDate.value = val }
	const setEndDate = (val : string | null) => { endDate.value = val }
	const setDataList = (val : string[]) => { dataList.value = val }

	// ============== prop 默认值计算 ==============
	const title = computed(() : string => props.title != null ? props.title! : '日期选择')
	const showTitle = computed(() : boolean => props.showTitle == true)
	const mode = computed(() : string => props.mode != null ? props.mode! : 'single')
	const startText = computed(() : string => props.startText != null ? props.startText! : '开始')
	const endText = computed(() : string => props.endText != null ? props.endText! : '结束')
	const formatter = computed(() : string => props.formatter != null ? props.formatter! : 'YYYY-MM-DD')
	const showMark = computed(() : boolean => props.showMark == true)
	const readonly = computed(() : boolean => props.readonly == true)
	const showRangePrompt = computed(() : boolean => props.showRangePrompt == true)
	const allowSameDay = computed(() : boolean => props.allowSameDay == true)
	const showConfirmProp = computed(() : boolean => props.showConfirm == true)
	const showScrollbar = computed(() : boolean => props.showScrollbar == true)
	const monthCount = computed(() : number => props.monthCount != null ? props.monthCount! : 12)
	const widthVal = computed(() : string | number => props.width != null ? props.width! : '100%')
	const heightVal = computed(() : string | number => props.height != null ? props.height! : '100%')
	const minDateVal = computed(() : string | number | null => props.minDate)
	const maxDateVal = computed(() : string | number | null => props.maxDate)
	const viewStartVal = computed(() : string | number | null => props.viewStart)
	const viewEndVal = computed(() : string | number | null => props.viewEnd)
	const signsVal = computed(() : UTSJSONObject => props.signs != null ? props.signs! : new UTSJSONObject())
	const defaultDateVal = computed(() : string | number | null => props.defaultDate)
	const maxCountVal = computed(() : number => {
		const mc = props.maxCount
		if (mc == null) return 0
		if (typeof mc === 'number') return mc as number
		return parseFloat(mc as string)
	})
	const maxRangeVal = computed(() : number => {
		const mr = props.maxRange
		if (mr == null) return 0
		if (typeof mr === 'number') return mr as number
		return parseFloat(mr as string)
	})
	const rangePromptVal = computed(() : string => props.rangePrompt != null ? props.rangePrompt! as string : '')

	// ============== 颜色计算 ==============
	const calendarColor = computed(() : string => {
		const c = props.color
		return c != null && c !== '' ? c! : colorData.steThemeColor
	})
	const calendarWeekendColor = computed(() : string => {
		const c = props.weekendColor
		return c != null && c !== '' ? c! : calendarColor.value
	})
	const calendarBgColor = computed(() : string => Color.formatColor(calendarColor.value, 0.1))
	const calendarRangeColor = computed(() : string => {
		const rc = props.rangeColor
		if (rc != null && rc != '') {
			return rc!
		}
		return Color.formatColor(calendarColor.value, 0.2)
	})
	const calendarDisabledColor = computed(() : string => Color.formatColor(calendarColor.value, 0.3))
	const cmpShowRangeText = computed(() : boolean => props.showRangeText != false)

	// ============== signs 判断 ==============
	const cmpShowSigns = computed(() : boolean => {
		const s = signsVal.value
		// #ifdef APP-ANDROID || APP-IOS
		return s.toMap().size > 0
		// #endif
		// #ifndef APP-ANDROID || APP-IOS
		const keys = Object.keys(s as Any)
		return keys.length > 0
		// #endif
	})

	// ============== 星期固定文案 ==============
	const weekTexts : string[] = ['日', '一', '二', '三', '四', '五', '六']

	// ============== 行高 ==============
	const rowHeight = computed(() : number => {
		const rpx = cmpShowSigns.value ? ROW_HEIGHT_WITH_SIGN : ROW_HEIGHT_WITHOUT_SIGN
		return uni.rpx2px(rpx)
	})

	// ============== 月份轻量元数据推导 ==============
	const cmpMonthMetasInfo = computed(() : MonthMetasResult => {
		const rh = rowHeight.value > 0 ? rowHeight.value : 63
		const hh = uni.rpx2px(MONTH_HEADER_HEIGHT)
		// APP 原生环境安全收敛：禁用跨越20年的超大范围展开（避免 252 个月循环导致主线程假死），收敛为常规月数渲染
		return generateMonthMetas(
			minDateVal.value,
			maxDateVal.value,
			defaultDateVal.value,
			monthCount.value,
			viewStartVal.value,
			viewEndVal.value,
			props.monthFormatter != null && props.monthFormatter != '' ? props.monthFormatter! : 'YYYY年MM月',
			false,
			1,
			rh,
			hh
		)
	})

	const todayStr = formatDate(new Date())

	/**
	 * 月份完整数据列表：
	 * 在合理月份跨度（通常 12~24 个月）内由 UTS 高速生成（耗时 < 5ms），
	 * 直接交由成熟的 scroll-view 渲染，彻底杜绝 list-view 首帧假死
	 */
	const displayMonths = computed(() : MonthType[] => {
		const metas = cmpMonthMetasInfo.value.metas
		const result : MonthType[] = []
		for (let i = 0; i < metas.length; i++) {
			result.push(generateSingleMonthData(
				metas[i],
				minDateVal.value,
				maxDateVal.value,
				formatter.value,
				signsVal.value,
				todayStr
			))
		}
		return result
	})

	/**
	 * 统一宽度安全转换：支持纯数字(按rpx换算)、rpx、px及百分比
	 */
	function formatWidth(w : string | number) : string {
		return formatPx(w)
	}

	/**
	 * 统一高度安全转换：支持纯数字(按rpx换算)、rpx、px及百分比
	 */
	function formatHeight(h : string | number) : string {
		return formatPx(h)
	}

	// ============== 根样式 ==============
	// 当 height 为 100%（默认值）时同时声明 flex: 1 与 height: 100%，
	// 双重兜底保障在各种复杂弹窗和嵌套容器中均能撑满剩余空间，彻底根除 Yoga 引擎嵌套坍塌
	const cmpRootStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {
			width: formatWidth(widthVal.value),
			opacity: initing.value ? 0 : 1,
		}
		const h = heightVal.value
		if (typeof h === 'string' && (h as string) == '100%') {
			style['flex'] = '1'
			style['height'] = '100%'
		} else {
			style['height'] = formatHeight(h)
		}
		return style
	})

	// ============== 周头部样式 ==============
	const weekHeadStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {
			height: normalizeFontSize(80),
			borderBottomWidth: '1px',
			borderBottomStyle: 'solid',
			borderBottomColor: '#dddddd',
			borderRadius: '8px',
		}
		// #ifndef APP-ANDROID
		style['boxShadow'] = '0px 3px 10px 1px rgba(0,0,0,0.1)'
		// #endif
		return style
	})

	const weekRowStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {
			height: rowHeight.value + 'px',
		}
		return style
	})

	function getWeekTextStyle(index : number) : UTSJSONObject {
		const style : UTSJSONObject = {
			fontSize: normalizeFontSize(32),
			lineHeight: normalizeFontSize(80),
			textAlign: 'center',
		}
		if (index == 0 || index == 6) {
			style['color'] = calendarWeekendColor.value
		}
		return style
	}

	// ============== 确认按钮样式 ==============
	const cmpShowConfirm = computed(() : boolean => showConfirmProp.value && readonly.value != true)

	// ============== 月份背景大字样式 ==============
	// uvue scroll-view 内不支持 absolute 撑开高度，用正常流 + 明确 height + 负 margin
	// 关键修复：声明 pointerEvents: 'none'，彻底防止背景层拦截下方日期格子的点击/触摸交互
	const monthBgStyle = computed(() : UTSJSONObject => {
		const h = rowHeight.value * 5
		const finalH = h > 0 ? h : 300
		return {
			width: '100%',
			height: finalH + 'px',
			display: 'flex',
			flexDirection: 'row',
			justifyContent: 'center',
			alignItems: 'center',
			position: 'relative',
			zIndex: 1,
			marginBottom: '-' + finalH + 'px',
			pointerEvents: 'none',
		} as UTSJSONObject
	})

	const monthBgTextStyle = computed(() : UTSJSONObject => {
		return {
			fontSize: normalizeFontSize(360),
			fontWeight: 'bold',
			color: calendarBgColor.value,
			lineHeight: normalizeFontSize(400),
		} as UTSJSONObject
	})

	// ============== 日期容器样式 ==============
	const dateContentStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {
			width: '100%',
			flex: '1',
		}
		return style
	})

	// ============== day-item 样式 ==============
	function getDayItemStyle(d : WeekType) : UTSJSONObject {
		const style : UTSJSONObject = {
			flex: '1',
			position: 'relative',
			height: rowHeight.value + 'px',
			display: 'flex',
			flexDirection: 'column',
			justifyContent: 'center',
			alignItems: 'center',
		}
		const isActive = dataList.value.indexOf(d.key) >= 0
		const isStart = startDate.value == d.key
		const isEnd = endDate.value == d.key
		const isRange = mode.value == 'range'

		if (d.disabled) {
			style['backgroundColor'] = 'transparent'
		} else if (isStart || isEnd) {
			if (isRange) {
				style['backgroundColor'] = calendarColor.value
			} else if (cmpShowSigns.value != true) {
				style['backgroundColor'] = calendarColor.value
			}
		} else if (isActive && isRange) {
			style['backgroundColor'] = calendarRangeColor.value
		} else if (isActive && cmpShowSigns.value != true) {
			style['backgroundColor'] = calendarColor.value
		}
		return style
	}

	function getDayContentStyle(d : WeekType) : UTSJSONObject {
		const style : UTSJSONObject = {
			width: '100%',
			height: uni.rpx2px(48) + 'px',
			display: 'flex',
			flexDirection: 'row',
			justifyContent: 'center',
			alignItems: 'center',
		}
		const isActive = dataList.value.indexOf(d.key) >= 0
		const isStart = startDate.value == d.key
		const isEnd = endDate.value == d.key
		const isRange = mode.value == 'range'

		// signs 模式下 day-content 自带背景色
		if (cmpShowSigns.value && (isActive || isStart || isEnd) && d.disabled != true) {
			style['backgroundColor'] = calendarColor.value
			style['borderRadius'] = '6rpx'
		}
		// active.range 中间态 day-content 透明
		if (isActive && isRange && isStart != true && isEnd != true) {
			style['backgroundColor'] = 'transparent'
		}
		if (cmpShowSigns.value) {
			style['height'] = uni.rpx2px(72) + 'px'
		}
		return style
	}

	function getDayTextStyle(d : WeekType) : UTSJSONObject {
		const style : UTSJSONObject = {
			fontSize: normalizeFontSize(32),
			textAlign: 'center',
		}
		const isActive = dataList.value.indexOf(d.key) >= 0
		const isStart = startDate.value == d.key
		const isEnd = endDate.value == d.key
		const isRange = mode.value == 'range'

		if (d.disabled) {
			style['color'] = '#bbbbbb'
		} else if (isStart || isEnd) {
			// 选中起止：所有模式文字白色
			style['color'] = '#ffffff'
		} else if (isActive && isRange) {
			// range 中间态：文字为主题色
			style['color'] = calendarColor.value
		} else if (isActive) {
			// 非range选中（含signs模式）：文字白色
			style['color'] = '#ffffff'
		} else if (d.today) {
			style['fontWeight'] = 'bold'
			style['color'] = calendarColor.value
		} else if (d.weekend) {
			style['color'] = calendarWeekendColor.value
		}
		return style
	}

	const dayRangeTextStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {
			fontSize: normalizeFontSize(24),
			lineHeight: uni.rpx2px(24) + 'px',
			textAlign: 'center',
		}
		return style
	})

	// ============== signs 辅助方法 ==============
	function getDaySigns(d : WeekType) : SignItem[] {
		if (d.signs != null) return d.signs!
		return [] as SignItem[]
	}
	function getSignStyle(sign : SignItem) : UTSJSONObject {
		if (sign.style != null) return sign.style!
		return {} as UTSJSONObject
	}
	// sign 的文字样式需单独提取应用到 <text>，因为 uvue 中 <text> 不继承父 <view> 的 color
	function getSignTextStyle(sign : SignItem) : UTSJSONObject {
		const style : UTSJSONObject = {}
		if (sign.style != null) {
			const s = sign.style!
			const color = s.get('color')
			if (color != null) style['color'] = color
			const fontSize = s.get('fontSize')
			if (fontSize != null) style['fontSize'] = fontSize
			const fontWeight = s.get('fontWeight')
			if (fontWeight != null) style['fontWeight'] = fontWeight
		}
		return style
	}
	function getSignClass(sign : SignItem) : string {
		if (sign.className != null) return sign.className!
		return ''
	}

	const confirmButtonStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {
			width: '100%',
			height: uni.rpx2px(72) + 'px',
			borderRadius: uni.rpx2px(36) + 'px',
			backgroundColor: calendarColor.value,
			display: 'flex',
			flexDirection: 'row',
			justifyContent: 'center',
			alignItems: 'center',
		}
		return style
	})

	// ============== 滚动逻辑 ==============
	let viewTimer : number | null = null
	const clearViewTimer = () => {
		if (viewTimer != null) {
			clearTimeout(viewTimer!)
			viewTimer = null
		}
	}

	const doScroll = (top : number, _viewMonth : string) => {
		// uvue 中 scroll-top 双 ref 切换不可靠，改用 scroll-into-view 直接滚动到元素
		scrollIntoView.value = ''
		nextTick(() => {
			scrollIntoView.value = `month-${_viewMonth}`
			scrollTop.value = top
			viewMonth.value = _viewMonth
			initing.value = false
		})
	}

	// 可见性观察
	let isVisible = false
	let pendingScrollTop : number | null = null
	const instance = getCurrentInstance()
	// #ifdef MP-WEIXIN || MP-ALIPAY
	let mpObserver : any = null
	// #endif

	const startObserver = () => {
		// #ifdef H5
		// H5 端直接标记为可见
		isVisible = true
		return
		// #endif
		// #ifdef MP-WEIXIN || MP-ALIPAY
		try {
			if (instance != null) {
				mpObserver = uni.createIntersectionObserver(instance as any)
				mpObserver.relativeToViewport()
				mpObserver.observe('.ste-calendar-root', (res : any) => {
					const visible = res.intersectionRatio > 0
					if (visible && isVisible != true) {
						isVisible = true
						if (pendingScrollTop != null) {
							const top = pendingScrollTop!
							const _viewMonth = formatDate(viewDate.value, 'YYYY-MM')
							pendingScrollTop = null
							nextTick(() => doScroll(top, _viewMonth))
						}
					} else if (visible != true) {
						isVisible = false
					}
				})
			}
		} catch (_e) {
			isVisible = true
		}
		return
		// #endif
		// #ifdef APP-ANDROID || APP-IOS
		// APP 端微延迟标记可见，确保弹窗场景下 scroll-view 完成首帧布局
		// 性能优化：延迟从 300ms 缩短为 60ms，大幅减少唤起日历时的白屏与等待感
		setTimeout(() => {
			isVisible = true
			if (pendingScrollTop != null) {
				const top = pendingScrollTop!
				const _viewMonth = formatDate(viewDate.value, 'YYYY-MM')
				pendingScrollTop = null
				nextTick(() => doScroll(top, _viewMonth))
			} else {
				initing.value = false
			}
		}, 60)
		// #endif
	}

	onUnmounted(() => {
		clearViewTimer()
		// #ifdef MP-WEIXIN || MP-ALIPAY
		if (mpObserver != null) {
			try {
				mpObserver.disconnect()
			} catch (_e) {
			}
			mpObserver = null
		}
		// #endif
	})

	// ============== showMonth ==============
	const showMonth = (date ?: DateType) => {
		const newDate : Date = date != null ? toDate(date!) : viewDate.value
		const newKey = formatDate(newDate, 'YYYY-MM-DD')
		const oldKey = formatDate(viewDate.value, 'YYYY-MM-DD')
		if (newKey !== oldKey) {
			viewDate.value = newDate
		}
		initing.value = true
		clearViewTimer()
		viewTimer = setTimeout(() => {
			const minD = minDateVal.value
			const maxD = maxDateVal.value
			const hasMin = minD != null && !(typeof minD === 'number' && (minD as number) == 0)
			const hasMax = maxD != null && !(typeof maxD === 'number' && (maxD as number) == 0)
			if (hasMin && hasMax) {
				const viewValue = viewDate.value.getTime()
				const minValue = toDate(minD as DateType).getTime()
				const maxValue = toDate(maxD as DateType).getTime()
				if (viewValue < minValue) {
					viewDate.value = toDate(minD as DateType)
				} else if (viewValue > maxValue) {
					viewDate.value = toDate(maxD as DateType)
				}
			}
			const _viewMonth = formatDate(viewDate.value, 'YYYY-MM')
			const metas = cmpMonthMetasInfo.value.metas
			let targetIndex = -1
			let top : number | null = null
			for (let i = 0; i < metas.length; i++) {
				if (metas[i].key == _viewMonth) {
					targetIndex = i
					top = metas[i].top
					break
				}
			}
			if (top == null) {
				initing.value = false
				return
			}
			if (isVisible != true) {
				pendingScrollTop = top
				return
			}
			doScroll(top!, _viewMonth)
		}, VIEW_MONTH_DELAY)
	}

	// ============== 选择逻辑 ==============
	const onMultiple = (day : WeekType) => {
		const idx = dataList.value.indexOf(day.key)
		if (idx == -1) {
			if (maxCountVal.value > 0 && dataList.value.length >= maxCountVal.value) return
			dataList.value.push(day.key)
		} else {
			dataList.value.splice(idx, 1)
		}
	}

	const rangeDates = () => {
		if (startDate.value == null || endDate.value == null) return
		const start = formatDate(startDate.value)
		const end = formatDate(endDate.value)
		const startD = toDate(start)
		const endD = toDate(end)
		const list : string[] = []
		const current = new Date(startD.getTime())
		while (current.getTime() <= endD.getTime()) {
			list.push(formatDate(new Date(current.getTime()), formatter.value))
			current.setDate(current.getDate() + 1)
		}

		let finalList : string[] = list
		if (finalList.length < 2) {
			finalList = [startDate.value!, endDate.value!]
		}

		if (maxRangeVal.value > 0 && finalList.length > maxRangeVal.value) {
			setEndDate(null)
			if (showRangePrompt.value) {
				uni.showModal({
					title: '提示',
					content: rangePromptVal.value != null && rangePromptVal.value !== '' ? rangePromptVal.value : `选择天数不能超过${maxRangeVal.value}天`,
					showCancel: false,
				})
			}
			return
		}
		setDataList(finalList)
	}

	const onRange = (day : WeekType) => {
		setDataList([])
		if (startDate.value == null) {
			setStartDate(day.key)
		} else if (endDate.value == null) {
			if ((allowSameDay.value && day.key == startDate.value) || day.key > startDate.value!) {
				setEndDate(day.key)
			} else if (day.key < startDate.value!) {
				setEndDate(startDate.value)
				setStartDate(day.key)
			}
		} else {
			setStartDate(day.key)
			setEndDate(null)
		}
		rangeDates()
	}

	const onSelect = (day : WeekType) => {
		if (readonly.value || day.dayText.length == 0 || day.disabled) return
		if (mode.value == 'single') {
			setDataList([day.key])
		} else if (mode.value == 'multiple') {
			onMultiple(day)
		} else if (mode.value == 'range') {
			onRange(day)
		}
		emits('select', dataList.value, day.key)
	}

	// ============== watch ==============
	watch(() : any[] | null => props.list, (v : any[] | null) => {
		const newVal = v != null ? v! : []
		const formatted : string[] = []
		for (let i = 0; i < newVal.length; i++) {
			formatted.push(formatDate(newVal[i] as DateType, formatter.value))
		}
		setDataList(formatted)
		if (mode.value == 'range') {
			if (formatted.length >= 2) {
				setStartDate(formatted[0]!)
				setEndDate(formatted[formatted.length - 1]!)
			} else if (formatted.length == 1) {
				setStartDate(formatted[0]!)
				setEndDate(formatted[0]!)
			} else {
				setStartDate(null)
				setEndDate(null)
			}
			rangeDates()
		}
	}, { immediate: true })

	watch(() : string | number | null => props.defaultDate, (v : string | number | null) => {
		if (v == null || (typeof v === 'number' && (v as number) == 0) || (typeof v === 'string' && (v as string) == '')) {
			viewDate.value = new Date()
		} else {
			viewDate.value = toDate(v as DateType)
		}
	}, { immediate: true })

	// ============== confirm ==============
	const confirm = () => {
		emits('confirm', dataList.value)
	}

	// ============== 滚动事件（scroll-view 驱动） ==============
	const onScroll = (e : UniScrollEvent) => {
		const st = e.detail.scrollTop

		const metas = cmpMonthMetasInfo.value.metas
		if (metas.length == 0) return

		// 二分快速定位当前所在月份下标，仅广播 view-month 事件
		const index = findMonthIndexByScrollTop(st, metas)
		const currentMeta = metas[index]
		if (viewMonth.value != currentMeta.key) {
			viewMonth.value = currentMeta.key
			emits('view-month', currentMeta.key)
		}
	}

	// ============== onMounted ==============
	onMounted(() => {
		startObserver()
		// 延迟执行，确保普通模式或弹窗展开时 scroll-view 完成首帧布局与动画就绪
		nextTick(() => {
			setTimeout(() => {
				showMonth(null)
			}, VIEW_MONTH_DELAY)
			setTimeout(() => {
				showMonth(null)
			}, 150)
		})
	})

	defineExpose({ showMonth: showMonth })
</script>

<style>
.ste-calendar-root {
	display: flex;
	flex-direction: column;
}

.week-row {
	width: 100%;
	display: flex;
	flex-direction: row;
}

.week-item {
	flex: 1;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
}

.week-item-text {
	text-align: center;
	color: #252525;
}

.calendar-title {
	height: 90rpx;
	padding-top: 30rpx;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
}

.calendar-title-text {
	font-size: 32rpx;
	line-height: 44rpx;
	color: #252525;
}

.week-head {
	width: 100%;
	display: flex;
	flex-direction: row;
}

.date-content {
	width: 100%;
	padding-bottom: 12rpx;
}

.month-item {
	padding: 20rpx 0;
	position: relative;
}

.month-bg {
	pointer-events: none;
}

.month-bg-text {
	pointer-events: none;
}

.month-text {
	position: relative;
	width: 100%;
	height: 44rpx;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	z-index: 2;
}

.month-text-text {
	font-size: 32rpx;
	line-height: 44rpx;
	color: #252525;
}

.day-week-row {
	display: flex;
	flex-direction: row;
	position: relative;
	z-index: 2;
}

.day-item {
	position: relative;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	z-index: 2;
}

.day-content {
	width: 100%;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
}

.day-content-text {
	text-align: center;
	color: #252525;
}

.day-range-head {
	width: 100%;
	height: 24rpx;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
}

.day-range-foot {
	width: 100%;
	height: 24rpx;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
}

.day-range-text {
	text-align: center;
	color: #252525;
}

.day-signs {
	width: 100%;
	height: 102rpx;
	padding: 0 4rpx;
	display: flex;
	flex-direction: column;
	overflow: hidden;
}

.day-sign {
	width: 100%;
	height: 24rpx;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	margin-top: 6rpx;
	overflow: hidden;
}

.day-sign-text {
	font-size: 24rpx;
}

.confirm-button {
	width: 100%;
	height: 72rpx;
	border-radius: 36rpx;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
}

.confirm-button-text {
	color: #ffffff;
	font-size: 28rpx;
}
</style>
