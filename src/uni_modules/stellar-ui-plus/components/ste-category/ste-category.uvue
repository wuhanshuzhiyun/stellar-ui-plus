<template>
	<!-- Category 分类组件根容器 -->
	<view class="ste-category-root">
		<!-- 垂直滚动左侧分类导航栏 -->
		<scroll-view scroll-y="true" class="ste-category-scroll" :show-scrollbar="false">
			<view
				class="ste-category-block"
				:class="getBlockClass(index)"
				v-for="(item, index) in categoryData"
				:key="index"
			>
				<!-- 徽标包装器（若配置了 badge 则呈现角标） -->
				<ste-badge :content="item.badge">
					<!-- 单个分类单元项：支持优雅内圆角过渡状态绑定 -->
					<view
						class="ste-category-item"
						:class="getItemClass(index)"
						@click="handleCategoryClick(item, index)"
					>
						<!-- 分类主标题 -->
						<text class="ste-category-title">{{ item.title }}</text>
						<!-- 默认插槽：支持外部通过作用域参数自定义副标题/图标等 -->
						<view class="ste-category-sub-title">
							<slot :item="item"></slot>
						</view>
					</view>
				</ste-badge>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
/**
 * @file ste-category.uvue
 * @description Category 分类侧边栏组件 (uni-app x / UTS 原生重构实现)
 *
 * 核心设计与模块职责：
 * 1. 严格遵循 UTS 强类型模型：定义标准 CategoryItem 结构；
 * 2. 交互状态机驱动：自动计算激活索引 (currentActiveIndex) 与前后相邻索引 (prev / next)；
 * 3. UVUE 视觉圆角算法适配：消除原生不支持的 :has() 与兄弟选择器 +，通过单类名动态组合实现平滑优雅的内圆角过渡；
 * 4. 双向绑定受控流：支持 v-model:value (update:value) 与 change 事件分发。
 */

import { ref, watch, reactive } from 'vue';
import type { CategoryItem } from './constants.uts';

export type { CategoryItem };

/**
 * 组件 Props 属性定义
 */
const props = defineProps({
	/** 当前选中的分类数据值，支持 v-model:value 双向绑定 */
	value: {
		type: [String, Number],
		default: ''
	},
	/** 分类菜单数据列表 */
	data: {
		type: Array as PropType<CategoryItem[]>,
		default: (): CategoryItem[] => [] as CategoryItem[]
	}
});

/**
 * 组件 Emits 事件声明
 */
const emit = defineEmits<{
	/** 双向绑定更新值事件 */
	(e: 'update:value', value: string): void;
	/** 分类切换激活项变化事件 */
	(e: 'change', value: string): void;
}>();

/** 当前激活选中的分类索引 */
const currentActiveIndex = ref(0);
/** 内部响应式分类数据集合 */
const categoryData = reactive<CategoryItem[]>([]);

/**
 * 计算单个分类项的动态 CSS 样式类名
 * @param index 当前项索引
 * @returns 组合样式类名
 */
function getItemClass(index: number): UTSJSONObject {
	const isActive = currentActiveIndex.value === index;
	const isPrev = currentActiveIndex.value === index + 1;
	const isNext = currentActiveIndex.value === index - 1;
	return {
		'ste-category-item-active': isActive,
		'ste-category-item-prev': isPrev,
		'ste-category-item-next': isNext
	};
}

/**
 * 计算单个分类块外层容器的动态 CSS 样式类名
 * 当当前项处于激活态或相邻过渡态时，父容器背景显白，使圆角裁切时自然透出白色形成内凹效果
 * @param index 当前块索引
 * @returns 外层容器样式类名
 */
function getBlockClass(index: number): UTSJSONObject {
	const isActive = currentActiveIndex.value === index;
	const isPrev = currentActiveIndex.value === index + 1;
	const isNext = currentActiveIndex.value === index - 1;
	return {
		'ste-category-block-active-neighbor': isActive || isPrev || isNext
	};
}

/**
 * 根据外部 props.value 匹配定位当前激活索引
 * @returns 激活项索引（未匹配到则默认返回 0）
 */
function getIndex(): number {
	const valStr = props.value.toString();
	if (valStr == '') {
		return 0;
	}
	const list = props.data;
	for (let i = 0; i < list.length; i++) {
		if (list[i].value.toString() === valStr) {
			currentActiveIndex.value = i;
			return i;
		}
	}
	return 0;
}

/**
 * 初始化并同步外部传入的分类数据列表
 */
function initData() {
	categoryData.length = 0;
	const activeIdx = getIndex();
	const list = props.data;
	for (let i = 0; i < list.length; i++) {
		const raw = list[i];
		const item: CategoryItem = {
			title: raw.title,
			value: raw.value.toString(),
			badge: raw.badge,
			count: raw.count,
			disabled: raw.disabled,
			active: i === activeIdx
		};
		categoryData.push(item);
	}
}

// 监听外部数据源变化，触发数据同步重构
watch(
	(): any => props.data,
	() => {
		initData();
	},
	{ immediate: true, deep: true }
);

// 监听受控值 value 变化，同步更新选中索引
watch(
	(): any => props.value,
	() => {
		const idx = getIndex();
		currentActiveIndex.value = idx;
		for (let i = 0; i < categoryData.length; i++) {
			categoryData[i].active = i === idx;
		}
	}
);

/**
 * 处理分类单元项点击事件
 * @param item 当前点击的分类项
 * @param index 当前点击项的索引
 */
function handleCategoryClick(item: CategoryItem, index: number) {
	if (item.disabled == true) {
		return;
	}
	for (let i = 0; i < categoryData.length; i++) {
		categoryData[i].active = i === index;
	}
	currentActiveIndex.value = index;
	const valStr = item.value.toString();
	emit('update:value', valStr);
	emit('change', valStr);
}
</script>

<style>
/* 根容器：固定宽度 144rpx，填满父级视口高度 */
.ste-category-root {
	width: 144rpx;
	height: 100%;
}

/* 垂直滚动容器 */
.ste-category-scroll {
	width: 144rpx;
	height: 100%;
	background-color: #f4f5f6;
	display: flex;
	flex-direction: column;
}

/* 单个分类块外层容器：默认跟随列表灰色，激活及相邻项透白以支撑内凹圆角 */
.ste-category-block {
	width: 144rpx;
	background-color: #f4f5f6;
}

/* 激活项或相邻项外层块：背景显白，使 item 裁切圆角时精准透出白色形成内凹 */
.ste-category-block-active-neighbor {
	background-color: #ffffff;
}

/* 分类项基础样式 */
.ste-category-item {
	width: 144rpx;
	padding-top: 24rpx;
	padding-bottom: 24rpx;
	padding-left: 16rpx;
	padding-right: 16rpx;
	align-items: center;
	justify-content: center;
	background-color: #f4f5f6;
}

/* 主标题文本样式 */
.ste-category-title {
	font-size: 24rpx;
	color: #000000;
	text-align: center;
	lines: 2;
	text-overflow: ellipsis;
}

/* 副标题/插槽容器 */
.ste-category-sub-title {
	margin-top: 8rpx;
	align-items: center;
	justify-content: center;
}

/* 激活项相邻上方项：右下圆角内凹过渡 */
.ste-category-item-prev {
	border-bottom-right-radius: 16rpx;
}

/* 激活项相邻下方项：右上圆角内凹过渡 */
.ste-category-item-next {
	border-top-right-radius: 16rpx;
}

/* 激活选中项样式 */
.ste-category-item-active {
	background-color: #ffffff;
	border-top-right-radius: 0rpx;
	border-bottom-right-radius: 0rpx;
}
</style>
