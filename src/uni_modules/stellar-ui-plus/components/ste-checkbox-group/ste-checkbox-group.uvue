<template>
	<view class="ste-checkbox-group-root" :style="cmpRootStyle">
		<slot></slot>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref, provide } from 'vue'
	import type { CheckboxGroupContext } from '../ste-checkbox/checkbox-types.uts'

	defineOptions({ name: 'ste-checkbox-group', options: { virtualHost: true } })

	type CheckboxGroupProps = {
		modelValue ?: any[],
		direction ?: string,
		max ?: number,
		disabled ?: boolean,
		readonly ?: boolean,
		shape ?: string,
		iconSize ?: string | number,
		checkedColor ?: string,
		textPosition ?: string,
		textSize ?: string | number,
		textInactiveColor ?: string,
		textActiveColor ?: string,
		textDisabled ?: boolean,
		marginLeft ?: string | number,
		marginRight ?: string | number,
		columnGap ?: string | number,
	}

	const props = withDefaults(defineProps<CheckboxGroupProps>(), {
		modelValue: () => [] as any[],
		direction: 'column',
		max: 0,
		disabled: false,
		readonly: false,
		textDisabled: false,
	})
	const emits = defineEmits(['change', 'update:modelValue'])

	// 子组件注册计数
	const childrenCount = ref(0)

	function registerChild() : number {
		const index = childrenCount.value
		childrenCount.value++
		return index
	}

	function unregisterChild() {
		if (childrenCount.value > 0) childrenCount.value--
	}

	function updateValue(value : any[]) {
		emits('change', value)
		emits('update:modelValue', value)
	}

	// provide 给子组件 — 用 getter 函数避免 UTS 类型不匹配（defineProps 返回编译器生成类型）
	// string | number 类型的属性统一转为 string 返回，避免子组件类型比较问题
	const groupContext : CheckboxGroupContext = {
		getModelValue: () : any[] => props.modelValue,
		getMax: () : number => props.max,
		getDirection: () : string => props.direction != null ? props.direction! : 'column',
		getDisabled: () : boolean => props.disabled == true,
		getReadonly: () : boolean => props.readonly == true,
		getShape: () : string => props.shape != null ? props.shape! : '',
		getIconSize: () : string => props.iconSize != null ? '' + props.iconSize! : '',
		getCheckedColor: () : string => props.checkedColor != null ? props.checkedColor! : '',
		getTextPosition: () : string => props.textPosition != null ? props.textPosition! : '',
		getTextSize: () : string => props.textSize != null ? '' + props.textSize! : '',
		getTextInactiveColor: () : string => props.textInactiveColor != null ? props.textInactiveColor! : '',
		getTextActiveColor: () : string => props.textActiveColor != null ? props.textActiveColor! : '',
		getTextDisabled: () : boolean => props.textDisabled == true,
		getMarginLeft: () : string => props.marginLeft != null ? '' + props.marginLeft! : '',
		getMarginRight: () : string => props.marginRight != null ? '' + props.marginRight! : '',
		getColumnGap: () : string => props.columnGap != null ? '' + props.columnGap! : '',
		updateValue: (value : any[]) => updateValue(value),
		registerChild: () : number => registerChild(),
		unregisterChild: () => unregisterChild(),
	}
	provide('ste-checkbox', groupContext)

	const cmpRootStyle = computed(() : UTSJSONObject => {
		return {
			flexDirection: props.direction != null ? props.direction! : 'column',
		} as UTSJSONObject
	})
</script>

<style>
.ste-checkbox-group-root {
	display: flex;
}
</style>
