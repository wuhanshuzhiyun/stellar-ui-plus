// Checkbox 组件共享类型定义

export type CheckboxGroupContext = {
	getModelValue : () => any[],
	getMax : () => number,
	getDirection : () => string,
	getDisabled : () => boolean,
	getReadonly : () => boolean,
	getShape : () => string,
	getIconSize : () => string,
	getCheckedColor : () => string,
	getTextPosition : () => string,
	getTextSize : () => string,
	getTextInactiveColor : () => string,
	getTextActiveColor : () => string,
	getTextDisabled : () => boolean,
	getMarginLeft : () => string,
	getMarginRight : () => string,
	getColumnGap : () => string,
	updateValue : (value : any[]) => void,
	registerChild : () => number,
	unregisterChild : () => void,
}
