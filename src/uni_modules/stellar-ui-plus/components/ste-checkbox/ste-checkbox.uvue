<template>
	<view class="ste-checkbox-root" :style="cmpRootStyle" @click="click">
		<view class="checkbox-icon" :style="cmpIconStyle">
			<view class="input-icon" :style="cmpInputStyle">
				<ste-icon v-if="cmpChecked" :size="iconSizeComputed * 0.8" code="&#xe67a;" :color="cmpDisabled ? '#bbbbbb' : '#fff'" bold></ste-icon>
			</view>
		</view>
		<view class="checkbox-text">
			<text :style="cmpTextStyle"><slot></slot></text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed, ref, inject, onUnmounted } from 'vue'
	import { useColorStore } from '../../store/color.uts'
	import { formatPx } from '../../utils/utils.uts'
	import { normalizeFontSize } from '../../config/index.uts'
	import type { CheckboxGroupContext } from './checkbox-types.uts'

	defineOptions({ name: 'ste-checkbox', options: { virtualHost: true } })

	type CheckboxProps = {
		modelValue ?: boolean,
		name ?: string | number,
		disabled ?: boolean,
		readonly ?: boolean,
		shape ?: string,
		iconSize ?: string | number,
		checkedColor ?: string,
		textPosition ?: string,
		textSize ?: string | number,
		textInactiveColor ?: string,
		textActiveColor ?: string,
		textDisabled ?: boolean,
		marginLeft ?: string | number,
		marginRight ?: string | number,
		columnGap ?: string | number,
	}

	const props = withDefaults(defineProps<CheckboxProps>(), {
		modelValue: false,
		name: '',
		disabled: false,
		readonly: false,
		shape: 'circle',
		iconSize: 36,
		checkedColor: '',
		textPosition: 'right',
		textSize: 28,
		textInactiveColor: '#000000',
		textActiveColor: '#000000',
		textDisabled: false,
		marginLeft: '0',
		marginRight: '0',
		columnGap: '16',
	})
	const emits = defineEmits(['click', 'change', 'input', 'update:modelValue'])

	// 颜色 store
	const colorStore = useColorStore()
	const colorData = colorStore.getColor()

	// 父组件上下文通过 inject 注入
	// 使用共享类型 CheckboxGroupContext 避免跨文件类型不匹配
	// inject 必须在 setup 顶层调用
	const injected = inject<CheckboxGroupContext | null>('ste-checkbox', null)
	const parentData = injected

	const childIndex = ref(-1)
	const num = ref(1)

	// 注册子组件
	if (parentData != null) {
		childIndex.value = parentData!.registerChild()
	}

	onUnmounted(() => {
		if (parentData != null) {
			parentData!.unregisterChild()
		}
	})

	// 是否在 group 中
	const inGroup = computed(() : boolean => parentData != null)

	// ============== 属性获取（优先本地 > 父组件 > 默认值） ==============

	function getDisabled() : boolean {
		if (props.disabled) return true
		if (inGroup.value && parentData!.getDisabled()) return true
		return false
	}

	function getReadonly() : boolean {
		if (props.readonly) return true
		if (inGroup.value && parentData!.getReadonly()) return true
		return false
	}

	function getShape() : string {
		if (props.shape != null) return props.shape!
		if (inGroup.value) {
			const v = parentData!.getShape()
			if (v != '') return v
		}
		return 'circle'
	}

	function getTextPosition() : string {
		if (props.textPosition != null) return props.textPosition!
		if (inGroup.value) {
			const v = parentData!.getTextPosition()
			if (v != '') return v
		}
		return 'right'
	}

	function getTextSize() : string | number {
		if (props.textSize != null) return props.textSize!
		if (inGroup.value) {
			const v = parentData!.getTextSize()
			if (v != '') return v
		}
		return 28
	}

	function getCheckedColor() : string {
		if (props.checkedColor != null && props.checkedColor != '') return props.checkedColor!
		if (inGroup.value) {
			const v = parentData!.getCheckedColor()
			if (v != '') return v
		}
		return colorData.steThemeColor
	}

	function getTextActiveColor() : string {
		if (props.textActiveColor != null && props.textActiveColor != '') return props.textActiveColor!
		if (inGroup.value) {
			const v = parentData!.getTextActiveColor()
			if (v != '') return v
		}
		return '#000000'
	}

	function getTextInactiveColor() : string {
		if (props.textInactiveColor != null && props.textInactiveColor != '') return props.textInactiveColor!
		if (inGroup.value) {
			const v = parentData!.getTextInactiveColor()
			if (v != '') return v
		}
		return '#000000'
	}

	function getTextDisabled() : boolean {
		if (props.textDisabled) return true
		if (inGroup.value && parentData!.getTextDisabled()) return true
		return false
	}

	function getColumnGap() : string | number {
		if (props.columnGap != null) return props.columnGap!
		if (inGroup.value) {
			const v = parentData!.getColumnGap()
			if (v != '') return v
		}
		return '16'
	}

	function getDirection() : string {
		if (inGroup.value) return parentData!.getDirection()
		return 'column'
	}

	function getMax() : number {
		if (inGroup.value) return parentData!.getMax()
		return 0
	}

	// ============== 核心状态 ==============

	// 判断 name 是否在选中数组中
	function isNameChecked() : boolean {
		if (!inGroup.value) return false
		const list = parentData!.getModelValue()
		for (let i = 0; i < list.length; i++) {
			if (list[i] == props.name) return true
		}
		return false
	}

	const cmpChecked = computed(() : boolean => {
		if (inGroup.value) {
			return num.value > 0 && isNameChecked()
		}
		return props.modelValue == true
	})

	const cmpDisabled = computed(() : boolean => {
		let disabled = getDisabled()
		if (inGroup.value) {
			const max = getMax()
			if (max > 0) {
				const list = parentData!.getModelValue()
				if (cmpChecked.value != true && list.length >= max) {
					disabled = true
				}
			}
		}
		return disabled
	})

	const iconSizeComputed = computed(() : number => {
		let size : string | number = 36
		if (props.iconSize != null) size = props.iconSize!
		else if (inGroup.value) {
			const v = parentData!.getIconSize()
			if (v != '') size = v
		}
		if (typeof size === 'number') return size as number
		return parseFloat(size as string)
	})

	// ============== 样式 computed ==============

	const cmpRootStyle = computed(() : UTSJSONObject => {
		const textPosition = getTextPosition()

		let marginLeft : string | number = '0'
		if (props.marginLeft != null) marginLeft = props.marginLeft!
		else if (inGroup.value) {
			const v = parentData!.getMarginLeft()
			if (v != '') marginLeft = v
		}

		let marginRight : string | number = '0'
		if (props.marginRight != null) marginRight = props.marginRight!
		else if (inGroup.value) {
			const v = parentData!.getMarginRight()
			if (v != '') marginRight = v
		}

		// group 中非首个元素自动间距
		if (inGroup.value && childIndex.value > 0) {
			const direction = getDirection()
			if (direction == 'row') {
				const ml = typeof marginLeft === 'string' ? marginLeft as string : '' + marginLeft
				if (ml == '0' || ml == '0rpx' || ml == '0px') {
					marginLeft = '16'
				}
			}
		}

		const style : UTSJSONObject = {
			flexDirection: textPosition == 'right' ? 'row' : 'row-reverse',
			marginLeft: formatPx(marginLeft),
			marginRight: formatPx(marginRight),
			display: 'flex',
			alignItems: 'center',
		}

		// 纵向排列时间距
		if (inGroup.value && childIndex.value > 0) {
			const direction = getDirection()
			if (direction == 'column') {
				style['marginTop'] = '8px'
			}
		}

		return style
	})

	// 文本样式（fontSize/color 只能用于 <text> 元素）
	const cmpTextStyle = computed(() : UTSJSONObject => {
		const textSize = getTextSize()
		return {
			fontSize: typeof textSize === 'number' ? normalizeFontSize(textSize as number) : formatPx(textSize as string),
			color: cmpChecked.value ? getTextActiveColor() : getTextInactiveColor(),
		} as UTSJSONObject
	})

	const cmpIconStyle = computed(() : UTSJSONObject => {
		return {
			marginRight: formatPx(getColumnGap()),
		} as UTSJSONObject
	})

	const cmpInputStyle = computed(() : UTSJSONObject => {
		const shape = getShape()
		const size = iconSizeComputed.value
		const checkedColor = getCheckedColor()
		const checked = cmpChecked.value

		const style : UTSJSONObject = {
			borderRadius: shape == 'circle' ? '50%' : '0px',
			border: '1px solid ' + (checked ? checkedColor : '#BBBBBB'),
			background: checked ? checkedColor : '#FFFFFF',
			width: uni.rpx2px(size) + 'px',
			height: uni.rpx2px(size) + 'px',
			display: 'flex',
			justifyContent: 'center',
			alignItems: 'center',
		}

		if (cmpDisabled.value) {
			style['background'] = '#eeeeee'
			style['borderColor'] = '#bbbbbb'
		}

		return style
	})

	// ============== 点击处理 ==============

	// 点击事件上下文类型
	type ClickEventContext = {
		suspend : () => void,
		next : () => void,
		stop : () => void,
	}

	const click = () => {
		if (cmpDisabled.value) return
		if (getReadonly()) return

		let suspended = false

		// 执行变更的函数
		const executeChange = () => {
			let value : any
			if (inGroup.value) {
				const list = [...parentData!.getModelValue()] as any[]
				if (cmpChecked.value) {
					const newList = [] as any[]
					for (let i = 0; i < list.length; i++) {
						if (list[i] != props.name) newList.push(list[i])
					}
					value = newList
				} else {
					list.push(props.name)
					value = list
				}
				parentData!.updateValue(value as any[])
				num.value++
			} else {
				value = cmpChecked.value != true
				emits('update:modelValue', value as boolean)
			}
			emits('change', value)
		}

		// 创建事件上下文
		const context : ClickEventContext = {
			suspend: () => {
				suspended = true
			},
			next: () => {
				// 如果已经 suspended，则继续执行
				if (suspended) {
					executeChange()
				}
			},
			stop: () => {
				// 用户调用 stop()，不执行后续逻辑
				// 什么都不做
			},
		}

		// 触发 click 事件，传递当前值和 context 对象
		emits('click', props.modelValue, context)

		// 如果用户没有调用 suspend()，则直接执行
		if (!suspended) {
			executeChange()
		}
	}
</script>

<style>
.ste-checkbox-root {
	width: auto;
	display: flex;
	align-items: center;
}

.input-icon {
	display: flex;
	justify-content: center;
	align-items: center;
}

.checkbox-text {
	display: flex;
	align-items: center;
}
</style>
