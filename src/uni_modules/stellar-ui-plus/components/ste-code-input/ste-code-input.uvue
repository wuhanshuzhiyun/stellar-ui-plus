<script setup lang="uts">
	import { ref, computed, watch, onUnmounted } from 'vue'
	import { formatPx, addUnit } from '../../utils/utils.uts'
	import { normalizeFontSize } from '../../config/index.uts'

	defineOptions({ name: 'ste-code-input', options: { virtualHost: true } })

	type Props = {
		value ?: string | number,
		maxlength ?: string | number,
		mode ?: string,
		fontSize ?: string | number,
		fontColor ?: string,
		borderColor ?: string,
		size ?: string | number,
		space ?: string | number,
		formatter ?: string,
		focus ?: boolean,
		readOnly ?: boolean,
		disabledDot ?: boolean,
	}

	const props = withDefaults(defineProps<Props>(), {
		value: '',
		maxlength: 6,
		mode: 'box',
		fontSize: 28,
		fontColor: '#000000',
		borderColor: '#dddddd',
		size: 64,
		space: 16,
		formatter: '',
		focus: false,
		readOnly: false,
		disabledDot: true,
	})

	const emits = defineEmits(['change', 'input', 'finish'])

	const inputValue = ref('')
	const isFocus = ref(props.focus)

	// 光标闪烁控制
	const cursorVisible = ref(true)
	let cursorTimer : number | null = null

	const startCursorBlink = () => {
		if (cursorTimer != null) return
		cursorTimer = setInterval(() => {
			cursorVisible.value = !cursorVisible.value
		}, 400) as number
	}

	const stopCursorBlink = () => {
		if (cursorTimer != null) {
			clearInterval(cursorTimer!)
			cursorTimer = null
		}
		cursorVisible.value = true
	}

	// 监听 focus 变化
	watch(() : boolean => props.focus, (val : boolean) => {
		isFocus.value = val
	})

	// 监听 inputValue 变化，控制光标闪烁
	watch(() : string => inputValue.value, () => {
		if (isFocus.value) {
			cursorVisible.value = true
			startCursorBlink()
		}
	})

	// 监听 isFocus 变化
	watch(() : boolean => isFocus.value, (val : boolean) => {
		if (val) {
			startCursorBlink()
		} else {
			stopCursorBlink()
		}
	})

	const cmpCodeLengthArray = computed(() : any[] => {
		const len = props.maxlength as number
		const arr = [] as any[]
		for (let i = 0; i < len; i++) {
			arr.push(i)
		}
		return arr
	})

	const cmpCodeArray = computed(() : string[] => {
		const str = '' + inputValue.value
		const arr = [] as string[]
		for (let i = 0; i < str.length; i++) {
			arr.push(str.charAt(i))
		}
		return arr
	})

	const cmpRootStyle = computed(() : UTSJSONObject => {
		return {
			display: 'flex',
			flexDirection: 'row',
			position: 'relative',
			overflow: 'hidden',
		} as UTSJSONObject
	})

	function getItemStyle(index : number) : UTSJSONObject {
		const sizeVal = parseFloat('' + props.size)
		const sizeStr = addUnit(sizeVal)
		const spaceVal = parseFloat('' + props.space)
		const maxLen = parseFloat('' + props.maxlength)

		const style : UTSJSONObject = {
			width: sizeStr,
			height: sizeStr,
			position: 'relative',
			display: 'flex',
			flexDirection: 'row',
			justifyContent: 'center',
			alignItems: 'center',
		}

		// 盒子模式
		if (props.mode == 'box') {
			style['border'] = '1px solid ' + props.borderColor
			style['backgroundColor'] = '#F5F5F5'

			if (spaceVal == 0) {
				// 第一个和最后一个盒子设置圆角
				if (index == 0) {
					style['borderTopLeftRadius'] = '3px'
					style['borderBottomLeftRadius'] = '3px'
				}
				if (index == maxLen - 1) {
					style['borderTopRightRadius'] = '3px'
					style['borderBottomRightRadius'] = '3px'
				}
				// 最后一个盒子的右边框需要保留
				if (index != maxLen - 1) {
					style['borderRight'] = 'none'
				}
			} else {
				style['borderRadius'] = '5px'
			}
		}

		// 设置间距
		if (index != maxLen - 1) {
			style['marginRight'] = addUnit(spaceVal)
		} else {
			style['marginRight'] = '0px'
		}

		return style
	}

	function getTextStyle() : UTSJSONObject {
		const sizeVal = parseFloat('' + props.size)
		return {
			fontSize: normalizeFontSize(parseFloat('' + props.fontSize)),
			color: props.fontColor,
			position: 'absolute',
			top: '0px',
			left: '0px',
			width: addUnit(sizeVal),
			height: addUnit(sizeVal),
			lineHeight: addUnit(sizeVal),
			textAlign: 'center',
		} as UTSJSONObject
	}

	function getLineStyle() : UTSJSONObject {
		return {
			position: 'absolute',
			bottom: '0px',
			height: '2px',
			borderRadius: '20px',
			width: addUnit(parseFloat('' + props.size)),
			backgroundColor: props.borderColor,
		} as UTSJSONObject
	}

	function getCursorStyle() : UTSJSONObject {
		return {
			position: 'absolute',
			top: '22.5%',
			left: '50%',
			width: '1px',
			height: '55%',
			backgroundColor: props.fontColor,
			opacity: cursorVisible.value ? 1 : 0,
			transition: 'opacity 0.1s ease',
		} as UTSJSONObject
	}

	function getInputStyle() : UTSJSONObject {
		return {
			height: addUnit(parseFloat('' + props.size)),
		} as UTSJSONObject
	}

	function inputHandler(e : InputEvent) {
		let value : string = ''
		const v = e.detail.value
		if (v != null) {
			value = v
		}

		// 是否允许输入"."符号
		if (props.disabledDot) {
			value = value.replace('.', '')
		}

		inputValue.value = value

		// 未达到 maxlength 之前，发送 change 事件，达到后发送 finish 事件
		emits('change', inputValue.value)
		// 修改通过 v-model 双向绑定的值
		emits('input', inputValue.value)
		// 达到用户指定输入长度时，发出完成事件
		if (('' + inputValue.value).length >= parseFloat('' + props.maxlength)) {
			emits('finish', inputValue.value)
		}
	}

	// 组件卸载时清理光标定时器，避免内存泄漏
	onUnmounted(() => {
		stopCursorBlink()
	})

	watch(() : string | number => props.value, (val : string | number) => {
		// 转为字符串，超出部分截掉
		inputValue.value = ('' + val).substring(0, parseFloat('' + props.maxlength))
	}, { immediate: true })
</script>

<template>
	<view class="ste-code-input-root" :style="[cmpRootStyle]">
		<view class="ste-code-input-item" :style="[getItemStyle(index)]" v-for="(item, index) in cmpCodeLengthArray" :key="index">
			<text class="ste-code-input-item-dot" :style="[getTextStyle()]" v-if="formatter != '' && cmpCodeArray.length > index">
				{{ formatter }}
			</text>
			<text class="ste-code-input-item-text" :style="[getTextStyle()]" v-else-if="cmpCodeArray.length > index">
				{{ cmpCodeArray[index] }}
			</text>
			<view class="ste-code-input-item-line" :style="[getLineStyle()]" v-if="mode == 'line'"></view>
			<view v-if="isFocus == true && cmpCodeArray.length == index" :style="[getCursorStyle()]" class="ste-code-input-item-cursor"></view>
		</view>
		<input
			v-if="!readOnly"
			type="number"
			:focus="focus"
			:value="inputValue"
			:maxlength="parseFloat('' + maxlength)"
			adjustPosition
			class="ste-code-input-input"
			:cursor-spacing="30"
			@input="inputHandler"
			:style="getInputStyle()"
			@focus="isFocus = true"
			@blur="isFocus = false"
		/>
	</view>
</template>

<style>
.ste-code-input-root {
	display: flex;
	flex-direction: row;
	position: relative;
	overflow: hidden;
}

.ste-code-input-item {
	position: relative;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
}

.ste-code-input-item-text {
	position: absolute;
	top: 0px;
	left: 0px;
}

.ste-code-input-item-dot {
	position: absolute;
	top: 0px;
	left: 0px;
}

.ste-code-input-item-line {
	position: absolute;
	bottom: 0px;
	height: 2px;
	border-radius: 20px;
}

.ste-code-input-item-cursor {
	position: absolute;
	top: 22.5%;
	left: 50%;
	width: 1px;
	height: 55%;
}

.ste-code-input-input {
	position: absolute;
	left: -10000px;
	width: 20000px;
	top: 0px;
	opacity: 0;
	background-color: transparent;
	text-align: left;
}
</style>
