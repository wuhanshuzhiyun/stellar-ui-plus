<template>
	<!-- Comment 评论组件根容器：无评价时应用柔和浅橙渐变底色 -->
	<view class="ste-comment-root" :class="{ 'ste-comment-root-empty': totalData === 0 }">
		<!-- 顶部标题与右侧查看全部操作栏 -->
		<view class="comment-head">
			<view class="comment-head-title">
				<text class="comment-head-title-text">商品评价({{ totalData }})</text>
			</view>
			<view class="comment-head-right" @click="handleHeadRightClick">
				<text class="comment-head-right-text">{{ headRight }}</text>
				<!-- 全部评价状态下展示向右箭头图标 -->
				<ste-icon v-if="headRight === '全部评价'" code="&#xe674;" size="24" color="#858585" />
			</view>
		</view>

		<!-- 评价主体内容区：仅在有评价或评论数大于 0 时展示 -->
		<view class="comment-content" v-if="totalData > 0 || comments.length > 0">
			<!-- 顶部评价聚合标签列表 -->
			<view class="comment-tags" v-if="tags.length > 0">
				<view
					class="comment-tag"
					v-for="(tag, index) in tags"
					:key="index"
					@click="handleTagClick(tag, index)"
				>
					<text class="comment-tag-text">{{ tag }}</text>
				</view>
			</view>

			<!-- 用户评论卡片列表 -->
			<view class="comment-list">
				<view
					class="comment-item"
					v-for="(item, index) in comments"
					:key="index"
					@click="handleItemClick(item, index)"
				>
					<!-- 评价者头部信息：头像、昵称、好评图标及日期 -->
					<view class="comment-head-info">
						<image
							class="comment-head-avatar"
							:src="item.userAvatar"
							mode="aspectFill"
						/>
						<view class="comment-head-right-info">
							<view class="comment-head-name-row">
								<text class="comment-head-name">{{ item.userName }}</text>
								<!-- 1 为好评类型时展示好评徽章图标 -->
								<image
									class="good-tag"
									v-if="item.type === 1"
									src="https://image.whzb.com/chain/StellarUI/component-icons/好评.png"
									mode="aspectFit"
								/>
							</view>
							<text class="comment-head-time">{{ item.date }}</text>
						</view>
					</view>

					<!-- 评价文字正文 -->
					<view class="comment-text-content">
						<text class="comment-text">{{ item.evaluateText }}</text>
					</view>

					<!-- 评价配图九宫格列表 -->
					<view class="comment-images" v-if="item.imgList != null && item.imgList!.length > 0">
						<image
							class="comment-image"
							:class="{ 'comment-image-last-col': (imgIndex + 1) % 4 === 0 }"
							v-for="(image, imgIndex) in item.imgList!"
							:key="imgIndex"
							:src="image"
							mode="aspectFill"
							@click.stop="handleImageClick(image, imgIndex, item.imgList!)"
						/>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * @file ste-comment.uvue
 * @description Comment 评论组件 (uni-app x / UTS 原生重构实现)
 *
 * 核心设计与模块职责：
 * 1. 强类型契约驱动：采用 CommentType 严格约束评价项数据结构；
 * 2. 状态机与空状态呈现：根据 total 与 comments 计算有效评价数，无评论时展示“期待你的首评”并启用优雅渐变底色；
 * 3. Android 跨端样式优化：消除原生不支持的 :nth-child(4n) 伪类，由动态类实现九宫格每行第 4 张图片右边距清零；
 * 4. 丰富交互事件联动：支持点击右侧更多、点击标签、点击晒图（内置全屏大图预览）与点击单条卡片。
 */

import { computed } from 'vue';
import type { PropType } from 'vue';
import type { CommentType } from './constants.uts';

export type { CommentType };

/**
 * 组件 Props 属性定义
 */
const props = defineProps({
	/** 聚合标签数据列表 */
	tags: {
		type: Array as PropType<string[]>,
		default: (): string[] => [] as string[]
	},
	/** 评价总数（外部传入的统计数字） */
	total: {
		type: Number,
		default: 0
	},
	/** 评价列表数据 */
	comments: {
		type: Array as PropType<CommentType[]>,
		default: (): CommentType[] => [] as CommentType[]
	}
});

/**
 * 组件 Emits 事件声明
 */
const emit = defineEmits<{
	/** 点击头部右上角（全部评价 / 期待你的首评）事件 */
	(e: 'click-head-right', text: string): void;
	/** 点击评价标签事件 */
	(e: 'click-tag', tag: string, index: number): void;
	/** 点击评价配图事件 */
	(e: 'click-image', image: string, index: number, images: string[]): void;
	/** 点击单条评价卡片事件 */
	(e: 'click-item', item: CommentType, index: number): void;
}>();

/**
 * 实际有效评价总数计算属性（取外部 total 与列表长度最大值）
 */
const totalData = computed((): number => {
	return Math.max(props.total, props.comments.length);
});

/**
 * 头部右侧文案计算属性
 */
const headRight = computed((): string => {
	if (totalData.value === 0) {
		return '期待你的首评';
	}
	return '全部评价';
});

/**
 * 处理头部右侧点击操作
 */
function handleHeadRightClick() {
	emit('click-head-right', headRight.value);
}

/**
 * 处理评价标签点击操作
 * @param tag 被点击的标签文本
 * @param index 标签索引
 */
function handleTagClick(tag: string, index: number) {
	emit('click-tag', tag, index);
}

/**
 * 处理单条评价卡片点击操作
 * @param item 评论项数据
 * @param index 评论项索引
 */
function handleItemClick(item: CommentType, index: number) {
	emit('click-item', item, index);
}

/**
 * 处理评价晒图点击操作（默认唤起系统大图预览）
 * @param currentUrl 当前点击的大图地址
 * @param index 当前图片索引
 * @param images 该条评价的所有图片列表
 */
function handleImageClick(currentUrl: string, index: number, images: string[]) {
	emit('click-image', currentUrl, index, images);
	// 唤起原生大图预览
	uni.previewImage({
		current: currentUrl,
		urls: images
	});
}
</script>

<style>
/* 根容器：默认纯白背景，铺满宽度 */
.ste-comment-root {
	width: 100%;
	background-color: #ffffff;
}

/* 空评价状态：柔和浅橙渐变背景 */
.ste-comment-root-empty {
	background-image: linear-gradient(161deg, #ffffff 0%, #ffffff 42%, #fff1ed 100%);
}

/* 顶部操作条容器 */
.comment-head {
	width: 100%;
	height: 92rpx;
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding-left: 24rpx;
	padding-right: 20rpx;
}

/* 顶部标题文本 */
.comment-head-title-text {
	font-weight: bold;
	font-size: 32rpx;
	color: #000000;
}

/* 顶部右侧文案与箭头容器 */
.comment-head-right {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.comment-head-right-text {
	font-size: 28rpx;
	color: #858585;
	margin-right: 4rpx;
}

/* 评价主体内容区外层内边距 */
.comment-content {
	width: 100%;
	padding-left: 24rpx;
	padding-right: 24rpx;
	padding-bottom: 20rpx;
}

/* 评价聚合标签容器 */
.comment-tags {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin-top: 4rpx;
}

/* 单个聚合标签样式 */
.comment-tag {
	background-color: rgba(246, 84, 25, 0.08);
	padding-top: 10rpx;
	padding-bottom: 10rpx;
	padding-left: 28rpx;
	padding-right: 28rpx;
	margin-right: 20rpx;
	margin-bottom: 20rpx;
	border-radius: 26rpx;
}

.comment-tag-text {
	font-size: 24rpx;
	font-weight: 500;
	color: #f65419;
}

/* 评价卡片列表容器 */
.comment-list {
	width: 100%;
}

/* 单条评价卡片外框 */
.comment-item {
	width: 100%;
	background-color: #f9f9fb;
	border-radius: 16rpx;
	padding-top: 24rpx;
	padding-bottom: 16rpx;
	padding-left: 18rpx;
	padding-right: 18rpx;
	margin-bottom: 20rpx;
}

/* 用户头部信息行 */
.comment-head-info {
	width: 100%;
	display: flex;
	flex-direction: row;
	align-items: center;
}

/* 用户圆形头像 */
.comment-head-avatar {
	width: 64rpx;
	height: 64rpx;
	border-radius: 32rpx;
}

/* 昵称与发布时间右侧垂直信息列 */
.comment-head-right-info {
	padding-left: 16rpx;
	height: 64rpx;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
}

/* 昵称与好评图标横向组合 */
.comment-head-name-row {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.comment-head-name {
	color: #000000;
	font-size: 24rpx;
	font-weight: bold;
}

/* 好评角标小图 */
.good-tag {
	width: 84rpx;
	height: 32rpx;
	margin-left: 16rpx;
}

/* 发布时间文本 */
.comment-head-time {
	color: #999999;
	font-size: 20rpx;
	font-weight: 400;
}

/* 评价正文外层 */
.comment-text-content {
	margin-top: 18rpx;
	margin-bottom: 16rpx;
}

.comment-text {
	font-size: 28rpx;
	color: #000000;
	line-height: 42rpx;
}

/* 九宫格配图容器 */
.comment-images {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}

/* 单张缩略图样式 */
.comment-image {
	width: 150rpx;
	height: 150rpx;
	margin-right: 8rpx;
	margin-bottom: 8rpx;
	border-radius: 8rpx;
}

/* 每行第 4 列图片右边距清零（消除 :nth-child 依赖以完美兼容 Android 原生） */
.comment-image-last-col {
	margin-right: 0rpx;
}
</style>
