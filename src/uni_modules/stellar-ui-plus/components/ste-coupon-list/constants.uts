/**
 * @file constants.uts
 * @description ste-coupon-list 优惠券卡片组件 - uni-app x / UTS 强类型契约与常量定义
 */

/**
 * 优惠券核心数据契约接口
 */
export type CouponData = {
	/** 优惠券主标题 */
	title: string;
	/** 优惠券副标题或描述说明（在未开启倒计时时展示） */
	desc?: string;
	/** 优惠券左侧主图或商品图片地址 */
	image: string;
	/** 券面价值或折扣金额（传递给 ste-price 渲染） */
	price: any;
	/** 使用门槛或限制条件文本（如 '满100元可用'） */
	constraint?: string;
	/** 底部使用须知/说明展开文本列表 */
	footers?: string[];
};

/**
 * 倒计时时间状态数据接口
 */
export type CouponCountDown = {
	/** 剩余天数 */
	days: number;
	/** 剩余小时数 (0-23) */
	hours: number;
	/** 剩余分钟数 (0-59) */
	minutes: number;
	/** 剩余秒数 (0-59) */
	seconds: number;
};
