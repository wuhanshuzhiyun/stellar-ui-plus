<template>
	<!-- CouponList 优惠券卡片组件根容器 -->
	<view class="ste-coupon-list-root">
		<!-- 优惠券主体内容卡片 -->
		<view class="coupon-info-block" :style="{ backgroundColor: backgroundColor }">
			<!-- 左侧优惠券封面图片 -->
			<ste-image width="144" height="144" :src="data.image" radius="12" />

			<!-- 中间核心信息展示区 -->
			<view class="coupon-info">
				<!-- 优惠券主标题：开启进度条时自动避让右上角半圆环 -->
				<text class="info-title" :class="{ 'info-title-with-progress': progress >= 0 }">{{ data.title }}</text>

				<!-- 倒计时状态或普通副标题说明 -->
				<view class="info-desc">
					<!-- 若配置了 endTime 则渲染限时倒计时 -->
					<view v-if="endTime != null" class="count-down">
						<view class="count-down-view">
							<text class="count-down-num">{{ viewTime(countDown.hours) }}</text>
						</view>
						<text class="count-down-dot">:</text>
						<view class="count-down-view">
							<text class="count-down-num">{{ viewTime(countDown.minutes) }}</text>
						</view>
						<text class="count-down-dot">:</text>
						<view class="count-down-view">
							<text class="count-down-num">{{ viewTime(countDown.seconds) }}</text>
						</view>
						<text class="count-down-msg">后截止</text>
					</view>
					<!-- 未配置倒计时则呈现常规描述文本 -->
					<text v-else class="info-desc-text">{{ data.desc != null ? data.desc! : '' }}</text>
				</view>

				<!-- 价格与购买按钮操作行 -->
				<view class="info-price">
					<view class="price-left">
						<!-- 优惠券券面金额/价格 -->
						<ste-price :value="data.price" font-size="40" />
						<!-- 满减或使用门槛说明 -->
						<text class="info-constraint" v-if="data.constraint != null">{{ data.constraint }}</text>
					</view>
					<view class="price-right">
						<!-- 购买或领取行动按钮 -->
						<ste-button
							:disabled="buttonDisabled"
							:mode="100"
							@click="handleButtonClick"
						>{{ buttonText }}</ste-button>
					</view>
				</view>
			</view>

			<!-- 右上角半圆环形抢购进度条 -->
			<view class="circle-progress-canvas" v-if="progress >= 0">
				<canvas :id="canvasId" class="canvas-element" />
				<!-- 进度条正中/下方说明文本 -->
				<text class="progress-text">{{ progressText }}</text>
			</view>

			<!-- 右上角自定义扩展插槽（如角标、标签等） -->
			<slot name="position"></slot>
		</view>

		<!-- 底部使用须知/规则展开说明栏 -->
		<view
			class="coupon-footer-block"
			:style="{ backgroundColor: backgroundColor }"
			v-if="data.footers != null && data.footers!.length > 0"
		>
			<view
				class="coupon-footer-item"
				v-for="(footerText, i) in data.footers!"
				:key="i"
				@click="handleFooterClick(i)"
			>
				<text class="footer-item-text">{{ footerText }}</text>
				<view class="footer-item-icon">
					<ste-icon code="&#xe674;" size="20" color="#A4A4A4" />
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * @file ste-coupon-list.uvue
 * @description CouponList 优惠券卡片组件 (uni-app x / UTS 原生重构实现)
 *
 * 核心设计与模块职责：
 * 1. 强类型契约模型：采用 CouponData 严格规范优惠券主图、标题、描述、价格与底部规则；
 * 2. 倒计时引擎驱动：内置秒级递减定时驱动，支持 Date/字符串/时间戳，并具备 onUnmounted 防内存泄露清理；
 * 3. 异步 Canvas 半圆环进度条：通过 uni.createCanvasContextAsync 精准绘制抢购百分比弧度，消灭平台差异；
 * 4. 跨端内联样式穿透：彻底废弃 Android 原生不支持的 CSS 变量 var(--ste-coupon-lis-background)，采用动态内联样式直出；
 * 5. 全面空安全防御：针对可空字段进行严格收窄，杜绝运行时 NPE 崩溃。
 */

import { ref, computed, watch, onMounted, onUnmounted } from 'vue';
import type { PropType } from 'vue';
import type { CouponData, CouponCountDown } from './constants.uts';

export type { CouponData, CouponCountDown };

/**
 * 组件 Props 属性定义
 */
const props = defineProps({
	/** 优惠券核心业务数据 */
	data: {
		type: Object as PropType<CouponData>,
		default: (): CouponData => ({
			title: '',
			image: '',
			price: 0
		} as CouponData)
	},
	/** 倒计时结束时间（支持 Date、时间戳 number 或时间字符串） */
	endTime: {
		type: [Date, String, Number],
		default: null
	},
	/** 剩余可用或库存数量 */
	residue: {
		type: Number,
		default: -1
	},
	/** 抢购百分比进度 (0-100，若小于 0 则不渲染进度条) */
	progress: {
		type: Number,
		default: -1
	},
	/** 进度条下方描述文本（如 '仅剩30%'、'已抢70%'） */
	progressText: {
		type: String,
		default: ''
	},
	/** 购买/领取操作按钮文案 */
	buttonText: {
		type: String,
		default: '购买'
	},
	/** 是否禁用操作按钮 */
	buttonDisabled: {
		type: Boolean,
		default: false
	},
	/** 卡片背景色（默认为纯白 #ffffff） */
	backgroundColor: {
		type: String,
		default: '#ffffff'
	}
});

/**
 * 组件 Emits 事件声明
 */
const emit = defineEmits<{
	/** 点击操作按钮事件 */
	(e: 'buttonClick'): void;
	/** 点击底部规则项事件 */
	(e: 'footerClick', index: number): void;
	/** 倒计时秒级变动事件 */
	(e: 'countDown', remainSeconds: number): void;
}>();

// ==================== 倒计时逻辑模块 ====================

/** 当前倒计时天、时、分、秒状态集合 */
const countDown = ref<CouponCountDown>({
	days: 0,
	hours: 0,
	minutes: 0,
	seconds: 0
} as CouponCountDown);

/** 定时器句柄 */
let timerId: number = 0;

/**
 * 格式化时间数字为两位字符
 * @param v 整数数字
 * @returns 补齐 0 的两位字符串
 */
function viewTime(v: number): string {
	return v >= 10 ? v.toString() : '0' + v.toString();
}

/**
 * 解析各种格式的 endTime 为毫秒时间戳
 * @param timeVal 原始结束时间入参
 * @returns 毫秒时间戳数字
 */
function parseEndTime(timeVal: any | null): number {
	if (timeVal == null) {
		return 0;
	}
	if (typeof timeVal === 'number') {
		const num = timeVal as number;
		return num > 10000000000 ? num : num * 1000;
	}
	const str = timeVal.toString().replace(/-/g, '/');
	const d = new Date(str);
	return d.getTime();
}

/**
 * 停止并清理正在运行的倒计时定时器
 */
function stopCountDown() {
	if (timerId != 0) {
		clearInterval(timerId);
		timerId = 0;
	}
}

/**
 * 启动限时抢购倒计时引擎
 */
function startCountDown() {
	stopCountDown();
	if (props.endTime == null) {
		return;
	}

	const endTimestamp = parseEndTime(props.endTime);
	if (endTimestamp <= 0) {
		return;
	}

	// 立即计算一次
	const tick = () => {
		const now = Date.now();
		const diffSeconds = Math.floor((endTimestamp - now) / 1000);
		if (diffSeconds <= 0) {
			countDown.value = { days: 0, hours: 0, minutes: 0, seconds: 0 } as CouponCountDown;
			emit('countDown', 0);
			stopCountDown();
			return;
		}

		countDown.value = {
			days: Math.floor(diffSeconds / 86400),
			hours: Math.floor((diffSeconds / 3600) % 24),
			minutes: Math.floor((diffSeconds / 60) % 60),
			seconds: Math.floor(diffSeconds % 60)
		} as CouponCountDown;

		emit('countDown', diffSeconds);
	};

	tick();
	timerId = setInterval(tick, 1000);
}

// ==================== 进度条 Canvas 渲染模块 ====================

/** 生成组件内全局唯一的 Canvas 标识符 */
const canvasId = ref('ste_coupon_canvas_' + Math.floor(Math.random() * 1000000).toString());

/**
 * 异步绘制半圆环形抢购进度条
 */
function drawProgress() {
	if (props.progress < 0) {
		return;
	}

	uni.createCanvasContextAsync({
		id: canvasId.value,
		success: (context: CanvasContext) => {
			const ctx = context.getContext('2d') as CanvasRenderingContext2D;
			if (ctx == null) {
				return;
			}

			const canvas = ctx.canvas;
			const dpr: number = (uni.getDeviceInfo().devicePixelRatio ?? 1) > 0 ? (uni.getDeviceInfo().devicePixelRatio ?? 1) : 1;
			const width = canvas.offsetWidth;
			const height = canvas.offsetHeight;

			// 高清缩放处理
			canvas.width = width * dpr;
			canvas.height = height * dpr;
			ctx.scale(dpr, dpr);

			// 清空画布
			ctx.clearRect(0, 0, width, height);

			const centerX = width / 2;
			const centerY = height;
			const radius = width / 2 - 4; // 留出 4px 安全边距以防边缘线帽裁切

			// 1. 绘制底层灰色半圆轨道
			ctx.beginPath();
			ctx.arc(centerX, centerY, radius, Math.PI, 0, false);
			ctx.lineWidth = 4;
			ctx.strokeStyle = '#F3F3F3';
			ctx.lineCap = 'round';
			ctx.stroke();

			// 2. 绘制已抢红色高亮进度弧线
			if (props.progress > 0) {
				const percent = Math.min(100, Math.max(0, props.progress));
				const progressAngle = Math.PI * (percent / 100);
				ctx.beginPath();
				ctx.arc(centerX, centerY, radius, Math.PI, Math.PI + progressAngle, false);
				ctx.lineWidth = 4;
				ctx.strokeStyle = '#FF283A';
				ctx.lineCap = 'round';
				ctx.stroke();
			}
		}
	} as CreateCanvasContextAsyncOptions);
}

// ==================== 事件交互回调 ====================

function handleButtonClick() {
	if (!props.buttonDisabled) {
		emit('buttonClick');
	}
}

function handleFooterClick(index: number) {
	emit('footerClick', index);
}

// ==================== 生命周期与监听器 ====================

onMounted(() => {
	startCountDown();
	if (props.progress >= 0) {
		setTimeout(() => {
			drawProgress();
		}, 100);
	}
});

onUnmounted(() => {
	stopCountDown();
});

watch(
	(): any | null => props.endTime,
	() => {
		startCountDown();
	}
);

watch(
	(): number => props.progress,
	() => {
		setTimeout(() => {
			drawProgress();
		}, 50);
	}
);
</script>

<style>
/* 根容器：整宽呈现 */
.ste-coupon-list-root {
	width: 100%;
}

/* 优惠券主体内容卡片容器 */
.coupon-info-block {
	width: 100%;
	padding-top: 18rpx;
	padding-bottom: 14rpx;
	padding-left: 18rpx;
	padding-right: 18rpx;
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	justify-content: space-between;
	border-radius: 16rpx;
	position: relative;
}

/* 中间优惠券信息区域 */
.coupon-info {
	flex: 1;
	margin-left: 18rpx;
	height: 100%;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
}

/* 主标题文本 */
.info-title {
	font-weight: bold;
	font-size: 28rpx;
	line-height: 40rpx;
	color: #000000;
	lines: 1;
	text-overflow: ellipsis;
}

/* 开启进度条时为标题提供右侧安全避让空间，防止与右上角半圆环重合 */
.info-title-with-progress {
	padding-right: 110rpx;
}

/* 描述与倒计时外层容器 */
.info-desc {
	margin-top: 8rpx;
	height: 36rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
}

.info-desc-text {
	font-size: 22rpx;
	color: #727272;
	line-height: 32rpx;
	lines: 1;
	text-overflow: ellipsis;
}

/* 倒计时横向排布行 */
.count-down {
	display: flex;
	flex-direction: row;
	align-items: center;
}

/* 倒计时数字方块 */
.count-down-view {
	width: 32rpx;
	height: 30rpx;
	background-color: #fef4f1;
	border-radius: 4rpx;
	align-items: center;
	justify-content: center;
}

.count-down-num {
	font-size: 20rpx;
	font-weight: 500;
	color: #ff283a;
	line-height: 28rpx;
	text-align: center;
}

.count-down-dot {
	margin-left: 6rpx;
	margin-right: 6rpx;
	font-size: 20rpx;
	font-weight: 500;
	color: #ff283a;
}

.count-down-msg {
	font-size: 20rpx;
	color: #a4a4a4;
	line-height: 28rpx;
	margin-left: 12rpx;
}

/* 价格与行动按钮操作行 */
.info-price {
	margin-top: 12rpx;
	width: 100%;
	height: 56rpx;
	display: flex;
	flex-direction: row;
	align-items: flex-end;
	justify-content: space-between;
}

.price-left {
	display: flex;
	flex-direction: row;
	align-items: flex-end;
}

/* 使用门槛限制文本 */
.info-constraint {
	font-size: 20rpx;
	color: #363636;
	line-height: 36rpx;
	margin-left: 12rpx;
}

.price-right {
	display: flex;
	flex-direction: row;
	align-items: center;
}

/* 右上角半圆环进度条容器 */
.circle-progress-canvas {
	width: 96rpx;
	height: 48rpx;
	position: absolute;
	top: 20rpx;
	right: 24rpx;
}

.canvas-element {
	width: 96rpx;
	height: 48rpx;
}

.progress-text {
	width: 96rpx;
	text-align: center;
	position: absolute;
	bottom: -4rpx;
	font-size: 16rpx;
	color: #a4a4a4;
	line-height: 22rpx;
}

/* 底部规则与展开栏外框 */
.coupon-footer-block {
	width: 100%;
	margin-top: 4rpx;
	border-radius: 16rpx;
	padding-top: 14rpx;
	padding-bottom: 14rpx;
	padding-left: 18rpx;
	padding-right: 18rpx;
}

/* 规则单项行 */
.coupon-footer-item {
	width: 100%;
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding-top: 6rpx;
	padding-bottom: 6rpx;
}

.footer-item-text {
	flex: 1;
	lines: 1;
	text-overflow: ellipsis;
	font-size: 24rpx;
	color: #a4a4a4;
	line-height: 34rpx;
}

/* 规则右侧圆形箭头指示图标 */
.footer-item-icon {
	width: 32rpx;
	height: 32rpx;
	margin-left: 12rpx;
	align-items: center;
	justify-content: center;
	background-color: #f3f3f3;
	border-radius: 16rpx;
}
</style>
