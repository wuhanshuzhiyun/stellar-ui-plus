<template>
	<!-- CustomKeyboard 定制键盘组件根容器 -->
	<view class="ste-custom-keyboard-root">
		<!-- 基于底层 NumberKeyboard 原生引擎进行高阶功能封装 -->
		<ste-number-keyboard
			:mode="mode"
			:model-value="dataValue"
			:show="dataShow"
			:maxlength="maxlength"
			:right-keys="rightKeys"
			:random-keys="randomKeys"
			:confirm-text="confirmText"
			:confirm-disabled="confirmDisabled"
			:custom-keys="actualCustomKeys"
			:show-clear="showClear"
			:text-color="textColor"
			:text-size="textSize"
			:backspace-size="backspaceSize"
			:confirm-bg="confirmBg"
			:confirm-color="confirmColor"
			:key-bg="keyBg"
			:background="background"
			:active-input-ref="activeInputRef"
			:input-values="inputValues"
			:root-style="rootStyle"
			@update:model-value="onModelValueUpdate"
			@update:show="onShowUpdate"
			@update:input-values="onInputValuesUpdate"
			@change="onChange"
			@input="onInput"
			@confirm="onConfirm"
			@clear="onClear"
			@backspace="onBackspace"
			@click="onKeyClick"
			@beforeinput="onBeforeInput"
			@open="onOpen"
			@close="onClose"
		>
			<!-- 弹窗标题插槽：支持外部自定义，默认根据 type 呈现对应标题 -->
			<template #default>
				<slot>
					<text class="ste-ck-title-text">{{ computedTitle }}</text>
				</slot>
			</template>

			<!-- 键盘顶部内容插槽：当 type 为 discount 时渲染快捷折扣胶囊栏 -->
			<template #header>
				<view class="ste-ck-discount-bar" v-if="type === 'discount' && discountList.length > 0">
					<view
						class="ste-ck-discount-item"
						:style="cmpDiscountItemStyle"
						v-for="(item, dIdx) in discountList"
						:key="dIdx"
						@click="handleDiscountClick(item)"
					>
						<text class="ste-ck-discount-num" :style="{ color: confirmColor }">{{ item.n }}</text>
						<text class="ste-ck-discount-dot" :style="{ color: confirmColor }" v-if="item.d > 0">.{{ item.d }}</text>
						<text class="ste-ck-discount-text" :style="{ color: confirmColor }">折</text>
					</view>
				</view>
			</template>
		</ste-number-keyboard>
	</view>
</template>

<script setup lang="uts">
/**
 * @file ste-custom-keyboard.uvue
 * @description CustomKeyboard 定制键盘组件 (uni-app x / UTS 原生重构实现)
 *
 * 核心设计与模块职责：
 * 1. 强类型契约模型：采用 CustomKeyboardProps 与 DiscountItem 约束属性与折扣胶囊数据；
 * 2. 高阶引擎组合：依托原生 ste-number-keyboard 统一处理按键网格、弹窗抽屉与手势交互；
 * 3. 场景化能力扩展：
 *    - type='idcard': 自动补齐 'X' 键，标题切换为“身份证键盘”；
 *    - type='discount': 自动解析 discounts 数组并在 #header 注入横向折扣胶囊快捷栏；
 *    - type='number': 标准数字键盘，支持自定义按键；
 * 4. 全事件与双向受控转发：100% 保持原有 v-model 与事件契约向下兼容。
 */

import { ref, computed, watch } from 'vue';
import type { PropType } from 'vue';
import type { CustomKeyboardProps, DiscountItem } from './constants.uts';

export type { CustomKeyboardProps, DiscountItem };

/**
 * 组件 Props 属性定义
 */
const props = defineProps({
	/** 键盘展示模式：popup（底部抽屉弹窗）或 page（嵌入文档流） */
	mode: {
		type: String,
		default: 'popup'
	},
	/** 键盘业务类型：number（普通数字）、idcard（身份证键盘）、discount（折扣键盘） */
	type: {
		type: String,
		default: 'number'
	},
	/** 双向绑定的输入值 */
	modelValue: {
		type: String,
		default: ''
	},
	/** 最大输入字符长度限制 */
	maxlength: {
		type: [Number, String],
		default: null
	},
	/** 控制弹窗显隐状态 (mode='popup' 时生效) */
	show: {
		type: Boolean,
		default: false
	},
	/** 折扣预设数组，如 [70, 75, 80, 85, 90] 分别对应 7折、7.5折、8折等 */
	discounts: {
		type: Array as PropType<number[]>,
		default: (): number[] => [] as number[]
	},
	/** 是否展示右侧确认与退格操作列 */
	rightKeys: {
		type: Boolean,
		default: true
	},
	/** 自定义补充按键数组（如 ['.']） */
	customKeys: {
		type: Array as PropType<string[]>,
		default: (): string[] => [] as string[]
	},
	/** 是否随机打乱数字按键布局（安全防窥键盘） */
	randomKeys: {
		type: Boolean,
		default: false
	},
	/** 确认操作按钮文案，默认为 '确定' */
	confirmText: {
		type: String,
		default: '确定'
	},
	/** 是否禁用确认按钮 */
	confirmDisabled: {
		type: Boolean,
		default: false
	},
	/** 是否展示清空按键 */
	showClear: {
		type: Boolean,
		default: true
	},
	/** 按键文本文字颜色 */
	textColor: {
		type: String,
		default: '#1f2329'
	},
	/** 按键文字字号大小 */
	textSize: {
		type: [Number, String],
		default: 48
	},
	/** 删除退格图标尺寸大小 */
	backspaceSize: {
		type: [Number, String],
		default: 48
	},
	/** 确认按钮背景颜色 */
	confirmBg: {
		type: String,
		default: ''
	},
	/** 确认按钮文字颜色 */
	confirmColor: {
		type: String,
		default: '#ffffff'
	},
	/** 普通按键背景颜色 */
	keyBg: {
		type: String,
		default: '#ffffff'
	},
	/** 键盘整体底层容器背景色 */
	background: {
		type: String,
		default: '#f2f3f5'
	},
	/** 多输入框联动引用标识 */
	activeInputRef: {
		type: String,
		default: ''
	},
	/** 多输入框键值映射字典 */
	inputValues: {
		type: Object as PropType<UTSJSONObject>,
		default: (): UTSJSONObject => ({}) as UTSJSONObject
	},
	/** 自定义最外层容器样式 */
	rootStyle: {
		type: Object as PropType<UTSJSONObject>,
		default: (): UTSJSONObject => ({}) as UTSJSONObject
	}
});

/**
 * 组件 Emits 事件声明
 */
const emit = defineEmits<{
	/** 双向绑定更新值事件 */
	(e: 'update:modelValue', value: string): void;
	/** 双向绑定弹窗显示状态事件 */
	(e: 'update:show', show: boolean): void;
	/** 多输入框映射更新事件 */
	(e: 'update:inputValues', values: UTSJSONObject): void;
	/** 输入值变更事件 */
	(e: 'change', value: string): void;
	/** 键入字符事件 */
	(e: 'input', value: string): void;
	/** 点击确认按钮事件 */
	(e: 'confirm', value: string): void;
	/** 点击清空按钮事件 */
	(e: 'clear'): void;
	/** 点击退格删除按钮事件 */
	(e: 'backspace'): void;
	/** 点击任意按键事件 */
	(e: 'click', key: string): void;
	/** 输入前拦截事件 */
	(e: 'beforeinput', key: string, suspend: () => void, next: () => void, stop: () => void): void;
	/** 弹窗打开事件 */
	(e: 'open'): void;
	/** 弹窗关闭事件 */
	(e: 'close'): void;
	/** 点击折扣胶囊标签事件 */
	(e: 'click-discount', key: string): void;
}>();

// ==================== 内部响应式状态 ====================

/** 当前绑定的输入值 */
const dataValue = ref(props.modelValue);
/** 当前弹窗展示状态 */
const dataShow = ref(props.show);

// ==================== 计算属性 ====================

/**
 * 根据键盘业务类型计算默认弹窗标题
 */
const computedTitle = computed((): string => {
	if (props.type === 'idcard') {
		return '身份证键盘';
	}
	if (props.type === 'discount') {
		return '折扣键盘';
	}
	return '数字键盘';
});

/**
 * 根据键盘类型计算实际传递给底层键盘的自定义按键列表
 */
const actualCustomKeys = computed((): string[] => {
	const list: string[] = [];
	if (props.customKeys != null) {
		for (let i = 0; i < props.customKeys!.length; i++) {
			list.push(props.customKeys![i]);
		}
	}
	// 身份证键盘自动追加 'X' 键
	if (props.type === 'idcard') {
		if (!list.includes('X')) {
			list.push('X');
		}
	}
	return list;
});

/**
 * 结构化解析折扣列表数据
 */
const discountList = computed((): DiscountItem[] => {
	const res: DiscountItem[] = [];
	if (props.discounts == null || props.discounts!.length === 0) {
		return res;
	}
	const arr = props.discounts!;
	for (let i = 0; i < arr.length; i++) {
		const v = arr[i];
		const n = Math.floor(v / 10);
		const d = v % 10;
		const text = d > 0 ? `${n}.${d}折` : `${n}折`;
		res.push({
			n: n,
			d: d,
			v: v,
			text: text
		} as DiscountItem);
	}
	return res;
});

/**
 * 折扣胶囊动态样式
 */
const cmpDiscountItemStyle = computed((): UTSJSONObject => {
	const style: UTSJSONObject = {};
	if (props.confirmBg != '') {
		style['backgroundColor'] = props.confirmBg;
	}
	return style;
});

// ==================== 事件转发与交互处理 ====================

function onModelValueUpdate(val: string) {
	dataValue.value = val;
	emit('update:modelValue', val);
}

function onShowUpdate(val: boolean) {
	dataShow.value = val;
	emit('update:show', val);
}

function onInputValuesUpdate(vals: UTSJSONObject) {
	emit('update:inputValues', vals);
}

function onChange(val: string) {
	emit('change', val);
}

function onInput(val: string) {
	emit('input', val);
}

function onConfirm(val: string) {
	emit('confirm', val);
}

function onClear() {
	emit('clear');
}

function onBackspace() {
	emit('backspace');
}

function onKeyClick(key: string) {
	emit('click', key);
}

function onBeforeInput(key: string, suspend: () => void, next: () => void, stop: () => void) {
	emit('beforeinput', key, suspend, next, stop);
}

function onOpen() {
	emit('open');
}

function onClose() {
	emit('close');
}

/**
 * 点击顶部折扣胶囊快捷按钮
 * @param item 选中的折扣实体
 */
function handleDiscountClick(item: DiscountItem) {
	emit('click', item.text);
	emit('click-discount', item.text);

	// 折扣值直接格式化并更新当前输入值
	const discountVal = item.d > 0 ? `${item.n}.${item.d}` : `${item.n}`;
	dataValue.value = discountVal;
	emit('update:modelValue', discountVal);
	emit('input', discountVal);
	emit('change', discountVal);
}

// ==================== 响应式监听 ====================

watch(
	(): string => props.modelValue,
	(val: string) => {
		dataValue.value = val;
	}
);

watch(
	(): boolean => props.show,
	(val: boolean) => {
		dataShow.value = val;
	}
);
</script>

<style>
/* 根容器 */
.ste-custom-keyboard-root {
	width: 100%;
}

/* 弹窗顶部标题文本 */
.ste-ck-title-text {
	font-size: 30rpx;
	font-weight: bold;
	color: #1f2329;
}

/* 折扣胶囊外层横向排布栏 */
.ste-ck-discount-bar {
	width: 100%;
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	padding-left: 12rpx;
	padding-right: 12rpx;
	padding-bottom: 16rpx;
}

/* 单个折扣胶囊按钮 */
.ste-ck-discount-item {
	min-width: 120rpx;
	padding-top: 8rpx;
	padding-bottom: 8rpx;
	padding-left: 20rpx;
	padding-right: 20rpx;
	margin-right: 16rpx;
	margin-bottom: 12rpx;
	border-radius: 8rpx;
	background-color: #0090ff;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}

/* 折扣整数数字 */
.ste-ck-discount-num {
	font-size: 28rpx;
	font-weight: bold;
	color: #ffffff;
}

/* 折扣小数部分 */
.ste-ck-discount-dot {
	font-size: 24rpx;
	font-weight: bold;
	color: #ffffff;
}

/* “折”字后缀文本 */
.ste-ck-discount-text {
	font-size: 22rpx;
	color: #ffffff;
	margin-left: 2rpx;
}
</style>
