<template>
	<view class="ste-date-picker-root">
		<ste-picker
			:columns="columns"
			:title="title"
			:showToolbar="showToolbar"
			:cancelText="cancelText"
			:cancelColor="cancelColor"
			:confirmText="confirmText"
			:confirmColor="cmpConfirmColor"
			:visibleItemCount="visibleItemCount"
			:defaultIndex="innerDefaultIndex"
			:itemHeight="itemHeight"
			@change="change"
			@cancel="cancel"
			@confirm="confirm"
			rootClass="ste-date-picker-view"
			v-if="show"
		></ste-picker>
	</view>
</template>

<script setup lang="uts">
import { ref, onMounted, nextTick, computed, watch } from 'vue'
import { useColorStore } from '../../store/color'

type DatePickerModeType = 'all' | 'datetime' | 'date' | 'year-month' | 'month-day' | 'time' | 'hour-minute' | 'minute-second'
type CloumnType = 'year' | 'month' | 'day' | 'hour' | 'minute' | 'second'

type DateParts = {
	year: number
	month: number
	day: number
	hour: number
	minute: number
	second: number
}

type BoundaryResult = {
	minYear: number
	minMonth: number
	minDate: number
	minHour: number
	minMinute: number
	minSecond: number
	maxYear: number
	maxMonth: number
	maxDate: number
	maxHour: number
	maxMinute: number
	maxSecond: number
}

type SteDatePickerProps = {
	showToolbar: boolean
	value: string | number
	title: string
	mode: string
	maxDate: number | string | Date
	minDate: number | string | Date
	filter: ((type: CloumnType, values: string[]) => string[]) | null
	formatter: ((type: CloumnType, value: string) => string) | null
	itemHeight: string | number
	cancelText: string
	confirmText: string
	cancelColor: string
	confirmColor: string
	visibleItemCount: string | number
}

const props = withDefaults(defineProps<SteDatePickerProps>(), {
	showToolbar: true,
	value: '',
	title: '',
	mode: 'all',
	maxDate: () => new Date(new Date().getFullYear() + 10, 11, 31, 23, 59, 59).getTime(),
	minDate: () => new Date(new Date().getFullYear() - 10, 0, 1).getTime(),
	filter: null,
	formatter: null,
	itemHeight: 43,
	cancelText: '取消',
	confirmText: '确认',
	cancelColor: '#969799',
	confirmColor: '',
	visibleItemCount: 5,
})

const emit = defineEmits<{
	(e: 'change', changeObj: UTSJSONObject): void
	(e: 'cancel'): void
	(e: 'confirm', value: string | number): void
	(e: 'update:value', value: string | number): void
}>()

const colorStore = useColorStore()
const getColor = colorStore.getColor

const cmpConfirmColor = computed(() : string => {
	return props.confirmColor != '' ? props.confirmColor : getColor().steThemeColor
})

const DEFAULT_DATE = new Date(1970, 0, 1, 0, 0, 0)

const padZero = (value: string | number) : string => {
	const str = '' + value
	if (str.length >= 2) return str
	return '0' + str
}

const times = (n: number, iteratee: (index: number) => string) : string[] => {
	const result: string[] = []
	for (let i = 0; i < n; i++) {
		result.push(iteratee(i))
	}
	return result
}

const columns = ref<string[][]>([])
const innerValue = ref<string | number>('')
const innerDefaultIndex = ref<number[]>([])
const show = ref(false)

const innerFormatter = (type: string, value: string) : string => value

const getDaysInMonth = (year: number, month: number) : number => {
	return new Date(year, month, 0).getDate()
}

const getDateParts = (timestamp: number | string | Date) : DateParts => {
	let date: Date
	if (typeof timestamp === 'number') {
		date = new Date(timestamp)
	} else if (typeof timestamp === 'string') {
		date = new Date(timestamp)
	} else {
		date = timestamp
	}
	return {
		year: date.getFullYear(),
		month: date.getMonth() + 1,
		day: date.getDate(),
		hour: date.getHours(),
		minute: date.getMinutes(),
		second: date.getSeconds(),
	}
}

const getTimestamp = (timestamp: number | string | Date) : number => {
	if (typeof timestamp === 'number') return timestamp
	if (typeof timestamp === 'string') return new Date(timestamp).getTime()
	return timestamp.getTime()
}

const correctValue = (value: string | number) : number => {
	let timestamp = 0
	if (typeof value === 'string') {
		if (value == '') {
			timestamp = new Date().getTime()
		} else {
			timestamp = new Date(value).getTime()
		}
	} else {
		timestamp = value
	}

	const minTimestamp = getTimestamp(props.minDate)
	const maxTimestamp = getTimestamp(props.maxDate)

	if (timestamp < minTimestamp) {
		return minTimestamp
	} else if (timestamp > maxTimestamp) {
		return maxTimestamp
	}
	return timestamp
}

const getBoundary = (type: 'min' | 'max', innerValue: number) : BoundaryResult => {
	const valueParts = getDateParts(innerValue)
	const boundaryParts = getDateParts(type == 'min' ? props.minDate : props.maxDate)

	const year = boundaryParts.year
	let month = 1
	let date = 1
	let hour = 0
	let minute = 0
	let second = 0

	if (type == 'max') {
		month = 12
		date = getDaysInMonth(valueParts.year, valueParts.month)
		hour = 23
		minute = 59
		second = 59
	}

	if (valueParts.year == year) {
		month = boundaryParts.month
		if (valueParts.month == month) {
			date = boundaryParts.day
			if (valueParts.day == date) {
				hour = boundaryParts.hour
				if (valueParts.hour == hour) {
					minute = boundaryParts.minute
					if (valueParts.minute == minute) {
						second = boundaryParts.second
					}
				}
			}
		}
	}

	return {
		minYear: type == 'min' ? year : 0,
		minMonth: type == 'min' ? month : 0,
		minDate: type == 'min' ? date : 0,
		minHour: type == 'min' ? hour : 0,
		minMinute: type == 'min' ? minute : 0,
		minSecond: type == 'min' ? second : 0,
		maxYear: type == 'max' ? year : 0,
		maxMonth: type == 'max' ? month : 0,
		maxDate: type == 'max' ? date : 0,
		maxHour: type == 'max' ? hour : 0,
		maxMinute: type == 'max' ? minute : 0,
		maxSecond: type == 'max' ? second : 0,
	}
}

type RangeResult = { type: CloumnType, range: number[] }

const getRanges = () : RangeResult[] => {
	const maxBoundary = getBoundary('max', innerValue.value as number)
	const minBoundary = getBoundary('min', innerValue.value as number)

	const minYear = minBoundary.minYear
	const minMonth = minBoundary.minMonth
	const minDate = minBoundary.minDate
	const minHour = minBoundary.minHour
	const minMinute = minBoundary.minMinute
	const minSecond = minBoundary.minSecond

	const maxYear = maxBoundary.maxYear
	const maxMonth = maxBoundary.maxMonth
	const maxDate = maxBoundary.maxDate
	const maxHour = maxBoundary.maxHour
	const maxMinute = maxBoundary.maxMinute
	const maxSecond = maxBoundary.maxSecond

	const result: RangeResult[] = [
		{ type: 'year', range: [minYear, maxYear] },
		{ type: 'month', range: [minMonth, maxMonth] },
		{ type: 'day', range: [minDate, maxDate] },
		{ type: 'hour', range: [minHour, maxHour] },
		{ type: 'minute', range: [minMinute, maxMinute] },
		{ type: 'second', range: [minSecond, maxSecond] },
	]

	let temp: RangeResult[] = []
	if (props.mode == 'datetime') {
		for (let i = 0; i < 5; i++) temp.push(result[i])
	} else if (props.mode == 'date') {
		for (let i = 0; i < 3; i++) temp.push(result[i])
	} else if (props.mode == 'year-month') {
		for (let i = 0; i < 2; i++) temp.push(result[i])
	} else if (props.mode == 'month-day') {
		for (let i = 1; i < 3; i++) temp.push(result[i])
	} else if (props.mode == 'time') {
		for (let i = 3; i < 6; i++) temp.push(result[i])
	} else if (props.mode == 'hour-minute') {
		for (let i = 3; i < 5; i++) temp.push(result[i])
	} else if (props.mode == 'minute-second') {
		for (let i = 4; i < 6; i++) temp.push(result[i])
	} else {
		temp = result
	}
	return temp
}

type OriginColumn = { type: CloumnType, values: string[] }

const getOriginColumns = () : OriginColumn[] => {
	const ranges = getRanges()
	const results: OriginColumn[] = []

	for (let i = 0; i < ranges.length; i++) {
		const range = ranges[i]
		const values = times(range.range[1] - range.range[0] + 1, (index: number) : string => {
			const value = '' + (range.range[0] + index)
			if (range.type == 'year') return value
			return padZero(value)
		})

		let finalValues = values
		if (props.filter != null) {
			finalValues = props.filter!(range.type, values)
		}
		results.push({ type: range.type, values: finalValues })
	}
	return results
}

const updateColumns = () => {
	const formatter = props.formatter != null ? props.formatter! : innerFormatter
	const originColumns = getOriginColumns()
	const result: string[][] = []

	for (let i = 0; i < originColumns.length; i++) {
		const column = originColumns[i]
		const columnValues: string[] = []
		for (let j = 0; j < column.values.length; j++) {
			columnValues.push(formatter(column.type, column.values[j]))
		}
		result.push(columnValues)
	}

	columns.value = result
	nextTick(() : void => {
		show.value = true
	})
}

const updateIndexs = () => {
	const value = innerValue.value as number
	const values: string[] = []
	const formatter = props.formatter != null ? props.formatter! : innerFormatter
	const parts = getDateParts(value)

	values.push(
		formatter('year', '' + parts.year),
		formatter('month', padZero(parts.month)),
		formatter('day', padZero(parts.day)),
		formatter('hour', padZero(parts.hour)),
		formatter('minute', padZero(parts.minute)),
		formatter('second', padZero(parts.second))
	)

	let startFlag = 0
	if (props.mode == 'month-day') {
		startFlag = 1
	} else if (props.mode == 'time' || props.mode == 'hour-minute') {
		startFlag = 3
	} else if (props.mode == 'minute-second') {
		startFlag = 4
	}

	const indexs: number[] = []
	for (let i = 0; i < columns.value.length; i++) {
		const column = columns.value[i]
		const targetValue = values[i + startFlag]
		let foundIndex = 0
		for (let j = 0; j < column.length; j++) {
			if (column[j] == targetValue) {
				foundIndex = j
				break
			}
		}
		indexs.push(foundIndex)
	}

	innerDefaultIndex.value = indexs
}

const updateColumnValue = (value: string | number) => {
	innerValue.value = value
	updateColumns()
	updateIndexs()
}

const init = () => {
	innerValue.value = correctValue(props.value)
	updateColumnValue(innerValue.value)
}

watch(() : string | number => props.value, () : void => {
	init()
})

const change = (e: UTSJSONObject) => {
	const indexs = e['indexs'] as number[]
	const values = e['values'] as string[][]

	let dateArr: number[] = [
		DEFAULT_DATE.getFullYear(),
		DEFAULT_DATE.getMonth() + 1,
		DEFAULT_DATE.getDate(),
		DEFAULT_DATE.getHours(),
		DEFAULT_DATE.getMinutes(),
		DEFAULT_DATE.getSeconds(),
	]

	let startFlag = 0
	if (props.mode == 'month-day') {
		startFlag = 1
	} else if (props.mode == 'time' || props.mode == 'hour-minute') {
		startFlag = 3
	} else if (props.mode == 'minute-second') {
		startFlag = 4
	}

	for (let i = 0; i < values.length; i++) {
		const value = values[i]
		const index = indexs[i]
		const selectedValue = value[index]
		const numValue = parseFloat(selectedValue)

		const pos = i + startFlag
		if (pos == 0) {
			dateArr[0] = numValue
		} else if (pos == 1) {
			dateArr[1] = numValue
		} else if (pos == 2) {
			dateArr[2] = numValue
		} else if (pos == 3) {
			dateArr[3] = numValue
		} else if (pos == 4) {
			dateArr[4] = numValue
		} else if (pos == 5) {
			dateArr[5] = numValue
		}
	}

	const maxDay = getDaysInMonth(dateArr[0], dateArr[1])
	dateArr[2] = Math.min(maxDay, dateArr[2])
	if (dateArr[2] == 0) dateArr[2] = 1

	const dateStr = `${dateArr[0]}/${padZero(dateArr[1])}/${padZero(dateArr[2])} ${padZero(dateArr[3])}:${padZero(dateArr[4])}:${padZero(dateArr[5])}`
	const selectValue = new Date(dateStr).getTime()

	updateColumnValue(selectValue)

	const changeObj = {
		value: selectValue,
		columnIndexs: indexs,
	} as UTSJSONObject
	emit('change', changeObj)
	emit('update:value', selectValue)
}

const cancel = () => {
	emit('cancel')
}

const confirm = () => {
	emit('confirm', innerValue.value)
}

onMounted(() : void => {
	init()
})
</script>

<style scoped>
.ste-date-picker-root {
	width: 100%;
}
</style>
