/**
 * ste-date-user 人员信息以及日期组件常量与类型定义
 * 
 * @description 提供了 ste-date-user 组件在 UTS 环境下的强类型支持，包括日历信息数据结构与组件 Props 定义。
 */

/**
 * 日期组件展示模式类型
 * - `date`: 日期展示模式（左侧当天号数，右侧年月与星期/节气）
 * - `user`: 人员信息模式（左侧头像，右侧昵称与自定义描述插槽）
 */
export type DateUserType = 'date' | 'user';

/**
 * 日历接口返回或本地兜底解析的数据结构
 */
export type DateCalendarData = {
    /** 完整的日期字符串，格式如 'YYYY-MM-DD' */
    today: string;
    /** 星期中文名称，如 '星期一'、'星期五' */
    weekDay: string;
    /** 农历节气或节日名称，如 '春分'、'中秋节'（可选） */
    jieQiName?: string;
};

/**
 * ste-date-user 组件属性定义
 */
export type DateUserProps = {
    /**
     * 组件业务类型
     * @default 'date'
     */
    type?: DateUserType;
    /**
     * 人员头像图片地址（type='user' 时生效）
     * @default ''
     */
    avatar?: string;
    /**
     * 人员姓名/昵称（type='user' 时生效）
     * @default ''
     */
    nickname?: string;
};
