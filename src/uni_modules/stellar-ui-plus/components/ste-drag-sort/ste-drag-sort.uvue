<template>
	<view
		class="ste-drag-sort-root"
		:class="{ 'ste-drag-sort-columns': _columns > 1, 'ste-drag-sort-root-dragging': dragging }"
		@touchmove.stop.prevent="onRootTouchMove"
		@touchend="onRootTouchEnd"
		@touchcancel="onRootTouchEnd"
	>
		<view
			v-for="(item, index) in dataList"
			:key="getItemKey(item)"
			class="ste-drag-sort-item"
			:class="getItemClass(index)"
			:style="getItemStyle(index)"
			@touchstart="onTouchStart($event as TouchEvent, index)"
			@longpress="handleLongPress($event as TouchEvent, index)"
		>
			<slot name="item" :item="item" :index="index" :dragging="dragging" :dragIndex="dragIndex" :insertIndex="insertIndex"></slot>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, watch, onMounted, getCurrentInstance } from 'vue'

	type DragSortProps = {
		modelValue ?: UTSJSONObject[],
		disabled ?: boolean,
		columns ?: number,
		longPress ?: boolean,
	}

	type ItemPosition = {
		top : number,
		left : number,
		width : number,
		height : number,
	}

	defineOptions({ name: 'ste-drag-sort', options: { virtualHost: true } })

	const props = defineProps<DragSortProps>()
	const emit = defineEmits(['update:modelValue', 'change', 'start', 'end'])

	const _disabled = computed(() : boolean => props.disabled == true)
	const _longPress = computed(() : boolean => props.longPress != false)
	const _columns = computed(() : number => {
		const v = props.columns != null ? props.columns! : 1
		return v > 0 ? v : 1
	})

	// 内部数据列表（每项有 uid）
	const dataList = ref<UTSJSONObject[]>([])
	// 拖拽状态
	const dragging = ref(false)
	const dragIndex = ref(-1)
	const insertIndex = ref(-1)
	const startX = ref(0)
	const startY = ref(0)
	const offsetX = ref(0)
	const offsetY = ref(0)
	const sortingStarted = ref(false)
	const finishing = ref(false)

	// 元素位置信息
	const itemPositions = ref<ItemPosition[]>([])
	const itemWidth = ref(0)
	const itemHeight = ref(0)

	let uidCounter = 0
	// 内部变更标记，防止 emit → watch → syncList 回环
	let internalChange = false
	// 防止 finishDrag 重复调用
	let finishLock = false

	// #ifdef MP-WEIXIN
	// 微信小程序需要组件实例用于 createSelectorQuery().in()
	const mpInstance = getCurrentInstance()
	// #endif

	// 同步外部 modelValue 到内部 dataList
	function syncList(value : UTSJSONObject[]) {
		const result : UTSJSONObject[] = []
		for (let i = 0; i < value.length; i++) {
			const raw = value[i]
			const uid = 'drag_' + uidCounter
			uidCounter++
			const item : UTSJSONObject = {}
			item['uid'] = uid
			// 复制 raw 的所有属性
			const rawMap = raw.toMap()
			// #ifdef APP-ANDROID || APP-IOS
			const iter = rawMap.keys.iterator()
			while (iter.hasNext()) {
				const key = iter.next()
				item[key] = rawMap[key]
			}
			// #endif
			// #ifdef H5 || MP-WEIXIN || MP-ALIPAY
			const keys = Object.keys(raw as Any)
			for (let j = 0; j < keys.length; j++) {
				const key = keys[j]
				item[key] = raw[key]
			}
			// #endif
			result.push(item)
		}
		dataList.value = result
	}

	// 初始化
	function initData() {
		const mv = props.modelValue != null ? props.modelValue! : [] as UTSJSONObject[]
		syncList(mv)
	}
	initData()

	// watch modelValue — 跳过内部触发的变更
	watch(() : UTSJSONObject[] | null => props.modelValue, (val : UTSJSONObject[] | null) => {
		if (internalChange) {
			internalChange = false
			return
		}
		if (val != null) {
			syncList(val)
		}
	})

	// 获取 v-for 列表项的 :key
	// 微信小程序下，dragging 切换时让 key 变化，强制 Vue 销毁旧 DOM 创建新 DOM
	// 等效于 .vue 中双 template v-if v-else 切换，规避 dataList 重排时 Vue key 协调错位
	function getItemKey(item : UTSJSONObject) : string {
		const uid = item['uid'] as string
		// #ifdef MP-WEIXIN
		return uid + (dragging.value ? '_d' : '_n')
		// #endif
		// #ifndef MP-WEIXIN
		return uid
		// #endif
	}

	function getItemDisabled(index : number) : boolean {
		if (index < 0 || index >= dataList.value.length) return true
		const item = dataList.value[index]
		const d = item['disabled']
		return d == true
	}

	// 获取所有未禁用项的索引
	function getEnabledIndices() : number[] {
		const result : number[] = []
		for (let i = 0; i < dataList.value.length; i++) {
			if (!getItemDisabled(i)) {
				result.push(i)
			}
		}
		return result
	}

	// 重排预览：返回 finalIndexMap（原始索引 → 新位置）和 nextEnabledSourceIndices（位置 → 原始索引）
	type ReorderPreview = {
		enabledIndices : number[],
		nextEnabledSourceIndices : number[],
		finalIndexMap : number[],  // finalIndexMap[原始索引] = 新位置
	}

	function getReorderPreview(dragIdx : number, targetIdx : number) : ReorderPreview | null {
		const enabledIndices = getEnabledIndices()
		const dragEnabledIndex = enabledIndices.indexOf(dragIdx)
		const targetEnabledIndex = enabledIndices.indexOf(targetIdx)

		if (dragEnabledIndex < 0 || targetEnabledIndex < 0) return null

		// nextEnabledSourceIndices: 从 enabledIndices 中移除 dragIdx，再在 targetEnabledIndex 位置插入
		// 手动构建数组（不用 splice，UTS 中 splice 不可靠）
		const removed : number[] = []
		for (let i = 0; i < enabledIndices.length; i++) {
			if (i != dragEnabledIndex) {
				removed.push(enabledIndices[i])
			}
		}
		const dragSource = enabledIndices[dragEnabledIndex]
		const nextEnabledSourceIndices : number[] = []
		for (let i = 0; i < targetEnabledIndex; i++) {
			nextEnabledSourceIndices.push(removed[i])
		}
		nextEnabledSourceIndices.push(dragSource)
		for (let i = targetEnabledIndex; i < removed.length; i++) {
			nextEnabledSourceIndices.push(removed[i])
		}

		// finalIndexMap: 原始索引 → 新位置
		const finalIndexMap : number[] = []
		for (let i = 0; i < dataList.value.length; i++) {
			finalIndexMap.push(i)
		}
		for (let orderIndex = 0; orderIndex < enabledIndices.length; orderIndex++) {
			const slotIndex = enabledIndices[orderIndex]
			const sourceIndex = nextEnabledSourceIndices[orderIndex]
			finalIndexMap[sourceIndex] = slotIndex
		}

		return {
			enabledIndices: enabledIndices,
			nextEnabledSourceIndices: nextEnabledSourceIndices,
			finalIndexMap: finalIndexMap,
		}
	}

	function getTranslateOffset(index : number) : ItemPosition {
		const zero : ItemPosition = { top: 0, left: 0, width: 0, height: 0 }
		if (!sortingStarted.value) return zero
		if (getItemDisabled(index)) return zero
		if (index == dragIndex.value) return zero
		if (dragIndex.value == insertIndex.value) return zero

		const reorderPreview = getReorderPreview(dragIndex.value, insertIndex.value)
		if (reorderPreview == null) return zero

		const preview = reorderPreview!
		const nextIndex = preview.finalIndexMap[index]
		if (nextIndex == index) return zero

		if (_columns.value > 1) {
			const cols = _columns.value
			const currentRow = Math.floor(index / cols)
			const currentCol = index % cols
			const nextRow = Math.floor(nextIndex / cols)
			const nextCol = nextIndex % cols
			return { top: (nextRow - currentRow) * itemHeight.value, left: (nextCol - currentCol) * itemWidth.value, width: 0, height: 0 }
		}

		return { top: (nextIndex - index) * itemHeight.value, left: 0, width: 0, height: 0 }
	}

	function getItemStyle(index : number) : UTSJSONObject {
		const style : UTSJSONObject = {}

		if (_columns.value > 1) {
			const w = `${100 / _columns.value}%`
			style['flexBasis'] = w
			style['width'] = w
			style['boxSizing'] = 'border-box'
		}

		// finishing 阶段：禁用 transition，让 item 瞬间到达新位置
		if (finishing.value) {
			style['transitionProperty'] = 'none'
		}

		if (!dragging.value) return style

		if (index == dragIndex.value) {
			const dragScale = sortingStarted.value ? 1.03 : 1.02
			style['transform'] = `translate(${offsetX.value}px, ${offsetY.value}px) scale(${dragScale})`
			style['zIndex'] = 100
			return style
		}

		const offset = getTranslateOffset(index)
		if (offset.left != 0 || offset.top != 0) {
			style['transform'] = `translate(${offset.left}px, ${offset.top}px)`
		}

		return style
	}

	function getItemClass(index : number) : string[] {
		const classes : string[] = []
		if (_disabled.value || getItemDisabled(index)) {
			classes.push('ste-drag-sort-item-disabled')
		}
		if (dragging.value && dragIndex.value == index && !sortingStarted.value) {
			classes.push('ste-drag-sort-item-ready')
		}
		if (dragging.value && dragIndex.value == index) {
			classes.push('ste-drag-sort-item-dragging')
		}
		if (dragging.value && dragIndex.value != index) {
			classes.push('ste-drag-sort-item-animating')
		}
		return classes
	}

	function triggerHaptic() {
		// uvue 不支持 uni.vibrateShort，移除
	}

	// 测量所有 item 的位置
	function measureItems() {
		const query = uni.createSelectorQuery()
		query.select('.ste-drag-sort-root').boundingClientRect((rootRect : any) => {
			const r = rootRect as NodeInfo
			if (r != null) {
				if (_columns.value > 1) {
					const rootW = r.width!
					const cols = _columns.value
					itemWidth.value = rootW / cols
				}
			}
		})
		query.selectAll('.ste-drag-sort-item').boundingClientRect((rects : any) => {
			const arr = rects as NodeInfo[]
			if (arr == null || arr.length == 0) return

			if (_columns.value <= 1) {
				itemWidth.value = arr[0].width!
			}
			itemHeight.value = arr[0].height!

			const positions : ItemPosition[] = []
			for (let i = 0; i < arr.length; i++) {
				const rect = arr[i]
				positions.push({
					top: rect.top!,
					left: rect.left!,
					width: rect.width!,
					height: rect.height!,
				})
			}
			itemPositions.value = positions
		})
		query.exec()
	}

	// #ifdef MP-WEIXIN
	// 微信小程序独立实现：需要 .in(mpInstance) 限定查询作用域到组件内（virtualHost）
	function measureItemsMP() {
		const query = uni.createSelectorQuery()
		if (mpInstance != null) {
			query.in(mpInstance as any)
		}
		query.select('.ste-drag-sort-root').boundingClientRect((rootRect : any) => {
			const r = rootRect as NodeInfo
			if (r != null) {
				if (_columns.value > 1) {
					const rootW = r.width!
					const cols = _columns.value
					itemWidth.value = rootW / cols
				}
			}
		})
		query.selectAll('.ste-drag-sort-item').boundingClientRect((rects : any) => {
			const arr = rects as NodeInfo[]
			if (arr == null || arr.length == 0) return

			if (_columns.value <= 1) {
				itemWidth.value = arr[0].width!
			}
			itemHeight.value = arr[0].height!

			const positions : ItemPosition[] = []
			for (let i = 0; i < arr.length; i++) {
				const rect = arr[i]
				positions.push({
					top: rect.top!,
					left: rect.left!,
					width: rect.width!,
					height: rect.height!,
				})
			}
			itemPositions.value = positions
		})
		query.exec()
	}
	// #endif

	// 跨平台调度：APP 走 measureItems，微信走 measureItemsMP
	function doMeasureItems() {
		// #ifdef APP-ANDROID || APP-IOS
		measureItems()
		// #endif
		// #ifdef MP-WEIXIN
		measureItemsMP()
		// #endif
	}

	function calculateInsertIndex() : number {
		if (dragIndex.value < 0) return dragIndex.value
		if (itemWidth.value <= 0 || itemHeight.value <= 0) return dragIndex.value

		const cols = _columns.value
		const dragRow = Math.floor(dragIndex.value / cols)
		const dragCol = dragIndex.value % cols

		if (cols > 1) {
			// 多列：用偏移量算移动了几个格子
			const dCol = Math.round(offsetX.value / itemWidth.value)
			const dRow = Math.round(offsetY.value / itemHeight.value)
			let targetCol = dragCol + dCol
			let targetRow = dragRow + dRow
			if (targetCol < 0) targetCol = 0
			if (targetCol >= cols) targetCol = cols - 1
			if (targetRow < 0) targetRow = 0

			let target = targetRow * cols + targetCol
			if (target >= dataList.value.length) {
				target = dataList.value.length - 1
			}
			// 跳过禁用项
			while (target > 0 && getItemDisabled(target)) {
				target--
			}
			return target
		}

		// 单列：用偏移量算移动了几个格子
		const dRow = Math.round(offsetY.value / itemHeight.value)
		let target = dragIndex.value + dRow
		if (target < 0) target = 0
		if (target >= dataList.value.length) {
			target = dataList.value.length - 1
		}
		return target
	}

	function checkMovedToOtherElement() : boolean {
		if (dragIndex.value < 0) return false
		if (itemWidth.value <= 0 || itemHeight.value <= 0) return false

		const cols = _columns.value
		if (cols > 1) {
			const dCol = Math.round(offsetX.value / itemWidth.value)
			const dRow = Math.round(offsetY.value / itemHeight.value)
			return dCol != 0 || dRow != 0
		}

		const dRow = Math.round(offsetY.value / itemHeight.value)
		return dRow != 0
	}

	function startDrag(index : number, clientX : number, clientY : number) {
		if (_disabled.value) return
		if (dragging.value) return
		if (finishLock) return
		if (index < 0 || index >= dataList.value.length) return
		if (getItemDisabled(index)) return

		dragging.value = true
		dragIndex.value = index
		insertIndex.value = index
		startX.value = clientX
		startY.value = clientY
		offsetX.value = 0
		offsetY.value = 0
		sortingStarted.value = false

		triggerHaptic()
		emit('start', index)

		// 延迟测量，等 DOM 更新
		setTimeout(() => {
			doMeasureItems()
		}, 50)
	}

	function moveDrag(clientX : number, clientY : number) {
		if (!dragging.value) return

		offsetX.value = clientX - startX.value
		offsetY.value = clientY - startY.value

		if (!sortingStarted.value && checkMovedToOtherElement()) {
			sortingStarted.value = true
		}

		if (sortingStarted.value) {
			insertIndex.value = calculateInsertIndex()
		}
	}

	function finishDrag() {
		if (!dragging.value) return
		if (finishLock) return
		finishLock = true

		const oldIndex = dragIndex.value
		const targetIndex = insertIndex.value >= 0 ? insertIndex.value : oldIndex
		const reorderPreview = getReorderPreview(oldIndex, targetIndex)
		const newIndex = reorderPreview != null ? reorderPreview!.finalIndexMap[oldIndex] : oldIndex
		const hasReorder = oldIndex != newIndex && oldIndex >= 0 && reorderPreview != null

		// 先算好 newList（在清状态之前，因为要用 reorderPreview）
		let newList : UTSJSONObject[] = []
		if (hasReorder && reorderPreview != null) {
			const preview = reorderPreview!
			const len = dataList.value.length
			for (let i = 0; i < len; i++) newList.push(dataList.value[i])
			for (let orderIndex = 0; orderIndex < preview.enabledIndices.length; orderIndex++) {
				const slotIndex = preview.enabledIndices[orderIndex]
				const sourceIndex = preview.nextEnabledSourceIndices[orderIndex]
				newList[slotIndex] = dataList.value[sourceIndex]
			}
		}

		// 第一步：先清所有拖拽状态 —— 这样 getItemStyle 不再计算 transform
		dragging.value = false
		dragIndex.value = -1
		insertIndex.value = -1
		sortingStarted.value = false
		offsetX.value = 0
		offsetY.value = 0
		startX.value = 0
		startY.value = 0

		// 第二步：如果有重排，禁用过渡 + 更新数据（同一 tick 内，Vue 批量渲染）
		if (hasReorder) {
			finishing.value = true
			dataList.value = newList
			internalChange = true
			emit('update:modelValue', newList)
			emit('change', newList)

			// 第三步：延迟恢复过渡（setTimeout 确保 DOM 重绘完成后）
			setTimeout(() => {
				finishing.value = false
				finishLock = false
			}, 50)
		} else {
			finishLock = false
		}

		emit('end', newIndex)
	}

	function onTouchStart(e : TouchEvent, index : number) {
		if (_longPress.value) return // 长按模式不响应 touchstart
		if (e.touches.length == 0) return
		const touch = e.touches[0]
		startDrag(index, touch.clientX, touch.clientY)
	}

	function onLongPress(e : TouchEvent, index : number) {
		if (!_longPress.value) return
		if (e.touches.length == 0) return
		const touch = e.touches[0]
		startDrag(index, touch.clientX, touch.clientY)
	}

	// #ifdef MP-WEIXIN
	// 微信小程序独立实现：longpress 事件 touches 可能为空，需回退到 changedTouches
	function onLongPressMP(e : TouchEvent, index : number) {
		if (!_longPress.value) return
		if (e.touches.length > 0) {
			const touch = e.touches[0]
			startDrag(index, touch.clientX, touch.clientY)
		} else if (e.changedTouches.length > 0) {
			const touch = e.changedTouches[0]
			startDrag(index, touch.clientX, touch.clientY)
		}
	}
	// #endif

	// 跨平台调度：APP 走 onLongPress，微信走 onLongPressMP
	function handleLongPress(e : TouchEvent, index : number) {
		// #ifdef APP-ANDROID || APP-IOS
		onLongPress(e, index)
		// #endif
		// #ifdef MP-WEIXIN
		onLongPressMP(e, index)
		// #endif
	}

	function onTouchMove(e : TouchEvent) {
		if (!dragging.value) return
		if (finishLock) return
		if (e.touches.length == 0) return
		const touch = e.touches[0]
		moveDrag(touch.clientX, touch.clientY)
	}

	function onRootTouchMove(e : TouchEvent) {
		onTouchMove(e)
	}

	function onTouchEnd() {
		finishDrag()
	}

	function onRootTouchEnd() {
		onTouchEnd()
	}
</script>

<style scoped>
.ste-drag-sort-root {
	position: relative;
	display: flex;
	flex-direction: column;
}

.ste-drag-sort-columns {
	flex-direction: row;
	flex-wrap: wrap;
}

.ste-drag-sort-item {
	position: relative;
	z-index: 10;
	transition-property: transform, opacity;
	transition-duration: 0.2s;
	transition-timing-function: ease;
}

.ste-drag-sort-item-dragging {
	opacity: 0.95;
	z-index: 20;
	transition-property: opacity;
	transition-duration: 0.12s;
}

.ste-drag-sort-item-ready {
	opacity: 0.98;
}

.ste-drag-sort-item-disabled {
	opacity: 0.6;
}
</style>
