<template>
	<view class="ste-drag-root">
		<view
			class="ste-drag-content"
			:style="cmpDragStyle"
			@touchstart="onTouchStart"
			@touchmove.stop.prevent="onTouchMove"
			@touchend="onTouchEnd"
			@touchcancel="onTouchEnd"
		>
			<slot></slot>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, watch, computed, onMounted, getCurrentInstance } from 'vue'

	type DragProps = {
		attract ?: boolean,
		direction ?: string,
		boundary ?: UTSJSONObject,
	}

	type PositionStatus = {
		isLeft : boolean,
		isRight : boolean,
		isTop : boolean,
		isBottom : boolean,
	}

	defineOptions({ name: 'ste-drag', options: { virtualHost: true } })

	const props = defineProps<DragProps>()
	const emit = defineEmits(['start', 'end'])

	const _attract = computed(() : boolean => props.attract == true)
	const _direction = computed(() : string => props.direction != null ? props.direction : 'all')

	// 拖拽容器（ste-drag-root）的尺寸
	const rootWidth = ref<number>(0)
	const rootHeight = ref<number>(0)
	// 可拖拽元素（ste-drag-content）的尺寸
	const elWidth = ref<number>(0)
	const elHeight = ref<number>(0)

	const startTop = ref<number>(0)
	const startLeft = ref<number>(0)
	const top = ref<number>(0)
	const left = ref<number>(0)
	const attractTransition = ref<boolean>(false)

	const _boundaryTop = ref<number>(0)
	const _boundaryLeft = ref<number>(0)
	const _boundaryRight = ref<number>(0)
	const _boundaryBottom = ref<number>(0)

	let isMove = false

	// 初始化 boundary
	function initBoundary() {
		const b = props.boundary != null ? props.boundary! : {} as UTSJSONObject
		const t = b['top']
		const l = b['left']
		const r = b['right']
		const bt = b['bottom']
		_boundaryTop.value = t != null ? t as number : 0
		_boundaryLeft.value = l != null ? l as number : 0
		_boundaryRight.value = r != null ? r as number : 0
		_boundaryBottom.value = bt != null ? bt as number : 0
	}
	initBoundary()

	watch(() : UTSJSONObject | null => props.boundary, (_ : UTSJSONObject | null) => {
		initBoundary()
	})

	// 获取容器与元素尺寸
	onMounted(() => {
		const query = uni.createSelectorQuery().in(getCurrentInstance() as any)
		query.select('.ste-drag-root').boundingClientRect((rootRect : any) => {
			const r = rootRect as NodeInfo
			if (r != null) {
				rootWidth.value = r.width!
				rootHeight.value = r.height!
			}
		}).exec()
		query.select('.ste-drag-content').boundingClientRect((contentRect : any) => {
			const c = contentRect as NodeInfo
			if (c != null) {
				elWidth.value = c.width!
				elHeight.value = c.height!
				// 如果有 boundary，初始位置使用 boundary.left/top，让元素一开始就在限制范围内
				if (_boundaryLeft.value > 0) left.value = _boundaryLeft.value
				if (_boundaryTop.value > 0) top.value = _boundaryTop.value
			}
		}).exec()
	})

	const cmpDragStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		style['transform'] = `translate(${left.value}px, ${top.value}px)`
		if (attractTransition.value) {
			style['transitionProperty'] = 'all'
			style['transitionDuration'] = '0.3s'
			style['transitionTimingFunction'] = 'ease'
		}
		return style
	})

	// 边界判断函数（提前定义）
	function getPositionStatus() : PositionStatus {
		return {
			isLeft: left.value <= _boundaryLeft.value,
			isRight: left.value + elWidth.value >= rootWidth.value - _boundaryRight.value,
			isTop: top.value <= _boundaryTop.value,
			isBottom: top.value + elHeight.value >= rootHeight.value - _boundaryBottom.value,
		}
	}

	// 吸边函数（提前定义）
	function attractFn() {
		if (!_attract.value || _direction.value == 'y') return
		if (elWidth.value == 0 || rootWidth.value == 0) return

		const centerX = left.value + elWidth.value / 2
		const rootCenter = rootWidth.value / 2

		if (centerX < rootCenter) {
			// 吸左边
			left.value = _boundaryLeft.value
		} else {
			// 吸右边
			left.value = rootWidth.value - elWidth.value - _boundaryRight.value
		}
		attractTransition.value = true
		emit('end', getPositionStatus())
		setTimeout(() => {
			attractTransition.value = false
		}, 400)
	}

	function onTouchStart(e : TouchEvent) {
		isMove = true
		emit('start')
		if (e.touches.length > 0) {
			const touch = e.touches[0]
			startLeft.value = touch.clientX - left.value
			startTop.value = touch.clientY - top.value
		}
		attractTransition.value = false
	}

	function onTouchMove(e : TouchEvent) {
		if (e.touches.length == 0) return
		const touch = e.touches[0]
		let newLeft = touch.clientX - startLeft.value
		let newTop = touch.clientY - startTop.value

		// 边界限制（相对 root 容器内部坐标）
		const maxLeft = rootWidth.value - elWidth.value - _boundaryRight.value
		const maxTop = rootHeight.value - elHeight.value - _boundaryBottom.value
		if (newLeft < _boundaryLeft.value) newLeft = _boundaryLeft.value
		if (newLeft > maxLeft) newLeft = maxLeft
		if (newTop < _boundaryTop.value) newTop = _boundaryTop.value
		if (newTop > maxTop) newTop = maxTop

		if (_direction.value != 'y') left.value = newLeft
		if (_direction.value != 'x') top.value = newTop
	}

	function onTouchEnd() {
		if (isMove && !_attract.value) {
			emit('end', getPositionStatus())
			isMove = false
		}
		attractFn()
	}
</script>

<style scoped>
.ste-drag-root {
	position: relative;
	width: 100%;
	height: 100%;
}
.ste-drag-content {
	position: absolute;
	left: 0;
	top: 0;
}
</style>
