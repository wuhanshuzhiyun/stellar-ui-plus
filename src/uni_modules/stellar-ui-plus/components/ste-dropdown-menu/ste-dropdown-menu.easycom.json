{
    "name": "ste-dropdown-menu",
    "description": "下拉菜单",
    "tutorial": "https://stellar-ui.intecloud.com.cn/?projectName=stellar-ui-plus&menu=%E7%BB%84%E4%BB%B6&active=ste-dropdown-menu",
    "attributes": [
        {
            "name": "title",
            "description": "菜单标题，未设置时会显示选中项的值",
            "type": "string"
        },
        {
            "name": "value",
            "description": "下拉菜单选中的值",
            "type": "string | array"
        },
        {
            "name": "inactiveColor",
            "description": "未选中颜色",
            "type": "string",
            "default": "#000000"
        },
        {
            "name": "activeColor",
            "description": "选中色",
            "type": "string",
            "default": "#0090FF"
        },
        {
            "name": "direction",
            "description": "展开方向",
            "type": "string",
            "default": "down",
            "values": [
                {
                    "name": "up",
                    "description": "向上展开"
                },
                {
                    "name": "down",
                    "description": "向下展开"
                }
            ]
        },
        {
            "name": "duration",
            "description": "展开动画执行时间",
            "type": "number",
            "default": "0.2"
        },
        {
            "name": "showMask",
            "description": "是否展示遮罩",
            "type": "boolean",
            "default": "true"
        },
        {
            "name": "isMaskClick",
            "description": "是否点击遮罩关闭",
            "type": "boolean",
            "default": "true"
        },
        {
            "name": "zIndex",
            "description": "弹窗层级z-index",
            "type": "number"
        },
        {
            "name": "offsetTop",
            "description": "菜单内容 top 值的偏移量；数值按 rpx 处理，也支持 px、rpx 单位字符串",
            "type": "string | number",
            "default": "0"
        },
        {
            "name": "type",
            "description": "下拉选项的形状",
            "type": "string",
            "default": "block",
            "values": [
                {
                    "name": "round",
                    "description": "圆形"
                },
                {
                    "name": "block",
                    "description": "块状"
                }
            ]
        },
        {
            "name": "max",
            "description": "可选数量",
            "type": "number",
            "default": "1"
        },
        {
            "name": "showPopup",
            "description": "是否显示菜单弹窗",
            "type": "boolean",
            "default": "false",
            "version": "1.21.0"
        },
        {
            "name": "modelValue",
            "description": "当前菜单选中值，支持 v-model[仅UVue支持]",
            "type": "string | number | Array<any>"
        },
        {
            "name": "dropDownIconColor",
            "description": "下拉箭头图标颜色[仅UVue支持]",
            "type": "string",
            "default": "#999999"
        },
        {
            "name": "[event]change",
            "description": "选项改变时触发",
            "params": [
                {
                    "name": "value",
                    "description": "选中的值"
                }
            ]
        },
        {
            "name": "[event]open",
            "description": "菜单打开",
            "params": [
                {
                    "name": "data",
                    "description": "() => void"
                }
            ]
        },
        {
            "name": "[event]close",
            "description": "菜单收起",
            "params": [
                {
                    "name": "data",
                    "description": "() => void"
                }
            ]
        },
        {
            "name": "[slot]default",
            "description": "内容插槽，用于承载 ste-dropdown-menu-item"
        },
        {
            "name": "[slot]title",
            "description": "自定义菜单标题插槽"
        },
        {
            "name": "[slot]icon",
            "description": "选中项对应的图标 (type 为 block 时生效)"
        },
        {
            "name": "[method]open",
            "description": "打开指定索引或当前下拉菜单",
            "params": [
                {
                    "name": "index",
                    "description": "需要打开的菜单索引（可选）"
                }
            ],
            "return": "void"
        },
        {
            "name": "[method]close",
            "description": "关闭当前展开的下拉菜单",
            "params": [],
            "return": "void"
        },
        {
            "name": "[event]item-choose",
            "description": "选中子项时触发",
            "params": [
                {
                    "name": "item",
                    "description": "选中项数据"
                }
            ]
        },
        {
            "name": "[event]maskClick",
            "description": "点击遮罩层时触发",
            "params": []
        }
    ],
    "uvue_diff": {
        "model_value": "UVue 端增加 modelValue 双向绑定与 dropDownIconColor 展开图标颜色定制"
    }
}
