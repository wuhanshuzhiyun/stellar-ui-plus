<template>
	<!-- 根容器：展开时提升层级，保持菜单栏明亮置顶 -->
	<view class="ste-dropdown-menu-root" :style="cmpRootStyle">
		<!-- 0. 菜单上方全屏占位点击层：覆盖屏幕顶部至菜单栏，点击拦截并自动收起当前菜单 -->
		<view
			v-if="showMenu || isAnimating"
			class="dropdown-placeholder"
			:style="cmpPlaceholderStyle"
			@click="close"
		/>

		<!-- 1. 菜单栏触发区：展示当前选中项标题或默认标题，附带旋转小箭头 -->
		<view
			:id="menuBarId"
			class="ste-dropdown-menu-bar"
			@click="handleMenuClick"
		>
			<slot name="title">
				<view class="menu-box">
					<text class="menu-title" :style="cmpTitleStyle">{{ displayTitle }}</text>
					<view class="menu-title-icon-wrap" :style="cmpIconWrapStyle">
						<ste-icon code="&#xe699;" :size="20" :color="dropDownIconColor" />
					</view>
				</view>
			</slot>
		</view>

		<!-- 2. 定向背景遮罩：独立兄弟节点，层级 zIndex - 1，仅覆盖菜单展开方向，绝不遮盖上方原生组件 -->
		<view
			v-if="showMenu || isAnimating"
			class="dropdown-mask-layer"
			:style="cmpMaskLayerStyle"
			@click="handleMaskClick"
		/>

		<!-- 3. 下拉菜单独立浮层：独立兄弟节点，层级 zIndex，位于遮罩上方 -->
		<view
			v-if="showMenu || isAnimating"
			class="dropdown-content-layer"
			:style="cmpContentLayerStyle"
		>
			<!-- 选项承载容器：执行滑入/滑出动画 -->
			<view
				class="menu-item-container"
				:class="[type == 'round' ? 'round-container' : 'block-container']"
				:style="cmpItemContainerStyle"
			>
				<slot />
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * @file ste-dropdown-menu.uvue
	 * @description DropdownMenu 下拉菜单容器组件 (uni-app x / UTS 版本)
	 * 采用精准坐标动态测量与“全屏遮罩 + 独立内容层”分层架构，支持单选/多选联动、列表与胶囊按钮排版、双向弹出与平滑过渡。
	 */

	import { provide, ref, computed, watch, onMounted, onUnmounted } from 'vue'
	import { useColorStore } from '../../store/color.uts'
	import {
		DROPDOWN_MENU_KEY,
		DropdownItemData,
		DropdownMenuContext,
		MenuRootQuery,
		DEFAULT_DURATION,
		MIN_DURATION,
		MAX_DURATION
	} from './constants.uts'

	/** 注入全局主题色状态 */
	const colorStore = useColorStore()

	/**
	 * 组件入参 Props 声明
	 */
	const props = withDefaults(
		defineProps<{
			/** 菜单标题，若未指定则自动跟随当前选中项的 title 变化 */
			title ?: string
			/** 绑定值 (兼容 value) */
			value ?: any
			/** 绑定值 (v-model 默认) */
			modelValue ?: any
			/** 未选中状态下的文字颜色，默认 #000000 */
			inactiveColor ?: string
			/** 选中高亮激活颜色，默认读取主题色 */
			activeColor ?: string
			/** 下拉菜单弹出方向：'down' 向下 (默认)，'up' 向上 */
			direction ?: string
			/** 动画过渡时长（秒），默认 0.2 */
			duration ?: number
			/** 是否展示背景半透明遮罩，默认 true */
			showMask ?: boolean
			/** 点击遮罩是否关闭弹窗，默认 true */
			isMaskClick ?: boolean
			/** 弹窗层级 z-index，默认 1000 */
			zIndex ?: number
			/** 菜单排版布局形式：'block' 列表模式 (默认)，'round' 胶囊按钮模式 */
			type ?: string
			/** 允许选中的最大项数，默认 1 (单选) */
			max ?: number
			/** 右侧小箭头图标颜色，默认 #bbbbbb */
			dropDownIconColor ?: string
			/** 弹窗显隐受控状态 */
			showPopup ?: boolean
			/** 菜单内容 top 值的偏移量；数值按 rpx 处理，也支持 px、rpx 单位字符串 */
			offsetTop ?: any
		}>(),
		{
			title: '',
			value: null,
			modelValue: null,
			inactiveColor: '#000000',
			activeColor: '',
			direction: 'down',
			duration: 0.2,
			showMask: true,
			isMaskClick: true,
			zIndex: 1000,
			type: 'block',
			max: 1,
			dropDownIconColor: '#bbbbbb',
			showPopup: false,
			offsetTop: 0
		}
	)

	/**
	 * 事件 Emits 声明
	 */
	const emits = defineEmits<{
		open: []
		close: []
		maskClick: []
		change: [value: string[]]
		'item-choose': [item: DropdownItemData]
		'update:modelValue': [value: any]
		'update:showPopup': [value: boolean]
	}>()

	/** 生成唯一节点 ID 用于精确测量矩形边界 */
	const menuBarId = ref<string>('ste-ddm-bar-' + Math.floor(Math.random() * 1000000).toString())

	/** 菜单展开显隐状态 */
	const showMenu = ref<boolean>(false)
	/** 动画过渡中状态（控制 DOM 销毁时机） */
	const isAnimating = ref<boolean>(false)
	/** 浮层内容透明度动画状态 */
	const contentOpacity = ref<number>(0)
	/** 浮层滑入位移 Y */
	const contentTranslateY = ref<string>('-100%')

	/** 测量得到的菜单栏在视窗中的坐标数据 */
	const menuQuery = ref<MenuRootQuery>({
		height: 0,
		left: 0,
		top: 0,
		bottom: 0
	} as MenuRootQuery)

	/** 动态计算的浮层内容顶部偏移 */
	const contentTop = ref<number>(0)

	/** 内部当前选中项集合（存字符串值） */
	const chooseItems = ref<string[]>([])

	/** 内部收集的子选项数据字典（用于根据选中项反查其 title 展示） */
	const registeredItems = ref<DropdownItemData[]>([])

	/** 规范化动画过渡时长 */
	const validDuration = computed((): number => {
		let d = props.duration
		if (d < MIN_DURATION) return MIN_DURATION
		if (d > MAX_DURATION) return MAX_DURATION
		return d
	})

	/** 定时器引用 */
	let animTimer: number | null = null

	/**
	 * 执行打开菜单动画（前置声明供 watch 及点击函数调用）
	 */
	function open() {
		if (animTimer != null) {
			clearTimeout(animTimer!)
			animTimer = null
		}
		isAnimating.value = true
		showMenu.value = true
		emits('open')
		emits('update:showPopup', true)

		// 触发微任务滑入动画
		setTimeout(() => {
			contentOpacity.value = 1
			contentTranslateY.value = '0%'
		}, 30)
	}

	/**
	 * 执行关闭菜单动画（前置声明供 watch 及外部调用）
	 */
	function close() {
		contentOpacity.value = 0
		if (props.direction == 'down') {
			contentTranslateY.value = '-100%'
		} else {
			contentTranslateY.value = '100%'
		}

		showMenu.value = false
		emits('close')
		emits('update:showPopup', false)

		if (animTimer != null) {
			clearTimeout(animTimer!)
		}
		animTimer = setTimeout(() => {
			isAnimating.value = false
			animTimer = null
		}, Math.floor(validDuration.value * 1000) + 50)
	}

	/**
	 * 将 offsetTop 属性安全转换为 px 数值
	 * @param val 传入的偏移量，支持数字 (默认按 rpx 处理) 或 'rpx'/'px' 字符串
	 * @return 转换后的 px 数值
	 */
	function parseOffsetPx(val: any): number {
		if (val == null) return 0.0
		if (typeof val === 'number') {
			return uni.rpx2px(val as number)
		}
		if (typeof val === 'string') {
			const s = (val as string).trim()
			if (s.endsWith('rpx')) {
				const num = parseFloat(s.slice(0, -3))
				return isNaN(num) ? 0.0 : uni.rpx2px(num)
			}
			if (s.endsWith('px')) {
				const num = parseFloat(s.slice(0, -2))
				return isNaN(num) ? 0.0 : num
			}
			const num = parseFloat(s)
			return isNaN(num) ? 0.0 : uni.rpx2px(num)
		}
		return 0.0
	}

	/**
	 * 测量菜单栏节点在视窗中的坐标并执行展开动画（前置声明供 watch 调用）
	 */
	function measureAndOpen() {
		const offset = parseOffsetPx(props.offsetTop)
		// 1. 安全定位兜底：确保即便异步测量延迟，浮层也有初始有效定位
		if (contentTop.value <= 0) {
			contentTop.value = 100 + offset
		}

		// 2. 立即触发展开动画
		open()

		// 3. 异步获取节点精确矩形边界以微调定位（不带无效的 .in(this)）
		const query = uni.createSelectorQuery()
		query.select('#' + menuBarId.value).boundingClientRect((res: any) => {
			if (res != null) {
				const node = res as NodeInfo

				menuQuery.value = {
					height: node.height ?? 0,
					left: node.left ?? 0,
					top: node.top ?? 0,
					bottom: node.bottom ?? 0
				} as MenuRootQuery

				if (props.direction == 'down') {
					contentTop.value = (node.bottom ?? 0) + offset
				} else {
					contentTop.value = (node.top ?? 0) + offset
				}
			}
		}).exec()
	}

	/**
	 * 同步外部 value / modelValue 赋值至内部 chooseItems
	 */
	function syncFromProps() {
		const target = props.value != null ? props.value : props.modelValue
		if (target == null) {
			chooseItems.value = []
			return
		}
		if (Array.isArray(target)) {
			const arr = target as any[]
			const res: string[] = []
			for (let i = 0; i < arr.length; i++) {
				const item = arr[i]
				if (item != null) res.push(item.toString())
			}
			chooseItems.value = res
		} else {
			chooseItems.value = [target.toString()]
		}
	}

	/**
	 * 点击菜单栏切换展开/收起
	 */
	function handleMenuClick() {
		if (!showMenu.value) {
			measureAndOpen()
		} else {
			close()
		}
	}

	/**
	 * 点击遮罩事件处理：点击任意空白处收起
	 */
	function handleMaskClick() {
		emits('maskClick')
		if (props.isMaskClick) {
			close()
		}
	}

	/**
	 * 子项点击选择事件流转
	 */
	function choose(item: DropdownItemData) {
		const val = item.value
		const maxCount = props.max < 1 ? 1 : props.max
		const current = chooseItems.value.slice()
		const idx = current.indexOf(val)

		if (idx > -1) {
			// 已选中项再次点击执行反选移除
			current.splice(idx, 1)
		} else {
			if (current.length < maxCount) {
				current.push(val)
			} else {
				if (maxCount == 1) {
					current.splice(0, current.length)
					current.push(val)
				} else {
					// 多选已满：移除最早的一项，压入新项
					current.shift()
					current.push(val)
				}
			}
		}

		chooseItems.value = current
		emits('item-choose', item)
		emits('change', current)

		// 单选或多选双向绑定同步
		if (maxCount == 1) {
			const resVal = current.length > 0 ? current[0] : ''
			emits('update:modelValue', resVal)
			// 单选模式下，选定即自动关闭收起
			close()
		} else {
			emits('update:modelValue', current)
			// 多选模式下，选满最大数量自动关闭收起
			if (current.length >= maxCount) {
				close()
			}
		}
	}

	/**
	 * 注册子项元数据
	 */
	function registerItem(item: DropdownItemData) {
		const list = registeredItems.value
		for (let i = 0; i < list.length; i++) {
			if (list[i].value == item.value) {
				list[i].title = item.title
				return
			}
		}
		list.push(item)
	}

	/**
	 * 销毁注销子项
	 */
	function unregisterItem(value: string) {
		const list = registeredItems.value
		for (let i = 0; i < list.length; i++) {
			if (list[i].value == value) {
				list.splice(i, 1)
				return
			}
		}
	}

	// 监听外部 value / modelValue
	watch(
		(): any => [props.modelValue, props.value],
		() => {
			syncFromProps()
		},
		{ immediate: true }
	)

	// 监听外部 showPopup 控制
	watch(
		(): boolean => props.showPopup,
		(val: boolean) => {
			if (val && !showMenu.value) {
				measureAndOpen()
			} else if (!val && showMenu.value) {
				close()
			}
		}
	)

	/** 计算实际生效的主题高亮颜色 */
	const themeActiveColor = computed((): string => {
		if (props.activeColor != '') {
			return props.activeColor
		}
		const theme = colorStore.getColor().steThemeColor
		return theme != '' ? theme : '#0090FF'
	})

	/**
	 * 计算菜单栏展示的最终标题
	 */
	const displayTitle = computed((): string => {
		if (props.title != '') {
			return props.title
		}
		// 若未指定 title，则查找当前首个选中项的 title 进行呈现
		if (chooseItems.value.length > 0) {
			const firstVal = chooseItems.value[0]
			for (let i = 0; i < registeredItems.value.length; i++) {
				const item = registeredItems.value[i]
				if (item.value == firstVal) {
					return item.title
				}
			}
		}
		return '请选择'
	})

	/** 菜单标题文本样式 */
	const cmpTitleStyle = computed((): UTSJSONObject => {
		const isSelected = chooseItems.value.length > 0
		return {
			color: isSelected ? themeActiveColor.value : props.inactiveColor
		}
	})

	/** 标题栏右侧小箭头旋转样式 */
	const cmpIconWrapStyle = computed((): UTSJSONObject => {
		let deg = 0
		if (props.direction == 'down') {
			deg = showMenu.value ? 180 : 0
		} else {
			deg = showMenu.value ? 0 : 180
		}
		return {
			transform: 'rotate(' + deg + 'deg)',
			transitionDuration: validDuration.value + 's'
		}
	})

	/** 根容器层级样式：展开时提升至遮罩之上，保持菜单栏明亮置顶 */
	const cmpRootStyle = computed((): UTSJSONObject => {
		const isOpened = showMenu.value || isAnimating.value
		return {
			position: 'relative',
			zIndex: isOpened ? (props.zIndex + 1) : 1
		}
	})

	/** 菜单上方占位层动态样式：覆盖屏幕顶部至菜单栏，拦截向上方向的点击并自动收起 */
	const cmpPlaceholderStyle = computed((): UTSJSONObject => {
		const winH = uni.getWindowInfo().windowHeight
		let topPx = '0px'
		let heightPx = '0px'

		if (props.direction == 'down') {
			// 向下展开：占位层覆盖视窗顶部 (0) 到菜单栏底部 (contentTop) 的全部区域
			topPx = '0px'
			heightPx = contentTop.value + 'px'
		} else {
			// 向上展开：占位层覆盖菜单栏底部到视窗底部的全部区域
			const bottomY = menuQuery.value.bottom > 0 ? menuQuery.value.bottom : contentTop.value
			topPx = bottomY + 'px'
			const h = winH > bottomY ? (winH - bottomY) : 0
			heightPx = h + 'px'
		}

		return {
			position: 'fixed',
			left: '0px',
			right: '0px',
			top: topPx,
			height: heightPx,
			zIndex: props.zIndex - 1
		}
	})

	/** 定向背景遮罩动态样式：仅覆盖菜单展开方向，绝不遮盖菜单栏与上方原生组件 */
	const cmpMaskLayerStyle = computed((): UTSJSONObject => {
		const bg = props.showMask ? 'rgba(0, 0, 0, 0.5)' : 'rgba(0, 0, 0, 0)'
		const winH = uni.getWindowInfo().windowHeight
		if (props.direction == 'down') {
			const top = contentTop.value
			const height = winH > top ? (winH - top) : 0
			return {
				position: 'fixed',
				left: '0px',
				right: '0px',
				top: top + 'px',
				height: height + 'px',
				backgroundColor: bg,
				zIndex: props.zIndex - 1,
				opacity: contentOpacity.value,
				transitionProperty: 'opacity',
				transitionDuration: validDuration.value + 's'
			}
		} else {
			return {
				position: 'fixed',
				left: '0px',
				right: '0px',
				top: '0px',
				height: contentTop.value + 'px',
				backgroundColor: bg,
				zIndex: props.zIndex - 1,
				opacity: contentOpacity.value,
				transitionProperty: 'opacity',
				transitionDuration: validDuration.value + 's'
			}
		}
	})

	/** 下拉内容独立浮层样式 */
	const cmpContentLayerStyle = computed((): UTSJSONObject => {
		if (props.direction == 'down') {
			return {
				position: 'fixed',
				left: '0px',
				right: '0px',
				top: contentTop.value + 'px',
				zIndex: props.zIndex,
				overflow: 'hidden'
			}
		} else {
			const winH = uni.getWindowInfo().windowHeight
			return {
				position: 'fixed',
				left: '0px',
				right: '0px',
				bottom: (winH - contentTop.value) + 'px',
				zIndex: props.zIndex,
				overflow: 'hidden'
			}
		}
	})

	/** 选项承载容器滑动动画样式 */
	const cmpItemContainerStyle = computed((): UTSJSONObject => {
		return {
			transform: 'translateY(' + contentTranslateY.value + ')',
			transitionProperty: 'transform',
			transitionDuration: validDuration.value + 's',
			transitionTimingFunction: 'ease-out'
		}
	})

	// 跨层级依赖注入上下文
	const menuContext: DropdownMenuContext = {
		getType: (): string => props.type,
		getDirection: (): string => props.direction,
		getActiveColor: (): string => themeActiveColor.value,
		getInactiveColor: (): string => props.inactiveColor,
		getChooseItems: (): string[] => chooseItems.value,
		getDuration: (): number => validDuration.value,
		choose: (item: DropdownItemData) => choose(item),
		registerItem: (item: DropdownItemData) => registerItem(item),
		unregisterItem: (val: string) => unregisterItem(val)
	}

	provide<DropdownMenuContext>(DROPDOWN_MENU_KEY, menuContext)

	// 对外暴露实例方法
	defineExpose({
		open,
		close
	})

	onUnmounted(() => {
		if (animTimer != null) {
			clearTimeout(animTimer!)
			animTimer = null
		}
	})
</script>

<style lang="scss">
	.ste-dropdown-menu-root {
		position: relative;
		width: 100%;
	}

	/* 菜单触发栏：添加实心背景，确保提升层级后不透底 */
	.ste-dropdown-menu-bar {
		padding: 20rpx 0;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		background-color: #ffffff;
	}

	.menu-box {
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.menu-title {
		font-size: 28rpx;
		margin-right: 12rpx;
	}

	.menu-title-icon-wrap {
		justify-content: center;
		align-items: center;
		transition-property: transform;
		transition-timing-function: linear;
	}

	/* 定向背景遮罩 */
	.dropdown-mask-layer {
		position: fixed;
	}

	/* 下拉内容独立浮层 */
	.dropdown-content-layer {
		position: fixed;
		left: 0;
		right: 0;
		overflow: hidden;
	}

	/* 选项承载容器 */
	.menu-item-container {
		width: 100%;
		background-color: #ffffff;
	}

	/* 列表排版容器 */
	.block-container {
		flex-direction: column;
	}

	/* 胶囊按钮排版容器 */
	.round-container {
		padding: 24rpx;
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: space-between;
		border-top: 1rpx solid #f2f2f2;
	}
</style>
