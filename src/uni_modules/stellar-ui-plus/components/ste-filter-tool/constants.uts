/**
 * ste-filter-tool 筛选选项组件常量与类型定义
 * 
 * @description 提供了 ste-filter-tool 组件在 UTS 环境下的强类型支持，包括各类筛选项结构、事件与数据定义。
 */

/**
 * 筛选控件分类模式
 * - `button`: 按钮网格模式（支持单选、多选、展开折叠、输入框）
 * - `checkbox`: 单选勾选列表模式（配合 ste-radio）
 * - `calendar`: 日历日期选择模式（嵌入 ste-calendar）
 */
export type FilterType = 'button' | 'checkbox' | 'calendar';

/**
 * 控件类型（分组内项类型）
 * - `button`: 标准按钮胶囊项
 * - `input`: 自定义输入框项
 */
export type FilterToolType = 'button' | 'input';

/**
 * 基础筛选项子项结构
 */
export type FilterChildItem = {
    /** 选项展示文本 */
    title: string;
    /** 选项实际值 */
    value: any;
    /** 是否当前激活选中（内部维护） */
    active?: boolean;
    /** 是否禁用该选项 */
    disabled?: boolean;
};

/**
 * 当分组类型为 input 时的配置项
 */
export type FilterItemConfig = {
    /** 输入框默认/当前值 */
    value?: string;
    /** 输入提示占位文案 */
    placeholder?: string;
    /** 最大输入字符长度 */
    maxLength?: number;
    /** 是否显示清空图标按钮 */
    clearable?: boolean;
    /** 控件宽度，如 '100%' 或 '300rpx' */
    width?: string;
};

/**
 * 筛选主分组结构
 */
export type FilterItem = {
    /** 分组标题 */
    title: string;
    /** 分组唯一标识 Key */
    key?: string;
    /** 兼容旧版标识，若无 key 时使用 value 作为 key */
    value?: any;
    /** 分组下的子选项数组 */
    children?: FilterChildItem[];
    /** 是否支持多选（button模式生效） */
    multiple?: boolean;
    /** 每一行展示的选项列数（支持 2, 3, 4，默认 3） */
    rowCount?: number;
    /** 是否展开全部（内部维护） */
    expand?: boolean;
    /** 折叠状态下默认展示的行数（0 或不填表示不折叠） */
    expandCount?: number;
    /** 项类型：button 或 input */
    type?: FilterToolType;
    /** 输入框配置（type='input' 时生效） */
    config?: FilterItemConfig;
    /** 是否启用随机流式布局（flex-wrap） */
    random?: boolean;
    /** checkbox 单选模式下的激活值（内部维护） */
    activeValue?: string;
};

/**
 * 筛选结果返回数据结构
 */
export type FilterValue = {
    /** 筛选项标题 */
    title?: string;
    /** 筛选项 key */
    key: string;
    /** 选中的值数组（单选也是单元素数组） */
    values: string[];
};

/**
 * 左侧分类栏数据结构
 */
export type CategoryItem = {
    /** 分类标题 */
    title: string;
    /** 分类唯一 Key */
    key: string;
    /** 绑定的值 */
    value?: any;
    /** 是否当前激活高亮 */
    active: boolean;
};
