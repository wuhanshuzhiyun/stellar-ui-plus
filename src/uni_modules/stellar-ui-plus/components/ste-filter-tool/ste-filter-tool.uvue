<template>
	<view class="ste-filter-tool--root" data-test="filter-tool">
		<!-- 下拉外层菜单与遮罩 -->
		<ste-dropdown-menu
			ref="steDropMenu"
			class="filter-box-menu"
			:activeColor="themeActiveColor"
			dropDownIconColor="#000000"
			:offsetTop="props.offsetTop"
			v-model:showPopup="showMenu"
			@maskClick="handleMaskClick"
		>
			<!-- 自定义外部 Trigger 按钮插槽 -->
			<template #title>
				<slot>
					<view class="default-trigger">
						<text class="trigger-text">筛选</text>
						<ste-icon code="&#xe6c7;" color="#000000" :size="24"></ste-icon>
					</view>
				</slot>
			</template>

			<!-- 内部展开的筛选内容面板（使用具名插槽支持自定义扩展，绝不被外部触发按钮的默认插槽覆盖） -->
			<view class="custom-menu-box">
				<slot name="content">
					<view class="menu-box" :class="menuBoxClasses">
					<!-- 1. 日历日期模式 -->
					<template v-if="props.filterType == 'calendar'">
						<ste-calendar
							:height="600"
							:width="750"
							:showConfirm="false"
							:show-title="false"
						/>
					</template>

					<!-- 2. 按钮与单选勾选模式 -->
					<template v-else>
						<!-- 左侧分类侧边栏 -->
						<scroll-view
							scroll-y="true"
							class="menu-category"
							:show-scrollbar="false"
							v-if="props.showCategory"
						>
							<view
								class="category-item"
								v-for="(item, index) in categoryData"
								:key="index"
								:class="{
									active: currentActiveIndex == index,
									next: currentActiveIndex == index - 1,
									prev: currentActiveIndex == index + 1
								}"
								@click="handleCategoryClick(index)"
							>
								<text
									class="category-text"
									:style="{
										color: currentActiveIndex == index ? themeActiveColor : '#888c92',
										fontWeight: currentActiveIndex == index ? 'bold' : 'normal'
									}"
								>{{ item.title }}</text>
							</view>
						</scroll-view>

						<!-- 右侧筛选项滚动区域 -->
						<scroll-view
							scroll-y="true"
							class="menu-items"
							:scroll-into-view="scrollTargetId"
							:scroll-with-animation="true"
							:show-scrollbar="false"
							@scroll="handleScroll"
						>
							<!-- A. 按钮胶囊网格模式 -->
							<template v-if="props.filterType == 'button'">
								<view
									class="menu-item-block"
									v-for="(item, index) in filtersData"
									:key="index"
									:id="'block_' + index"
								>
									<!-- 分组标题与展开折叠操作 -->
									<view class="menu-item-title">
										<text class="title-text">{{ item.title }}</text>
										<view
											v-if="(item.expandCount ?? 0) > 0"
											class="expand-btn"
											@click.stop="toggleExpand(item)"
										>
											<text class="expand-text">{{ item.expand == true ? '收起' : '展开' }}</text>
											<view class="expand-icon" :class="{ expanded: item.expand == true }">
												<ste-icon code="&#xe676;" color="#888c92" :size="20"></ste-icon>
											</view>
										</view>
									</view>

									<!-- 自定义输入框类型 -->
									<view v-if="item.type == 'input'" class="menu-item-input">
										<ste-input
											:fontSize="24"
											background="#F4F5F6"
											:modelValue="item.config?.value ?? ''"
											:placeholder="item.config?.placeholder ?? '请输入内容'"
											:maxlength="item.config?.maxLength ?? 100"
											:clearable="item.config?.clearable ?? false"
											@input="(val : any) => handleFilterItemInput(item, val)"
										/>
									</view>

									<!-- 标准选项网格流式布局 -->
									<view v-else class="menu-item-content">
										<view
											v-for="(child, childIndex) in getVisibleChildren(item)"
											:key="childIndex"
											class="menu-item-child"
											:style="getChildItemStyle(item, child)"
											@click="handleFilterItemClick(item, child)"
										>
											<text
												class="child-title"
												:style="getChildTextStyle(item, child)"
											>{{ child.title }}</text>
										</view>
									</view>
								</view>
							</template>

							<!-- B. 复选单选勾选模式 -->
							<template v-if="props.filterType == 'checkbox'">
								<view
									class="menu-item-checkbox"
									v-for="(child, index) in getCurrentCategoryChildren()"
									:key="index"
									@click="handleCheckboxItemClick(child)"
								>
									<text class="checkbox-label">{{ child.title }}</text>
									<view class="checkbox-action">
										<ste-radio
											:modelValue="getCurrentCategoryActiveValue()"
											:name="getChildValueStr(child)"
										/>
									</view>
								</view>
							</template>
						</scroll-view>
					</template>
				</view>
				</slot>

				<!-- 底部重置与确认操作栏 -->
				<view class="action-box">
					<view class="btn reset" @click="handleMenuReset">
						<text class="btn-text reset-text">重置</text>
					</view>
					<view
						class="btn confirm"
						:class="{ disabled: props.confirmDisabled }"
						:style="{ backgroundColor: props.confirmDisabled ? '#c8d9ff' : themeActiveColor }"
						@click="handleMenuConfirm"
					>
						<text class="btn-text confirm-text">确认</text>
					</view>
				</view>
			</view>
		</ste-dropdown-menu>
	</view>
</template>

<script setup lang="uts">
/**
 * ste-filter-tool 多维筛选工具组件
 * 
 * @description 支持按钮网格、单选勾选与日历三种筛选模式，实现左侧分类栏与右侧内容双向联动定位。
 * 兼容 uni-app x 原生弹性布局，消除对 CSS Grid 与 CSS 变量的依赖。
 */
import {
	FilterType,
	FilterItem,
	FilterChildItem,
	FilterValue,
	CategoryItem
} from './constants.uts';
import { useColorStore } from '../../store/color.uts';

/**
 * 组件属性定义
 */
const props = withDefaults(
	defineProps<{
		/**
		 * 当前选中的值数组
		 * @default []
		 */
		value?: FilterValue[];
		/**
		 * 激活高亮主题色
		 * @default ''
		 */
		activeColor?: string;
		/**
		 * 未激活项文字颜色
		 * @default '#555A61'
		 */
		inactiveColor?: string;
		/**
		 * 筛选控件类型：'button' | 'checkbox' | 'calendar'
		 * @default 'button'
		 */
		filterType?: FilterType;
		/**
		 * 筛选数据列表
		 * @default []
		 */
		data?: FilterItem[];
		/**
		 * 是否展示左侧分类栏
		 * @default true
		 */
		showCategory?: boolean;
		/**
		 * 是否禁用确认按钮
		 * @default false
		 */
		confirmDisabled?: boolean;
		/**
		 * 下拉菜单内容顶部偏移量，数值按 rpx 处理，也支持带单位字符串
		 * @default 0
		 */
		offsetTop?: any;
	}>(),
	{
		value: () : FilterValue[] => [] as FilterValue[],
		activeColor: '',
		inactiveColor: '#555A61',
		filterType: 'button' as FilterType,
		data: () : FilterItem[] => [] as FilterItem[],
		showCategory: true,
		confirmDisabled: false,
		offsetTop: 0
	}
);

/**
 * 事件发射器定义
 */
const emits = defineEmits<{
	(e : 'update:value', values : FilterValue[]) : void;
	(e : 'confirm', values : FilterValue[]) : void;
	(e : 'reset') : void;
	(e : 'itemClick', item : FilterValue) : void;
	(e : 'maskClose') : void;
}>();

/** 下拉菜单组件实例引用 */
const steDropMenu = ref<any | null>(null);

/** 是否展示下拉抽屉面板 */
const showMenu = ref<boolean>(false);

/** 当前选中的左侧分类索引 */
const currentActiveIndex = ref<number>(0);

/** 右侧滚动容器的目标锚点 ID（如 'block_0'） */
const scrollTargetId = ref<string>('');

/** 是否处于程序性滚动过程中（防止滚动事件反向修改分类索引） */
let isProgrammaticScrolling = false;
let scrollTimeoutId : number | null = null;

/** 内部管理的左侧分类列表数据 */
const categoryData = ref<CategoryItem[]>([]);

/** 内部管理的右侧筛选分组数据 */
const filtersData = ref<FilterItem[]>([]);

/** 主题色计算 */
const themeActiveColor = computed<string>(() : string => {
	if (props.activeColor != '') {
		return props.activeColor;
	}
	const storeColor = useColorStore().getColor();
	return storeColor.steThemeColor != '' ? storeColor.steThemeColor : '#0275FF';
});

/** 菜单面板样式类名 */
const menuBoxClasses = computed<string>(() : string => {
	const list : string[] = [];
	if (props.filterType == 'checkbox') {
		list.push('checkbox-mode');
	} else if (props.filterType == 'calendar') {
		list.push('calendar-mode');
	}
	return list.join(' ');
});

/**
 * 获取子选项根据折叠设置的展示列表
 * 
 * @param item 当前筛选分组
 */
function getVisibleChildren(item : FilterItem) : FilterChildItem[] {
	const children = item.children ?? [];
	const expandCount = item.expandCount ?? 0;
	if (expandCount <= 0 || item.expand == true) {
		return children;
	}
	const rowCount = item.rowCount ?? 3;
	const maxVisible = expandCount * rowCount;
	if (children.length > maxVisible) {
		return children.slice(0, maxVisible);
	}
	return children;
}

/**
 * 动态计算选项按钮的布局宽度与背景
 */
function getChildItemStyle(item : FilterItem, child : FilterChildItem) : any {
	const rowCount = item.rowCount ?? 3;
	let widthPercent = '30%';
	if (rowCount == 2) {
		widthPercent = '47%';
	} else if (rowCount == 4) {
		widthPercent = '22%';
	}

	const isAct = child.active == true;
	let bg = 'rgba(230, 232, 234, 0.5)';
	if (isAct) {
		if (item.multiple == true) {
			bg = 'rgba(2, 117, 255, 0.08)';
		} else {
			bg = themeActiveColor.value;
		}
	}

	return {
		width: widthPercent,
		backgroundColor: bg
	};
}

/**
 * 动态计算选项文字颜色
 */
function getChildTextStyle(item : FilterItem, child : FilterChildItem) : any {
	const isAct = child.active == true;
	let color = props.inactiveColor;
	if (isAct) {
		if (item.multiple == true) {
			color = themeActiveColor.value;
		} else {
			color = '#ffffff';
		}
	}
	return {
		color: color,
		fontWeight: isAct ? '500' : 'normal'
	};
}

/**
 * 获取当前激活分类的子项列表（checkbox模式）
 */
function getCurrentCategoryChildren() : FilterChildItem[] {
	if (currentActiveIndex.value >= 0 && currentActiveIndex.value < filtersData.value.length) {
		return filtersData.value[currentActiveIndex.value].children ?? [];
	}
	return [];
}

/**
 * 安全获取子项值的字符串表示
 */
function getChildValueStr(child : FilterChildItem) : string {
	return child.value != null ? `${child.value}` : '';
}

/**
 * 获取当前激活分类选中的值（checkbox模式）
 */
function getCurrentCategoryActiveValue() : string {
	if (currentActiveIndex.value >= 0 && currentActiveIndex.value < filtersData.value.length) {
		return filtersData.value[currentActiveIndex.value].activeValue ?? '';
	}
	return '';
}

/**
 * 根据外部传入的 FilterValue[] 更新组件内部各选项的选中状态
 */
function setValuesFromProps(values : FilterValue[]) {
	// 1. 重置所有选项
	for (let i = 0; i < filtersData.value.length; i++) {
		const f = filtersData.value[i];
		if (f.children != null) {
			for (let j = 0; j < f.children!.length; j++) {
				f.children![j].active = false;
			}
		}
		if (props.filterType == 'checkbox') {
			f.activeValue = '';
		}
	}

	// 2. 根据 values 匹配激活
	for (let v = 0; v < values.length; v++) {
		const valItem = values[v];
		for (let i = 0; i < filtersData.value.length; i++) {
			const f = filtersData.value[i];
			if (f.key == valItem.key) {
				if (props.filterType == 'checkbox') {
					if (valItem.values.length > 0) {
						f.activeValue = valItem.values[0];
					}
				} else {
					if (f.type == 'input' && f.config != null) {
						if (valItem.values.length > 0) {
							f.config!.value = valItem.values[0];
						}
					} else if (f.children != null) {
						for (let j = 0; j < f.children!.length; j++) {
							const c = f.children![j];
							const cValStr = c.value != null ? `${c.value}` : '';
							c.active = valItem.values.includes(cValStr);
						}
					}
				}
				break;
			}
		}
	}
}

/**
 * 初始化并同步外部 Props 数据
 */
function initializeData() {
	categoryData.value = [];
	filtersData.value = [];

	const rawData = props.data;
	for (let i = 0; i < rawData.length; i++) {
		const rawItem = rawData[i];
		const itemKey = (rawItem.key != null && rawItem.key != '')
			? rawItem.key!
			: (rawItem.value != null ? `${rawItem.value}` : `${i}`);

		// 克隆子项
		const childrenList : FilterChildItem[] = [];
		if (rawItem.children != null) {
			for (let j = 0; j < rawItem.children!.length; j++) {
				const c = rawItem.children![j];
				childrenList.push({
					title: c.title,
					value: c.value,
					active: c.active ?? false
				});
			}
		}

		// 构建筛选块对象
		const fItem : FilterItem = {
			title: rawItem.title,
			key: itemKey,
			value: rawItem.value,
			children: childrenList,
			multiple: rawItem.multiple ?? false,
			rowCount: rawItem.rowCount ?? 3,
			expand: rawItem.expand ?? false,
			expandCount: rawItem.expandCount ?? 0,
			type: rawItem.type ?? 'button',
			config: rawItem.config,
			random: rawItem.random ?? false,
			activeValue: rawItem.activeValue ?? ''
		};
		filtersData.value.push(fItem);

		// 构建分类项对象（显式声明类型）
		const catItem : CategoryItem = {
			title: rawItem.title,
			key: itemKey,
			value: rawItem.value,
			active: i == 0
		};
		categoryData.value.push(catItem);
	}

	// 同步外部已选中的值
	setValuesFromProps(props.value);
}

/**
 * 搜集当前全部选中的数据并封装成标准 FilterValue[] 结构
 */
function collectCurrentValues() : FilterValue[] {
	const results : FilterValue[] = [];

	for (let i = 0; i < filtersData.value.length; i++) {
		const item = filtersData.value[i];
		const itemKey = item.key ?? '';
		const selectedValues : string[] = [];

		if (props.filterType == 'checkbox') {
			if (item.activeValue != null && item.activeValue != '') {
				selectedValues.push(item.activeValue!);
			}
		} else {
			if (item.type == 'input') {
				if (item.config?.value != null && item.config!.value != '') {
					selectedValues.push(item.config!.value!);
				}
			} else if (item.children != null) {
				for (let j = 0; j < item.children!.length; j++) {
					const child = item.children![j];
					if (child.active == true) {
						selectedValues.push(child.value != null ? `${child.value}` : '');
					}
				}
			}
		}

		if (selectedValues.length > 0) {
			results.push({
				title: item.title,
				key: itemKey,
				values: selectedValues
			});
		}
	}

	return results;
}

/**
 * 触发当前选项点击与数据变更
 */
function updateAndEmitValues(item : FilterItem) {
	const currentValues = collectCurrentValues();
	emits('update:value', currentValues);

	// 找到当前变更的项
	for (let i = 0; i < currentValues.length; i++) {
		if (currentValues[i].key == item.key) {
			emits('itemClick', currentValues[i]);
			return;
		}
	}
}

/**
 * 处理左侧分类栏点击
 * 
 * @param index 选中的分类索引
 */
function handleCategoryClick(index : number) {
	currentActiveIndex.value = index;
	for (let i = 0; i < categoryData.value.length; i++) {
		categoryData.value[i].active = (i == index);
	}

	// 针对按钮模式触发滚动锚点定位
	if (props.filterType == 'button') {
		isProgrammaticScrolling = true;
		scrollTargetId.value = 'block_' + index;

		if (scrollTimeoutId != null) {
			clearTimeout(scrollTimeoutId!);
		}
		scrollTimeoutId = setTimeout(() => {
			isProgrammaticScrolling = false;
		}, 600);
	}
}

/**
 * 展开/收起切换
 */
function toggleExpand(item : FilterItem) {
	item.expand = !(item.expand == true);
	filtersData.value = filtersData.value.slice();
}

/**
 * 处理选项按钮点击
 */
function handleFilterItemClick(item : FilterItem, child : FilterChildItem) {
	if (child.disabled == true) {
		return;
	}
	if (item.multiple == true) {
		child.active = !(child.active == true);
	} else {
		// 单选
		if (item.children != null) {
			for (let i = 0; i < item.children!.length; i++) {
				item.children![i].active = false;
			}
		}
		child.active = true;
	}
	// 重新分配数组引用，主动通知 Vue 渲染引擎触发更新与重新计算样式
	filtersData.value = filtersData.value.slice();
	updateAndEmitValues(item);
}

/**
 * 处理单选勾选列表点击
 */
function handleCheckboxItemClick(child : FilterChildItem) {
	if (currentActiveIndex.value >= 0 && currentActiveIndex.value < filtersData.value.length) {
		const curItem = filtersData.value[currentActiveIndex.value];
		curItem.activeValue = child.value != null ? `${child.value}` : '';
		filtersData.value = filtersData.value.slice();
		updateAndEmitValues(curItem);
	}
}

/**
 * 处理输入框输入事件
 */
function handleFilterItemInput(item : FilterItem, val : any) {
	const strVal = val != null ? `${val}` : '';
	if (item.config != null) {
		item.config!.value = strVal;
	} else {
		item.config = { value: strVal };
	}
	filtersData.value = filtersData.value.slice();
	updateAndEmitValues(item);
}

/**
 * 重置全部筛选选择
 */
function handleMenuReset() {
	// 重置所有内部数据
	for (let i = 0; i < filtersData.value.length; i++) {
		const f = filtersData.value[i];
		if (f.children != null) {
			for (let j = 0; j < f.children!.length; j++) {
				f.children![j].active = false;
			}
		}
		if (f.config != null) {
			f.config!.value = '';
		}
		f.activeValue = '';
	}

	currentActiveIndex.value = 0;
	scrollTargetId.value = 'block_0';
	for (let i = 0; i < categoryData.value.length; i++) {
		categoryData.value[i].active = (i == 0);
	}

	// 触发响应式刷新
	filtersData.value = filtersData.value.slice();
	emits('update:value', [] as FilterValue[]);
	emits('reset');
	showMenu.value = false;
}

/**
 * 确认筛选
 */
function handleMenuConfirm() {
	if (props.confirmDisabled) {
		return;
	}
	const results = collectCurrentValues();
	emits('confirm', results);
	showMenu.value = false;
}

/**
 * 点击遮罩事件
 */
function handleMaskClick() {
	emits('maskClose');
}

/**
 * 右侧内容滚动监听
 */
function handleScroll(_e : UniScrollEvent) {
	if (isProgrammaticScrolling) {
		return;
	}
	// 在日常轻量级筛选中，scroll-into-view 和点击分类已满足主要联动需求
}

watch(
	() : FilterItem[] => props.data,
	(_newData : FilterItem[]) => {
		initializeData();
	},
	{ immediate: true }
);

watch(
	() : FilterValue[] => props.value,
	(newVal : FilterValue[]) => {
		if (newVal != null) {
			setValuesFromProps(newVal);
		}
	}
);

onMounted(() => {
	initializeData();
});

/**
 * 命令式关闭筛选菜单
 */
function closeMenu() {
	showMenu.value = false;
}

defineExpose({
	closeMenu
});
</script>

<style lang="scss" scoped>
.ste-filter-tool--root {
	width: 100%;

	.default-trigger {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 10rpx 0;

		.trigger-text {
			font-size: 24rpx;
			color: #1c1f23;
			margin-right: 8rpx;
		}
	}

	.custom-menu-box {
		background-color: #ffffff;
		padding-top: 24rpx;
		display: flex;
		flex-direction: column;

		.menu-box {
			width: 100%;
			height: 480rpx;
			min-height: 328rpx;
			max-height: 480rpx;
			display: flex;
			flex-direction: row;

			&.calendar-mode {
				height: 832rpx;
				max-height: 832rpx;
			}

			&.checkbox-mode {
				height: 410rpx;
				min-height: 410rpx;
				max-height: 410rpx;
			}

			.menu-category {
				width: 144rpx;
				height: 100%;
				background-color: #f4f5f6;
				display: flex;
				flex-direction: column;

				.category-item {
					padding: 24rpx 12rpx;
					display: flex;
					flex-direction: row;
					justify-content: center;
					align-items: center;
					background-color: #f4f5f6;

					&.active {
						background-color: #ffffff;
					}

					&.prev {
						border-bottom-right-radius: 16rpx;
					}

					&.next {
						border-top-right-radius: 16rpx;
					}

