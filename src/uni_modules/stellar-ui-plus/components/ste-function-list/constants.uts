/**
 * ste-function-list 功能列表组件常量与类型定义
 * 
 * @description 提供了 ste-function-list 组件在 UTS 环境下的强类型支持，包括功能项数据结构与事件参数定义。
 */

/**
 * 功能列表单个数据项结构
 */
export type FunctionListItem = {
    /** 标题文本 */
    title: string;
    /** 副标题说明文案 */
    subhead?: string;
    /** 底部状态标签文案（如 '当前不可取消'） */
    statusText?: string;
    /** 缩略图片地址 */
    image?: string;
    /** 操作按钮文案（如 '核销'） */
    buttonText?: string;
    /** 操作按钮图标代码 */
    buttonIcon?: string;
    /** 操作按钮背景色 */
    buttonBg?: string;
    /** 操作按钮文字颜色 */
    buttonColor?: string;
};

/**
 * 头部点击事件触发类型
 * - `empty`: 点击头部空白区域
 * - `title`: 点击主标题
 * - `subhead`: 点击副标题胶囊
 * - `more`: 点击右侧更多操作
 */
export type FunctionListHeaderClickType = 'empty' | 'title' | 'subhead' | 'more';

/**
 * 列表项点击事件触发类型
 * - `empty`: 点击列表项空白卡片
 * - `image`: 点击图片
 * - `title`: 点击标题
 * - `subhead`: 点击副标题
 * - `status`: 点击状态文本
 * - `button`: 点击操作按钮
 */
export type FunctionListItemClickType = 'empty' | 'image' | 'title' | 'subhead' | 'status' | 'button';

/**
 * 空状态点击事件触发类型
 * - `image`: 点击空状态图片
 * - `text`: 点击空状态文本
 * - `button`: 点击空状态按钮
 */
export type FunctionListEmptyClickType = 'image' | 'text' | 'button';
