<template>
	<view class="ste-function-list-root" :style="{ backgroundColor: props.background }" data-test="function-list">
		<!-- 1. 卡片头部栏 -->
		<view class="ste-function-list-header" @click="onClickHeader('empty')">
			<!-- 头部左侧：主标题与副标题胶囊 -->
			<view class="ste-function-list-header-l">
				<text class="ste-function-list-title" @click.stop="onClickHeader('title')">{{ props.title }}</text>
				<view class="ste-function-list-subhead" v-if="hasSubhead" @click.stop="onClickHeader('subhead')">
					<!-- @slot subhead 自定义副标题插槽 -->
					<slot name="subhead">
						<text class="subhead-text">{{ props.subhead }}</text>
					</slot>
				</view>
			</view>
			<!-- 头部右侧：更多操作按钮 -->
			<view class="ste-function-list-header-r">
				<!-- @slot header-right 自定义头部右侧操作区插槽 -->
				<slot name="header-right">
					<view class="ste-function-list-more" @click.stop="onClickHeader('more')">
						<text class="more-text">更多</text>
						<ste-icon code="&#xe674;" color="#353535" :size="22"></ste-icon>
					</view>
				</slot>
			</view>
		</view>

		<!-- 2. 内容数据展示区（有数据时） -->
		<view class="ste-function-list-content" v-if="props.data.length > 0">
			<!-- 横向横滑容器 -->
			<scroll-view
				direction="horizontal"
				class="content-scroll"
				:show-scrollbar="false"
			>
				<view class="content-row">
					<view
						class="content-list-item"
						:class="{ 'is-multiple': isMultiple, 'is-single': !isMultiple }"
						:style="{ backgroundColor: props.contentBg }"
						v-for="(item, index) in props.data"
						:key="index"
						@click="onClickItem('empty', item)"
					>
						<!-- 缩略配图 -->
						<view class="content-list-item-image" @click.stop="onClickItem('image', item)">
							<ste-image
								v-if="item.image != null && item.image != ''"
								:src="item.image!"
								mode="aspectFill"
								:width="140"
								:height="140"
							></ste-image>
							<view v-else class="empty-thumb"></view>
						</view>

						<!-- 右侧信息栏 -->
						<view class="content-list-item-info">
							<!-- 标题 -->
							<text class="info-title" @click.stop="onClickItem('title', item)">{{ item.title }}</text>
							<!-- 副标题 -->
							<text
								class="info-subhead"
								v-if="item.subhead != null && item.subhead != ''"
								@click.stop="onClickItem('subhead', item)"
							>{{ item.subhead }}</text>
							<!-- 底部状态与操作按钮 -->
							<view class="info-footer">
								<text class="info-status" @click.stop="onClickItem('status', item)">{{ item.statusText ?? '' }}</text>
								<view
									class="info-button-wrap"
									v-if="hasItemButton(item)"
									@click.stop="onClickItem('button', item)"
								>
									<ste-button
										:mode="100"
										:rootStyle="{ height: '56rpx' }"
										type="primary"
										:background="getItemBtnBg(item)"
										:color="getItemBtnColor(item)"
										@click="onClickItem('button', item)"
									>
										<ste-icon
											v-if="getItemBtnIcon(item) != ''"
											:code="getItemBtnIcon(item)"
											:color="getItemBtnColor(item)"
											:size="24"
											:fontFamily="props.fontFamily"
										></ste-icon>
										<text class="btn-inner-text" :style="{ color: getItemBtnColor(item) }">{{ getItemBtnText(item) }}</text>
									</ste-button>
								</view>
							</view>
						</view>
					</view>
				</view>
			</scroll-view>
		</view>

		<!-- 3. 空数据占位区（无数据时） -->
		<view class="ste-function-list-empty" :style="{ backgroundColor: props.contentBg }" v-else>
			<view class="empty-left" @click="onClickEmpty('image')" v-if="props.emptyImage != ''">
				<ste-image
					:src="props.emptyImage"
					:width="96"
					:height="96"
					mode="aspectFit"
				></ste-image>
			</view>
			<text class="empty-message" @click="onClickEmpty('text')">{{ props.emptyText }}</text>
			<view class="empty-btn-wrap" v-if="props.emptyButtonText != ''" @click="onClickEmpty('button')">
				<ste-button
					:mode="100"
					:rootStyle="{ height: '56rpx' }"
					type="primary"
					:background="props.buttonBg"
					:color="props.buttonColor"
					@click="onClickEmpty('button')"
				>
					<text class="btn-inner-text" :style="{ color: props.buttonColor }">{{ props.emptyButtonText }}</text>
				</ste-button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * ste-function-list 功能列表展示组件
 * 
 * @description 提供了横向横滑功能卡片展示，包含主标题、副标题胶囊、缩略图、状态标签及操作按钮，支持空数据占位。
 * 兼容 uni-app x 原生弹性布局，解耦 CSS 变量与 inline-flex 限制。
 */
import { FunctionListItem } from './constants.uts';

/**
 * 组件入参 Props 规范定义
 */
const props = withDefaults(
	defineProps<{
		/** 根卡片背景色 */
		background?: string;
		/** 内部内容卡片背景色 */
		contentBg?: string;
		/** 头部主标题 */
		title?: string;
		/** 头部副标题徽标说明 */
		subhead?: string;
		/** 列表核心数据源 */
		data?: FunctionListItem[];
		/** 默认操作按钮背景色 */
		buttonBg?: string;
		/** 默认操作按钮文字颜色 */
		buttonColor?: string;
		/** 默认操作按钮文案 */
		buttonText?: string;
		/** 默认操作按钮图标代码 */
		buttonIcon?: string;
		/** 空数据时显示的占位图片 */
		emptyImage?: string;
		/** 空数据时显示的说明文字 */
		emptyText?: string;
		/** 空数据时显示的引导操作按钮文字 */
		emptyButtonText?: string;
		/** 图标字体族名 */
		fontFamily?: string;
	}>(),
	{
		background: '#ffffff',
		contentBg: '#f9f9f9',
		title: '',
		subhead: '',
		data: () : FunctionListItem[] => [] as FunctionListItem[],
		buttonBg: '#EC3E1A',
		buttonColor: '#ffffff',
		buttonText: '',
		buttonIcon: '',
		emptyImage: '',
		emptyText: '',
		emptyButtonText: '',
		fontFamily: 'ste-iconfont-1709689042473'
	}
);

/**
 * 事件 Emits 声明
 */
const emits = defineEmits<{
	/** 点击头部区域时触发，type: 'empty' | 'title' | 'subhead' | 'more' */
	(e: 'click-header', type: string): void;
	/** 点击列表项内部各部位时触发，type: 'empty' | 'image' | 'title' | 'subhead' | 'status' | 'button' */
	(e: 'click-item', type: string, item: FunctionListItem): void;
	/** 点击空数据占位区域时触发，type: 'image' | 'text' | 'button' */
	(e: 'click-empty', type: string): void;
}>();

/** 是否具备副标题展示内容 */
const hasSubhead = computed<boolean>(() : boolean => {
	return props.subhead != '';
});

/** 数据项是否超过 1 条（用于确定卡片宽度与露出） */
const isMultiple = computed<boolean>(() : boolean => {
	return props.data.length > 1;
});

/**
 * 判断当前项是否展示操作按钮
 */
function hasItemButton(item : FunctionListItem) : boolean {
	const itemBtnText = item.buttonText != null ? item.buttonText! : '';
	const itemBtnIcon = item.buttonIcon != null ? item.buttonIcon! : '';
	return itemBtnText != '' || props.buttonText != '' || itemBtnIcon != '' || props.buttonIcon != '';
}

/**
 * 获取项操作按钮背景色
 */
function getItemBtnBg(item : FunctionListItem) : string {
	if (item.buttonBg != null && item.buttonBg != '') {
		return item.buttonBg!;
	}
	return props.buttonBg;
}

/**
 * 获取项操作按钮文字颜色
 */
function getItemBtnColor(item : FunctionListItem) : string {
	if (item.buttonColor != null && item.buttonColor != '') {
		return item.buttonColor!;
	}
	return props.buttonColor;
}

/**
 * 获取项操作按钮文案
 */
function getItemBtnText(item : FunctionListItem) : string {
	if (item.buttonText != null && item.buttonText != '') {
		return item.buttonText!;
	}
	return props.buttonText;
}

/**
 * 获取项操作按钮图标代码
 */
function getItemBtnIcon(item : FunctionListItem) : string {
	if (item.buttonIcon != null && item.buttonIcon != '') {
		return item.buttonIcon!;
	}
	return props.buttonIcon;
}

/** 点击头部处理 */
function onClickHeader(type : string) {
	emits('click-header', type);
}

/** 点击项内部区域处理 */
function onClickItem(type : string, item : FunctionListItem) {
	emits('click-item', type, item);
}

/** 点击空状态区域处理 */
function onClickEmpty(type : string) {
	emits('click-empty', type);
}
</script>

<style lang="scss" scoped>
.ste-function-list-root {
	padding: 24rpx 24rpx 20rpx 24rpx;
	border-radius: 12rpx;
	display: flex;
	flex-direction: column;

	.ste-function-list-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;

		.ste-function-list-header-l {
			display: flex;
			flex-direction: row;
			align-items: center;

			.ste-function-list-title {
				font-weight: bold;
				font-size: 32rpx;
				color: #000000;
			}

			.ste-function-list-subhead {
				display: flex;
				flex-direction: row;
				align-items: center;
				height: 44rpx;
				background-color: rgba(252, 222, 151, 0.23);
				border-radius: 22rpx;
				padding-left: 14rpx;
				padding-right: 14rpx;
				margin-left: 18rpx;

				.subhead-text {
					font-size: 24rpx;
					color: #ac7900;
					line-height: 44rpx;
				}
			}
		}

		.ste-function-list-header-r {
			display: flex;
			flex-direction: row;
			align-items: center;

			.ste-function-list-more {
				display: flex;
				flex-direction: row;
				align-items: center;

				.more-text {
					font-size: 24rpx;
					color: #353535;
					margin-right: 4rpx;
				}
			}
		}
	}

	.ste-function-list-content {
		width: 100%;
		margin-top: 24rpx;

		.content-scroll {
			width: 100%;
			display: flex;
			flex-direction: row;

			.content-row {
				display: flex;
				flex-direction: row;
				align-items: center;

				.content-list-item {
					display: flex;
					flex-direction: row;
					justify-content: space-between;
					align-items: center;
					border-radius: 12rpx;
					padding: 24rpx 20rpx 20rpx 20rpx;
					margin-right: 20rpx;

					&.is-single {
						width: 100%;
						margin-right: 0;
					}

					&.is-multiple {
						width: 580rpx;
					}

					.content-list-item-image {
						width: 140rpx;
						height: 140rpx;
						border-radius: 12rpx;
						overflow: hidden;
						background-color: #dddddd;
						display: flex;
						justify-content: center;
						align-items: center;

						.empty-thumb {
							width: 140rpx;
							height: 140rpx;
							background-color: #e5e6eb;
						}
					}

					.content-list-item-info {
						flex: 1;
						margin-left: 20rpx;
						display: flex;
						flex-direction: column;
						justify-content: space-between;
						height: 140rpx;

						.info-title {
							font-weight: bold;
							font-size: 28rpx;
							color: #000000;
							line-height: 40rpx;
							lines: 1;
							text-overflow: ellipsis;
						}

						.info-subhead {
							font-size: 24rpx;
							color: #757575;
							line-height: 34rpx;
							margin-top: 6rpx;
							lines: 1;
							text-overflow: ellipsis;
						}

						.info-footer {
							display: flex;
							flex-direction: row;
							align-items: center;
							justify-content: space-between;
							margin-top: 6rpx;

							.info-status {
								flex: 1;
								font-size: 24rpx;
								color: #757575;
								padding-right: 12rpx;
								lines: 1;
								text-overflow: ellipsis;
							}

							.info-button-wrap {
								display: flex;
								flex-direction: row;
								align-items: center;
							}
						}
					}
				}
			}
		}
	}

	.btn-inner-text {
		font-size: 24rpx;
		margin-left: 6rpx;
	}

	.ste-function-list-empty {
		width: 100%;
		height: 130rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		border-radius: 12rpx;
		padding: 0 20rpx;
		margin-top: 24rpx;

		.empty-left {
			width: 96rpx;
			height: 96rpx;
			display: flex;
			justify-content: center;
			align-items: center;
		}

		.empty-message {
			flex: 1;
			padding: 0 20rpx;
			lines: 1;
			text-overflow: ellipsis;
			font-size: 28rpx;
			color: #000000;
		}

		.empty-btn-wrap {
			display: flex;
			flex-direction: row;
			align-items: center;
		}
	}
}
</style>
