<template>
	<view class="ste-goods-info-root" :class="{ 'is-less': mode == 'less' }" :style="cmpRootStyle" data-test="goods-info">
		<!-- 核心内容详情区 -->
		<view class="ste-goods-info-details" :class="cmpDetailClasses">
			<!-- A. 左侧选择框 -->
			<view
				v-if="cmpMore && checkbox == 'left'"
				class="ste-goods-info-checkbox left-checkbox"
				@click="clickChecked"
			>
				<ste-checkbox
					:disabled="checkboxDisabled"
					:iconSize="30"
					:modelValue="_checked"
				/>
			</view>

			<!-- B. 中间商品主体视图（图片 + 信息区） -->
			<view class="ste-goods-info-view" @click="onClick('empty')">
				<!-- 商品主图 -->
				<view class="ste-goods-info-image" :style="cmpImageWrapperStyle" @click.stop="onClick('image')">
					<ste-image
						v-if="cmpMore"
						:radius="imageRadius"
						:src="goodsData.image ?? ''"
						:width="cmpImageWidth"
						:height="cmpImageHeight"
					/>
					<ste-image
						v-else
						:radius="imageRadius"
						:src="goodsData.image ?? ''"
						:width="176"
						:height="240"
					/>
				</view>

				<!-- 商品右侧信息流 -->
				<view class="ste-goods-info-content">
					<!-- 上部信息：标题、标签、编码、副标题 -->
					<view class="content-header">
						<view class="ste-goods-info-header">
							<view class="ste-goods-info-title-wrap" :style="titleStyle" @click.stop="onClick('title')">
								<!-- 标签徽标 -->
								<view class="ste-goods-info-tag" v-if="hasTag" :style="{ backgroundColor: tagBgColor }">
									<text class="tag-text">{{ goodsData.tag }}</text>
								</view>
								<text class="title-text">{{ goodsData.title ?? '' }}</text>
							</view>

							<!-- 右侧选择框 -->
							<view
								v-if="cmpMore && checkbox == 'right'"
								class="ste-goods-info-checkbox right-checkbox"
								@click="clickChecked"
							>
								<ste-checkbox
									:disabled="checkboxDisabled"
									:iconSize="30"
									:modelValue="_checked"
								/>
							</view>
						</view>

						<!-- 商品编码与条形码（仅 more 模式） -->
						<view
							class="ste-goods-info-codes"
							v-if="cmpMore && hasCodes"
							@click.stop="onClick('code')"
						>
							<text class="code-text" v-if="goodsData.code != null && goodsData.code != ''">{{ goodsData.code }}</text>
							<text class="code-divider" v-if="hasBothCodes">|</text>
							<text class="code-text" v-if="goodsData.barCode != null && goodsData.barCode != ''">{{ goodsData.barCode }}</text>
						</view>

						<!-- 自定义描述插槽或默认副标题 -->
						<slot>
							<text
								class="ste-goods-info-sub-title"
								v-if="goodsData.subTitle != null && goodsData.subTitle != ''"
							>{{ goodsData.subTitle }}</text>
						</slot>
					</view>

					<!-- 下部信息：价格、步进器与建议用量 -->
					<view class="content-footer">
						<!-- 价格与步进器行 -->
						<view class="ste-goods-info-price-row" v-if="showPriceRow">
							<!-- 现价与划线原价 -->
							<view class="price-left-box">
								<template v-if="!hidePrice">
									<view class="sale-price" @click.stop="onClick('price')">
										<ste-price
											:value="goodsData.price ?? 0"
											:digits="2"
											:bold="true"
											:styleType="3"
											:linePriceColor="priceColor"
											:fontSize="priceSize"
										/>
									</view>
									<view
										class="original-price"
										v-if="goodsData.originalPrice != null && goodsData.originalPrice != ''"
										@click.stop="onClick('originalPrice')"
									>
										<ste-price
											:value="goodsData.originalPrice"
											:digits="2"
											:isSuggestPrice="true"
											linePriceColor="#666666"
											:marginLeft="cmpMore ? 16 : 10"
											:fontSize="cmpMore ? 20 : 24"
											:showUnit="showOriginalUnit"
										/>
									</view>
								</template>
							</view>

							<!-- 右侧步进器或自定义插槽 -->
							<view class="price-right-box" @click.stop="onClick('stepper')">
								<!-- @slot stepper 自定义步进器区域插槽 -->
								<slot name="stepper">
									<view v-if="stepper" class="stepper-wrap" :class="{ 'is-readonly': readonlyStepper }">
										<ste-stepper
											v-model="_number"
											:precision="precision"
											:step="step"
											theme="line"
											:min="min"
											:max="max"
											btnSize="40"
											:disabled="disabledStepper"
											:disableInput="disableInput"
											:disablePlus="disablePlus"
											:disableMinus="disableMinus"
											:readonlyInput="readonlyStepperInput"
											@change="onNumberChange"
											@plus="onPlus"
											@minus="onMinus"
											@click-input="onClickStepperInput"
										/>
									</view>
								</slot>
							</view>
						</view>

						<!-- 建议用量与申请输入栏（仅 more 模式且有 suggestData 时） -->
						<view class="ste-goods-info-suggest" v-if="cmpMore && showSuggest">
							<!-- 左侧建议摘要按钮 -->
							<view class="suggest-method-btn" @click.stop="clickSuggest('method')">
								<view class="suggest-method-title">
									<text class="suggest-title-text">{{ curSuggestData.title ?? '建议' }}</text>
									<view class="suggest-title-icon-triangle" />
								</view>
								<text class="suggest-number-text">{{ curSuggestData.number ?? 0 }}</text>
							</view>

							<!-- 右侧申请输入栏 -->
							<view class="suggest-apply-for" v-if="hasApplyForText">
								<text class="apply-for-label">{{ curSuggestData.applyForText }}：</text>
								<view class="apply-for-number-box">
									<input
										class="apply-for-input"
										:class="{ 'is-readonly': readonlySuggestInput }"
										type="number"
										placeholder="请输入"
										placeholder-style="font-size:22rpx;color:#cccccc"
										:focus="applyForInputFocus"
										:value="applyForInputText"
										@input="onApplyForInput"
										@focus="onClickSuggestInput"
									/>
									<view class="apply-for-back-btn" @click.stop="clickSuggest('back')">
										<ste-icon code="&#xe632;" :size="16" color="#888c92" />
									</view>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>
		</view>

		<!-- C. 展开的建议明细面板（仅 more 模式且 showSuggestList=true） -->
		<view v-if="cmpMore && showSuggestList" class="ste-goods-info-suggest-list">
			<view class="suggest-list-card">
				<scroll-view direction="horizontal" class="suggest-items-scroll" :show-scrollbar="false">
					<view class="suggest-items-row">
						<template v-for="(item, index) in curSuggestData.items" :key="index">
							<view class="suggest-list-line" v-if="index > 0" />
							<view
								class="suggest-list-item"
								:style="getSuggestItemWidthStyle(curSuggestData.items.length)"
								@click="clickSuggestItem(item)"
							>
								<text class="suggest-item-label">{{ item.label }}</text>
								<text class="suggest-item-value">{{ item.value }}</text>
							</view>
						</template>
					</view>
				</scroll-view>
				<view class="suggest-right-arrow" @click="clickSuggest('right')">
					<ste-icon code="&#xe674;" :size="20" color="#888c92" />
				</view>
			</view>
		</view>

		<!-- D. 状态水印 -->
		<image
			v-if="cmpMore && watermark != ''"
			class="ste-goods-info-watermark"
			:style="watermarkStyle"
			:src="watermark"
		/>
	</view>
</template>

<script setup lang="uts">
/**
 * ste-goods-info 商品信息展示组件
 * 
 * @description 展示商品图文、价格、标签、编码、复选框、步进器与建议用量，支持门店与食堂两种模式。
 * 兼容 uni-app x 原生弹性盒布局，消除了对 CSS 动态变量与 calc 的依赖。
 */
import {
	GoodsInfoType,
	SuggestData,
	SuggestDataItem,
	GoodsInfoChangePayload,
	defaultSuggestData
} from './constants.uts';
import { useColorStore } from '../../store/color.uts';
import { formatPx } from '../../utils/utils.uts';

defineOptions({
	name: 'ste-goods-info'
});

/**
 * 组件入参 Props 规范定义
 */
const props = withDefaults(
	defineProps<{
		/** 商品核心数据 */
		data ?: GoodsInfoType;
		/** 展示模式：more-(门店)数据丰富，less-(食堂)数据精炼 */
		mode ?: string;
		/** 组件背景颜色 */
		background ?: string;
		/** 图片尺寸大小（rpx 或 px，默认 160） */
		imageSize ?: any;
		/** 图片圆角大小 */
		imageRadius ?: any;
		/** 是否隐藏价格行 */
		hidePrice ?: boolean;
		/** 价格文字字体大小 */
		priceSize ?: any;
		/** 价格文字颜色 */
		priceColor ?: string;
		/** 商品标签背景颜色（为空时跟随主题色） */
		tagBg ?: string;
		/** 标题自定义内联样式 */
		titleStyle ?: UTSJSONObject;
		/** 复选框位置：left | right | none */
		checkbox ?: string;
		/** 是否禁用复选框 */
		checkboxDisabled ?: boolean;
		/** 复选框选中状态 */
		checked ?: boolean;
		/** 水印图片地址 */
		watermark ?: string;
		/** 水印图片自定义样式 */
		watermarkStyle ?: UTSJSONObject;
		/** 步进器当前数量 */
		number ?: number;
		/** 是否展示步进器 */
		stepper ?: boolean;
		/** 步进器是否只读 */
		readonlyStepper ?: boolean;
		/** 步进器输入框是否只读 */
		readonlyStepperInput ?: boolean;
		/** 是否禁用步进器 */
		disabledStepper ?: boolean;
		/** 是否禁用步进器输入框 */
		disableInput ?: boolean;
		/** 是否禁用步进器增加按钮 */
		disablePlus ?: boolean;
		/** 是否禁用步进器减少按钮 */
		disableMinus ?: boolean;
		/** 步进器数值精度 */
		precision ?: number;
		/** 步进器调整步长 */
		step ?: number;
		/** 步进器允许的最小值 */
		min ?: number;
		/** 步进器允许的最大值 */
		max ?: number;
		/** 建议用量配置数据 */
		suggestData ?: SuggestData;
		/** 建议用量输入框是否只读 */
		readonlySuggestInput ?: boolean;
		/** 划线原价是否展示货币符号 */
		showOriginalUnit ?: boolean;
	}>(),
	{
		mode: 'more',
		background: '#ffffff',
		imageSize: 160,
		imageRadius: 4,
		hidePrice: false,
		priceSize: 28,
		priceColor: '#ea4335',
		tagBg: '',
		titleStyle: () : UTSJSONObject => ({} as UTSJSONObject),
		checkbox: 'none',
		checkboxDisabled: false,
		checked: false,
		watermark: '',
		watermarkStyle: () : UTSJSONObject => ({} as UTSJSONObject),
		number: 1,
		stepper: false,
		readonlyStepper: false,
		readonlyStepperInput: false,
		disabledStepper: false,
		disableInput: false,
		disablePlus: false,
		disableMinus: false,
		precision: 0,
		step: 1,
		min: 1,
		max: 9999,
		readonlySuggestInput: false,
		showOriginalUnit: false
	}
);

/**
 * 组件事件 Emits 规范定义
 */
const emits = defineEmits<{
	(e : 'update:number', value : number) : void;
	(e : 'update:checked', value : boolean) : void;
	(e : 'change', change : GoodsInfoChangePayload, data : GoodsInfoType) : void;
	(e : 'click', type : string) : void;
	(e : 'plus', value : any, suspend : () => void, next : () => void, stop : () => void) : void;
	(e : 'minus', value : any, suspend : () => void, next : () => void, stop : () => void) : void;
	(e : 'click-suggest', type : string, item ?: SuggestDataItem) : void;
	(e : 'click-suggest-input') : void;
	(e : 'click-stepper-input') : void;
}>();

const colorStore = useColorStore();

/**
 * 内部状态管理
 */
const _number = ref<number>(1);
const _checked = ref<boolean>(false);
const showSuggestList = ref<boolean>(false);
const applyForInputFocus = ref<boolean>(false);
const applyForInputText = ref<string>('');
const applyForNumberHistory = ref<number[]>([]);
const curSuggestData = ref<SuggestData>(defaultSuggestData());
let applyForHistoryTimer : number | null = null;
let backTriggerValue = -999999;

/**
 * 安全解析后的商品数据
 */
const goodsData = computed<GoodsInfoType>(() : GoodsInfoType => {
	if (props.data != null) {
		return props.data!;
	}
	return {} as GoodsInfoType;
});

/**
 * 是否为详细门店模式
 */
const cmpMore = computed<boolean>(() : boolean => {
	return props.mode != 'less';
});

/**
 * 根容器样式
 */
const cmpRootStyle = computed<UTSJSONObject>(() : UTSJSONObject => {
	return {
		backgroundColor: props.background
	} as UTSJSONObject;
});

/**
 * 详情容器样式类
 */
const cmpDetailClasses = computed<UTSJSONObject>(() : UTSJSONObject => {
	const hasCb = props.checkbox == 'left' || props.checkbox == 'right';
	return {
		'has-checkbox': hasCb,
		'checkbox-left': props.checkbox == 'left',
		'checkbox-right': props.checkbox == 'right'
	} as UTSJSONObject;
});

/**
 * 图片尺寸像素转换
 */
const cmpImageWidth = computed<any>(() : any => {
	if (!cmpMore.value) {
		return 176;
	}
	return props.imageSize;
});

const cmpImageHeight = computed<any>(() : any => {
	if (!cmpMore.value) {
		return 240;
	}
	return props.imageSize;
});

/**
 * 图片外层包装容器宽高样式
 */
const cmpImageWrapperStyle = computed<UTSJSONObject>(() : UTSJSONObject => {
	if (!cmpMore.value) {
		return {
			width: '176rpx',
			height: '240rpx'
		} as UTSJSONObject;
	}
	const sizeStr = formatPx(props.imageSize);
	return {
		width: sizeStr,
		height: sizeStr
	} as UTSJSONObject;
});

/**
 * 是否展示标签
 */
const hasTag = computed<boolean>(() : boolean => {
	return goodsData.value.tag != null && goodsData.value.tag != '';
});

/**
 * 标签背景色
 */
const tagBgColor = computed<string>(() : string => {
	if (props.tagBg != '') {
		return props.tagBg;
	}
	return colorStore.getColor().steThemeColor;
});

/**
 * 是否存在编码或条形码
 */
const hasCodes = computed<boolean>(() : boolean => {
	const c = goodsData.value.code;
	const b = goodsData.value.barCode;
	return (c != null && c != '') || (b != null && b != '');
});

/**
 * 是否同时存在编码与条形码
 */
const hasBothCodes = computed<boolean>(() : boolean => {
	const c = goodsData.value.code;
	const b = goodsData.value.barCode;
	return (c != null && c != '') && (b != null && b != '');
});

/**
 * 是否展示价格行
 */
const showPriceRow = computed<boolean>(() : boolean => {
	return props.stepper || !props.hidePrice;
});

/**
 * 是否存在建议用量数据
 */
const showSuggest = computed<boolean>(() : boolean => {
	return props.suggestData != null;
});

/**
 * 是否有申请数量提示文字
 */
const hasApplyForText = computed<boolean>(() : boolean => {
	const t = curSuggestData.value.applyForText;
	return t != null && t != '';
});

/**
 * 计算建议条目的宽度分配样式
 */
function getSuggestItemWidthStyle(itemCount : number) : UTSJSONObject {
	if (itemCount > 1) {
		const widthPct = (100.0 / itemCount).toFixed(2) + '%';
		return { width: widthPct } as UTSJSONObject;
	}
	return { width: '100%' } as UTSJSONObject;
}

/**
 * 监听 number 变化
 */
watch(
	() : number => props.number,
	(val : number) => {
		if (val < 1) {
			_number.value = 1;
		} else if (_number.value != val) {
			_number.value = val;
		}
	},
	{ immediate: true }
);

/**
 * 监听 checked 变化
 */
watch(
	() : boolean => props.checked,
	(val : boolean) => {
		if (val != _checked.value) {
			_checked.value = val;
		}
	},
	{ immediate: true }
);

/**
 * 监听 suggestData 变化
 */
watch(
	() : SuggestData | null => props.suggestData,
	(val : SuggestData | null) => {
		if (val != null) {
			curSuggestData.value = {
				title: val.title ?? '建议',
				number: val.number ?? 0,
				applyForText: val.applyForText,
				applyForNumber: val.applyForNumber,
				items: val.items != null ? val.items : ([] as SuggestDataItem[])
			} as SuggestData;
			applyForInputText.value = val.applyForNumber != null ? `${val.applyForNumber}` : '';
		} else {
			curSuggestData.value = defaultSuggestData();
			applyForInputText.value = '';
		}
	},
	{ immediate: true, deep: true }
);

/**
 * 监听 applyForNumber 变动并记录历史栈
 */
watch(
	() : number | null => curSuggestData.value.applyForNumber ?? null,
	(newVal : number | null, oldVal : number | null) => {
		if (newVal != null) {
			const payload = { applyForNumber: newVal } as GoodsInfoChangePayload;
			emits('change', payload, goodsData.value);

			if (newVal == backTriggerValue) {
				return;
			}
			if (oldVal != null && oldVal != newVal) {
				if (applyForHistoryTimer != null) {
					clearTimeout(applyForHistoryTimer!);
				}
				applyForHistoryTimer = setTimeout(() => {
					applyForNumberHistory.value.push(oldVal);
				}, 300);
			}
		}
	}
);

/**
 * 处理申请输入内容变更
 */
function onApplyForInput(e : UniInputEvent) {
	const str = e.detail.value;
	applyForInputText.value = str;
	if (str != '') {
		const num = parseFloat(str);
		if (!isNaN(num)) {
			curSuggestData.value.applyForNumber = num;
		}
	} else {
		curSuggestData.value.applyForNumber = null;
	}
}

/**
 * 复选框切换
 */
function clickChecked() {
	if (props.checkboxDisabled) {
		return;
	}
	_checked.value = !_checked.value;
	emits('update:checked', _checked.value);
	const payload = { checked: _checked.value } as GoodsInfoChangePayload;
	emits('change', payload, goodsData.value);
}

/**
 * 步进器值更新
 */
function onNumberChange(num : any) {
	const n = typeof num == 'number' ? (num as number) : parseInt(`${num}`);
	_number.value = n;
	emits('update:number', n);
	const payload = { number: n } as GoodsInfoChangePayload;
	emits('change', payload, goodsData.value);
}

/**
 * 步进器加操作
 */
function onPlus(val : any, suspend : () => void, next : () => void, stop : () => void) {
	emits('plus', val, suspend, next, stop);
}

/**
 * 步进器减操作
 */
function onMinus(val : any, suspend : () => void, next : () => void, stop : () => void) {
	emits('minus', val, suspend, next, stop);
}

/**
 * 步进器输入框点击
 */
function onClickStepperInput() {
	emits('click-stepper-input');
}

/**
 * 申请输入框点击唤起输入聚焦
 */
function onClickSuggestInput() {
	if (!hasApplyForText.value) {
		return;
	}
	emits('click-suggest-input');
	if (props.readonlySuggestInput) {
		return;
	}
	applyForInputFocus.value = false;
	setTimeout(() => {
		applyForInputFocus.value = true;
	}, 50);
}

/**
 * 区域通用点击
 */
function onClick(type : string) {
	emits('click', type);
	if (type == 'title' || type == 'code') {
		onClickSuggestInput();
	}
}

/**
 * 建议区域各类交互（单参数方法）
 */
function clickSuggest(type : string) {
	if (type == 'method') {
		showSuggestList.value = !showSuggestList.value;
	} else if (type == 'back') {
		if (applyForNumberHistory.value.length > 0) {
			const lastVal = applyForNumberHistory.value.pop()!;
			backTriggerValue = lastVal;
			curSuggestData.value.applyForNumber = lastVal;
			applyForInputText.value = `${lastVal}`;
		}
	}
	emits('click-suggest', type);
}

/**
 * 点击建议明细条目
 */
function clickSuggestItem(item : SuggestDataItem) {
	emits('click-suggest', 'item', item);
}
</script>

<style scoped>
/* 根容器 */
.ste-goods-info-root {
	width: 100%;
	position: relative;
	border-radius: 12rpx;
	overflow: hidden;
}

/* 详情主体布局 */
.ste-goods-info-details {
	width: 100%;
	padding: 24rpx 16rpx;
	display: flex;
	flex-direction: row;
	align-items: flex-start;
}

/* 带有复选框时的内边距调整 */
.has-checkbox.checkbox-left {
	padding-left: 8rpx;
}

.has-checkbox.checkbox-right {
	padding-right: 8rpx;
}

/* 复选框区域 */
.ste-goods-info-checkbox {
	width: 46rpx;
	padding: 8rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}

.left-checkbox {
	margin-right: 8rpx;
}

.right-checkbox {
	margin-left: 8rpx;
}

/* 中间商品主体视图：图片 + 信息 */
.ste-goods-info-view {
	flex: 1;
	display: flex;
	flex-direction: row;
	align-items: flex-start;
}

/* 图片容器 */
.ste-goods-info-image {
	flex-shrink: 0;
}

/* 信息展示容器 */
.ste-goods-info-content {
	flex: 1;
