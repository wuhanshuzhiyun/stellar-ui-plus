/**
 * ste-guide-qa 引导服务区/常见问答组件常量与类型定义
 * 
 * @description 提供了 ste-guide-qa 组件在 UTS 环境下的强类型支持，包括问答条目结构与点击事件类型。
 */

/**
 * 常见问答条目数据模型
 */
export type GuideQaItem = {
	/** 问题标题或提问内容 */
	question : string;
	/** 答案详情或解释说明文本 */
	answer : string;
};

/**
 * 问答条目点击事件区域类型
 * - `q`: 点击问题区域
 * - `a`: 点击答案区域
 */
export type GuideQaClickType = 'q' | 'a';
