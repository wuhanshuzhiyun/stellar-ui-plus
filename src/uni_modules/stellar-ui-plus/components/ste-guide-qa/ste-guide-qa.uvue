<template>
	<view class="ste-guide-qa-root" data-test="guide-qa">
		<!-- 模式一 (mode='1')：精炼摘要模式，展示标题栏、数量、全部按钮与首条问答 -->
		<view class="qa-box mode-1" v-if="props.mode == '1'">
			<!-- 标题与全部操作栏 -->
			<view class="title-box">
				<view class="title-left">
					<text class="title-text">{{ props.title }}</text>
					<text class="title-count" v-if="props.showNum">({{ props.data.length }})</text>
				</view>
				<view class="action-right" @click="handleActionClick">
					<text class="action-text">{{ props.actionTitle }}</text>
					<ste-icon code="&#xe674;" :size="24" color="#858585" />
				</view>
			</view>

			<!-- 首条问答展示（空安全防护） -->
			<view class="show-box" v-if="firstItem != null">
				<!-- 问题行 -->
				<view class="qa-item question-row">
					<view class="item-icon">
						<!-- @slot prefix-q 自定义问题前缀插槽 -->
						<slot name="prefix-q">
							<ste-image
								src="https://image.whzb.com/chain/StellarUI/image/guide-q.png"
								mode="widthFix"
								:width="32"
							/>
						</slot>
					</view>
					<text class="item-text question-text single-line">{{ firstItem!.question }}</text>
				</view>
				<!-- 答案行 -->
				<view class="qa-item answer-row">
					<view class="item-icon">
						<!-- @slot prefix-a 自定义答案前缀插槽 -->
						<slot name="prefix-a">
							<ste-image
								src="https://image.whzb.com/chain/StellarUI/image/guide-a.png"
								mode="widthFix"
								:width="32"
							/>
						</slot>
					</view>
					<text class="item-text answer-text single-line">{{ firstItem!.answer }}</text>
				</view>
			</view>
		</view>

		<!-- 模式二 (mode='2')：完整卡片流模式，展示全部问答列表并支持独立点击 -->
		<view class="qa-box mode-2" v-else>
			<view
				class="show-box card-box"
				v-for="(item, index) in props.data"
				:key="index"
			>
				<!-- 问题行（支持点击） -->
				<view class="qa-item question-row" @click="handleItemClick('q', item)">
					<view class="item-icon">
						<slot name="prefix-q">
							<ste-image
								src="https://image.whzb.com/chain/StellarUI/image/guide-q.png"
								mode="widthFix"
								:width="32"
							/>
						</slot>
					</view>
					<text class="item-text question-text mode2-question">{{ item.question }}</text>
				</view>
				<!-- 答案行（支持点击） -->
				<view class="qa-item answer-row" @click="handleItemClick('a', item)">
					<view class="item-icon">
						<slot name="prefix-a">
							<ste-image
								src="https://image.whzb.com/chain/StellarUI/image/guide-a.png"
								mode="widthFix"
								:width="32"
							/>
						</slot>
					</view>
					<text class="item-text answer-text">{{ item.answer }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * ste-guide-qa 引导服务区/常见问答组件
 * 
 * @description 展示常见问题与解答，支持简单摘要模式（带数量与全部跳转）与完整列表卡片模式（问题与答案独立点击）。
 * 遵循 uni-app x 原生规范，内置空安全防护。
 */
import { GuideQaItem } from './constants.uts';

defineOptions({
	name: 'ste-guide-qa'
});

/**
 * 组件入参 Props 规范定义
 */
const props = withDefaults(
	defineProps<{
		/** 问答数据列表 */
		data ?: GuideQaItem[];
		/** 显示模式：'1' - 简单摘要模式，'2' - 完整列表模式 */
		mode ?: string;
		/** 顶部标题文本 */
		title ?: string;
		/** 右侧操作按钮文本 */
		actionTitle ?: string;
		/** 是否展示问答数量统计 */
		showNum ?: boolean;
	}>(),
	{
		data: () : GuideQaItem[] => [] as GuideQaItem[],
		mode: '1',
		title: '常见问题',
		actionTitle: '全部',
		showNum: true
	}
);

/**
 * 组件事件 Emits 规范定义
 */
const emits = defineEmits<{
	(e : 'click-item', type : string, item : GuideQaItem) : void;
	(e : 'click-all') : void;
}>();

/**
 * 首条问答条目安全计算（防范空数组越界崩溃）
 */
const firstItem = computed<GuideQaItem | null>(() : GuideQaItem | null => {
	if (props.data.length > 0) {
		return props.data[0];
	}
	return null;
});

/**
 * 处理右上角“全部”操作点击
 */
function handleActionClick() {
	emits('click-all');
}

/**
 * 处理问答项点击
 * 
 * @param type 点击区域：'q'-问题，'a'-答案
 * @param item 当前问答条目
 */
function handleItemClick(type : string, item : GuideQaItem) {
	emits('click-item', type, item);
}
</script>

<style scoped>
/* 根容器 */
.ste-guide-qa-root {
	width: 100%;
}

/* 模式一容器卡片 */
.mode-1 {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 24rpx;
}

/* 模式二卡片流 */
.mode-2 .card-box {
	background-color: #ffffff;
	border-radius: 16rpx;
	padding: 24rpx;
	margin-bottom: 16rpx;
}

/* 标题栏布局 */
.title-box {
	margin-bottom: 24rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.title-left {
	flex: 1;
	display: flex;
	flex-direction: row;
	align-items: center;
}

.title-text {
	font-size: 32rpx;
	font-weight: bold;
	color: #1f2329;
	lines: 1;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.title-count {
	font-size: 32rpx;
	font-weight: bold;
	color: #1f2329;
	margin-left: 6rpx;
}

.action-right {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
}

.action-text {
	color: #858585;
	font-size: 28rpx;
	margin-right: 8rpx;
}

/* 问答条目布局 */
.qa-item {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
}

.item-icon {
	width: 32rpx;
	min-height: 40rpx;
	margin-right: 16rpx;
	flex-shrink: 0;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}

.item-text {
	flex: 1;
	font-size: 28rpx;
	line-height: 40rpx;
}

/* 问题行文字加粗 */
.question-text {
	font-weight: bold;
	color: #1f2329;
}

.mode2-question {
	font-size: 32rpx;
	line-height: 44rpx;
}

/* 答案行文字与间距 */
.answer-row {
	margin-top: 16rpx;
}

.answer-text {
	color: #666666;
}

/* 单行文本省略截断 */
.single-line {
	lines: 1;
	text-overflow: ellipsis;
	white-space: nowrap;
}
</style>
