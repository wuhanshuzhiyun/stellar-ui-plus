<template>
	<view class="ste-icon-root" :style="cmpRootStyle" @click="onClick">
		<text class="ste-icon-text" :style="cmpTextStyle">{{ cmpCode }}</text>
	</view>
</template>

<script setup lang="uts">
	import { computed, onMounted } from 'vue'
	import { addUnit } from '../../utils/utils.uts'
	import { normalizeFontSize } from '../../config/index.uts'

	type IconProps = {
		code ?: string,
		size ?: string | number,
		color ?: string,
		bold ?: boolean,
		marginLeft ?: string | number,
		marginRight ?: string | number,
		marginTop ?: string | number,
		marginBottom ?: string | number,
		fontFamily ?: string,
		showBorder ?: boolean,
		inlineBlock ?: boolean,
		rootStyle ?: UTSJSONObject,
	}

	defineOptions({ name: 'ste-icon', options: { virtualHost: true } })

	const props = defineProps<IconProps>()
	const emit = defineEmits(['click'])

	const defaultFontFamily = 'ste-iconfont-1709689042473'
	let fontLoaded = false

	// 加载字体（所有平台统一通过 uni.loadFontFace 加载）
	function loadFont() {
		if (fontLoaded) return
		uni.loadFontFace({
			family: defaultFontFamily,
			// 微信小程序要求 https，APP 也兼容
			source: 'https://at.alicdn.com/t/c/font_4457057_74vgslmjyas.ttf?t=1749781466318',
			global: true,
			success: () => {
				fontLoaded = true
			},
			fail: (err) => {
				console.error('字体加载失败:', err)
			}
		})
	}

	onMounted(() => {
		loadFont()
	})

	// 图标编码：处理 HTML 实体格式 &#xe6a0; / &#xe67a; 转为实际 Unicode 字符
	const cmpCode = computed(() : string => {
		const code = props.code
		if (code == null || code == '') return ''
		// 如果包含 &# 前缀，转换为 Unicode 字符
		if (code.indexOf('&#') >= 0) {
			let cleaned = code.replace('&#', '').replace(';', '').trim()
			let radix = 10
			if (cleaned.startsWith('x') || cleaned.startsWith('X')) {
				cleaned = cleaned.substring(1)
				radix = 16
			}
			const codePoint = parseInt(cleaned, radix)
			if (!isNaN(codePoint) && codePoint > 0) {
				return String.fromCharCode(codePoint)
			}
		}
		return code
	})

	// 字体大小：如果是数字则用 normalizeFontSize，否则用 addUnit
	const cmpFontSize = computed(() : string => {
		const size = props.size
		if (size == null) return normalizeFontSize(28)
		if (typeof size === 'number') {
			return normalizeFontSize(size as number)
		}
		const str = size as string
		// 纯数字字符串
		if (/^\d+\.?\d*$/.test(str) == true) {
			return normalizeFontSize(parseFloat(str))
		}
		// 已带单位
		return str
	})

	const _fontFamily = computed(() : string => {
		return props.fontFamily != null && props.fontFamily != '' ? props.fontFamily! : defaultFontFamily
	})

	// 容器样式
	const cmpRootStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		const display = props.inlineBlock == false ? 'flex' : 'flex'
		style['display'] = display
		style['flexDirection'] = 'row'
		style['justifyContent'] = 'center'
		style['alignItems'] = 'center'

		// margin
		const ml = props.marginLeft != null ? addUnit(props.marginLeft as any) : '0'
		const mr = props.marginRight != null ? addUnit(props.marginRight as any) : '0'
		const mt = props.marginTop != null ? addUnit(props.marginTop as any) : '0'
		const mb = props.marginBottom != null ? addUnit(props.marginBottom as any) : '0'
		style['marginLeft'] = ml
		style['marginRight'] = mr
		style['marginTop'] = mt
		style['marginBottom'] = mb

		// border
		if (props.showBorder == true) {
			style['borderWidth'] = '1px'
			style['borderColor'] = '#bbb'
			style['borderStyle'] = 'solid'
		}

		// rootStyle 覆盖
		if (props.rootStyle != null) {
			const rs = props.rootStyle!
			// #ifdef APP-ANDROID || APP-IOS
			const rsMap = rs.toMap()
			const iter = rsMap.keys.iterator()
			while (iter.hasNext()) {
				const key = iter.next()
				style[key] = rsMap[key]
			}
			// #endif
			// #ifdef H5 || MP-WEIXIN || MP-ALIPAY
			const keys = Object.keys(rs as Any)
			for (let i = 0; i < keys.length; i++) {
				const key = keys[i]
				style[key] = rs[key]
			}
			// #endif
		}

		return style
	})

	// 文本样式（字体相关属性必须放 text 上）
	const cmpTextStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		style['fontFamily'] = _fontFamily.value
		style['fontSize'] = cmpFontSize.value
		if (props.color != null && props.color != '') {
			style['color'] = props.color
		}
		if (props.bold == true) {
			style['fontWeight'] = 'bold'
		}
		// 行高等于字号实现居中
		style['lineHeight'] = cmpFontSize.value
		return style
	})

	function onClick() {
		emit('click')
	}
</script>

<style>
.ste-icon-root {
	position: relative;
}

.ste-icon-text {
	text-align: center;
}
</style>
