<template>
	<view class="ste-image-root" :style="[cmpStyle]">
		<view class="loading-icon" v-if="!hiddenLoading && status == 0">
			<slot name="loading">
				<ste-icon :code="loadingCode" :size="iconSize" color="#bbbbbb" />
			</slot>
		</view>

		<image class="content" :style="cmpContentStyle" :src="src" :mode="mode" :lazy-load="lazyLoad"
			:show-menu-by-longpress="showMenuByLongpress" @load="onLoadOver" @error="onFault"
			@click="onClick" />

		<view class="loading-icon" v-if="!hiddenError && status == 2">
			<slot name="error">
				<ste-icon :code="errorCode" :size="iconSize" color="#bbbbbb" />
			</slot>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, watch, onMounted } from 'vue'
	import { formatPx } from '../../utils/utils.uts'

	defineOptions({ name: 'ste-image', options: { virtualHost: true } })

	type ImageProps = {
		src ?: string,
		width ?: number | string,
		height ?: number | string,
		radius ?: number | string,
		mode ?: string,
		display ?: string,
		hiddenLoading ?: boolean,
		hiddenError ?: boolean,
		showMenuByLongpress ?: boolean,
		lazyLoad ?: boolean,
	}

	const props = withDefaults(defineProps<ImageProps>(), {
		src: '',
		width: '100%',
		height: '100%',
		radius: 0,
		mode: 'scaleToFill',
		display: 'inline-flex',
		hiddenLoading: false,
		hiddenError: false,
		showMenuByLongpress: false,
		lazyLoad: false,
	})

	const emit = defineEmits(['click', 'load', 'error'])

	// 0:loading 1:success 2:fail
	const status = ref<number>(0)
	const iconSize = ref<number>(50)
	const initializing = ref<boolean>(true)

	const loadingCode = '&#xe693;'
	const errorCode = '&#xe692;'

	const cmpStyle = computed(() : UTSJSONObject => {
		let width = formatPx(props.width as number | string)
		let height = formatPx(props.height as number | string)
		const mode = props.mode
		if (mode == 'widthFix') {
			if (status.value != 1) {
				height = width
			} else {
				height = 'auto'
			}
		} else if (mode == 'heightFix') {
			if (status.value != 1) {
				width = height
			} else {
				width = 'auto'
			}
		}
		return {
			width: width,
			height: height,
			display: props.display,
			borderRadius: formatPx(props.radius as number | string),
			backgroundColor: status.value == 1 ? 'none' : 'rgba(127,127,127,.05)',
		}
	})

	const cmpContentStyle = computed(() : UTSJSONObject => {
		return { opacity: status.value == 1 ? '1' : '0' }
	})

	watch(() : string => props.src, (_newVal : string) : void => {
		status.value = 0
		initializing.value = true
	})

	const onLoadOver = (e : any) => {
		initializing.value = false
		if (status.value != 1) status.value = 1
		emit('load', e)
	}

	const onFault = (e ?: any) => {
		if (status.value != 2) status.value = 2
		emit('error', e)
	}

	const onClick = (e : any) => {
		emit('click', e)
	}

	function initIconSize() {
		try {
			const wStr = '' + props.width
			const wNum = parseFloat(wStr)
			const w = isNaN(wNum) ? 100 : wNum
			const hStr = '' + props.height
			const hNum = parseFloat(hStr)
			const h = isNaN(hNum) ? 100 : hNum
			const size = w <= h ? w : h
			if (size <= 30) iconSize.value = 24
			else if (size <= 50) iconSize.value = 40
			else if (size <= 100) iconSize.value = 60
			else if (size <= 150) iconSize.value = 100
			else iconSize.value = 140
		} catch (err) {
			iconSize.value = 50
		}
	}

	onMounted(() => {
		initIconSize()
	})
</script>

<style>
	.ste-image-root {
		justify-content: center;
		align-items: center;
		overflow: hidden;
		position: relative;
	}

	.content {
		width: 100%;
		height: 100%;
	}

	.loading-icon {
		position: absolute;
		z-index: 2;
	}
</style>
