{
    "name": "ste-index-item",
    "description": "索引列表分组项组件，承载单个分组（如 A、B、C）的标题与行数据列表。",
    "tutorial": "https://stellar-ui.intecloud.com.cn/?projectName=stellar-ui-plus&menu=%E7%BB%84%E4%BB%B6&active=ste-index-list",
    "attributes": [
        {
            "name": "title",
            "description": "分组标题，这是必需的",
            "type": "String",
            "default": ""
        },
        {
            "name": "list",
            "description": "分组字符串列表",
            "type": "Array<String>",
            "default": []
        },
        {
            "name": "[slot]default",
            "description": "自定义列表内容"
        },
        {
            "name": "[slot]title",
            "description": "自定义标题内容"
        }
    ]
}
