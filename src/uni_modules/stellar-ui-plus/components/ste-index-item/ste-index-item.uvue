<template>
	<!--
		ste-index-item 索引分组项组件
		模块职责：承载各个字母分组的标题与行数据项，与 ste-index-list 主容器配合实现锚点滚动与联动高亮
	-->
	<view :id="anchorId" class="ste-index-item-root">
		<!-- 分组标题插槽（支持外部自定义标题内容） -->
		<slot name="title">
			<view v-if="title != ''" class="index-item-title" :style="titleCustomStyle">
				<text class="title-text" :style="titleTextStyle">{{ title }}</text>
			</view>
		</slot>

		<!-- 默认内容插槽（未提供时按 list 数组自动渲染行列表） -->
		<slot>
			<view v-if="list.length > 0" class="index-item-text-list">
				<view
					v-for="(text, index) in list"
					:key="index"
					class="index-item-text-wrap"
					hover-class="index-item-hover"
					@click="handleItemClick(text)"
				>
					<text class="index-item-text">{{ text }}</text>
				</view>
			</view>
		</slot>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, inject, onMounted, onUnmounted } from 'vue'
	import { INDEX_LIST_KEY, IndexListContext, IndexItemRegisterData } from '../ste-index-list/constants.uts'

	defineOptions({
		name: 'ste-index-item',
		options: {
			virtualHost: true
		}
	})

	/**
	 * 组件属性契约定义
	 */
	type IndexItemProps = {
		/** 分组索引标题（必填，如 "A", "B", "C"） */
		title : string
		/** 该分组下的文本列表 */
		list ?: Array<string>
	}

	const props = withDefaults(defineProps<IndexItemProps>(), {
		title: '',
		list: () : Array<string> => [] as Array<string>
	})

	/** 获取父级 IndexList 上下文 */
	const parentContext = inject<IndexListContext | null>(INDEX_LIST_KEY, null)

	/** 生成当前分组项的锚点唯一 ID（供 scroll-into-view 精准定位） */
	const anchorId = computed(() : string => {
		const cleanTitle = props.title.trim().replace(new RegExp('[^a-zA-Z0-9_-]', 'g'), '_')
		return 'ste-index-anchor-' + cleanTitle
	})

	/** 当前分组是否处于激活状态 */
	const isActive = computed(() : boolean => {
		if (parentContext != null) {
			return parentContext.getActiveTitle() == props.title
		}
		return false
	})

	/** 分组标题外层样式 */
	const titleCustomStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		return style
	})

	/** 分组标题文字动态样式（高亮与非激活色） */
	const titleTextStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		if (parentContext != null) {
			const activeColor = parentContext.getActiveColor()
			const inactiveColor = parentContext.getInactiveColor()
			if (isActive.value && activeColor != '') {
				style['color'] = activeColor
			} else if (inactiveColor != '') {
				style['color'] = inactiveColor
			}
		}
		return style
	})

	/**
	 * 处理单行数据点击事件
	 * 触发向上派发，调用父级上下文 onClickItem
	 * @param text 当前点击项的文本内容
	 */
	function handleItemClick(text : string) {
		if (parentContext != null) {
			parentContext.onClickItem(props.title, text)
		}
	}

	onMounted(() => {
		if (parentContext != null) {
			const regData : IndexItemRegisterData = {
				id: anchorId.value,
				title: props.title
			}
			parentContext.registerItem(regData)
		}
	})

	onUnmounted(() => {
		if (parentContext != null) {
			parentContext.unregisterItem(anchorId.value)
		}
	})
</script>

<style>
	.ste-index-item-root {
		width: 100%;
		flex-direction: column;
	}

	.index-item-title {
		width: 100%;
		height: 72rpx;
		padding-left: 32rpx;
		padding-right: 32rpx;
		background-color: #f5f6f8;
		justify-content: center;
	}

	.title-text {
		font-size: 28rpx;
		font-weight: bold;
		color: #666666;
	}

	.index-item-text-list {
		width: 100%;
		background-color: #ffffff;
		flex-direction: column;
	}

	.index-item-text-wrap {
		width: 100%;
		height: 96rpx;
		padding-left: 32rpx;
		padding-right: 32rpx;
		justify-content: center;
		border-bottom-width: 1px;
		border-bottom-style: solid;
		border-bottom-color: #f2f3f5;
	}

	.index-item-hover {
		background-color: #f7f8fa;
	}

	.index-item-text {
		font-size: 30rpx;
		color: #323233;
	}
</style>
