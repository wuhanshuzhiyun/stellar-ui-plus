/**
 * ste-index-list 上下文通信协议与强类型定义
 * 模块职责：为 ste-index-list 主容器与 ste-index-item 分组项提供类型契约及双向联动通信
 */

/**
 * 分组项注册数据结构
 */
export type IndexItemRegisterData = {
	/** 分组项唯一标识 */
	id: string
	/** 分组索引标题（如 "A", "B", "C"） */
	title: string
}

/**
 * 索引列表容器向子组件注入的上下文接口契约
 */
export type IndexListContext = {
	/** 获取当前激活的索引项下标 */
	getActiveIndex: () => number
	/** 获取当前激活的分组标题 */
	getActiveTitle: () => string
	/** 获取是否开启分组标题吸顶 */
	getSticky: () => boolean
	/** 获取激活态文字主题色 */
	getActiveColor: () => string
	/** 获取非激活态文字颜色 */
	getInactiveColor: () => string
	/** 子项列表项被点击时向上传递事件 */
	onClickItem: (title: string, text: string) => void
	/** 子项挂载注册 */
	registerItem: (data: IndexItemRegisterData) => void
	/** 子项卸载注销 */
	unregisterItem: (id: string) => void
}

/**
 * 依赖注入唯一 Key
 */
export const INDEX_LIST_KEY = 'STE_INDEX_LIST_KEY'
