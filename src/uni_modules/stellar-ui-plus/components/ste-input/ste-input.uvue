<template>
	<view class="ste-input-root" :class="cmpRootClass" :style="[cmpRootStyle, cmpInputStyle]" @click="inputClick">
		<view class="content">
			<view class="prefix-box" :style="cmpPrefixStyle">
				<slot name="prefix"></slot>
			</view>
			<view class="input-box">
				<textarea v-if="type == 'textarea'" class="ste-input-textarea" :focus="focused" :value="dataValue"
				:disabled="cmpDisabled" :placeholder="placeholder" :placeholder-style="placeholderStyle"
				:confirm-type="confirmType" :cursor-spacing="cursorSpacing" :maxlength="cmpMaxlength" @input="onInput"
				@focus="onFocus" @blur="onBlur" @confirm="onConfirm" :style="cmpTextStyle"></textarea>
			<template v-else>
				<input class="ste-input-input" :type="cmpInputType" :focus="focused" :value="dataValue"
					:disabled="cmpDisabled" :placeholder="placeholder" :placeholder-style="placeholderStyle"
					:confirm-type="confirmType" :maxlength="cmpMaxlength" :cursor-spacing="cursorSpacing"
						:cursor="cursor" :password="password" @input="onInput" @focus="onFocus" @blur="onBlur"
						@confirm="onConfirm" @click.stop="onInputClick" :style="[cmpTextStyle, cmpInputWidthStyle]" />
					<view v-if="cmpShowClear" class="clear-icon" @click.stop="onClear">
						<text class="clear-text" :style="cmpClearStyle">&#xe694;</text>
					</view>
				</template>
				<text v-if="type == 'textarea' && showWordLimit == true && maxlength != null && maxlength > 0"
					class="count-text" :style="cmpCountStyle">
					{{ cmpWordCount }}/{{ maxlength }}
				</text>
			</view>
			<view class="suffix-box" :style="cmpPrefixStyle">
				<slot name="suffix"></slot>
			</view>
		</view>
		<view v-if="shape == 'line'" class="line" :style="cmpLineStyle"></view>
	</view>
</template>

<script setup lang="uts">
	import { addUnit, bg2style, formatPx } from '../../utils/utils.uts'
	import { normalizeFontSize } from '../../config/index.uts'

	defineOptions({ name: 'ste-input', options: { virtualHost: true } })

	type InputProps = {
		value ?: string | number,
		modelValue ?: string,
		type ?: string,
		placeholder ?: string,
		placeholderStyle ?: string,
		placeholderClass ?: string,
		disabled ?: boolean,
		clearable ?: boolean,
		maxlength ?: number,
		showWordLimit ?: boolean,
		confirmType ?: string,
		focus ?: boolean,
		inputAlign ?: string,
		fontSize ?: string | number,
		fontColor ?: string,
		readonly ?: boolean,
		shape ?: string,
		border ?: boolean,
		borderColor ?: string,
		background ?: string,
		rootClass ?: string,
		cursorSpacing ?: number,
		allowSpace ?: boolean,
		cursor ?: number,
		password ?: boolean,
	}

	const props = defineProps<InputProps>()
	const emit = defineEmits(['input', 'clear', 'update:focus', 'update:modelValue', 'blur', 'focus', 'confirm'])

	const focused = ref(false)
	const dataValue = ref('')
	const tmpDataValue = ref('')

	// 初始化 focus
	if (props.focus == true) {
		focused.value = true
	}

	// disabled 计算（Boolean? -> Boolean）
	const cmpDisabled = computed(() : boolean => {
		return (props.disabled == true || props.readonly == true)
	})

	// 初始化 value
	const initVal = props.value != null ? ('' + (props.value as any)) : (props.modelValue != null ? props.modelValue : '')
	dataValue.value = initVal
	tmpDataValue.value = initVal

	// 根类名
	const cmpRootClass = computed(() : string => {
		let classStr = 'ste-input-root'
		if (props.disabled == true) {
			classStr += ' ste-input-disabled'
		}
		if (props.readonly == true) {
			classStr += ' ste-input-readonly'
		}
		const _shape = props.shape != null ? props.shape : 'square'
		classStr += ' ste-input-' + _shape
		if (props.rootClass != null && props.rootClass !== '') {
			classStr += ' ' + (props.rootClass as string)
		}
		if (props.type == 'textarea') {
			classStr += ' textarea-type'
		}
		return classStr
	})

	// 容器样式（背景、圆角）
	const cmpRootStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}

		const _background = props.background != null ? props.background : ''
		if (_background !== '') {
			const bgObj = bg2style(_background)
			// #ifdef APP-ANDROID || APP-IOS
			const bgMap = bgObj.toMap()
			const iter = bgMap.keys.iterator()
			while (iter.hasNext()) {
				const key = iter.next()!
				style[key] = bgObj[key]!
			}
			// #endif
			// #ifdef H5 || MP-WEIXIN || MP-ALIPAY
			const bgKeys = Object.keys(bgObj as Any) as string[]
			for (let i = 0; i < bgKeys.length; i++) {
				const key = bgKeys[i]
				style[key] = (bgObj as Any)[key]
			}
			// #endif
		}

		const _shape = props.shape != null ? props.shape : 'square'
		if (_shape === 'circle') {
			style['borderRadius'] = addUnit(40) as string
		} else if (_shape === 'square') {
			style['borderRadius'] = addUnit(16) as string
		}

		return style
	})

	// CSS 变量 -> 内联样式（uni-app x 不支持 CSS 变量）
	const cmpInputStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		const _border = props.border != null ? props.border : false
		const _borderColor = props.borderColor != null && props.borderColor !== '' ? props.borderColor : ''

		style['borderColor'] = _border == true ? (_borderColor !== '' ? _borderColor : '#eeeeee') : 'transparent'

		return style
	})

	// 输入框文本样式
	const cmpTextStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		const _fontSize = props.fontSize != null ? props.fontSize : 24
		const _fontColor = props.fontColor != null ? props.fontColor : '#000000'
		const _inputAlign = props.inputAlign != null ? props.inputAlign : 'left'

		style['fontSize'] = normalizeFontSize(typeof _fontSize === 'number' ? (_fontSize as number) : parseFloat(_fontSize as string))
		style['color'] = props.disabled == true ? '#cccccc' : _fontColor
		style['textAlign'] = _inputAlign
		style['backgroundColor'] = 'transparent'

		return style
	})

	// 是否显示清除按钮
	const cmpShowClear = computed(() : boolean => {
		const dv = dataValue.value
		return props.disabled != true && props.readonly != true && (props.clearable == null || props.clearable == true) && dv != null && dv !== '' && focused.value == true
	})

	// 清除按钮文字样式
	const cmpClearStyle = computed(() : UTSJSONObject => {
		return {
			fontSize: normalizeFontSize(34),
			fontFamily: 'ste-iconfont-1709689042473',
			color: '#bbbbbb',
		} as UTSJSONObject
	})

	// 字数统计文字样式
	const cmpCountStyle = computed(() : UTSJSONObject => {
		return {
			fontSize: normalizeFontSize(24)
		} as UTSJSONObject
	})

	// input 宽度（清除按钮时的偏移）
	const cmpInputWidthStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		if (cmpShowClear.value == true) {
			style['width'] = 'calc(100% - 48rpx)'
		} else {
			style['width'] = 'calc(100% - 8rpx)'
		}
		return style
	})

	// prefix/suffix 样式
	const cmpPrefixStyle = computed(() : UTSJSONObject => {
		return {} as UTSJSONObject
	})

	// line 样式
	const cmpLineStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		const _borderColor = props.borderColor != null && props.borderColor !== '' ? props.borderColor : '#eeeeee'
		style['borderBottomWidth'] = '2rpx'
		style['borderBottomStyle'] = 'solid'
		style['borderBottomColor'] = _borderColor
		return style
	})

	// input type 映射
	const cmpInputType = computed(() : string => {
		const _type = props.type != null ? props.type : 'text'
		if (_type === 'password') {
			return 'text'
		}
		if (_type === 'textarea') {
			return 'text'
		}
		return _type
	})

	// 字数统计
	const cmpWordCount = computed(() : number => {
		const v = tmpDataValue.value
		if (v != null) {
			return v.length
		}
		return 0
	})

	// maxlength: 0/null/-1 都转为 -1 不限制
	const cmpMaxlength = computed(() : number => {
		const m = props.maxlength
		if (m == null || m <= 0) return -1
		return m
	})

	// value 同步
	watch(() : string | null => {
		const v1 = props.value != null ? ('' + (props.value as any)) : null
		const v2 = props.modelValue != null ? props.modelValue : null
		return v1 != null ? v1 : v2
	}, (val : string | null) => {
		if (val != null) {
			dataValue.value = val
			tmpDataValue.value = val
		}
	})

	// focus 同步
	watch(() : boolean | null => props.focus, (val : boolean | null) => {
		setTimeout(() => {
			focused.value = val == true
		}, 50)
	})

	function onInput(e : InputEvent) {
		let value : string = ''
		const v = e.detail.value
		if (v != null) {
			value = v
		}
		if (props.allowSpace != true) {
			value = value.replace(/\s*/g, '')
		}

		const _maxlength = props.maxlength != null ? props.maxlength : -1
		if (_maxlength > 0) {
			value = value.substring(0, _maxlength)
		}

		const finalValue = value
		nextTick(() => {
			dataValue.value = finalValue
			tmpDataValue.value = finalValue
			emit('input', finalValue)
			emit('update:modelValue', finalValue)
		})
	}

	function onClear() {
		if (props.disabled == true) return
		dataValue.value = ''
		tmpDataValue.value = ''
		emit('input', '')
		emit('update:modelValue', '')
		emit('clear')
	}

	function onFocus() {
		if (props.disabled == true) return
		focused.value = true
		emit('update:focus', true)
		emit('focus', dataValue.value)
	}

	function onBlur() {
		setTimeout(() => {
			emit('update:focus', false)
			focused.value = false
			emit('blur')
		}, 200)
	}

	function onConfirm() {
		emit('confirm', dataValue.value)
	}

	function inputClick() {
		onFocus()
	}

	function onInputClick() {
	}
</script>

<style scoped>
	.ste-input-root {
		border-width: 1rpx;
		border-style: solid;
		background-color: #ffffff;
		position: relative;
		height: 100%;
	}

	.content {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding-left: 24rpx;
		padding-right: 24rpx;
		padding-top: 0;
		padding-bottom: 0;
		height: 100%;
	}

	.prefix-box {
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
		flex-grow: 0;
		align-items: stretch;
	}

	.suffix-box {
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
		flex-grow: 0;
		align-items: stretch;
	}

	.input-box {
		position: relative;
		width: 100%;
		flex: 1;
	}

	.clear-icon {
		position: absolute;
		right: 8rpx;
		top: 0;
		bottom: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48rpx;
	}

	.clear-text {
		color: #bbbbbb;
	}

	.ste-input-input {
		padding: 0;
		margin: 0;
		height: 100%;
		border-width: 0;
		border-style: solid;
		border-color: transparent;
		background-color: transparent;
	}

	.ste-input-textarea {
		padding: 0;
		margin: 0;
		min-height: 160rpx;
		width: 100%;
		border-width: 0;
		border-style: solid;
		border-color: transparent;
		background-color: transparent;
	}

	.count-text {
		position: absolute;
		bottom: 0;
		right: 0;
		color: #bbbbbb;
	}

	.line {
		border-bottom-width: 2rpx;
		border-bottom-style: solid;
	}

	.ste-input-disabled .ste-input-input,
	.ste-input-disabled .ste-input-textarea {
		color: #cccccc;
	}

	.ste-input-line {
		background-color: transparent;
		border-width: 0;
		border-style: solid;
		border-color: transparent;
	}

	.ste-input-line .content {
		padding-left: 0;
		padding-right: 0;
		padding-top: 0;
		padding-bottom: 0;
	}

	.textarea-type {
		height: 100%;
	}

	.textarea-type .content {
		padding-top: 20rpx;
		padding-bottom: 20rpx;
		padding-left: 24rpx;
		padding-right: 24rpx;
		height: 100%;
	}

	.textarea-type .input-box {
		height: 100%;
	}
</style>