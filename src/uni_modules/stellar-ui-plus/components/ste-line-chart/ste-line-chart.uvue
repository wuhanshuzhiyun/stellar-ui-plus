<template>
	<!-- 折线图根容器 -->
	<view class="ste-line-chart-root" :style="[cmpRootStyle]">
		<canvas
			:id="canvasId"
			class="ste-chart-canvas"
			:style="[cmpCanvasStyle]"
			:disable-scroll="true"
			type="2d"
			@touchstart="onTouch"
			@touchmove="onTouch"
			@touchend="onTouchEnd"
		></canvas>
	</view>
</template>

<script setup lang="uts">
/**
 * @file ste-line-chart.uvue
 * @description LineChart 折线图组件 (uni-app x / UTS 纯原生实现)
 * 基于统一图表渲染引擎 StellarChartEngine 驱动，支持折线/贝塞尔平滑曲线、入场补间动画与手势十字吸附
 */

import { StellarChartEngine } from '../../Charts/engine/StellarChartEngine.uts'
import { ChartSeriesItem, ChartExtra } from '../../Charts/types/uts-types.uts'

// 1. Props 声明
const props = defineProps({
	/** 图表宽度 (支持数字或带单位字符串，如 750、'100%') */
	width: {
		type: [Number, String],
		default: '750'
	},
	/** 图表高度 (rpx 或 px 数值) */
	height: {
		type: [Number, String],
		default: '400'
	},
	/** 数据序列列表 [{ name: '目标值', data: [35, 36, ...] }] */
	series: {
		type: Array as PropType<Array<UTSJSONObject>>,
		default: (): UTSJSONObject[] => [] as UTSJSONObject[]
	},
	/** X 轴分类维度数组 ['2020', '2021', ...] */
	categories: {
		type: Array as PropType<Array<string>>,
		default: (): string[] => [] as string[]
	},
	/** 自定义调色板 */
	color: {
		type: Array as PropType<Array<string>>,
		default: (): string[] => [] as string[]
	},
	/** 是否开启动画 */
	animation: {
		type: Boolean,
		default: true
	},
	/** 动画过渡时长 (ms) */
	duration: {
		type: Number,
		default: 600
	},
	/** 是否显示数据上方数值标注 */
	dataLabel: {
		type: Boolean,
		default: true
	},
	/** 是否显示底部图例 */
	showLegend: {
		type: Boolean,
		default: true
	},
	/** 扩展特有配置（曲线平滑、线条宽度等） */
	extra: {
		type: Object as PropType<UTSJSONObject>,
		default: (): UTSJSONObject => ({} as UTSJSONObject)
	}
});

// 2. 响应式与上下文状态
const canvasId = 'ste-line-chart-' + Math.floor(Math.random() * 1000000).toString();
let engine: StellarChartEngine | null = null;

// 格式化尺寸数值 (默认将 750 转为全屏宽度)
function parsePx(val: any, isWidth: boolean): number {
	if (typeof val === 'number') {
		return val as number;
	}
	const str = val.toString().trim();
	if (str.endsWith('px')) {
		return parseFloat(str);
	}
	if (str.endsWith('rpx')) {
		const win = uni.getWindowInfo();
		return (parseFloat(str) * win.windowWidth) / 750;
	}
	const num = parseFloat(str);
	if (!isNaN(num)) {
		// 若为 750，自适应屏幕宽度
		if (isWidth && num === 750) {
			return uni.getWindowInfo().windowWidth;
		}
		// 默认按 rpx 比例转换
		const win = uni.getWindowInfo();
		return (num * win.windowWidth) / 750;
	}
	return isWidth ? uni.getWindowInfo().windowWidth : 200;
}

// 根样式与 Canvas 样式
const cmpRootStyle = computed((): UTSJSONObject => {
	const w = parsePx(props.width, true);
	const h = parsePx(props.height, false);
	return {
		width: w.toString() + 'px',
		height: h.toString() + 'px'
	};
});

const cmpCanvasStyle = computed((): UTSJSONObject => {
	const w = parsePx(props.width, true);
	const h = parsePx(props.height, false);
	return {
		width: w.toString() + 'px',
		height: h.toString() + 'px'
	};
});

// 将 UTSJSONObject[] 转换为强类型 ChartSeriesItem[]
function normalizeSeries(rawList: UTSJSONObject[]): ChartSeriesItem[] {
	const list: ChartSeriesItem[] = [];
	for (let i = 0; i < rawList.length; i++) {
		const item = rawList[i];
		const name = item.getString('name') != null ? item.getString('name')! : '';
		const dataRaw = item.getArray('data');
		const dataNums: number[] = [];
		if (dataRaw != null) {
			for (let d = 0; d < dataRaw.length; d++) {
				const rawVal = dataRaw[d];
				if (rawVal != null) {
					dataNums.push(parseFloat(rawVal.toString()));
				} else {
					dataNums.push(0);
				}
			}
		}
		const color = item.getString('color');
		const shape = item.getString('legendShape');
		const show = item.getBoolean('show');

		list.push({
			name: name,
			data: dataNums,
			color: color,
			legendShape: shape,
			show: show
		});
	}
	return list;
}

// 解析 Extra 配置
function normalizeExtra(): ChartExtra {
	const extra: ChartExtra = {};
	if (props.extra != null) {
		const lineObj = props.extra.getJSON('line');
		if (lineObj != null) {
			extra.line = {
				type: lineObj.getString('type'),
				width: lineObj.getNumber('width'),
				showPoint: lineObj.getBoolean('showPoint'),
				pointRadius: lineObj.getNumber('pointRadius')
			};
		}
	}
	return extra;
}

// 3. 生命周期挂载
onMounted(() => {
	const width = parsePx(props.width, true);
	const height = parsePx(props.height, false);

	engine = new StellarChartEngine({
		canvasId: canvasId,
		type: 'line',
		width: width,
		height: height,
		series: normalizeSeries(props.series),
		categories: props.categories,
		colors: props.color.length > 0 ? props.color : null,
		animation: props.animation,
		duration: props.duration,
		dataLabel: props.dataLabel,
		showLegend: props.showLegend,
		extra: normalizeExtra()
	});

	engine?.mount();
});

// 4. 数据监听与平滑更新
watch(() : UTSJSONObject[] => props.series, (_newSeries: UTSJSONObject[]) => {
	if (engine != null) {
		engine?.updateData(normalizeSeries(props.series), props.categories);
	}
});

watch(() : string[] => props.categories, (_newCats: string[]) => {
	if (engine != null) {
		engine?.updateData(normalizeSeries(props.series), props.categories);
	}
});

// 5. 手势交互事件分发
function onTouch(e: TouchEvent) {
	engine?.handleTouch(e);
}

function onTouchEnd() {
	engine?.handleTouchEnd();
}

onUnmounted(() => {
	engine?.destroy();
	engine = null;
});
</script>

<style>
.ste-line-chart-root {
	position: relative;
	overflow: hidden;
}
.ste-chart-canvas {
	position: absolute;
	left: 0;
	top: 0;
}
</style>
