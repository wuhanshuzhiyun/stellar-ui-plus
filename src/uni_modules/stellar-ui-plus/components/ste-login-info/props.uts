/**
 * @file props.uts
 * @description ste-login-info 登录信息卡片组件 - uni-app x / UTS 强类型属性与契约定义
 */

/**
 * 默认未登录占位头像图片 URL
 */
export const DEFAULT_LOGIN_AVATAR = 'https://image.whzb.com/chain/StellarUI/%E5%9B%BE%E7%89%87.jpg'

/**
 * 默认未登录引导提示文案
 */
export const DEFAULT_LOGIN_TITLE = '请登录'

/**
 * 默认图标字体族名称
 */
export const DEFAULT_LOGIN_FONT_FAMILY = 'ste-iconfont-1709689042473'

/**
 * ste-login-info 组件 Props 强类型契约定义
 */
export type LoginInfoProps = {
	/**
	 * 用户头像图片 URL（在已登录状态下展示）
	 */
	avatar ?: string,
	/**
	 * 用户主昵称文本
	 */
	nickname ?: string,
	/**
	 * 用户副标题/身份标签描述（如 VIP 等级、食堂名称等）
	 */
	subTitle ?: string,
	/**
	 * 副标题前置图标 Unicode 编码（如 '&#xe670;'）
	 */
	subTitleIcon ?: string,
	/**
	 * 副标题文字与图标的高亮颜色（留空则默认自动跟随系统主题色）
	 */
	subColor ?: string,
	/**
	 * 字体图标所使用的 FontFamily
	 * @default 'ste-iconfont-1709689042473'
	 */
	fontFamily ?: string,
	/**
	 * 登录状态：0 为未登录，1 为已登录
	 * @default 1
	 */
	loginStatus ?: number,
	/**
	 * 未登录状态下展示的占位头像图片 URL
	 */
	loginSrc ?: string,
	/**
	 * 未登录状态下展示的标题提示文本
	 * @default '请登录'
	 */
	loginTitle ?: string,
	/**
	 * 是否在登录标题后强制显示跳转向右指示小箭头图标
	 * @default false
	 */
	showTitleIcon ?: boolean,
	/**
	 * 根节点自定义内联样式映射
	 */
	rootStyle ?: UTSJSONObject,
}
