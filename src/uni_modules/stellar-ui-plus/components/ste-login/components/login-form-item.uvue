<template>
	<view class="ste-login-form-item-root" :style="cmpRootStyle">
		<!-- 1. 下拉选择框类型 (type='select') -->
		<view class="input-type select-box" v-if="props.config.type == 'select'">
			<text class="item-label">{{ props.config.title }}</text>
			<view class="select-wrapper">
				<ste-select
					:height="94"
					:width="580"
					:fontSize="32"
					borderRadius="16rpx"
					borderColor="#EBEBEB"
					optionsPosition="bottom"
					:modelValue="innerValue"
					:list="selectList"
					labelKey="title"
					valueKey="key"
					:disabled="props.config.disabled == true"
					@change="onSelectChange"
				></ste-select>
			</view>
		</view>

		<!-- 2. 文本提示说明卡片 (type='txt') -->
		<view class="input-type txt-box" v-else-if="props.config.type == 'txt'">
			<text class="item-label">{{ props.config.title }}</text>
			<view class="tips-card" :style="cmpTipsCardStyle">
				<text class="tips-text">{{ props.config.value ?? '' }}</text>
			</view>
		</view>

		<!-- 3. 密码输入框 (type='password') -->
		<view class="input-type password-box" v-else-if="props.config.type == 'password'">
			<text class="item-label">{{ props.config.title }}</text>
			<view class="input-wrapper">
				<ste-input
					:placeholder="cmpPlaceholder"
					type="password"
					confirmType="next"
					:fontSize="32"
					:border="true"
					borderColor="#EBEBEB"
					:modelValue="innerValue"
					:maxlength="props.config.maxlength ?? 100"
					:disabled="props.config.disabled == true"
					@input="onInputChange"
				>
					<template #prefix>
						<view class="prefix-icon-wrap">
							<ste-icon
								:code="props.config.icon != null && props.config.icon != '' ? props.config.icon! : '&#xe630;'"
								:size="40"
								:color="iconColor"
							></ste-icon>
						</view>
					</template>
				</ste-input>
			</view>
		</view>

		<!-- 4. 验证码输入框 (type='validate') -->
		<view class="input-type validate-box" v-else-if="props.config.type == 'validate'">
			<text class="item-label">{{ props.config.title }}</text>
			<view class="input-wrapper">
				<ste-input
					:placeholder="cmpPlaceholder"
					confirmType="next"
					:fontSize="32"
					:border="true"
					borderColor="#EBEBEB"
					:modelValue="innerValue"
					:maxlength="props.config.maxlength ?? 6"
					:disabled="props.config.disabled == true"
					@input="onInputChange"
				>
					<template #prefix>
						<view class="prefix-icon-wrap">
							<ste-icon
								:code="props.config.icon != null && props.config.icon != '' ? props.config.icon! : '&#xe630;'"
								:size="40"
								:color="iconColor"
							></ste-icon>
						</view>
					</template>
					<template #suffix>
						<view
							class="validate-btn"
							:style="{ opacity: count > 0 ? 0.4 : 1.0 }"
							@click="handleGetCodeClick"
						>
							<text class="validate-text" :style="{ color: activeColor }">
								{{ count <= 0 ? '获取验证码' : `${count}秒后获取` }}
							</text>
						</view>
					</template>
				</ste-input>
			</view>
		</view>

		<!-- 5. 默认/数字账号输入框 (type='number' 或其他) -->
		<view class="input-type number-box" v-else>
			<text class="item-label">{{ props.config.title }}</text>
			<view class="input-wrapper">
				<ste-input
					:placeholder="cmpPlaceholder"
					confirmType="next"
					:fontSize="32"
					:border="true"
					borderColor="#EBEBEB"
					:modelValue="innerValue"
					:maxlength="props.config.maxlength ?? 100"
					:disabled="props.config.disabled == true"
					@input="onInputChange"
				>
					<template #prefix>
						<view class="prefix-icon-wrap">
							<ste-icon
								:code="props.config.icon != null && props.config.icon != '' ? props.config.icon! : '&#xe631;'"
								:size="40"
								:color="iconColor"
							></ste-icon>
						</view>
					</template>
				</ste-input>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * login-form-item 登录表单项子组件
 * 
 * @description 封装了数字账号、密文密码、下拉选择、说明文本以及验证码倒计时等 5 类输入形态。
 */
import { LoginItem, BaseConfigItem } from '../constants.uts';

defineOptions({
	name: 'login-form-item'
});

/**
 * 组件入参 Props 规范定义
 */
const props = withDefaults(
	defineProps<{
		/** 主题高亮主色 */
		color ?: string;
		/** 单项输入配置 */
		config : LoginItem;
		/** 当前双向绑定值 */
		modelValue ?: string;
	}>(),
	{
		color: '#0275ff',
		modelValue: ''
	}
);

/**
 * 组件事件 Emits 规范定义
 */
const emits = defineEmits<{
	(e : 'update:modelValue', value : string) : void;
	(e : 'change', value : string) : void;
	(e : 'getCode', suspend : () => void, next : () => void, stop : () => void) : void;
}>();

/**
 * 内部状态
 */
const innerValue = ref<string>(props.modelValue);
const count = ref<number>(0);
let timerId : number | null = null;

/**
 * 监听外部 modelValue 变动
 */
watch(
	() : string => props.modelValue,
	(val : string) => {
		if (innerValue.value != val) {
			innerValue.value = val;
		}
	}
);

/**
 * 当前生效主题色
 */
const activeColor = computed<string>(() : string => {
	if (props.color != '') {
		return props.color;
	}
	return '#0275ff';
});

/**
 * 图标颜色
 */
const iconColor = computed<string>(() : string => {
	const customColor = props.config.style?.getString('iconColor');
	if (customColor != null && customColor != '') {
		return customColor!;
	}
	return activeColor.value;
});

/**
 * 占位文本
 */
const cmpPlaceholder = computed<string>(() : string => {
	if (props.config.placeholder != null && props.config.placeholder != '') {
		return props.config.placeholder!;
	}
	return '请输入';
});

/**
 * 候选下拉数据
 */
const selectList = computed<BaseConfigItem[]>(() : BaseConfigItem[] => {
	if (props.config.selectData != null) {
		return props.config.selectData!;
	}
	return [] as BaseConfigItem[];
});

/**
 * 根容器内联样式
 */
const cmpRootStyle = computed<UTSJSONObject>(() : UTSJSONObject => {
	return {} as UTSJSONObject;
});

/**
 * 提示卡片样式
 */
const cmpTipsCardStyle = computed<UTSJSONObject>(() : UTSJSONObject => {
	const bg = props.config.style?.getString('background');
	const style : UTSJSONObject = {};
	if (bg != null && bg != '') {
		style['backgroundColor'] = bg;
	} else {
		style['backgroundColor'] = '#f7f8fa';
	}
	return style;
});

/**
 * 处理输入变更
 */
function onInputChange(val : any) {
	const str = val != null ? `${val}` : '';
	innerValue.value = str;
	emits('update:modelValue', str);
	emits('change', str);
}

/**
 * 处理下拉选择变更
 */
function onSelectChange(val : any) {
	const str = val != null ? `${val}` : '';
	innerValue.value = str;
	emits('update:modelValue', str);
	emits('change', str);
}

/**
 * 启动验证码倒计时
 */
function startCountdown() {
	count.value = 60;
	if (timerId != null) {
		clearInterval(timerId!);
	}
	timerId = setInterval(() => {
		count.value--;
		if (count.value <= 0) {
			if (timerId != null) {
				clearInterval(timerId!);
				timerId = null;
			}
		}
	}, 1000);
}

/**
 * 触发获取验证码
 */
function handleGetCodeClick() {
	if (count.value > 0) {
		return;
	}

	let shouldProceed = true;
	const suspend = () => {
		shouldProceed = false;
	};
	const next = () => {
		startCountdown();
	};
	const stop = () => {
		// 外部中止
	};

	emits('getCode', suspend, next, stop);

	if (shouldProceed) {
		startCountdown();
	}
}

/**
 * 组件卸载时清理定时器
 */
onUnmounted(() => {
	if (timerId != null) {
		clearInterval(timerId!);
		timerId = null;
	}
});
</script>

<style scoped>
/* 根容器 */
.ste-login-form-item-root {
	width: 100%;
}

.input-type {
	width: 100%;
}

/* 标签行 */
.item-label {
	height: 40rpx;
	font-size: 28rpx;
	color: #1f2329;
	line-height: 40rpx;
}

/* 输入框包装 */
.input-wrapper {
	width: 580rpx;
	border-radius: 16rpx;
	margin: 12rpx 0 24rpx;
}

/* 下拉选择包装 */
.select-wrapper {
	width: 580rpx;
	margin: 12rpx 0 24rpx;
}

/* 提示卡片 */
.tips-card {
	width: 580rpx;
	border-radius: 16rpx;
	padding: 20rpx;
	margin-top: 20rpx;
	margin-bottom: 24rpx;
}

.tips-text {
	font-size: 26rpx;
	color: #8f959e;
	line-height: 38rpx;
}

/* 前缀图标容器 */
.prefix-icon-wrap {
	margin-right: 20rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}

/* 验证码按钮 */
.validate-btn {
	margin-right: 24rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}

.validate-text {
	font-size: 28rpx;
	font-weight: 500;
}
</style>
