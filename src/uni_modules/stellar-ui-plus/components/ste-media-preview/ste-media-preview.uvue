<template>
	<!-- 全屏媒体预览根容器 -->
	<view class="ste-media-preview-root" :style="{ zIndex: props.zIndex }" v-if="dataShow">
		<view
			class="media-preview-content"
			@touchstart="onTouchstart"
			@touchmove="onTouchmove"
			@touchend="onTouchend"
			@touchcancel="onTouchend"
		>
			<!-- Swiper 容器常驻，避免由于 DOM 销毁重建导致的图片重载与白屏卡顿 -->
			<swiper
				class="swiper"
				:autoplay="props.autoplay > 0"
				:interval="props.autoplay"
				:circular="props.loop"
				:current="dataIndex"
				:disable-touch="isScale"
				@change="onChange"
			>
				<swiper-item v-for="(item, index) in cmpUrls" :key="index">
					<view
						class="preview-item"
						@click.stop="onClick"
						@longpress="onLongpress"
						:style="[dataIndex === index ? cmpTransform : {}]"
					>
						<video
							class="video"
							v-if="isItemVideo(index)"
							:src="itemUrl(index)"
							@click.stop="noop"
						/>
						<image
							v-else
							class="image"
							:show-menu-by-longpress="dataShowmenu"
							:src="itemUrl(index)"
							mode="aspectFit"
						/>
					</view>
				</swiper-item>
			</swiper>

			<!-- 自定义底部扩展插槽 -->
			<view class="media-preview-slot" @touchstart.stop="noop" @touchmove.stop="noop" @touchend.stop="noop">
				<slot></slot>
			</view>
		</view>

		<!-- 底部控制栏 -->
		<view class="media-preview-footer" @touchstart.stop="noop" @touchmove.stop="noop" @touchend.stop="noop">
			<view class="footer-index">
				<!-- 原生 App 编译规范：显式添加 footer-index-text 类名以支持样式定制 -->
				<text v-if="showIndex && cmpUrls.length > 0" class="footer-index-text">{{ dataIndex + 1 }}/{{ cmpUrls.length }}</text>
			</view>
			<view class="footer-close" @click="onClose">
				<ste-icon name="close" :size="60" code="&#xe6a0;" color="#fff" />
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * @file ste-media-preview.uvue
	 * @description 全屏多媒体预览组件 - 基于中心轴心严密物理定点仿射模型 (uni-app x 原生高性能版)
	 * @author Stellar UI Plus Team
	 *
	 * 核心架构设计：
	 * 1. 零 DOM 销毁重构：Swiper 容器与视图节点全生命周期常驻，通过 :disable-touch="isScale" 在缩放态锁死翻页，消除切换闪烁；
	 * 2. 中心轴心物理定点：顺应原生 RenderNode/View 天然的中心轴心 (center center)，严格保证双指落点正下方像素纹丝不动；
	 * 3. 动效与手势分层：手势交互中 transition: none 保证 120fps 极速跟手，松手/双击复位启动平滑物理缓动；
	 * 4. 消除手势期异步开销：手势期采用微秒级同步视口更新，绝不在 touchstart 高频事件中触发异步 SelectorQuery。
	 */

	import { ref, computed, watch, getCurrentInstance, nextTick, onMounted } from 'vue'
	import { getMediaFileType } from '../../utils/utils.uts'
	import { TouchScaleing } from './TouchScaleing.uts'

	defineOptions({ name: 'ste-media-preview' })

	// ==================== 属性与类型定义 (Props) ====================
	type MediaPreviewProps = {
		/** 是否显示全屏预览浮层 */
		show : boolean,
		/** 预览媒体资源地址列表 */
		urls : string[],
		/** 轮播自动播放间隔（毫秒，0 表示不自动播放） */
		autoplay : number,
		/** 是否采用衔接滑动循环轮播 */
		loop : boolean,
		/** 当前激活媒体项索引 */
		index : number | null,
		/** 是否在底部显示当前页码指示器 */
		showIndex : boolean,
		/** 是否开启双指缩放及单指拖拽手势 */
		scale : boolean,
		/** 是否允许长按图片弹出系统操作菜单 */
		showmenu : boolean,
		/** 浮层自定义 z-index 层级 */
		zIndex : number,
	}

	const props = withDefaults(defineProps<MediaPreviewProps>(), {
		show : false,
		urls : () : string[] => [] as string[],
		autoplay : 0,
		loop : false,
		index : null,
		showIndex : true,
		scale : false,
		showmenu : true,
		zIndex : 997,
	})

	// ==================== 事件派发定义 (Emits) ====================
	const emit = defineEmits([
		'beforeClose',
		'update:show',
		'close',
		'update:index',
		'change',
		'longpress'
	])

	// ==================== 核心响应式状态 (State) ====================
	const instance = getCurrentInstance()
	const dataIndex = ref<number>(0)
	const dataShow = ref<boolean>(false)
	const dataShowmenu = ref<boolean>(false)
	const isScale = ref<boolean>(false)

	/** 单值响应式变换字符串 */
	const activeTransform = ref<string>('translate(0px, 0px) scale(1)')
	/** 单值响应式过渡动画字符串 */
	const activeTransition = ref<string>('none')

	/** 物理定点手势计算引擎实例 */
	const touchInstance = new TouchScaleing()

	/** 空函数，阻止事件冒泡穿透 */
	const noop = () => {}

	// ==================== 计算属性 (Computed) ====================
	/**
	 * 过滤媒体列表中非音频的有效资源项
	 */
	const cmpUrls = computed(() : UTSJSONObject[] => {
		const result : UTSJSONObject[] = []
		for (let i = 0; i < props.urls.length; i++) {
			const url = props.urls[i]
			const type = getMediaFileType(url)
			if (type != 'audio') {
				result.push({
					url: url,
					type: type,
				} as UTSJSONObject)
			}
		}
		return result
	})

	/**
	 * 当前激活项的变换样式映射
	 */
	const cmpTransform = computed(() : UTSJSONObject => {
		return {
			transform: activeTransform.value,
			transformOrigin: 'center center',
			transition: activeTransition.value,
		} as UTSJSONObject
	})

	/**
	 * 获取指定索引的媒体资源 URL
	 * @param index 索引下标
	 */
	function itemUrl(index : number) : string {
		const urls = cmpUrls.value
		if (index >= 0 && index < urls.length) {
			const item = urls[index]
			return (item['url'] as string) ?? ''
		}
		return ''
	}

	/**
	 * 判断指定索引是否为单视频预览
	 * @param index 索引下标
	 */
	function isItemVideo(index : number) : boolean {
		const urls = cmpUrls.value
		if (index >= 0 && index < urls.length) {
			const item = urls[index]
			const type = (item['type'] as string) ?? 'image'
			return type == 'video' && urls.length <= 1
		}
		return false
	}

	// ==================== 物理真实视口中心测量 ====================
	/**
	 * 获取屏幕窗口与内容区域真实几何中心并同步给手势计算引擎
	 * 仅在浮层显示时异步校准一次绝对矩形，手势交互期间严禁频繁异步查询
	 */
	function measurePhysicalCenter() {
		// 1. 同步首选系统窗口物理中心兜底
		touchInstance.updateCenterFromWindow()

		// 2. 尝试通过 boundingClientRect 精准实测内容容器在屏幕中的绝对几何矩形
		try {
			const query = uni.createSelectorQuery().in(instance?.proxy)
			query.select('.media-preview-content').boundingClientRect((res : any) => {
				if (res != null) {
					const rect = res as NodeInfo
					if (rect.width != null && rect.height != null && (rect.width as number) > 0.0) {
						const left = rect.left ?? 0.0
						const top = rect.top ?? 0.0
						const width = rect.width as number
						const height = rect.height as number
						touchInstance.setCenter(left + width / 2.0, top + height / 2.0)
					}
				}
			}).exec()
		} catch (e) {}
	}

	// ==================== 核心方法 (Methods) ====================
	/**
	 * 重置当前缩放与漫游位移至初始状态
	 */
	function resetScal() {
		touchInstance.reset()
		isScale.value = false
		activeTransition.value = 'none'
		activeTransform.value = 'translate(0px, 0px) scale(1)'
	}

	/**
	 * 关闭媒体预览浮层
	 */
	function onClose() {
		emit('beforeClose')
		dataShow.value = false
		emit('update:show', false)
		emit('close')
		resetScal()
	}

	/**
	 * 触摸按下事件处理器 (touchstart)
	 * @param e 原生 TouchEvent
	 */
	function onTouchstart(e : TouchEvent) {
		if (!props.scale) return
		// 微秒级同步更新窗口几何中心，杜绝手势期间异步执行 query
		touchInstance.updateCenterFromWindow()
		// 检测到多指触控瞬间，立刻锁定 isScale，强制关闭 Swiper 滚动翻页拦截
		if (e.touches != null && e.touches.length >= 2) {
			isScale.value = true
		}
		touchInstance.touchStartEvent(e)
		activeTransition.value = 'none'
		if (dataShowmenu.value && e.touches != null && e.touches.length >= 2) {
			dataShowmenu.value = false
		}
	}

	/**
	 * 触摸移动事件处理器 (touchmove)
	 * @param e 原生 TouchEvent
	 */
	function onTouchmove(e : TouchEvent) {
		if (!props.scale) return
		const bool = touchInstance.touchMoveEvent(e)
		if (!bool) {
			// 未处于缩放态且为单指滑动时，返回 false 放行给 Swiper 翻页
			return
		}
		if (dataShowmenu.value) dataShowmenu.value = false
		activeTransition.value = 'none'
		activeTransform.value = touchInstance.getTransformString()
		isScale.value = touchInstance.isScale
	}

	/**
	 * 触摸离开事件处理器 (touchend)
	 * @param e 原生 TouchEvent
	 */
	function onTouchend(e : TouchEvent) {
		if (!props.scale) return
		if (dataShowmenu.value != props.showmenu) dataShowmenu.value = props.showmenu
		touchInstance.touchEndEvent(e)
		activeTransform.value = touchInstance.getTransformString()
		activeTransition.value = touchInstance.transition
		isScale.value = touchInstance.isScale
	}

	/**
	 * 轮播切换事件处理器 (change)
	 * @param e 轮播事件对象
	 */
	function onChange(e : SwiperChangeEvent) {
		const current = e.detail.current
		dataIndex.value = current
		emit('update:index', current)
		emit('change', current)
		resetScal()
	}

	/**
	 * 长按事件处理器 (longpress)
	 */
	function onLongpress() {
		// 缩放中或非 1.0x 常态下严禁触发长按，避免弹窗打断手势
		if (isScale.value || touchInstance.isScale) return
		emit('longpress', dataIndex.value)
	}

	// ==================== 双击定点放大 / 复位逻辑 ====================
	let clickNum = 0
	let clickTimer : number = 0

	/**
	 * 点击事件处理器 - 识别 300ms 内双击并触发定点放大/还原
	 * @param e 点击事件对象
	 */
	function onClick(e : any) {
		if (!props.scale) return
		if (clickTimer != 0) {
			clearTimeout(clickTimer)
			clickTimer = 0
		}
		clickNum++

		const clickEvent = e as UTSJSONObject
		let tapX = 187.5
		let tapY = 333.5
		try {
			const winInfo = uni.getWindowInfo()
			tapX = winInfo.windowWidth / 2.0
			tapY = winInfo.windowHeight / 2.0
		} catch (err) {}

		// 安全提取点击坐标
		if (clickEvent['clientX'] != null && (clickEvent['clientX'] as number) > 0.0) {
			tapX = clickEvent['clientX'] as number
		} else if (clickEvent['detail'] != null) {
			const detail = clickEvent['detail'] as UTSJSONObject
			if (detail['x'] != null) tapX = detail['x'] as number
		}

		if (clickEvent['clientY'] != null && (clickEvent['clientY'] as number) > 0.0) {
			tapY = clickEvent['clientY'] as number
		} else if (clickEvent['detail'] != null) {
			const detail = clickEvent['detail'] as UTSJSONObject
			if (detail['y'] != null) tapY = detail['y'] as number
		}

		if (clickNum > 1) {
			clickNum = 0
			touchInstance.onDoubleTap(tapX, tapY)
			activeTransform.value = touchInstance.getTransformString()
			activeTransition.value = touchInstance.transition
			isScale.value = touchInstance.isScale
			return
		}
		clickTimer = setTimeout(() => {
			clickNum = 0
			clickTimer = 0
		}, 300)
	}

	// ==================== 响应式侦听 (Watchers) ====================
	watch(() : boolean => props.show, (v : boolean) => {
		if (v) {
			const idx = props.index
			if (idx != null) {
				dataIndex.value = idx
			}
			nextTick(() => {
				measurePhysicalCenter()
			})
		}
		dataShow.value = v
		if (!v) {
			resetScal()
		}
	}, { immediate: true })

	watch(() : boolean => props.showmenu, (v : boolean) => {
		dataShowmenu.value = v
	}, { immediate: true })

	onMounted(() => {
		measurePhysicalCenter()
	})
</script>

<style>
	.ste-media-preview-root {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		width: 100%;
		height: 100%;
		background-color: #000000;
		display: flex;
		flex-direction: column;
	}

	.media-preview-content {
		width: 100%;
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
	}

	.preview-item {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		/* 采用天然的中心轴心 (center center)，保证跨端原生与 CSS 表现完全统一 */
		transform-origin: center center;
	}

	.swiper {
		width: 100%;
		height: 100%;
	}

	.image {
		width: 100%;
		height: 100%;
	}

	.video {
		width: 100%;
		height: 100%;
	}

	.media-preview-slot {
		position: absolute;
		bottom: 30rpx;
		left: 0;
		right: 0;
		display: flex;
		flex-direction: row;
		justify-content: center;
	}

	.media-preview-footer {
		width: 100%;
		height: 120rpx;
		padding-left: 30rpx;
		padding-right: 30rpx;
		padding-bottom: 30rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.footer-index {
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	/* 页码指示器文本样式 - uni-app x 必须使用单类名选择器 */
	.footer-index-text {
		font-size: 28rpx;
		color: #ffffff;
	}

	.footer-close {
		display: flex;
		flex-direction: row;
		align-items: center;
	}
</style>
