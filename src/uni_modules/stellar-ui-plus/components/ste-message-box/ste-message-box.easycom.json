{
    "name": "ste-message-box",
    "description": "模拟系统的消息提示框而实现的一套模态对话框组件，用于消息提示、确认消息和提交内容。",
    "example": "<ste-message-box></ste-message-box>",
    "tutorial": "https://stellar-ui.intecloud.com.cn/?projectName=stellar-ui-plus&menu=%E7%BB%84%E4%BB%B6&active=ste-message-box",
    "attributes": [
        {
            "name": "title",
            "description": "提示的标题",
            "type": "String",
            "default": ""
        },
        {
            "name": "content",
            "description": "提示的内容",
            "type": "String",
            "default": ""
        },
        {
            "name": "icon",
            "description": "提示区域显示图标，此时content会失效",
            "type": "String",
            "default": ""
        },
        {
            "name": "showCancel",
            "description": "是否显示取消按钮",
            "type": "Boolean",
            "default": true
        },
        {
            "name": "cancelText",
            "description": "提示的内容",
            "type": "String",
            "default": "取消"
        },
        {
            "name": "cancelColor",
            "description": "取消按钮的文字颜色",
            "type": "String",
            "default": "#333333"
        },
        {
            "name": "confirmText",
            "description": "确认按钮的文字，最多4个字符",
            "type": "String",
            "default": "确认"
        },
        {
            "name": "confirmColor",
            "description": "确认按钮的文字颜色",
            "type": "String",
            "default": "#0090FF"
        },
        {
            "name": "editable",
            "description": "是否显示输入框",
            "type": "Boolean",
            "default": false
        },
        {
            "name": "placeholderText",
            "description": "显示输入框时的提示文本",
            "type": "String",
            "default": ""
        },
        {
            "name": "confirm",
            "description": "点击确认的回调函数",
            "type": "Function",
            "default": null
        },
        {
            "name": "cancel",
            "description": "点击取消的回调函数",
            "type": "Function",
            "default": null
        },
        {
            "name": "complete",
            "description": "弹框关闭的回调函数（无论是确认关闭还是取消关闭）",
            "type": "Function",
            "default": null
        },
        {
            "name": "show",
            "description": "是否展示消息弹窗（支持双向绑定）[仅UVue支持]",
            "type": "boolean",
            "default": false
        },
        {
            "name": "closeOnClickOverlay",
            "description": "点击背景遮罩层是否允许自动关闭弹窗[仅UVue支持]",
            "type": "boolean",
            "default": false
        },
        {
            "name": "zIndex",
            "description": "弹窗的层级 z-index 数值[仅UVue支持]",
            "type": "number",
            "default": 9999
        },
        {
            "name": "[method]showMsgBox",
            "description": "命令式显式打开弹窗",
            "params": [
                {
                    "name": "options",
                    "description": "配置项 (可选)"
                }
            ],
            "return": "void"
        },
        {
            "name": "[method]hideMsgBox",
            "description": "命令式隐藏弹窗",
            "params": [],
            "return": "void"
        },
        {
            "name": "[method]closeBox",
            "description": "关闭弹窗并触发关闭回调",
            "params": [],
            "return": "void"
        },
        {
            "name": "[slot]default",
            "description": "弹窗自定义内容插槽"
        },
        {
            "name": "[event]confirm",
            "description": "点击确定按钮时触发",
            "params": []
        },
        {
            "name": "[event]cancel",
            "description": "点击取消按钮时触发",
            "params": []
        },
        {
            "name": "[event]complete",
            "description": "弹窗关闭动画完成时触发",
            "params": []
        },
        {
            "name": "[event]close",
            "description": "点击右上角关闭图标时触发",
            "params": []
        }
    ],
    "uvue_diff": {
        "invoke": "Vue 端支持通过 uni.$ste.showToast/messageBox 全局挂载；UVue 端支持通过 ref 实例或 useMessageBox() 组合式函数直接触发，新增 show, closeOnClickOverlay, zIndex 显式受控绑定"
    }
}
