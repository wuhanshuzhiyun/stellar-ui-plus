/**
 * @file ste-message-box.uts
 * @description MessageBox 弹窗事件广播 Key 生成工具
 * @author Stellar UI Plus Team
 */

export const messageBoxDefaultOptionsKey = 'ste:messageBox'

/**
 * 获取基于可选 selector 的全局事件广播标识 Key
 * @param customKey 自定义 selector 标识 (默认为空字符串)
 * @returns 唯一的事件监听 Key
 */
export function getMessageBoxKey(customKey : string = '') : string {
	if (customKey != '') {
		return `${messageBoxDefaultOptionsKey}:${customKey}`
	}
	return messageBoxDefaultOptionsKey
}
