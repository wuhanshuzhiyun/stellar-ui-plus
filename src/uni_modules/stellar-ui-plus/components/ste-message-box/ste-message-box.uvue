<template>
	<!-- MessageBox 模态对话框根容器 -->
	<view
		class="ste-message-box-root"
		:style="{ zIndex: props.zIndex }"
		v-if="dataShow"
		@touchmove.stop="noop"
	>
		<!-- 半透明黑色背景遮罩层 -->
		<view
			class="ste-message-box-mask"
			:style="maskStyle"
			@click="onMaskClick"
		></view>

		<!-- 弹窗主体卡片 -->
		<view
			class="ste-message-box-content"
			:style="contentStyle"
			@click.stop="noop"
		>
			<view class="content-inner">
				<!-- 内置图标展示区 (使用静态字面量 code 属性，兼容 uni-app x 字体图标解析) -->
				<view class="icon-box" v-if="dataIcon != ''">
					<ste-icon v-if="dataIcon == 'info'" code="&#xe67d;" color="#0090FF" :size="48" />
					<ste-icon v-else-if="dataIcon == 'success'" code="&#xe67a;" color="#00c250" :size="48" />
					<ste-icon v-else-if="dataIcon == 'error'" code="&#xe67b;" color="#fa5151" :size="48" />
					<ste-icon v-else code="&#xe67d;" color="#0090FF" :size="48" />
				</view>

				<!-- 弹窗标题 -->
				<text class="message-title" v-if="dataTitle != ''">{{ dataTitle }}</text>

				<!-- 内容与输入 / 自定义插槽区域 -->
				<view class="message-body">
					<slot>
						<!-- 常规提示文本 -->
						<text class="message-text" v-if="!dataEditable && dataContent != ''">{{ dataContent }}</text>

						<!-- Prompt 输入框模式 -->
						<view class="input-box" v-if="dataEditable">
							<input
								class="message-input"
								:value="dataInputValue"
								:placeholder="dataPlaceholderText"
								placeholder-class="message-input-placeholder"
								@input="onInput"
							/>
						</view>
					</slot>
				</view>
			</view>

			<!-- 底部操作按钮栏 -->
			<view class="message-footer">
				<!-- 取消操作按钮 -->
				<view
					class="footer-btn btn-cancel"
					v-if="dataShowCancel"
					@click="onCancel"
				>
					<text class="btn-text" :style="{ color: dataCancelColor }">{{ dataCancelText }}</text>
				</view>

				<!-- 确认操作按钮 -->
				<view
					class="footer-btn btn-confirm"
					@click="onConfirm"
				>
					<text class="btn-text" :style="{ color: dataConfirmColor }">{{ dataConfirmText }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * @file ste-message-box.uvue
	 * @description MessageBox 模态弹框组件 - uni-app x 原生高性能版本
	 * @author Stellar UI Plus Team
	 *
	 * 核心功能与架构：
	 * 1. 原生 GPU 硬件加速缩放淡入动效：通过 scale(0.85 -> 1) 与 opacity(0 -> 1) 实现原生级丝滑弹窗；
	 * 2. 双模式调用支持：支持 useMessageBox() 组合式函数全局广播调用与 template/ref 实例调用；
	 * 3. 样式全单类名规范：100% 遵循 uni-app x CSS 规范，完美兼容 Android Kotlin、iOS Swift 与 Web；
	 * 4. 多形态支持：内置 info/success/error 图标、Prompt 可编辑输入框、自定义按钮配色与 Slot 插槽扩展。
	 */

	import { ref, computed, watch, onMounted, onUnmounted, nextTick } from 'vue'
	import { DURATION, MessageBoxOptions } from './constants.uts'
	import { getMessageBoxKey } from './ste-message-box.uts'

	defineOptions({ name: 'ste-message-box' })

	// ==================== 属性与类型定义 (Props) ====================
	type MessageBoxProps = {
		/** 弹窗专属选择器标识 (用于单页面多实例隔离) */
		selector ?: string,
		/** 是否显示弹窗 (支持 v-model:show) */
		show ?: boolean,
		/** 弹窗标题 */
		title ?: string,
		/** 提示内容文本 */
		content ?: string,
		/** 内置图标类型 ('info' | 'success' | 'error' | '') */
		icon ?: string,
		/** 取消按钮文字 */
		cancelText ?: string,
		/** 取消按钮文字颜色 */
		cancelColor ?: string,
		/** 确认按钮文字 */
		confirmText ?: string,
		/** 确认按钮文字颜色 */
		confirmColor ?: string,
		/** 是否显示取消按钮 */
		showCancel ?: boolean,
		/** 是否开启输入框编辑模式 */
		editable ?: boolean,
		/** 输入框占位提示文本 */
		placeholderText ?: string,
		/** 自定义层级 z-index */
		zIndex ?: number,
		/** 是否允许点击背景遮罩层关闭 */
		closeOnClickOverlay ?: boolean,
	}

	const props = withDefaults(defineProps<MessageBoxProps>(), {
		selector: '',
		show: false,
		title: '提示',
		content: '',
		icon: '',
		cancelText: '取消',
		cancelColor: '#333333',
		confirmText: '确认',
		confirmColor: '#0090FF',
		showCancel: true,
		editable: false,
		placeholderText: '请输入',
		zIndex: 99999,
		closeOnClickOverlay: false,
	})

	// ==================== 事件派发定义 (Emits) ====================
	const emit = defineEmits([
		'update:show',
		'confirm',
		'cancel',
		'complete',
		'close',
	])

	// ==================== 核心响应式状态 (State) ====================
	const dataShow = ref<boolean>(false)
	const dataTitle = ref<string>(props.title)
	const dataContent = ref<string>(props.content)
	const dataIcon = ref<string>(props.icon)
	const dataCancelText = ref<string>(props.cancelText)
	const dataCancelColor = ref<string>(props.cancelColor)
	const dataConfirmText = ref<string>(props.confirmText)
	const dataConfirmColor = ref<string>(props.confirmColor)
	const dataShowCancel = ref<boolean>(props.showCancel)
	const dataEditable = ref<boolean>(props.editable)
	const dataPlaceholderText = ref<string>(props.placeholderText)
	const dataInputValue = ref<string>('')
	const dataCloseOnClickOverlay = ref<boolean>(props.closeOnClickOverlay)

	// 动画控制状态
	const maskOpacity = ref<number>(0.0)
	const contentScale = ref<number>(0.85)
	const contentOpacity = ref<number>(0.0)

	// 回调函数存储
	let callbackConfirm : ((val : string) => void) | null = null
	let callbackCancel : ((val : string) => void) | null = null
	let callbackComplete : ((val : string) => void) | null = null
	let closeTimer : number = 0

	/** 空函数，阻止事件冒泡与滚动穿透 */
	const noop = () => {}

	// ==================== 计算属性 (Computed) ====================
	const msgKey = computed(() : string => {
		return getMessageBoxKey(props.selector)
	})

	const maskStyle = computed(() : UTSJSONObject => {
		return {
			opacity: maskOpacity.value,
			transition: `opacity ${DURATION}ms ease-out`,
		} as UTSJSONObject
	})

	const contentStyle = computed(() : UTSJSONObject => {
		return {
			transform: `scale(${contentScale.value})`,
			opacity: contentOpacity.value,
			transition: `transform ${DURATION}ms cubic-bezier(0.25, 0.1, 0.25, 1), opacity ${DURATION}ms ease-out`,
		} as UTSJSONObject
	})

	// ==================== 核心方法 (Methods) ====================
	/**
	 * 打开弹窗并执行展开动画
	 */
	function showBox() {
		if (closeTimer != 0) {
			clearTimeout(closeTimer)
			closeTimer = 0
		}
		dataShow.value = true
		emit('update:show', true)

		nextTick(() => {
			maskOpacity.value = 1.0
			contentScale.value = 1.0
			contentOpacity.value = 1.0
		})
	}

	/**
	 * 关闭弹窗并执行平滑缩放淡出动画
	 */
	function closeBox() {
		maskOpacity.value = 0.0
		contentScale.value = 0.85
		contentOpacity.value = 0.0

		if (closeTimer != 0) {
			clearTimeout(closeTimer)
		}
		closeTimer = setTimeout(() => {
			dataShow.value = false
			emit('update:show', false)
			emit('close')
			dataInputValue.value = ''
			closeTimer = 0
		}, DURATION)
	}

	/**
	 * 载入外部动态传入的配置项
	 * @param options 弹窗配置项
	 */
	function loadMessageBoxParams(options : MessageBoxOptions) {
		dataTitle.value = (options.title != null) ? (options.title as string) : props.title
		dataContent.value = (options.content != null) ? (options.content as string) : props.content
		dataIcon.value = (options.icon != null) ? (options.icon as string) : props.icon
		dataCancelText.value = (options.cancelText != null) ? (options.cancelText as string) : props.cancelText
		dataCancelColor.value = (options.cancelColor != null) ? (options.cancelColor as string) : props.cancelColor
		dataConfirmText.value = (options.confirmText != null) ? (options.confirmText as string) : props.confirmText
		dataConfirmColor.value = (options.confirmColor != null) ? (options.confirmColor as string) : props.confirmColor
		dataShowCancel.value = (options.showCancel != null) ? (options.showCancel as boolean) : props.showCancel
		dataEditable.value = (options.editable != null) ? (options.editable as boolean) : props.editable
		dataPlaceholderText.value = (options.placeholderText != null) ? (options.placeholderText as string) : props.placeholderText
		dataCloseOnClickOverlay.value = (options.closeOnClickOverlay != null) ? (options.closeOnClickOverlay as boolean) : props.closeOnClickOverlay

		callbackConfirm = options.confirm ?? null
		callbackCancel = options.cancel ?? null
		callbackComplete = options.complete ?? null
	}

	/**
	 * 供外部 (useMessageBox 或 ref) 调用的显示弹窗接口
	 * @param options 弹窗配置项
	 */
	function showMsgBox(options : MessageBoxOptions) {
		loadMessageBoxParams(options)
		showBox()
	}

	/**
	 * 供外部调用的隐藏弹窗接口
	 */
	function hideMsgBox() {
		closeBox()
	}

	/**
	 * 输入框内容输入事件处理器
	 */
	function onInput(e : InputEvent) {
		dataInputValue.value = e.detail.value
	}

	/**
	 * 点击确认按钮触发
	 */
	function onConfirm() {
		const val = dataInputValue.value
		if (callbackConfirm != null) {
			callbackConfirm!(val)
		}
		emit('confirm', val)

		if (callbackComplete != null) {
			callbackComplete!(val)
		}
		emit('complete', val)
		closeBox()
	}

	/**
	 * 点击取消按钮触发
	 */
	function onCancel() {
		const val = dataInputValue.value
		if (callbackCancel != null) {
			callbackCancel!(val)
		}
		emit('cancel', val)

		if (callbackComplete != null) {
			callbackComplete!(val)
		}
		emit('complete', val)
		closeBox()
	}

	/**
	 * 点击遮罩层事件
	 */
	function onMaskClick() {
		if (dataCloseOnClickOverlay.value) {
			onCancel()
		}
	}

	// ==================== 全局广播事件注册与卸载 ====================
	function onEventShow(options : any) {
		if (options != null) {
			loadMessageBoxParams(options as MessageBoxOptions)
		}
		showBox()
	}

	function onEventHide(_val : any) {
		closeBox()
	}

	function registerEvents(flag : boolean) {
		const key = msgKey.value
		if (flag) {
			uni.$on(`${key}:show`, onEventShow)
			uni.$on(`${key}:hide`, onEventHide)
		} else {
			uni.$off(`${key}:show`, onEventShow)
			uni.$off(`${key}:hide`, onEventHide)
		}
	}

	// ==================== 响应式侦听 (Watchers) ====================
	watch(() : boolean => props.show, (v : boolean) => {
		if (v) {
			dataTitle.value = props.title
			dataContent.value = props.content
			dataIcon.value = props.icon
			dataCancelText.value = props.cancelText
			dataCancelColor.value = props.cancelColor
			dataConfirmText.value = props.confirmText
			dataConfirmColor.value = props.confirmColor
			dataShowCancel.value = props.showCancel
			dataEditable.value = props.editable
			dataPlaceholderText.value = props.placeholderText
			dataCloseOnClickOverlay.value = props.closeOnClickOverlay
			showBox()
		} else {
			closeBox()
		}
	}, { immediate: true })

	// ==================== 生命周期 (Lifecycle) ====================
	onMounted(() => {
		registerEvents(true)
	})

	onUnmounted(() => {
		registerEvents(false)
		if (closeTimer != 0) {
			clearTimeout(closeTimer)
			closeTimer = 0
		}
	})

	// 暴露给模板 Ref 实例调用
	defineExpose({
		showMsgBox: showMsgBox,
		hideMsgBox: hideMsgBox,
		closeBox: closeBox,
	})
</script>

<style>
	.ste-message-box-root {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.ste-message-box-mask {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(0, 0, 0, 0.6);
	}

	.ste-message-box-content {
		position: relative;
		width: 580rpx;
		background-color: #ffffff;
		border-radius: 24rpx;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.15);
	}

	.content-inner {
		padding: 44rpx 36rpx 36rpx 36rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.icon-box {
		width: 96rpx;
		height: 96rpx;
		border-radius: 48rpx;
		background-color: #f7f8fa;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 20rpx;
	}

	.message-title {
		font-size: 32rpx;
		font-weight: bold;
		color: #1f2329;
		text-align: center;
		margin-bottom: 16rpx;
		line-height: 44rpx;
	}

	.message-body {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.message-text {
		font-size: 28rpx;
		color: #646a73;
		text-align: center;
		line-height: 42rpx;
	}

	.input-box {
		width: 100%;
		margin-top: 12rpx;
		background-color: #f5f6f7;
		border-radius: 12rpx;
		padding: 0 20rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.message-input {
		width: 100%;
		height: 76rpx;
		font-size: 28rpx;
		color: #1f2329;
		background-color: transparent;
	}

	.message-input-placeholder {
		color: #8f959e;
		font-size: 28rpx;
	}

	.message-footer {
		width: 100%;
		height: 96rpx;
		border-top: 1rpx solid #ebeef5;
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.footer-btn {
		flex: 1;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.btn-cancel {
		border-right: 1rpx solid #ebeef5;
	}

	.btn-confirm {
		/* 确认按钮专属区域 */
	}

	.btn-text {
		font-size: 30rpx;
		font-weight: bold;
	}
</style>
