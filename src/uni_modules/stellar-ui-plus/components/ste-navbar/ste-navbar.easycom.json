{
    "name": "ste-navbar",
    "description": "提供导航功能，常用于页面顶部。",
    "example": "<ste-navbar></ste-navbar>",
    "tutorial": "https://stellar-ui.intecloud.com.cn/?projectName=stellar-ui-plus&menu=%E7%BB%84%E4%BB%B6&active=ste-navbar",
    "attributes": [
        {
            "name": "autoBack",
            "description": "是否显示返回按钮",
            "type": "Boolean",
            "default": true
        },
        {
            "name": "backColor",
            "description": "返回按钮颜色",
            "type": "String",
            "default": "#000"
        },
        {
            "name": "backCode",
            "description": "返回按钮icon的code",
            "type": "String",
            "default": "&#xe673;"
        },
        {
            "name": "backCode",
            "description": "返回按钮icon的code",
            "type": "String",
            "default": "&#xe673;"
        },
        {
            "name": "backBackgroundColor",
            "description": "返回按钮的背景颜色",
            "type": "String",
            "default": "transparent"
        },
        {
            "name": "backBorderColor",
            "description": "返回按钮的边框颜色",
            "type": "String",
            "default": "transparent"
        },
        {
            "name": "backOpacity",
            "description": "返回按钮透明度",
            "type": "Number",
            "default": 1
        },
        {
            "name": "stopNavigateBack",
            "description": "是否阻止点击返回按钮后，返回到上一页",
            "type": "Boolean",
            "default": false
        },
        {
            "name": "title",
            "description": "标题文本",
            "type": "String",
            "default": ""
        },
        {
            "name": "titleColor",
            "description": "标题颜色",
            "type": "String",
            "default": "#181818"
        },
        {
            "name": "titleAlignment",
            "description": "标题对齐方式",
            "type": "Number",
            "default": 1,
            "values": [
                {
                    "name": 1,
                    "description": "居左"
                },
                {
                    "name": 2,
                    "description": "居中"
                }
            ]
        },
        {
            "name": "fixed",
            "description": "是否固定到顶部",
            "type": "Boolean",
            "default": false
        },
        {
            "name": "safeAreaInsetTop",
            "description": "是否开启顶部安全区适配",
            "type": "Boolean",
            "default": true
        },
        {
            "name": "zIndex",
            "description": "导航栏 z-index",
            "type": "Number",
            "default": 10
        },
        {
            "name": "backgroundColor",
            "description": "导航栏背景色",
            "type": "String",
            "default": "transparent"
        },
        {
            "name": "colorType",
            "description": "导航栏预设配色主题[仅Vue支持]",
            "type": "string",
            "default": "primary",
            "values": [
                {
                    "name": 1,
                    "description": "黑色"
                },
                {
                    "name": 2,
                    "description": "白色"
                }
            ]
        },
        {
            "name": "placeholder",
            "description": "固定在顶部时，是否在相同位置生成占位元素，防止页面内容塌陷上移[仅UVue支持]",
            "type": "boolean",
            "default": true
        },
        {
            "name": "rootStyle",
            "description": "根节点原生样式对象[仅UVue支持]",
            "type": "object",
            "default": {}
        },
        {
            "name": "[event]backClick",
            "description": "返回按钮点击",
            "params": [
                {
                    "name": "data",
                    "description": "()=>void"
                }
            ]
        },
        {
            "name": "[slot]default",
            "description": "导航栏内容"
        },
        {
            "name": "[slot]left",
            "description": "导航栏左侧自定义插槽（替换默认返回按钮）"
        },
        {
            "name": "[slot]right",
            "description": "导航栏右侧功能按钮区域插槽"
        }
    ],
    "uvue_diff": {
        "placeholder": "UVue 端新增 placeholder 属性（是否自动生成占位节点防止页面内容被导航栏遮挡）与 rootStyle 样式支持；Vue 端拥有 colorType 属性"
    }
}
