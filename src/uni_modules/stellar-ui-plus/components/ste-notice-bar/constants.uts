/**
 * @file constants.uts
 * @description ste-notice-bar 公告栏组件的类型定义、常量与默认参数配置
 */

/**
 * NoticeBar 组件属性类型定义
 */
export type NoticeBarProps = {
    /**
     * 滚动数据列表
     * @default []
     */
    list ?: string[],
    /**
     * 滚动的方向
     * - across: 水平滚动
     * - vertical: 垂直滚动
     * @default 'across'
     */
    direction ?: string,
    /**
     * 是否启用关闭模式（显示右侧关闭按钮）
     * @default false
     */
    closeMode ?: boolean,
    /**
     * 文字颜色
     * @default '#000000'
     */
    color ?: string,
    /**
     * 背景颜色或背景渐变值
     * @default '#ffffff'
     */
    background ?: string,
    /**
     * 宽度（支持数字或百分比/像素字符串，如 400 或 '100%'）
     * @default '100%'
     */
    width ?: any,
    /**
     * 水平方向的滚动速率 (单位: px/s)
     * @default 50
     */
    acrossSpeed ?: number,
    /**
     * 垂直方向的滚动的速度 (单位: ms)
     * @default 500
     */
    verticalSpeed ?: number,
    /**
     * 延时启动时间 (单位: ms)
     * @default 1000
     */
    delay ?: number,
    /**
     * 每次滚动前停留时间，竖向滚动时有效 (单位: ms)
     * @default 1000
     */
    standTime ?: number,
    /**
     * 公告栏是否可以滚动
     * @default true
     */
    scrollable ?: boolean,
    /**
     * 根节点自定义样式对象
     */
    rootStyle ?: UTSJSONObject,
}

/**
 * 默认左侧图标 URL
 */
export const DEFAULT_LEFT_ICON = 'https://image.whzb.com/chain/StellarUI/notice-bar/tip.png'
