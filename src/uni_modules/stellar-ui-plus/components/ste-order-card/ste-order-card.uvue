<template>
	<view class="ste-order-card-root" :style="cmpRootStyle">
		<!-- 1. 卡片头部：商户信息、主标题与订单状态 -->
		<view class="order-card-head" @click="onClickHeader('empty')">
			<view class="head-left">
				<!-- 商户头像区，支持插槽 -->
				<view class="head-image-box" @click.stop="onClickHeader('image')">
					<slot name="head-image">
						<image
							v-if="props.image != ''"
							:src="props.image"
							class="head-image-img"
							mode="aspectFill"
						/>
						<view v-else class="head-image-default" />
					</slot>
				</view>
				<text class="head-title-text" @click.stop="onClickHeader('title')">{{ props.title }}</text>
			</view>
			<!-- 头部右侧状态 -->
			<text class="head-status-text" @click.stop="onClickHeader('status')">{{ props.statusText }}</text>
		</view>

		<!-- 2. 副标题信息栏：业务标签与辅助文本 -->
		<view
			v-if="props.tagText != '' || props.helperText != ''"
			class="order-card-sub-head"
			@click="onClickHeader('empty')"
		>
			<view v-if="props.tagText != ''" class="sub-tag" @click.stop="onClickHeader('tag')">
				<text class="sub-tag-text">{{ props.tagText }}</text>
			</view>
			<text
				v-if="props.helperText != ''"
				class="sub-helper-text"
				@click.stop="onClickHeader('helper')"
			>
				{{ props.helperText }}
			</text>
		</view>

		<!-- 3. 商品核心内容区：单商品图文排版 vs 多商品横向滚动流 -->
		<view class="order-card-content" :style="{ backgroundColor: cmpContentBg }">
			<!-- 3.1 单商品展示模式 -->
			<view
				class="content-single"
				v-if="oneData != null"
				@click="onClickItem('empty', oneData!)"
			>
				<view class="single-image-box" @click.stop="onClickItem('image', oneData!)">
					<ste-image
						:src="oneData!.image ?? ''"
						:width="132"
						:height="132"
						:radius="12"
						mode="aspectFill"
					/>
				</view>
				<view class="single-info-box">
					<view class="info-top">
						<text class="single-title" @click.stop="onClickItem('title', oneData!)">
							{{ oneData!.title ?? '' }}
						</text>
						<text
							v-if="(oneData!.subTitle ?? '') != ''"
							class="single-subtitle"
							@click.stop="onClickItem('sub-title', oneData!)"
						>
							{{ oneData!.subTitle ?? '' }}
						</text>
					</view>
					<!-- 单商品模式下的详情入口 -->
					<view
						v-if="props.showDetail"
						class="info-bottom-detail"
						@click.stop="onClickItem('details', oneData!)"
					>
						<text class="detail-label">详情</text>
						<ste-icon code="&#xe674;" :size="22" color="#757575" />
					</view>
				</view>
			</view>

			<!-- 3.2 多商品横向排布模式 -->
			<scroll-view
				v-else
				direction="horizontal"
				class="content-list-scroll"
				:show-scrollbar="false"
			>
				<view class="content-list-row">
					<view
						class="content-item"
						v-for="(item, index) in props.data"
						:key="index"
						@click="onClickItem('empty', item)"
					>
						<view @click.stop="onClickItem('image', item)">
							<ste-image
								:src="item.image ?? ''"
								:width="132"
								:height="132"
								:radius="12"
								mode="aspectFill"
							/>
						</view>
						<text class="item-title-text" @click.stop="onClickItem('title', item)">
							{{ item.title ?? '' }}
						</text>
					</view>
				</view>
			</scroll-view>
		</view>

		<!-- 4. 卡片底部：合计信息与功能操作按钮组 -->
		<view class="order-card-footer">
			<!-- 金额与件数统计 -->
			<view class="footer-data-row">
				<text class="footer-count-text">共{{ displayCount }}件</text>
				<view class="footer-price-wrap">
					<text class="footer-price-label">合计：</text>
					<ste-price :value="props.price" color="#000000" :fontSize="30" />
				</view>
			</view>

			<!-- 按钮交互操作栏 -->
			<view class="footer-btns-row">
				<view class="footer-btns-left" @click="onClickBtn('more')">
					<text v-if="props.showMore" class="more-text">更多</text>
				</view>
				<view class="footer-btns-right">
					<view v-if="props.subBtnText != ''" class="btn-item-wrap">
						<ste-button
							:round="true"
							background="#ffffff"
							borderColor="#e5e7eb"
							color="#374151"
							@click="onClickBtn('secondary')"
						>
							{{ props.subBtnText }}
						</ste-button>
					</view>
					<view v-if="props.mainBtnText != ''" class="btn-item-wrap">
						<ste-button
							:round="true"
							:background="props.mainBtnBg"
							:borderColor="props.mainBtnBg"
							:color="props.mainBtnTextColor"
							@click="onClickBtn('primary')"
						>
							{{ props.mainBtnText }}
						</ste-button>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * @file ste-order-card.uvue
	 * @description OrderCard 订单卡片组件 - uni-app x / UTS 纯原生版本
	 * 用于展示电商/餐饮/自提场景的订单列表卡片，支持单商品图文排版、多商品横向滚动、商品统计、详情入口及操作按钮联动。
	 */
	import { computed } from 'vue'
	import { OrderGoods, OrderCardProps } from './props.uts'
	import { deepMerge } from '../../utils/utils.uts'

	export type { OrderGoods }

	defineOptions({
		name: 'ste-order-card',
		options: {
			virtualHost: true,
		},
	})

	// ==================== 组件 Props 属性定义 ====================
	const props = withDefaults(defineProps<OrderCardProps>(), {
		background: '#ffffff',
		contentBg: '',
		image: '',
		title: '',
		statusText: '',
		tagText: '',
		helperText: '',
		data: () => [] as OrderGoods[],
		count: 0,
		price: '0',
		mainBtnText: '',
		mainBtnBg: '#EC3E1A',
		mainBtnTextColor: '#ffffff',
		subBtnText: '',
		showDetail: false,
		showMore: false,
		rootStyle: () => ({} as UTSJSONObject),
	})

	// ==================== 组件 Emits 事件声明 ====================
	const emit = defineEmits<{
		/** 点击卡片头部区域触发 */
		(e: 'click-header', type: string) : void,
		/** 点击商品条目触发 */
		(e: 'click-item', type: string, item: OrderGoods) : void,
		/** 点击底部操作按钮触发 */
		(e: 'click-button', type: string) : void,
	}>()

	// ==================== 计算属性 ====================
	/**
	 * 单商品数据项计算（当且仅当 data 长度为 1 时激活单商品排版模式）
	 */
	const oneData = computed(() : OrderGoods | null => {
		if (props.data.length == 1) {
			return props.data[0]
		}
		return null
	})

	/**
	 * 商品总件数展示计算
	 */
	const displayCount = computed(() : number => {
		if (props.count > 0) {
			return props.count
		}
		return props.data.length
	})

	/**
	 * 内容区背景颜色
	 */
	const cmpContentBg = computed(() : string => {
		if (props.contentBg != '') {
			return props.contentBg
		}
		return props.background
	})

	/**
	 * 根节点内联样式映射
	 */
	const cmpRootStyle = computed(() : UTSJSONObject => {
		const style = {} as UTSJSONObject
		style['backgroundColor'] = props.background
		return deepMerge(style, props.rootStyle) as UTSJSONObject
	})

	// ==================== 事件交互响应 ====================
	function onClickHeader(type : string) {
		emit('click-header', type)
	}

	function onClickItem(type : string, item : OrderGoods) {
		emit('click-item', type, item)
	}

	function onClickBtn(type : string) {
		emit('click-button', type)
	}
</script>

<style scoped>
	/* 订单卡片整体根容器 */
	.ste-order-card-root {
		border-radius: 16rpx;
		flex-direction: column;
		overflow: hidden;
	}

	/* 1. 头部商户与状态行 */
	.order-card-head {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 28rpx 28rpx 16rpx 28rpx;
	}

	.head-left {
		flex-direction: row;
		align-items: center;
		flex: 1;
		margin-right: 16rpx;
	}

	/* 头像盒子 */
	.head-image-box {
		width: 44rpx;
		height: 44rpx;
		border-radius: 22rpx;
		overflow: hidden;
		margin-right: 16rpx;
		justify-content: center;
		align-items: center;
	}

	.head-image-img {
		width: 44rpx;
		height: 44rpx;
		border-radius: 22rpx;
	}

	.head-image-default {
		width: 44rpx;
		height: 44rpx;
		background-color: #ec3e1a;
		border-radius: 22rpx;
	}

	/* 标题加粗 */
	.head-title-text {
		font-size: 32rpx;
		font-weight: bold;
		color: #111827;
		lines: 1;
		text-overflow: ellipsis;
		overflow: hidden;
		flex: 1;
	}

	/* 右侧状态高亮文本 */
	.head-status-text {
		font-size: 28rpx;
		font-weight: 500;
		color: #ec3e1a;
	}

	/* 2. 副标题与业务标签行 */
	.order-card-sub-head {
		flex-direction: row;
		align-items: center;
		padding: 0 28rpx 12rpx 28rpx;
	}

	.sub-tag {
		background-color: #fef3c7;
		border-radius: 6rpx;
		padding: 4rpx 12rpx;
		margin-right: 16rpx;
	}

	.sub-tag-text {
		font-size: 22rpx;
		color: #b45309;
		font-weight: 500;
	}

	.sub-helper-text {
		font-size: 26rpx;
		color: #6b7280;
		lines: 1;
		text-overflow: ellipsis;
		overflow: hidden;
		flex: 1;
	}

	/* 3. 商品主体展示区 */
	.order-card-content {
		padding: 16rpx 28rpx;
		border-radius: 12rpx;
	}

	/* 3.1 单商品图文结构 */
	.content-single {
		flex-direction: row;
		width: 100%;
	}

	.single-image-box {
		width: 132rpx;
		height: 132rpx;
		margin-right: 20rpx;
	}

	.single-info-box {
		flex: 1;
		flex-direction: column;
		justify-content: space-between;
	}

	.info-top {
		flex-direction: column;
	}

	.single-title {
		font-size: 28rpx;
		font-weight: bold;
		color: #1f2937;
		line-height: 38rpx;
		lines: 1;
		text-overflow: ellipsis;
		overflow: hidden;
	}

	.single-subtitle {
		font-size: 24rpx;
		color: #6b7280;
		line-height: 34rpx;
		margin-top: 6rpx;
		lines: 1;
		text-overflow: ellipsis;
		overflow: hidden;
	}

	.info-bottom-detail {
		flex-direction: row;
		align-items: center;
		justify-content: flex-end;
	}

	.detail-label {
		font-size: 24rpx;
		color: #6b7280;
		margin-right: 4rpx;
	}

	/* 3.2 多商品横向列表 */
	.content-list-scroll {
		width: 100%;
		flex-direction: row;
	}

	.content-list-row {
		flex-direction: row;
		align-items: center;
	}

	.content-item {
		width: 132rpx;
		margin-right: 24rpx;
		flex-direction: column;
	}

	.item-title-text {
		width: 132rpx;
		font-size: 24rpx;
		color: #4b5563;
		lines: 1;
		text-overflow: ellipsis;
		overflow: hidden;
		margin-top: 8rpx;
		text-align: center;
	}

	/* 4. 底部合计与操作栏 */
	.order-card-footer {
		padding: 12rpx 28rpx 24rpx 28rpx;
		flex-direction: column;
	}

	.footer-data-row {
		flex-direction: row;
		justify-content: flex-end;
		align-items: center;
		margin-bottom: 20rpx;
	}

	.footer-count-text {
		font-size: 26rpx;
		color: #4b5563;
		margin-right: 16rpx;
	}

	.footer-price-wrap {
		flex-direction: row;
		align-items: center;
	}

	.footer-price-label {
		font-size: 26rpx;
		color: #111827;
	}

	.footer-btns-row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.footer-btns-left {
		flex-direction: row;
		align-items: center;
		height: 60rpx;
	}

	.more-text {
		font-size: 26rpx;
		color: #6b7280;
	}

	.footer-btns-right {
		flex-direction: row;
		align-items: center;
	}

	.btn-item-wrap {
		margin-left: 16rpx;
	}
</style>
