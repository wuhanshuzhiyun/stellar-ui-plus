<template>
	<view class="ste-picker-root" :class="[rootClass]">
		<view class="ste-picker-toolbar" v-if="showToolbar">
			<text @click="cancel" class="cancel" :style="{ color: cancelColor }">{{ cancelText }}</text>
			<text class="title">{{ title }}</text>
			<text @click="confirm" class="confirm" :style="{ color: confirmColor }">{{ confirmText }}</text>
		</view>
		<picker-view @change="change" :indicatorStyle="cmpIndicatorStyle" class="ste-picker-view" :style="[cmpPickerViewStyle]" :value="innerIndex">
			<picker-view-column v-for="(col, key) in innerColumns" :key="key" class="ste-picker-column">
				<view class="item" v-for="(item, index) in col" :key="index" :style="[cmpPickerItemStyle]">
					<text class="item-text">{{ item }}</text>
				</view>
			</picker-view-column>
		</picker-view>
	</view>
</template>

<script setup lang="uts">
import { ref, watch, computed } from 'vue'
import { addUnit, formatPx } from '../../utils/utils.uts'

type StePickerProps = {
	columns: string[][]
	itemHeight: string | number
	visibleItemCount: string | number
	showToolbar: boolean
	title: string
	cancelText: string
	cancelColor: string
	confirmText: string
	confirmColor: string
	defaultIndex: number[]
	rootClass: string
}

const props = withDefaults(defineProps<StePickerProps>(), {
	columns: () => [],
	itemHeight: 44,
	visibleItemCount: 5,
	showToolbar: true,
	title: '',
	cancelText: '取消',
	cancelColor: '#969799',
	confirmText: '确认',
	confirmColor: '#0090FF',
	defaultIndex: () => [],
	rootClass: '',
})

const emit = defineEmits<{
	(e: 'change', changeObj: UTSJSONObject): void
	(e: 'cancel'): void
	(e: 'confirm'): void
}>()

const lastIndex = ref<number[]>([])
const innerIndex = ref<number[]>([])
const innerColumns = ref<string[][]>([])
const columnIndex = ref<number>(0)

const cmpIndicatorStyle = computed(() : string => {
	return `height: ${props.itemHeight}px`
})

const cmpPickerViewStyle = computed(() : UTSJSONObject => {
	const borderRadius = formatPx('12rpx')
	const height = parseFloat('' + props.visibleItemCount) * parseFloat('' + props.itemHeight)
	return {
		height: height + 'px',
	} as UTSJSONObject
})

const cmpPickerItemStyle = computed(() : UTSJSONObject => {
	return {
		height: `${props.itemHeight}px`,
	} as UTSJSONObject
})

const deepCloneArray = (arr: number[]): number[] => {
	const result: number[] = []
	for (let i = 0; i < arr.length; i++) {
		result.push(arr[i])
	}
	return result
}

const setLastIndexFn = (index: number[]) => {
	lastIndex.value = deepCloneArray(index)
}

const setIndexs = (index: number[], setLastIndex: boolean) => {
	innerIndex.value = deepCloneArray(index)
	if (setLastIndex == true) {
		setLastIndexFn(index)
	}
}

const deepCloneStringArray = (arr: string[][]): string[][] => {
	const result: string[][] = []
	for (let i = 0; i < arr.length; i++) {
		const inner: string[] = []
		for (let j = 0; j < arr[i].length; j++) {
			inner.push(arr[i][j])
		}
		result.push(inner)
	}
	return result
}

const setColumns = (columns: string[][]) => {
	innerColumns.value = deepCloneStringArray(columns)
	if (innerIndex.value.length == 0) {
		const zeroArr: number[] = []
		for (let i = 0; i < columns.length; i++) {
			zeroArr.push(0)
		}
		innerIndex.value = zeroArr
	}
}

const change = (e: PickerViewChangeEvent) => {
	const value = e.detail.value
	let index = 0
	let columnIdx = 0
	for (let i = 0; i < value.length; i++) {
		const compareValue = i < lastIndex.value.length ? lastIndex.value[i] : 0
		if (value[i] != compareValue) {
			columnIdx = i
			index = value[i]
			break
		}
	}
	columnIndex.value = columnIdx
	const values = innerColumns.value
	setLastIndexFn(value)
	setIndexs(value, false)

	const valueArr: string[] = []
	for (let i = 0; i < innerColumns.value.length; i++) {
		valueArr.push(innerColumns.value[i][value[i]])
	}

	const changeObj = {
		value: valueArr,
		index: index,
		indexs: value,
		values: values,
		columnIndex: columnIdx,
	} as UTSJSONObject
	emit('change', changeObj)
}

const cancel = () => {
	emit('cancel')
}

const confirm = () => {
	emit('confirm')
}

watch(() : number[] => props.defaultIndex, (newVal: number[]) : void => {
	setIndexs(newVal, true)
}, { immediate: true })

watch(() : string[][] => props.columns, (newVal: string[][]) : void => {
	setColumns(newVal)
}, { immediate: true })
</script>

<style lang="scss" scoped>
.ste-picker-root {
	width: 100%;
	background-color: #ffffff;
	border-radius: 12rpx;
}

.ste-picker-view {
	width: 100%;
}

.ste-picker-toolbar {
	padding: 30rpx 40rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
}

.cancel {
	font-size: 28rpx;
}

.title {
	font-size: 32rpx;
	font-weight: bold;
}

.confirm {
	font-size: 28rpx;
}

.item {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}

.item-text {
	font-size: 26rpx;
}
</style>
