<template>
	<!-- 价格根容器：采用原生行内 Flex 排列，底部基线对齐 -->
	<view class="ste-price-root" :style="rootContainerStyle">
		<!-- 货币单位符号 -->
		<text v-if="showUnit" class="ste-price-unit" :style="unitStyle">{{ unitSymbol }}</text>
		<!-- 整数金额部分 -->
		<text class="ste-price-yuan" :style="yuanStyle">{{ yuanPart }}</text>
		<!-- 小数角分部分（仅在分转元或存在小数时展示） -->
		<text v-if="fenPart != ''" class="ste-price-fen" :style="fenStyle">{{ fenPart }}</text>
	</view>
</template>

<script setup lang="uts">
/**
 * ste-price 价格/金额展示组件
 *
 * 模块职责：
 * 1. 跨端统一展示电商价格与财务金额，彻底摆脱 CSS 变量与 !important；
 * 2. 具备分转元换算、digits 精度保留（-1 / 0 / 1 / 2）与自定义 formatter；
 * 3. 具备三种排版字号形态（styleType 1/2/3），支持符号与角分差异化字号智能缩减；
 * 4. 支持划线价原价展示 (isSuggestPrice) 与文本底部基线自然对齐。
 */
import { computed } from 'vue'
import { formatPx, px2rpx } from '../../utils/utils.uts'

defineOptions({
	name: 'ste-price',
	options: {
		virtualHost: true
	}
})

/**
 * Props 入参属性声明
 */
const props = withDefaults(
	defineProps<{
		/** 价格数值，支持数字或字符串格式 */
		value?: any
		/** 输入金额的单位：fen 分（默认，自动除以100转元） | yuan 元 */
		valueUnit?: string
		/** 保留小数位数：-1 自动去除末尾0 | 0 整数 | 1 保留一位 | 2 保留两位 */
		digits?: number
		/** 是否展示金额货币符号 */
		showUnit?: boolean
		/** 自定义货币符号，默认为 ¥ */
		unitSymbol?: string
		/** 整数部分基准字体尺寸（默认 30，支持 rpx/px 或纯数字） */
		fontSize?: any
		/** 正常价格颜色 */
		color?: string
		/** 划线价原价颜色 */
		linePriceColor?: string
		/** 文字行高（-1 代表由文字自适应，其它数值将被格式化为具体行高） */
		lineHeight?: number
		/** 是否开启原价划线模式 (添加中划线) */
		isSuggestPrice?: boolean
		/** 左外边距 */
		marginLeft?: any
		/** 右外边距 */
		marginRight?: any
		/** 上外边距 */
		marginTop?: any
		/** 下外边距 */
		marginBottom?: any
		/** 排版字号风格：1 数字统一步调符号缩微 | 2 经典电商前大后小 | 3 统一字号 */
		styleType?: number
		/** 是否加粗展示 */
		bold?: boolean
		/** 自定义价格格式化函数 */
		formatter?: ((val: any) => string) | null
	}>(),
	{
		value: 0,
		valueUnit: 'fen',
		digits: -1,
		showUnit: true,
		unitSymbol: '¥',
		fontSize: 30,
		color: '#FF1E19',
		linePriceColor: '#999999',
		lineHeight: -1,
		isSuggestPrice: false,
		marginLeft: 0,
		marginRight: 0,
		marginTop: 0,
		marginBottom: 0,
		styleType: 2,
		bold: false,
		formatter: null
	}
)

/**
 * 格式化后的完整价格数值字符串
 * 处理分转元、自定义格式化与小数精度
 */
const formattedPriceStr = computed<string>(() : string => {
	if (props.formatter != null) {
		return props.formatter!(props.value)
	}

	const raw = props.value
	if (raw == null || raw === '') {
		return '0'
	}

	let num = 0.0
	if (typeof raw === 'number') {
		num = (raw as number).toDouble()
	} else {
		const parsed = parseFloat(raw.toString())
		num = isNaN(parsed) ? 0.0 : parsed
	}

	// 分转元处理
	if (props.valueUnit == 'fen') {
		num = num / 100.0
	}

	// 精度处理
	if (props.digits == -1) {
		const s = num.toString()
		if (s.includes('.')) {
			// 清除末尾无意义的连续 0
			let trimmed = s.replace(/0+$/, '')
			if (trimmed.endsWith('.')) {
				trimmed = trimmed.slice(0, -1)
			}
			return trimmed
		}
		return s
	} else {
		return num.toFixed(props.digits)
	}
})

/**
 * 整数部分提取
 */
const yuanPart = computed<string>(() : string => {
	const s = formattedPriceStr.value
	if (s.includes('.')) {
		return s.split('.')[0]
	}
	return s
})

/**
 * 小数角分部分提取（含小数点，如 .99）
 */
const fenPart = computed<string>(() : string => {
	const s = formattedPriceStr.value
	if (s.includes('.')) {
		return '.' + s.split('.')[1]
	}
	return ''
})

/**
 * 解析用户传入的 fontSize 为纯 rpx 参照数值
 */
function getBaseFontSizeNum() : number {
	const val = props.fontSize
	if (typeof val === 'number') {
		return val as number
	}
	const str = val.toString().trim()
	if (str.endsWith('rpx')) {
		return parseFloat(str.replace('rpx', ''))
	}
	if (str.endsWith('px')) {
		const px = parseFloat(str.replace('px', ''))
		return px2rpx(px)
	}
	const n = parseFloat(str)
	return isNaN(n) ? 30 : n
}

/**
 * 计算角分/货币符号等次要元素的缩小字号数值 (rpx)
 */
function calcMinorFontSizeNum() : number {
	const baseNum = getBaseFontSizeNum()
	let targetNum = baseNum

	if (props.styleType == 1) {
		// 风格 1：整数和小数等大，仅符号缩小
		if (baseNum <= 40) {
			targetNum = 20
		} else {
			targetNum = baseNum - 20
		}
	} else if (props.styleType == 3) {
		// 风格 3：全部等大
		targetNum = baseNum
	} else {
		// 风格 2：经典电商前大后小，符号与角分均缩小
		if (baseNum <= 28) {
			targetNum = baseNum
		} else if (baseNum <= 40) {
			targetNum = 20
		} else {
			targetNum = baseNum - 20
		}
	}
	return targetNum
}

/**
 * 计算角分/货币符号等次要元素的缩小字号 (px)
 */
function calcMinorFontSizePx() : string {
	return formatPx(calcMinorFontSizeNum())
}

/**
 * 计算次要小字号相对于基准整数大字号的垂直平移校准值 (px)
 * 解决 Android 原生 TextView 在字号不同时底部空隙不一致导致的“视觉下沉”问题
 * 采用 transform: translateY 具有绝对生效且不受 Flex 盒模型限制的优势
 */
function calcMinorTranslateY() : string {
	if (props.isSuggestPrice) {
		return '0px'
	}
	const baseNum = getBaseFontSizeNum()
	const minorNum = calcMinorFontSizeNum()
	const diff = baseNum - minorNum
	if (diff <= 0) {
		return '0px'
	}
	// 依据移动端原生字体体系基线以下 Descent 留白比例 (0.35) 计算向上平移量
	const offsetRpx = diff * 0.35
	return formatPx(offsetRpx)
}

/**
 * 实际生效的文字颜色
 */
const effectiveTextColor = computed<string>(() : string => {
	return props.isSuggestPrice ? props.linePriceColor : props.color
})

/**
 * 实际生效的划线装饰
 */
const effectiveTextDecoration = computed<string>(() : string => {
	return props.isSuggestPrice ? 'line-through' : 'none'
})

/**
 * 根容器样式绑定（控制外边距与横向底部对齐强约束）
 */
const rootContainerStyle = computed<string>(() : string => {
	const ml = formatPx(props.marginLeft)
	const mr = formatPx(props.marginRight)
	const mt = formatPx(props.marginTop)
	const mb = formatPx(props.marginBottom)
	return `display: flex; flex-direction: row; align-items: flex-end; margin-left: ${ml}; margin-right: ${mr}; margin-top: ${mt}; margin-bottom: ${mb};`
})

/**
 * 货币符号样式
 */
const unitStyle = computed<string>(() : string => {
	const colorProp = `color: ${effectiveTextColor.value};`
	const decorProp = `text-decoration: ${effectiveTextDecoration.value};`

	let sizePx = formatPx(props.fontSize)
	let transformProp = ''
	if (!props.isSuggestPrice && props.styleType != 3) {
		sizePx = calcMinorFontSizePx()
		const transY = calcMinorTranslateY()
		if (transY != '0px') {
			transformProp = `transform: translateY(-${transY});`
		}
	}
	const sizeProp = `font-size: ${sizePx};`
	const weightProp = props.bold ? 'font-weight: bold;' : ''
	const alignSelfProp = 'align-self: flex-end;'
	// 当未显式指定 lineHeight 时，不输出行高，让原生 TextView 采用自然紧凑度量，避免人为引入额外留白
	const lineHProp = props.lineHeight != -1 ? `line-height: ${formatPx(props.lineHeight)};` : ''

	return `${colorProp} ${decorProp} ${sizeProp} ${weightProp} ${alignSelfProp} ${transformProp} ${lineHProp}`
})

/**
 * 整数部分样式
 */
const yuanStyle = computed<string>(() : string => {
	const colorProp = `color: ${effectiveTextColor.value};`
	const decorProp = `text-decoration: ${effectiveTextDecoration.value};`
	const sizePx = formatPx(props.fontSize)
	const sizeProp = `font-size: ${sizePx};`
	const weightProp = props.bold ? 'font-weight: bold;' : ''
	const alignSelfProp = 'align-self: flex-end;'
	// 当未显式指定 lineHeight 时，不输出行高，采用自然紧凑度量
	const lineHProp = props.lineHeight != -1 ? `line-height: ${formatPx(props.lineHeight)};` : ''

	return `${colorProp} ${decorProp} ${sizeProp} ${weightProp} ${alignSelfProp} ${lineHProp}`
})

/**
 * 小数角分部分样式
 */
const fenStyle = computed<string>(() : string => {
	const colorProp = `color: ${effectiveTextColor.value};`
	const decorProp = `text-decoration: ${effectiveTextDecoration.value};`

	let sizePx = formatPx(props.fontSize)
	let transformProp = ''
	if (!props.isSuggestPrice && props.styleType == 2) {
		// 经典电商风格 2 下，角分小数部分按规则缩小，并做基线对齐向上平移校准
		sizePx = calcMinorFontSizePx()
		const transY = calcMinorTranslateY()
		if (transY != '0px') {
			transformProp = `transform: translateY(-${transY});`
		}
	}
	const sizeProp = `font-size: ${sizePx};`
	const weightProp = props.bold ? 'font-weight: bold;' : ''
	const alignSelfProp = 'align-self: flex-end;'
	// 当未显式指定 lineHeight 时，不输出行高，采用自然紧凑度量
	const lineHProp = props.lineHeight != -1 ? `line-height: ${formatPx(props.lineHeight)};` : ''

	return `${colorProp} ${decorProp} ${sizeProp} ${weightProp} ${alignSelfProp} ${transformProp} ${lineHProp}`
})
</script>

<style>
.ste-price-root {
	display: flex;
	flex-direction: row;
	align-items: flex-end;
}

.ste-price-unit {
	margin-right: 2rpx;
	align-self: flex-end;
}

.ste-price-yuan {
	align-self: flex-end;
}

.ste-price-fen {
	align-self: flex-end;
}
</style>
