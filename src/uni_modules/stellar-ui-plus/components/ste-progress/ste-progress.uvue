<template>
	<!-- 根容器：相对定位，尺寸由 width 与 strokeWidth 控制 -->
	<view class="ste-progress-root" :style="rootStyle">
		<!-- 未激活轨道背景层 -->
		<view class="ste-progress-inactive" :style="inactiveStyle"></view>

		<!-- 分段多阶段模式（当配置了 stageData 时优先展示） -->
		<view v-if="hasStage" class="ste-progress-stage-container">
			<view
				v-for="(stage, index) in stageList"
				:key="index"
				class="ste-progress-stage-item"
				:style="stage.boxStyle"
			>
				<text class="ste-progress-stage-text" :style="stage.textStyle">{{ stage.label }}</text>
			</view>
		</view>

		<!-- 普通连续进度模式（无分段配置时常驻展示，通过 width 驱动原生平滑过渡） -->
		<view
			v-else
			class="ste-progress-active"
			:style="activeStyle"
		>
			<!-- 支持默认插槽自定义激活条内部内容 -->
			<slot v-if="haveSlot"></slot>
			<!-- 默认展示文字内容 -->
			<text v-else-if="activeText != ''" class="ste-progress-text" :style="textStyle">
				{{ activeText }}
			</text>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * ste-progress 进度条组件
 *
 * 模块职责：
 * 1. 跨端统一展示任务进度、加载比例、分段阶梯与达成状态；
 * 2. 彻底摆脱对 CSS 变量的依赖，全部重构为原生动态内联样式；
 * 3. 完美支持纯色（Hex/RGB）与线性渐变背景（linear-gradient）；
 * 4. 支持分段阶梯里程碑（stageData）展示、文字阈值防溢出与丝滑动画过渡。
 */
import { ref, computed, watch, onMounted, onUnmounted, useSlots } from 'vue'
import { useColorStore } from '../../store/color.uts'
import { addUnit, bg2style, deepMerge } from '../../utils/utils.uts'

defineOptions({
	name: 'ste-progress',
	options: {
		virtualHost: true
	}
})

/**
 * 分段项内部解析数据模型
 */
type ParsedStageItem = {
	percent: number
	label: string
	boxStyle: UTSJSONObject
	textStyle: UTSJSONObject
}

/**
 * Props 入参属性声明
 */
const props = withDefaults(
	defineProps<{
		/** 进度百分比（0 ~ 100） */
		percentage?: number
		/** 激活进度条背景（支持纯色、RGBA 或 linear-gradient 渐变值） */
		activeBg?: string
		/** 未激活底轨背景（支持纯色、RGBA 等） */
		inactiveBg?: string
		/** 进度条高度粗细（支持 rpx/px 或纯数字，默认 24） */
		strokeWidth?: any
		/** 进度条整体宽度（支持 rpx/px/%，默认 100%） */
		width?: any
		/** 进度过渡动画时长（秒，默认 0.3） */
		duration?: number
		/** 是否禁用状态（置灰呈现） */
		disabled?: boolean
		/** 自定义内部展示文字（默认显示 "${percentage}%"） */
		pivotText?: string
		/** 内部文字颜色 */
		textColor?: string
		/** 文字水平对齐方式（'left' | 'center' | 'right'，默认 'right'） */
		textAlign?: string
		/** 文字字号（支持 rpx/px 或纯数字，默认 16） */
		textSize?: any
		/** 进度小于该阈值时隐藏文字（避免窄条产生文字挤压溢出，默认 0） */
		displayTextThreshold?: number
		/** 是否显示进度文字内容（默认 true） */
		showPivot?: boolean
		/** 分段进度配置数据对象，如 { 20: { label: '待支付' }, 80: { label: '已发货' } } */
		stageData?: UTSJSONObject | null
	}>(),
	{
		percentage: 0,
		activeBg: '',
		inactiveBg: '#eeeeee',
		strokeWidth: 24,
		width: '100%',
		duration: 0.3,
		disabled: false,
		pivotText: '',
		textColor: '#ffffff',
		textAlign: 'right',
		textSize: 16,
		displayTextThreshold: 0,
		showPivot: true,
		stageData: null
	}
)

const colorStore = useColorStore()
const slots = useSlots()

/** 当前实际目标受控进度数值 (0 ~ 100) */
const realPercentage = ref<number>(0)
/** 当前视图渲染呈现的插值进度数值 (0 ~ 100)，驱动平滑补间动画 */
const displayPercentage = ref<number>(0)
/** 标记组件是否已完成初次挂载就绪 */
const isMountedReady = ref<boolean>(false)
/** 是否包含默认插槽 */
const haveSlot = ref<boolean>(false)

/** 补间动画定时器句柄 */
let animTimer: number = 0

/**
 * 二次方缓动曲线（Ease-Out Quad），实现起步轻快、结尾平缓吸附的物理动效
 * @param t 当前时间归一化比例 (0.0 ~ 1.0)
 * @return 缓动计算后的进度系数 (0.0 ~ 1.0)
 */
function easeOutQuad(t: number): number {
	return t * (2 - t)
}

/**
 * 启动进度值高帧率平滑补间动画
 * @param fromVal 动画起始百分比
 * @param toVal 动画目标百分比
 * @param durationSec 动画总时长（秒）
 */
function startAnimation(fromVal: number, toVal: number, durationSec: number) {
	// 如果之前已有正在执行的补间动画，先清除上一个定时器，无缝衔接当前所在值
	if (animTimer != 0) {
		clearInterval(animTimer)
		animTimer = 0
	}

	// 若动画时长小于等于0，或起止值一致，则直接赋值目标值
	if (durationSec <= 0 || fromVal == toVal) {
		displayPercentage.value = toVal
		return
	}

	const durationMs = durationSec * 1000
	const startTime = Date.now()
	const diff = toVal - fromVal

	animTimer = setInterval(() => {
		const elapsed = Date.now() - startTime
		const progress = Math.min(1, elapsed / durationMs)
		const easedT = easeOutQuad(progress)
		const currentVal = fromVal + diff * easedT

		if (progress >= 1) {
			displayPercentage.value = toVal
			if (animTimer != 0) {
				clearInterval(animTimer)
				animTimer = 0
			}
		} else {
			// 保留一位小数，兼顾 60FPS 平滑过渡与计算性能
			displayPercentage.value = Math.round(currentVal * 10) / 10
		}
	}, 16)
}

onMounted(() => {
	haveSlot.value = slots['default'] != null
	isMountedReady.value = true
})

onUnmounted(() => {
	if (animTimer != 0) {
		clearInterval(animTimer)
		animTimer = 0
	}
})

/**
 * 安全约束百分比处于 [0, 100] 区间
 */
function clampPercentage(val: number): number {
	if (val < 0) return 0
	if (val > 100) return 100
	return val
}

// 监听外部 percentage 属性更新
watch(
	() : number => props.percentage,
	(val: number) => {
		const targetVal = clampPercentage(val)
		realPercentage.value = targetVal

		if (!isMountedReady.value) {
			// 初次挂载前直接赋值，避免页面首次进入时产生无谓闪烁
			displayPercentage.value = targetVal
		} else {
			// 后续动态更新触发补间动画引擎
			startAnimation(displayPercentage.value, targetVal, props.duration)
		}
	},
	{ immediate: true }
)

/**
 * 跨平台安全提取 UTSJSONObject 的键列表
 */
function getJsonObjectKeys(obj: UTSJSONObject | null): string[] {
	if (obj == null) return []
	const list: string[] = []
	// #ifdef APP-ANDROID || APP-IOS
	const map = obj.toMap()
	const mapKeys = map.keys
	const iter = mapKeys.iterator()
	while (iter.hasNext()) {
		list.push(iter.next()!)
	}
	// #endif
	// #ifdef H5 || MP-WEIXIN || MP-ALIPAY
	const objKeys = Object.keys(obj as any)
	for (let i = 0; i < objKeys.length; i++) {
		list.push(objKeys[i].toString())
	}
	// #endif
	return list
}

/**
 * 是否启用了分段多阶段模式
 */
const hasStage = computed<boolean>(() : boolean => {
	if (props.stageData == null) return false
	const keys = getJsonObjectKeys(props.stageData)
	return keys.length > 0
})

/**
 * 根容器内联样式
 */
const rootStyle = computed<UTSJSONObject>(() : UTSJSONObject => {
	const style: UTSJSONObject = {
		position: 'relative',
		width: addUnit(props.width),
		height: addUnit(props.strokeWidth)
	}
	return style
})

/**
 * 未激活底轨内联样式
 */
const inactiveStyle = computed<UTSJSONObject>(() : UTSJSONObject => {
	let style: UTSJSONObject = {
		width: '100%',
		height: '100%',
		borderRadius: '9999px'
	}
	if (props.disabled) {
		style['backgroundColor'] = '#eeeeee'
	} else {
		style = deepMerge(style, bg2style(props.inactiveBg)) as UTSJSONObject
	}
	return style
})

/**
 * 激活进度条内联样式
 */
const activeStyle = computed<UTSJSONObject>(() : UTSJSONObject => {
	let style: UTSJSONObject = {
		position: 'absolute',
		left: 0,
		top: 0,
		height: '100%',
		width: `${displayPercentage.value}%`,
		borderRadius: '9999px',
		display: 'flex',
		flexDirection: 'row',
		alignItems: 'center'
	}

	// 依据 textAlign 属性决定水平对齐方式
	if (props.textAlign == 'left') {
		style['justifyContent'] = 'flex-start'
	} else if (props.textAlign == 'center') {
		style['justifyContent'] = 'center'
	} else {
		style['justifyContent'] = 'flex-end'
	}

	// 当存在默认插槽时不设置内边距，文本展示时设置两端微小内边距保护
	if (!haveSlot.value) {
		style['paddingLeft'] = '16rpx'
		style['paddingRight'] = '16rpx'
	}

	// 禁用状态下统一置灰，否则采用传入的 activeBg 或全局主题色
	if (props.disabled) {
		style['backgroundColor'] = '#cccccc'
	} else {
		const bg = props.activeBg != '' ? props.activeBg : colorStore.getColor().steThemeColor
		style = deepMerge(style, bg2style(bg)) as UTSJSONObject
	}

	return style
})

/**
 * 激活进度条内部展示文本
 */
const activeText = computed<string>(() : string => {
	// 如果显式关闭了文字显示，则直接返回空
	if (props.showPivot == false) {
		return ''
	}
	// 如果设置了显示文字阈值，且当前进度低于阈值，则不显示文字以防溢出
	if (props.displayTextThreshold > 0 && displayPercentage.value < props.displayTextThreshold) {
		return ''
	}
	if (props.pivotText != '') {
		return props.pivotText
	}
	if (displayPercentage.value <= 0) {
		return ''
	}
	// 动态展示平滑四舍五入后的整数百分比
	return `${Math.round(displayPercentage.value)}%`
})

/**
 * 文本样式绑定
 */
const textStyle = computed<UTSJSONObject>(() : UTSJSONObject => {
	return {
		color: props.textColor,
		fontSize: addUnit(props.textSize),
		lineHeight: '1',
		whiteSpace: 'nowrap'
	} as UTSJSONObject
})

/**
 * 分段数据列表解析（按阶段数值排序，并构建多层叠加与文字定位样式）
 */
const stageList = computed<Array<ParsedStageItem>>(() : Array<ParsedStageItem> => {
	if (props.stageData == null) return []

	const rawObj = props.stageData!
	const keys = getJsonObjectKeys(rawObj)
	if (keys.length == 0) return []

	// 将字符串键转换为数字并从小到大排序
	const numKeys : number[] = []
	for (let i = 0; i < keys.length; i++) {
		const parsed = parseFloat(keys[i])
		if (!isNaN(parsed)) {
			numKeys.push(parsed)
		}
	}
	numKeys.sort((a : number, b : number) : number => a - b)

	const result : ParsedStageItem[] = []
	const totalStages = numKeys.length

	for (let i = 0; i < totalStages; i++) {
		const stageVal = numKeys[i]
		const itemObj = rawObj[stageVal.toString()] as UTSJSONObject | null

		let labelText = ''
		let customStyle : UTSJSONObject = {}
		if (itemObj != null) {
			if (itemObj['label'] != null) {
				labelText = itemObj['label']!.toString()
			}
			if (itemObj['style'] != null && typeof itemObj['style'] === 'object') {
				customStyle = itemObj['style'] as UTSJSONObject
			}
		}

		// 阶段容器样式：宽度等于该阶段的目标百分比，倒序分配 zIndex 使前面的阶段层叠在上方
		let boxStyle : UTSJSONObject = {
			position: 'absolute',
			left: 0,
			top: 0,
			height: '100%',
			width: `${clampPercentage(stageVal)}%`,
			zIndex: totalStages - i,
			borderRadius: '9999px',
			display: 'flex',
			flexDirection: 'row',
			alignItems: 'center',
			justifyContent: 'flex-end',
			paddingRight: '12rpx'
		}

		// 解析用户针对该分段自定义的背景与文字样式
		if (customStyle['background'] != null) {
			boxStyle = deepMerge(boxStyle, bg2style(customStyle['background']!.toString())) as UTSJSONObject
		} else if (customStyle['backgroundColor'] != null) {
			boxStyle['backgroundColor'] = customStyle['backgroundColor']
		} else {
			boxStyle['backgroundColor'] = colorStore.getColor().steThemeColor
		}

		// 阶段文字宽度计算：首个阶段占满当前块宽度，后续阶段计算相对于前一阶段的增量宽度
		let textW = '100%'
		let txtAlign = 'center'
		if (i > 0) {
			const prevVal = numKeys[i - 1]
			const widthRatio = (stageVal - prevVal) / stageVal
			textW = `${widthRatio * 100}%`
		}
		if (customStyle['textAlign'] != null) {
			txtAlign = customStyle['textAlign']!.toString()
		}

		const textStyle : UTSJSONObject = {
			width: textW,
			textAlign: txtAlign,
			color: props.textColor,
			fontSize: addUnit(props.textSize),
			lineHeight: '1',
			whiteSpace: 'nowrap'
		}

		result.push({
			percent: stageVal,
			label: labelText,
			boxStyle,
			textStyle
		})
	}

	return result
})
</script>

<style>
.ste-progress-root {
	position: relative;
	overflow: hidden;
}

.ste-progress-inactive {
	position: absolute;
	left: 0;
	top: 0;
}

.ste-progress-stage-container {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

.ste-progress-stage-item {
	position: absolute;
	left: 0;
	top: 0;
}

.ste-progress-stage-text {
	overflow: hidden;
	text-overflow: ellipsis;
}

.ste-progress-active {
	position: absolute;
	left: 0;
	top: 0;
}

.ste-progress-text {
}
</style>
