/**
 * @file constants.uts
 * @description ste-qrcode 二维码组件的属性类型定义与默认常量配置
 */

/**
 * QRCode 组件属性类型定义
 */
export type QRCodeProps = {
    /**
     * 二维码内容（必填，如网址、纯文本或编码数据）
     * @default ''
     */
    content : string,
    /**
     * 二维码尺寸（单位: px 或 rpx 数字/字符串）
     * @default 200
     */
    size ?: any,
    /**
     * 二维码背景颜色
     * @default '#ffffff'
     */
    background ?: string,
    /**
     * 二维码前景色（画笔色块颜色）
     * @default '#000000'
     */
    foreground ?: string,
    /**
     * 二维码中心 Logo 图标链接
     * @default ''
     */
    foregroundImageSrc ?: string,
    /**
     * Logo 图标宽度（为 null 时默认取二维码尺寸的 1/4）
     * @default null
     */
    foregroundImageWidth ?: any,
    /**
     * Logo 图标高度（为 null 时默认取二维码尺寸的 1/4）
     * @default null
     */
    foregroundImageHeight ?: any,
    /**
     * 根节点自定义样式
     */
    rootStyle ?: UTSJSONObject,
}
