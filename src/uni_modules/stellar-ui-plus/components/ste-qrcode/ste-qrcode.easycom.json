{
    "name": "ste-qrcode",
    "description": "二维码组件",
    "example": "<ste-qrcode content='https://example.com'></ste-qrcode>",
    "tutorial": "https://stellar-ui.intecloud.com.cn/?projectName=stellar-ui-plus&menu=%E7%BB%84%E4%BB%B6&active=ste-qrcode",
    "attributes": [
        {
            "name": "content",
            "description": "二维码内容",
            "type": "string"
        },
        {
            "name": "size",
            "description": "二维码尺寸，单位`px`",
            "type": "number"
        },
        {
            "name": "background",
            "description": "背景色",
            "type": "string"
        },
        {
            "name": "foreground",
            "description": "前景色(条形码画笔颜色)",
            "type": "string"
        },
        {
            "name": "foregroundImageSrc",
            "description": "二维码中间logo图",
            "type": "string"
        },
        {
            "name": "foregroundImageWidth",
            "description": "logo图宽度，默认二维码尺寸的四分之一",
            "type": "string",
            "default": "size / 4"
        },
        {
            "name": "foregroundImageHeight",
            "description": "logo图高度，默认二维码尺寸的四分之一",
            "type": "string",
            "default": "size / 4"
        },
        {
            "name": "rootStyle",
            "description": "根节点原生样式对象[仅UVue支持]",
            "type": "object",
            "default": {}
        },
        {
            "name": "[event]loadImage",
            "description": "加载完成后返回条形码对应的图片数据",
            "params": [
                {
                    "name": "src",
                    "description": "图片数据"
                }
            ]
        },
        {
            "name": "[event]success",
            "description": "二维码生成成功时触发",
            "params": [
                {
                    "name": "result",
                    "description": "生成结果对象"
                }
            ]
        },
        {
            "name": "[event]error",
            "description": "二维码生成失败时触发",
            "params": [
                {
                    "name": "error",
                    "description": "错误信息"
                }
            ]
        },
        {
            "name": "[event]click",
            "description": "点击二维码图片时触发",
            "params": []
        }
    ],
    "uvue_diff": {
        "styling": "UVue 端新增 rootStyle 原生样式对象支持；基于 uts 原生 Canvas 2D 绘制"
    }
}
