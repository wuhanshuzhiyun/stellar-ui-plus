{
    "name": "ste-radio-group",
    "description": "",
    "attributes": [
        {
            "name": "value",
            "description": "当前选中值（支持v-model双向绑定）",
            "type": "String"
        },
        {
            "name": "direction",
            "description": "排列方式",
            "type": "String",
            "default": "column",
            "values": [
                {
                    "name": "row",
                    "description": "横向"
                },
                {
                    "name": "column",
                    "description": "纵向"
                }
            ]
        },
        {
            "name": "disabled",
            "description": "是否禁用",
            "type": "Boolean",
            "default": false
        },
        {
            "name": "readonly",
            "description": "只读 (不置灰)",
            "type": "Boolean",
            "default": false
        },
        {
            "name": "shape",
            "description": "形状",
            "type": "String",
            "default": "circle",
            "values": [
                {
                    "name": "circle",
                    "description": "圆形"
                },
                {
                    "name": "squar",
                    "description": "方形"
                }
            ]
        },
        {
            "name": "iconSize",
            "description": "图标大小，单位rpx",
            "type": "Number/String",
            "default": 36
        },
        {
            "name": "checkedColor",
            "description": "选中状态的图标颜色",
            "type": "String",
            "default": "#0090FF"
        },
        {
            "name": "textPosition",
            "description": "文本的位置",
            "type": "String",
            "default": "right",
            "values": [
                {
                    "name": "right",
                    "description": "右"
                },
                {
                    "name": "left",
                    "description": "左"
                }
            ]
        },
        {
            "name": "textSize",
            "description": "文本字体大小，单位rpx",
            "type": "Number/String",
            "default": 25
        },
        {
            "name": "textlnactiveColor",
            "description": "未选中文本颜色",
            "type": "String",
            "default": "#000000"
        },
        {
            "name": "textActiveColor",
            "description": "选中文本颜色",
            "type": "String",
            "default": "#000000"
        },
        {
            "name": "textDisabled",
            "description": "禁用文本点击",
            "type": "Boolean",
            "default": false
        },
        {
            "name": "marginLeft",
            "description": "左边距,单位rpx",
            "type": "Number/String",
            "default": 0,
            "version": "v1.10.0"
        },
        {
            "name": "marginRight",
            "description": "右边距,单位rpx",
            "type": "Number/String",
            "default": 0,
            "version": "v1.10.0"
        },
        {
            "name": "columnGap",
            "description": "单选框和文本间距，单位rpx",
            "type": "Number/String",
            "default": 16,
            "version": "v1.10.0"
        },
        {
            "name": "[event]change",
            "description": "当绑定值变化时触发的事件",
            "params": [
                {
                    "name": "value",
                    "description": "改变后的绑定值"
                }
            ]
        }
    ]
}
