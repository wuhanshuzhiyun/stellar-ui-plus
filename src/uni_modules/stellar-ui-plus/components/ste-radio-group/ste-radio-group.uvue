<template>
	<view class="ste-radio-group-root" :style="cmpRootStyle">
		<slot></slot>
	</view>
</template>

<script setup lang="uts">
	import { computed, provide } from 'vue'
	import type { RadioGroupContext } from '../ste-radio/radio-types.uts'

	defineOptions({ name: 'ste-radio-group', options: { virtualHost: true } })

	type RadioGroupProps = {
		modelValue ?: string,
		direction ?: string,
		disabled ?: boolean,
		readonly ?: boolean,
		shape ?: string,
		iconSize ?: string | number,
		checkedColor ?: string,
		textPosition ?: string,
		textSize ?: string | number,
		textInactiveColor ?: string,
		textActiveColor ?: string,
		textDisabled ?: boolean,
		marginLeft ?: string | number,
		marginRight ?: string | number,
		columnGap ?: string | number,
	}

	const props = withDefaults(defineProps<RadioGroupProps>(), {
		modelValue: '',
		direction: 'row',
		disabled: false,
		readonly: false,
		shape: '',
		iconSize: '',
		checkedColor: '',
		textPosition: '',
		textSize: '',
		textInactiveColor: '',
		textActiveColor: '',
		textDisabled: false,
		marginLeft: '',
		marginRight: '',
		columnGap: '',
	})
	const emits = defineEmits(['change', 'update:modelValue'])

	// ============== provide 给子组件的 getter 函数 ==============

	const groupContext : RadioGroupContext = {
		getModelValue: () : string => props.modelValue,
		getDirection: () : string => props.direction,
		getDisabled: () : boolean => props.disabled,
		getReadonly: () : boolean => props.readonly,
		getShape: () : string => props.shape,
		getIconSize: () : string => {
			if (typeof props.iconSize === 'number') return '' + props.iconSize
			return props.iconSize as string
		},
		getCheckedColor: () : string => props.checkedColor,
		getTextPosition: () : string => props.textPosition,
		getTextSize: () : string => {
			if (typeof props.textSize === 'number') return '' + props.textSize
			return props.textSize as string
		},
		getTextInactiveColor: () : string => props.textInactiveColor,
		getTextActiveColor: () : string => props.textActiveColor,
		getTextDisabled: () : boolean => props.textDisabled,
		getMarginLeft: () : string => {
			if (typeof props.marginLeft === 'number') return '' + props.marginLeft
			return props.marginLeft as string
		},
		getMarginRight: () : string => {
			if (typeof props.marginRight === 'number') return '' + props.marginRight
			return props.marginRight as string
		},
		getColumnGap: () : string => {
			if (typeof props.columnGap === 'number') return '' + props.columnGap
			return props.columnGap as string
		},
		updateValue: (value : string) => {
			emits('change', value)
			emits('update:modelValue', value)
		},
	}

	provide<RadioGroupContext>('ste-radio', groupContext)

	const cmpRootStyle = computed(() : UTSJSONObject => {
		return {
			flexDirection: props.direction,
		} as UTSJSONObject
	})
</script>

<style>
.ste-radio-group-root {
	display: flex;
}
</style>
