<template>
	<view class="ste-search-box-root" :style="cmpRootStyle">
		<view class="search-box-main">
			<!-- 1. 左侧日期选择触发区 -->
			<view class="date-action" @click="handleActionClick">
				<!-- 单日期模式展示 -->
				<view v-if="props.type != 'dateRange'" class="date-single-wrap">
					<text class="date-text">{{ calendarStrs[0] }}</text>
				</view>
				<!-- 日期范围模式展示（起止双行） -->
				<view v-else class="date-range-wrap">
					<text class="date-range-text">{{ calendarStrs[0] }}</text>
					<text class="date-range-text">{{ calendarStrs.length > 1 ? calendarStrs[1] : '' }}</text>
				</view>
			</view>

			<!-- 垂直细分割线 -->
			<view class="divider" />

			<!-- 2. 搜索放大镜图标 -->
			<view class="search-icon-box">
				<ste-icon code="&#xe695;" color="#888C92" :size="32" />
			</view>

			<!-- 3. 搜索内容录入框（纯原生 input 直出，无嵌套阻碍，保障 100% 灵敏获焦与软键盘呼出） -->
			<view class="search-input-box">
				<input
					class="search-native-input"
					type="text"
					:value="inputValue"
					:placeholder="props.placeholder"
					:placeholder-style="cmpPlaceholderStyle"
					:confirm-type="props.confirmType"
					:style="cmpInputStyle"
					@input="handleInput"
					@confirm="handleInputConfirm"
				/>
				<!-- 清空按钮 -->
				<view
					v-if="props.clearable && inputValue.length > 0"
					class="search-clear-icon-box"
					@click.stop="handleInputClear"
				>
					<ste-icon code="&#xe694;" color="#C0C4CC" :size="28" />
				</view>
			</view>
		</view>

		<!-- 4. 右侧自定义扩展插槽 -->
		<view class="action-right">
			<slot name="right" />
		</view>

		<!-- 5. 底部日历选择弹窗：动态计算总高度与底部安全区避让，关闭多余关闭栏以预留全部垂直可视空间 -->
		<ste-popup v-model:show="showCalendar" position="bottom" :height="cmpPopupHeight" :round="true" :showClose="false">
			<view class="calendar-popup-content" :style="cmpCalendarPopupStyle">
				<ste-calendar
					:mode="calendarMode"
					:list="calendarValues"
					:monthCount="6"
					@confirm="handleCalendarConfirm"
				/>
			</view>
		</ste-popup>
	</view>
</template>

<script setup lang="uts">
	/**
	 * @file ste-search-box.uvue
	 * @description SearchBox 复合搜索框组件 - uni-app x / UTS 纯原生版本
	 * 整合日期/时间段筛选与文本关键字检索，支持单日期、日期范围选择、软键盘搜索响应及右侧扩展插槽。
	 */
	import { ref, computed, watch } from 'vue'
	import {
		SearchBoxProps,
		DEFAULT_SEARCH_BOX_PLACEHOLDER,
		DEFAULT_SEARCH_BOX_CONFIRM_TYPE,
	} from './props.uts'
	import { formatDate, DateType } from '../ste-calendar/date.uts'
	import { deepMerge, addUnit } from '../../utils/utils.uts'

	defineOptions({
		name: 'ste-search-box',
		options: {
			virtualHost: true,
		},
	})

	// ==================== 组件 Props 属性定义 ====================
	const props = withDefaults(defineProps<SearchBoxProps>(), {
		value: '',
		type: 'date',
		headerValue: '',
		placeholder: DEFAULT_SEARCH_BOX_PLACEHOLDER,
		height: '',
		textColor: '',
		placeholderColor: '',
		clearable: true,
		confirmType: DEFAULT_SEARCH_BOX_CONFIRM_TYPE,
		rootStyle: () => ({} as UTSJSONObject),
	})

	// ==================== 组件 Emits 事件声明 ====================
	const emit = defineEmits<{
		/** 输入框值变更时触发（用于 v-model:value 双向绑定） */
		(e: 'update:value', value : string) : void,
		/** 日期值变更时触发（用于 v-model:headerValue 双向绑定） */
		(e: 'update:headerValue', value : any) : void,
		/** 确定搜索时触发（键盘回车或点击清空） */
		(e: 'search', value : string) : void,
	}>()

	// ==================== 响应式状态 ====================
	/** 底部日历弹窗显隐控制 */
	const showCalendar = ref(false)

	/** 内部双向绑定的输入框文本 */
	const inputValue = ref(props.value != null ? '' + props.value : '')

	/** 内部日历选定的标准 YYYY-MM-DD 日期列表 */
	const calendarValues = ref<string[]>([])

	// 监听外部 value 属性变化并同步给 inputValue
	watch(() : any => props.value, (newVal : any) => {
		const str = newVal != null ? '' + newVal : ''
		if (inputValue.value != str) {
			inputValue.value = str
		}
	})

	// 监听内部 inputValue 变化并通知外部
	watch(inputValue, (newVal : string) => {
		emit('update:value', newVal)
	})

	// ==================== 日期格式与模式计算 ====================
	/**
	 * 日历组件的工作模式：单选 single / 范围选 range
	 */
	const calendarMode = computed(() : string => {
		return props.type == 'dateRange' ? 'range' : 'single'
	})

	/**
	 * 同步外部 headerValue 参数至内部标准日期列表
	 */
	function syncHeaderValue() {
		const nowStr = formatDate(new Date(), 'YYYY-MM-DD')
		let result : string[] = []
		if (props.type == 'dateRange') {
			if (Array.isArray(props.headerValue)) {
				const arr = props.headerValue as any[]
				const d1 = arr.length > 0 && arr[0] != null ? formatDate(arr[0] as DateType, 'YYYY-MM-DD') : nowStr
				const d2 = arr.length > 1 && arr[1] != null ? formatDate(arr[1] as DateType, 'YYYY-MM-DD') : nowStr
				result = [d1, d2]
			} else if (props.headerValue != null && ('' + props.headerValue) != '') {
				const d1 = formatDate(props.headerValue as DateType, 'YYYY-MM-DD')
				result = [d1, nowStr]
			} else {
				result = [nowStr, nowStr]
			}
		} else {
			if (Array.isArray(props.headerValue)) {
				const arr = props.headerValue as any[]
				const d1 = arr.length > 0 && arr[0] != null ? formatDate(arr[0] as DateType, 'YYYY-MM-DD') : nowStr
				result = [d1]
			} else if (props.headerValue != null && ('' + props.headerValue) != '') {
				result = [formatDate(props.headerValue as DateType, 'YYYY-MM-DD')]
			} else {
				result = [nowStr]
			}
		}
		calendarValues.value = result
	}

	watch(() : any => props.headerValue, () => {
		syncHeaderValue()
	}, { immediate: true })

	watch(() : string => props.type, () => {
		syncHeaderValue()
	})

	/**
	 * 头部展示所用的月日短字符串（如 '09-29'）
	 */
	const calendarStrs = computed(() : string[] => {
		if (calendarValues.value.length == 0) {
			const today = formatDate(new Date(), 'MM-DD')
			return [today]
		}
		if (props.type == 'dateRange') {
			const s1 = calendarValues.value.length > 0 ? formatDate(calendarValues.value[0], 'MM-DD') : ''
			const s2 = calendarValues.value.length > 1 ? formatDate(calendarValues.value[1], 'MM-DD') : ''
			return [s1, s2]
		} else {
			return [formatDate(calendarValues.value[0], 'MM-DD')]
		}
	})

	/**
	 * 根容器内联样式映射
	 */
	const cmpRootStyle = computed(() : UTSJSONObject => {
		const style = {} as UTSJSONObject
		if (props.height != null && ('' + props.height) != '') {
			style['height'] = addUnit(props.height)
		}
		return deepMerge(style, props.rootStyle) as UTSJSONObject
	})

	// ==================== 底部安全区域与弹窗高度计算 ====================
	/**
	 * 获取屏幕底部物理安全区高度（针对 iPhone Home Indicator 及全面屏手势条避让）
	 * @returns 底部安全区物理高度（px）
	 */
	function getSafeAreaBottom() : number {
		try {
			const sys = uni.getWindowInfo()
			if (sys.safeAreaInsets != null) {
				const b = sys.safeAreaInsets.bottom
				return b > 0 ? b : 0
			}
			if (sys.safeArea != null && sys.screenHeight > 0) {
				const b = sys.screenHeight - sys.safeArea.bottom
				return b > 0 ? b : 0
			}
		} catch (_e) {}
		return 0
	}

	/**
	 * 计算日历弹窗总高度（px 字符串）：
	 * 960rpx 基础高度叠加热区安全高度，显式携带 'px' 后缀，防止 ste-popup 内部 addUnit 二次误拼接 rpx 导致高度严重腰斩坍塌
	 */
	const cmpPopupHeight = computed(() : string => {
		const totalPx = uni.rpx2px(960) + getSafeAreaBottom()
		return `${totalPx}px`
	})

	/**
	 * 日历弹窗内容容器内联样式：
	 * 显式声明 height: 100% 与 box-sizing，保证弹性盒链条完整，内部日历可继承完整高度并避开底部安全区
	 */
	const cmpCalendarPopupStyle = computed(() : UTSJSONObject => {
		const safeBottom = getSafeAreaBottom()
		const basePadding = uni.rpx2px(24)
		const style : UTSJSONObject = {
			height: '100%',
			paddingBottom: (basePadding + safeBottom) + 'px',
			boxSizing: 'border-box',
		}
		return style
	})

	// ==================== 交互行为处理 ====================
	/**
	 * 点击左侧日期展示区唤起日历弹窗
	 */
	function handleActionClick() {
		showCalendar.value = true
	}

	/**
	 * 监听日历选定确定事件
	 */
	function handleCalendarConfirm(v : any) {
		if (Array.isArray(v)) {
			const list = v as any[]
			if (props.type == 'dateRange') {
				if (list.length >= 2) {
					calendarValues.value = ['' + list[0], '' + list[list.length - 1]]
				} else if (list.length == 1) {
					calendarValues.value = ['' + list[0], '' + list[0]]
				}
				emit('update:headerValue', calendarValues.value)
			} else {
				if (list.length > 0) {
					calendarValues.value = ['' + list[0]]
				}
				emit('update:headerValue', calendarValues.value[0])
			}
		}
		showCalendar.value = false
	}

	/**
	 * 文本输入事件处理，同步数据并派发更新
	 */
	function handleInput(e : InputEvent) {
		const val = e.detail.value != null ? '' + e.detail.value! : ''
		inputValue.value = val
		emit('update:value', val)
	}

	/**
	 * 计算输入框占位符样式
	 */
	const cmpPlaceholderStyle = computed(() : string => {
		const color = props.placeholderColor != '' ? props.placeholderColor : '#9CA3AF'
		return `color: ${color}; font-size: 26rpx;`
	})

	/**
	 * 计算输入框内联字体与颜色样式
	 */
	const cmpInputStyle = computed(() : string => {
		let styleStr = 'height: 100%; font-size: 26rpx;'
		if (props.textColor != '') {
			styleStr += `color: ${props.textColor};`
		} else {
			styleStr += 'color: #1F2937;'
		}
		return styleStr
	})

	/**
	 * 键盘确认或回车触发搜索
	 */
	function handleInputConfirm(_val : any) {
		emit('search', '' + inputValue.value)
	}

	/**
	 * 点击输入框清空按钮触发搜索
	 */
	function handleInputClear() {
		inputValue.value = ''
		emit('update:value', '')
		emit('search', '')
	}
</script>

<style scoped>
	/* 根容器：水平排布 */
	.ste-search-box-root {
		width: 100%;
		flex-direction: row;
		align-items: center;
	}

	/* 核心主输入与日期卡片盒 */
	.search-box-main {
		flex: 1;
		flex-direction: row;
		align-items: center;
		background-color: #ffffff;
		border-radius: 16rpx;
		padding: 0 16rpx;
		height: 72rpx;
	}

	/* 左侧日期交互入口 */
	.date-action {
		justify-content: center;
		align-items: center;
	}

	.date-single-wrap {
		justify-content: center;
		align-items: center;
		width: 80rpx;
	}

	.date-text {
		color: #0275ff;
		font-size: 24rpx;
		font-weight: 500;
	}

	.date-range-wrap {
		flex-direction: column;
		justify-content: center;
		align-items: center;
		width: 80rpx;
	}

	.date-range-text {
		color: #0275ff;
		font-size: 20rpx;
		line-height: 24rpx;
		font-weight: 500;
	}

	/* 垂直细分割线 */
	.divider {
		width: 2rpx;
		height: 26rpx;
		background-color: #e5e7eb;
		margin-left: 12rpx;
		margin-right: 12rpx;
	}

	/* 搜索放大镜图标容器 */
	.search-icon-box {
		justify-content: center;
		align-items: center;
		margin-right: 8rpx;
	}

	/* 文本输入框容器 */
	.search-input-box {
		flex: 1;
		height: 100%;
		flex-direction: row;
		align-items: center;
	}

	/* 原生搜索输入文本框 */
	.search-native-input {
		flex: 1;
		height: 100%;
		font-size: 26rpx;
		background-color: transparent;
		border-width: 0;
		padding: 0;
	}

	/* 清空按钮容器 */
	.search-clear-icon-box {
		height: 100%;
		width: 44rpx;
		justify-content: center;
		align-items: center;
	}

	/* 右侧扩展区 */
	.action-right {
		flex-direction: row;
		align-items: center;
	}

	/* 日历弹窗内容容器：采用弹性盒纵向撑满，显式声明高度 100% 消除 Yoga 引擎嵌套坍塌 */
	.calendar-popup-content {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		box-sizing: border-box;
	}
</style>
