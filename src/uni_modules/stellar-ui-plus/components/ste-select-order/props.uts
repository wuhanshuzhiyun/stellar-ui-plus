/**
 * ste-select-order 属性与类型定义
 *
 * @description 订单状态/下拉选择组件的属性配置与数据模型定义。
 * 适配 uni-app x / UTS 纯原生类型系统，提供健壮的动态键名解析与状态管理支持。
 */
import type { PropType } from 'vue';

/**
 * 下拉选项基础模型
 */
export type SelectOption = {
    /** 选项展示文案 */
    label?: string;
    /** 选项对应绑定的数据值 */
    value?: any;
    /** 是否禁用该选项 */
    disabled?: boolean;
};

/**
 * 选中的值类型
 */
export type SelectValue = any;

/**
 * ste-select-order Props 接口
 */
export type SteSelectOrderProps = {
    /** 当前选中的值 (v-model) */
    modelValue?: any;
    /** 候选列表数据源 */
    list?: any[];
    /** 未选择时的占位提示文本，默认 '请选择' */
    placeholder?: string;
    /** 选项展示文案在对象中的键名，默认 'label' */
    labelKey?: string;
    /** 选项数据值在对象中的键名，默认 'value' */
    valueKey?: string;
    /** 是否整体禁用组件 */
    disabled?: boolean;
    /** 点击遮罩层是否自动收起下拉面板，默认 true */
    maskClose?: boolean;
    /** 根节点额外样式字符串 */
    rootStyle?: string;
};

/**
 * 组件 Props 运行时默认属性配置
 */
export default {
    /** 当前选中的值 */
    modelValue: {
        type: null,
        default: null
    },
    /** 候选数据列表 */
    list: {
        type: Array as PropType<any[]>,
        default: (): any[] => [] as any[]
    },
    /** 占位提示文案 */
    placeholder: {
        type: String,
        default: '请选择'
    },
    /** 文案字段映射键名 */
    labelKey: {
        type: String,
        default: 'label'
    },
    /** 数值字段映射键名 */
    valueKey: {
        type: String,
        default: 'value'
    },
    /** 禁用状态 */
    disabled: {
        type: Boolean,
        default: false
    },
    /** 点击遮罩是否允许收起 */
    maskClose: {
        type: Boolean,
        default: true
    },
    /** 根节点样式 */
    rootStyle: {
        type: String,
        default: ''
    }
};
