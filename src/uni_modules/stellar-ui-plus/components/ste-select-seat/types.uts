/**
 * ste-select-seat 选座组件核心类型定义
 *
 * @description 声明座位坐标值、座位属性模型以及视口变换事件结构。
 * 适配 uni-app x / UTS 纯原生类型系统，严格遵守 Kotlin / Swift 空安全标准。
 */

/**
 * 选中的座位坐标模型
 */
export type SteSelectSeatValue = {
	/** 座位所在行号（从 0 开始计数） */
	row : number
	/** 座位所在列号（从 0 开始计数） */
	col : number
}

/**
 * 单个座位的属性配置数据模型
 */
export type SteSelectSeatItem = {
	/** 座位所在行号（从 0 开始计数） */
	row : number
	/** 座位所在列号（从 0 开始计数） */
	col : number
	/** 该座位是否已被锁定/售出禁用（默认 false） */
	disabled ?: boolean
	/** 是否为空位走道通道（为 true 时不渲染实体座位，默认 false） */
	empty ?: boolean
	/** 座位自定义默认背景颜色 */
	bgColor ?: string
	/** 座位自定义边框线条颜色 */
	borderColor ?: string
	/** 该座位被选中时的自定义高亮背景色 */
	selectedBgColor ?: string
	/** 该座位被选中时的内部对勾/文字颜色 */
	selectedColor ?: string
}

/**
 * 画布手势平移与缩放事件对象
 */
export type SteSelectSeatMoveEvent = {
	/** X 轴绝对平移偏移量（像素 px） */
	translateX : number
	/** Y 轴绝对平移偏移量（像素 px） */
	translateY : number
	/** 当前画布缩放倍数 */
	scale : number
	/** 屏幕视口水平中心平移量 */
	screenTranslateX : number
}

/**
 * 左侧行号标签渲染条目
 */
export type SteSelectSeatRowLabelItem = {
	/** 行号数值（从 0 开始计数，展示时 +1） */
	row : number
	/** 在视口中的 Y 轴绝对垂直坐标（像素 px） */
	top : number
	/** 当前缩放下的单行行高（像素 px） */
	rowHeight : number
}
