<template>
	<!-- ste-simple-calendar 简单日历胶囊根容器 -->
	<view
		:class="['ste-simple-calendar', props.customClass]"
		:style="[cmpRootStyle, props.rootStyle]"
		@click="handleClick"
	>
		<!-- 1. 日期数字区块（加粗大号展示当天日期） -->
		<view class="ste-simple-calendar-day-box">
			<text class="ste-simple-calendar-day" :style="{ color: props.color }">
				{{ dateInfo.day }}
			</text>
		</view>

		<!-- 2. 星期标签区块（竖向堆叠文字） -->
		<view class="ste-simple-calendar-week-box">
			<text
				v-for="(char, index) in weekChars"
				:key="index"
				class="ste-simple-calendar-week-text"
				:style="{ color: props.color }"
			>
				{{ char }}
			</text>
		</view>

		<!-- 3. 年月标题区块 -->
		<view class="ste-simple-calendar-month-box">
			<text class="ste-simple-calendar-month" :style="{ color: props.color }">
				{{ formattedMonth }}
			</text>
		</view>
	</view>

	<!-- 4. 底部日期选择弹窗（点击胶囊展开完整日历） -->
	<ste-popup
		:show="showPopup"
		:height="cmpPopupHeight"
		position="bottom"
		:showClose="false"
		@update:show="onPopupShowChange"
	>
		<view class="calendar-popup">
			<!-- 内嵌全功能日历选择器 -->
			<view class="calendar-wrapper">
				<ste-calendar
					:list="calendarList"
					:defaultDate="calendarDefaultDate"
					:showConfirm="false"
					:showTitle="false"
					:showMark="false"
					:monthCount="6"
					height="100%"
					@select="handleCalendarSelect"
				/>
			</view>

			<!-- 弹窗底部操作工具栏（重置 / 确认） -->
			<view class="action-box" :style="actionBoxStyle">
				<view class="action-btn-item">
					<ste-button
						mode="200"
						width="100%"
						background="#f5f5f5"
						borderColor="transparent"
						color="#666666"
						@click="handleReset"
					>
						<text class="btn-text reset-text">重置</text>
					</ste-button>
				</view>
				<view class="action-btn-item ml-20">
					<ste-button
						mode="200"
						width="100%"
						:background="themeColor"
						borderColor="transparent"
						color="#ffffff"
						@click="handleCalendarConfirm"
					>
						<text class="btn-text confirm-text">确认</text>
					</ste-button>
				</view>
			</view>
		</view>
	</ste-popup>
</template>

<script setup lang="uts">
	/**
	 * @file ste-simple-calendar.uvue
	 * @description SimpleCalendar 简单日历胶囊组件 - uni-app x / UTS 纯原生高性能版本
	 * 展示日、星期、年月迷你胶囊条，点击可联动拉起底部日历弹窗进行快捷切换选择。
	 */
	import { ref, computed, watch } from 'vue'
	import {
		SimpleCalendarProps,
		SimpleCalendarExpose,
		DateInfo,
		DEFAULT_SIMPLE_CALENDAR_FORMATTER,
		DEFAULT_SIMPLE_CALENDAR_WEEK_TEXTS,
		DEFAULT_SIMPLE_CALENDAR_COLOR,
	} from './props.uts'
	import {
		parseToDate,
		formatCalendarDate,
		createDateInfo,
	} from './useData.uts'
	import { useColorStore } from '../../store/color.uts'

	defineOptions({
		name: 'ste-simple-calendar',
		options: {
			virtualHost: true,
		},
	})

	// ==================== 组件 Props 声明 ====================
	const props = withDefaults(defineProps<SimpleCalendarProps>(), {
		date: null,
		formatter: DEFAULT_SIMPLE_CALENDAR_FORMATTER,
		weekTexts: () => DEFAULT_SIMPLE_CALENDAR_WEEK_TEXTS,
		color: DEFAULT_SIMPLE_CALENDAR_COLOR,
		showCalendar: true,
		rootStyle: () => ({} as UTSJSONObject),
		customClass: '',
	})

	// ==================== 组件 Emits 声明 ====================
	const emit = defineEmits<{
		/** 点击胶囊容器时触发，传递当前日期信息 */
		(e: 'click', dateInfo: DateInfo) : void,
		/** 选定日期发生变化时触发（包含初始化与弹窗确认） */
		(e: 'date-change', dateInfo: DateInfo) : void,
		(e: 'dateChange', dateInfo: DateInfo) : void,
	}>()

	// ==================== 内部日期响应式状态机 ====================
	const currentDate = ref<any | null>(props.date != null ? props.date : Date.now())

	/**
	 * 传递给内嵌日历组件的默认定位时间戳（基于当前已确认的基准日期）
	 * 严禁绑定为 pendingSelectedDate 计算属性！
	 * 否则在弹窗内点选下月日期时，会导致 ste-calendar 的 defaultDate 发生突变，
	 * 进而触发 getMonthList 重新以新月份为起点生成月份列表，导致当前月份及历史月份被截断丢失。
	 */
	const calendarDefaultDate = ref<number>(parseToDate(currentDate.value).getTime())

	const dateInfo = computed(() : DateInfo => {
		const d = parseToDate(currentDate.value)
		const texts = props.weekTexts != null && (props.weekTexts!).length >= 7
			? props.weekTexts!
			: DEFAULT_SIMPLE_CALENDAR_WEEK_TEXTS
		return createDateInfo(d, texts)
	})

	const formattedMonth = computed(() : string => {
		const d = parseToDate(currentDate.value)
		const fmt = props.formatter != null && props.formatter != ''
			? props.formatter!
			: DEFAULT_SIMPLE_CALENDAR_FORMATTER
		return formatCalendarDate(d, fmt)
	})

	// ==================== 底部日历弹窗控制 ====================
	const showPopup = ref(false)
	const pendingSelectedDate = ref<string>(dateInfo.value.date)

	/**
	 * 弹窗状态同步
	 */
	const onPopupShowChange = (val : boolean) => {
		showPopup.value = val
	}

	watch(
		() : any | null => props.date,
		(newVal : any | null) => {
			if (newVal != null) {
				currentDate.value = newVal
				const parsed = parseToDate(currentDate.value)
				calendarDefaultDate.value = parsed.getTime()
				pendingSelectedDate.value = formatCalendarDate(parsed, 'YYYY-MM-DD')
				emit('date-change', dateInfo.value)
				emit('dateChange', dateInfo.value)
			}
		}
	)

	/**
	 * 编程式设置选定日期
	 * @param {any} date 目标日期（支持标准字符串、时间戳或 Date 实例）
	 */
	const setDate = (date : any) => {
		currentDate.value = date
		const parsed = parseToDate(currentDate.value)
		calendarDefaultDate.value = parsed.getTime()
		pendingSelectedDate.value = formatCalendarDate(parsed, 'YYYY-MM-DD')
		emit('date-change', dateInfo.value)
		emit('dateChange', dateInfo.value)
	}

	/**
	 * 获取当前胶囊选定的详细日期数据对象
	 * @return {DateInfo} 结构化日期明细
	 */
	const getDateInfo = () : DateInfo => {
		return dateInfo.value
	}

	/**
	 * 编程式快速回到今天
	 */
	const today = () => {
		const todayDate = parseToDate(Date.now())
		const todayStr = formatCalendarDate(todayDate, 'YYYY-MM-DD')
		setDate(todayStr)
	}

	// ==================== 全局主题色状态 ====================
	const { getColor } = useColorStore()

	const themeColor = computed(() : string => {
		const colorConfig = getColor()
		return (colorConfig.steThemeColor != '') ? colorConfig.steThemeColor : '#0090FF'
	})

	// ==================== 响应式计算属性 ====================

	/**
	 * 将星期描述文本拆分为单字符数组，兼容原生跨端竖排循环渲染
	 */
	const weekChars = computed(() : string[] => {
		const txt = dateInfo.value.weekText
		const arr : string[] = []
		for (let i = 0; i < txt.length; i++) {
			arr.push(txt.charAt(i))
		}
		return arr
	})

	/**
	 * 根节点基础内联样式
	 */
	const cmpRootStyle = computed(() : UTSJSONObject => {
		return {} as UTSJSONObject
	})

	/**
	 * 传递给内嵌日历组件的高亮日期数组
	 */
	const calendarList = computed(() : string[] => {
		return [pendingSelectedDate.value]
	})



	/**
	 * 安全获取底部安全区高度（px）
	 */
	const getSafeAreaBottom = () : number => {
		try {
			const sys = uni.getWindowInfo()
			if (sys.safeArea != null && sys.screenHeight > 0) {
				const b = sys.screenHeight - sys.safeArea.bottom
				return b > 0 ? b : 0
			}
		} catch (_e) {}
		return 0
	}

	/**
	 * 弹窗高度（像素）：约占据屏幕 60%~65% 高度（基准 960rpx 换算为 px + 底部安全区），
	 * 彻底规避 uni-app x Android 原生不支持 vh 视口单位导致弹窗高度坍塌或被内容无限撑爆的问题
	 */
	const cmpPopupHeight = computed(() : string => {
		const totalPx = uni.rpx2px(960) + getSafeAreaBottom()
		return `${totalPx}px`
	})

	/**
	 * 确认操作按钮样式
	 */
	const confirmBtnStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		style['backgroundColor'] = themeColor.value
		return style
	})

	/**
	 * 底部操作工具栏安全区域间距计算
	 */
	const actionBoxStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		const safeBottom = getSafeAreaBottom()
		if (safeBottom > 0) {
			style['paddingBottom'] = `${safeBottom + 10}px`
		}
		return style
	})

	// ==================== 交互事件处理 ====================

	/**
	 * 点击胶囊触发
	 */
	const handleClick = () => {
		emit('click', dateInfo.value)
		if (props.showCalendar) {
			pendingSelectedDate.value = dateInfo.value.date
			calendarDefaultDate.value = parseToDate(currentDate.value).getTime()
			showPopup.value = true
		}
	}

	/**
	 * 在内嵌日历中点选日期
	 */
	const handleCalendarSelect = (days : any[], day : any) => {
		if (typeof day === 'string' && (day as string) != '') {
			pendingSelectedDate.value = day as string
		} else if (days.length > 0) {
			pendingSelectedDate.value = '' + days[0]
		}
	}

	/**
	 * 点击重置按钮：快速回到今天并关闭弹窗
	 */
	const handleReset = () => {
		today()
		showPopup.value = false
	}

	/**
	 * 点击确认按钮：应用当前选择的日期
	 */
	const handleCalendarConfirm = () => {
		setDate(pendingSelectedDate.value)
		calendarDefaultDate.value = parseToDate(pendingSelectedDate.value).getTime()
		showPopup.value = false
	}

	// ==================== 实例方法对外暴露 ====================
	defineExpose({
		setDate,
		getDateInfo,
		today,
	})
</script>

<style scoped>
	.ste-simple-calendar {
		display: flex;
		flex-direction: row;
		align-items: center;
		height: 48rpx;
	}

	/* 日期数字区块 */
	.ste-simple-calendar-day-box {
		background-color: #f3f3f3;
		border-radius: 4rpx;
		padding: 0 10rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		height: 100%;
		margin-right: 6rpx;
	}

	.ste-simple-calendar-day {
		font-size: 32rpx;
		font-weight: bold;
		line-height: 36rpx;
		text-align: center;
	}

	/* 星期文本区块 */
	.ste-simple-calendar-week-box {
		background-color: #f3f3f3;
		border-radius: 4rpx;
		padding: 0 10rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: 100%;
		margin-right: 6rpx;
	}

	.ste-simple-calendar-week-text {
		font-size: 16rpx;
		line-height: 18rpx;
		text-align: center;
	}

	/* 年月文本区块 */
	.ste-simple-calendar-month-box {
		background-color: #f3f3f3;
		border-radius: 4rpx;
		padding: 0 16rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		height: 100%;
	}

	.ste-simple-calendar-month {
		font-size: 24rpx;
		line-height: 28rpx;
		text-align: center;
	}

	/* 底部弹窗日历容器 */
	.calendar-popup {
		display: flex;
		flex-direction: column;
		height: 100%;
		width: 100%;
		background-color: #ffffff;
		overflow: hidden;
	}

	.calendar-wrapper {
		flex: 1;
		height: 0;
		min-height: 0;
		overflow: hidden;
	}

	.action-box {
		flex-shrink: 0;
		display: flex;
		flex-direction: row;
		padding: 20rpx 32rpx;
		background-color: #ffffff;
		border-top-width: 1rpx;
		border-top-style: solid;
		border-top-color: #f0f0f0;
	}

	.action-btn-item {
		flex: 1;
	}

	.ml-20 {
		margin-left: 20rpx;
	}

	.btn-text {
		font-size: 28rpx;
	}

	.reset-text {
		color: #666666;
	}

	.confirm-text {
		color: #ffffff;
		font-weight: bold;
	}
</style>
