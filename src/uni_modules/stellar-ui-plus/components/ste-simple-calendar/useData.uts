/**
 * @file useData.uts
 * @description ste-simple-calendar 简单日历核心日期计算与状态机模块
 * 采用原生 Date 纯原生实现，全面支持多平台时间戳、标准格式字符串与日期模板解析，彻底移除外部库依赖。
 */

import { computed, ref, watch } from 'vue'
import {
	DateInfo,
	SimpleCalendarProps,
	DEFAULT_SIMPLE_CALENDAR_FORMATTER,
	DEFAULT_SIMPLE_CALENDAR_WEEK_TEXTS,
} from './props.uts'

/**
 * 两位数前置补零工具函数
 * @param {number} n 目标数值
 * @return {string} 补零后的双字符文本
 */
export function padZero(n : number) : string {
	return n < 10 ? '0' + n : '' + n
}

/**
 * 将任意受支持的日期类型安全转换为标准 Date 实例
 * 针对各端（尤其是 iOS 内核）做多分隔符兼容解析
 * @param {any} value 输入的日期值（支持 Date、number、string 或 null/undefined）
 * @return {Date} 安全转换后的 Date 实例
 */
export function parseToDate(value : any | null) : Date {
	if (value == null) {
		return new Date()
	}
	if (value instanceof Date) {
		return value as Date
	}
	if (typeof value === 'number') {
		return new Date(value as number)
	}
	if (typeof value === 'string') {
		const str = (value as string).trim()
		if (str == '') {
			return new Date()
		}
		// 如果是纯数字时间戳字符串（如 "1700000000000"）
		const numVal = parseFloat(str)
		if (!Number.isNaN(numVal) && ('' + numVal) === str) {
			return new Date(numVal)
		}
		// 正则切分年月日时分秒（兼容 '-'、'/'、' '、':'、'T' 等）
		const parts = str.split(/[\-\/ :T]/)
		if (parts.length >= 2) {
			const y = parseInt(parts[0]!)
			const m = parseInt(parts[1]!) - 1
			const d = parts.length >= 3 ? parseInt(parts[2]!) : 1
			const h = parts.length >= 4 ? parseInt(parts[3]!) : 0
			const mi = parts.length >= 5 ? parseInt(parts[4]!) : 0
			const s = parts.length >= 6 ? parseInt(parts[5]!) : 0
			return new Date(y, m, d, h, mi, s)
		}
		return new Date(str)
	}
	return new Date()
}

/**
 * 按照指定格式化模板输出日期字符串
 * 支持占位符：YYYY(4位年)、MM(2位补零月)、M(单月)、DD(2位补零日)、D(单日)
 * @param {Date} d 标准 Date 实例
 * @param {string} formatter 格式模板
 * @return {string} 格式化结果文本
 */
export function formatCalendarDate(d : Date, formatter : string) : string {
	const year = '' + d.getFullYear()
	const month = d.getMonth() + 1
	const day = d.getDate()

	let res = formatter
	res = res.replace('YYYY', year)
	res = res.replace('MM', padZero(month))
	res = res.replace('M', '' + month)
	res = res.replace('DD', padZero(day))
	res = res.replace('D', '' + day)
	return res
}

/**
 * 根据 Date 对象和星期文本列表构造统一的 DateInfo 数据对象
 * @param {Date} d 标准 Date 对象
 * @param {string[]} weekTexts 星期文本数组
 * @return {DateInfo} 结构化日期明细
 */
export function createDateInfo(d : Date, weekTexts : string[]) : DateInfo {
	const year = d.getFullYear()
	const month = d.getMonth() + 1
	const day = d.getDate()
	const weekday = d.getDay()

	let weekText = '周日'
	if (weekday >= 0 && weekday < weekTexts.length) {
		weekText = weekTexts[weekday]!
	}

	const dateStr = `${year}-${padZero(month)}-${padZero(day)}`

	return {
		date: dateStr,
		year: year,
		month: month,
		day: day,
		weekday: weekday,
		weekText: weekText,
		timestamp: d.getTime(),
	} as DateInfo
}

