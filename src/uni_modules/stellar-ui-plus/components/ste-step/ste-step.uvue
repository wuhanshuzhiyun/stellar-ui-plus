<template>
	<!-- 横向布局模式 -->
	<view
		v-if="direction == 'row'"
		class="ste-step-row-item"
		:style="[cmpRootStyle, rootStyle]"
	>
		<!-- 步骤头部 (图标/点/数字 与 水平双半段连接线) -->
		<view class="ste-step-head-row" :class="[dot ? 'head-is-dot' : '']">
			<!-- 左半段水平连接线 (非第一步渲染，0% 到 50%) -->
			<view
				v-if="stepIndex > 1"
				class="ste-step-line-row-left"
				:style="cmpLineRowLeftStyle"
			></view>

			<!-- 右半段水平连接线 (非最后一步渲染，50% 到 100%) -->
			<view
				v-if="!isLast"
				class="ste-step-line-row-right"
				:style="cmpLineRowRightStyle"
			></view>

			<!-- 步骤圆形图标/圆点 (覆盖于连接线上方) -->
			<view
				class="ste-step-icon-wrap"
				:class="[dot ? 'icon-is-dot' : '']"
				:style="cmpIconWrapStyle"
				@click="handleClick"
			>
				<slot name="icon">
					<ste-icon
						v-if="!dot && displayIcon != ''"
						:code="displayIcon"
						:size="icon != '' ? 32 : 24"
						:color="displayIconColor"
					/>
					<text
						v-else-if="!dot"
						class="ste-step-num-text"
						:style="cmpNumTextStyle"
					>{{ stepIndex }}</text>
				</slot>
			</view>
		</view>

		<!-- 步骤文案区域 (标题与描述) -->
		<view class="ste-step-content-row" @click="handleClick">
			<view class="ste-step-title-wrap">
				<slot name="title">
					<text class="ste-step-title-text" :style="cmpTitleStyle">
						{{ title != '' ? title : '第' + stepIndex.toString() + '步' }}
					</text>
				</slot>
			</view>
			<view v-if="description != ''" class="ste-step-desc-wrap">
				<slot name="description">
					<text class="ste-step-desc-text" :style="cmpDescStyle">{{ description }}</text>
				</slot>
			</view>
		</view>
	</view>

	<!-- 纵向垂直布局模式 -->
	<view
		v-else
		class="ste-step-column-item"
		:style="[cmpRootStyle, rootStyle]"
	>
		<!-- 上半段垂直连接线 (非第一步渲染，顶部 0 到 图标中心 22rpx) -->
		<view
			v-if="stepIndex > 1"
			class="ste-step-line-col-top"
			:class="[dot ? 'line-col-is-dot' : '']"
			:style="cmpLineColTopStyle"
		></view>

		<!-- 下半段垂直连接线 (非最后一步渲染，图标中心 22rpx 一路贯通到 本项底部 0) -->
		<view
			v-if="!isLast"
			class="ste-step-line-col-bottom"
			:class="[dot ? 'line-col-is-dot' : '']"
			:style="cmpLineColBottomStyle"
		></view>

		<!-- 左侧：图标容器 (z-index 覆盖于垂直线上方) -->
		<view class="ste-step-head-column" :class="[dot ? 'head-is-dot' : '']">
			<!-- 步骤圆形图标/圆点 -->
			<view
				class="ste-step-icon-wrap"
				:class="[dot ? 'icon-is-dot' : '']"
				:style="cmpIconWrapStyle"
				@click="handleClick"
			>
				<slot name="icon">
					<ste-icon
						v-if="!dot && displayIcon != ''"
						:code="displayIcon"
						:size="icon != '' ? 32 : 24"
						:color="displayIconColor"
					/>
					<text
						v-else-if="!dot"
						class="ste-step-num-text"
						:style="cmpNumTextStyle"
					>{{ stepIndex }}</text>
				</slot>
			</view>
		</view>

		<!-- 右侧：标题与描述 (非最后一步添加 padding-bottom 撑开整体项高度) -->
		<view
			class="ste-step-content-column"
			:class="[!isLast ? 'content-has-bottom-space' : '']"
			@click="handleClick"
		>
			<view class="ste-step-title-wrap">
				<slot name="title">
					<text class="ste-step-title-text" :style="cmpTitleStyle">
						{{ title != '' ? title : '第' + stepIndex.toString() + '步' }}
					</text>
				</slot>
			</view>
			<view v-if="description != ''" class="ste-step-desc-wrap">
				<slot name="description">
					<text class="ste-step-desc-text" :style="cmpDescStyle">{{ description }}</text>
				</slot>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * @file ste-step.uvue
	 * @description Step 单步骤项组件 - uni-app x / UTS 版本
	 * 结合 ste-steps 上下文进行步骤流转展示，横纵两端均采用双半段闭环拼接架构，确保连接线在任何端 100% 像素级无缝贯通。
	 */
	import { ref, computed, inject, onMounted, onUnmounted } from 'vue'
	import { useColorStore } from '../../store/color.uts'
	import { StepsContext } from '../ste-steps/constants.uts'
	import { StepProps } from './constants.uts'

	defineOptions({
		name: 'ste-step',
		options: {
			virtualHost: true,
		},
	})

	// ==================== Props 属性与默认值 ====================
	const props = withDefaults(defineProps<StepProps>(), {
		title: '',
		description: '',
		icon: '',
		status: '',
		rootStyle: () => ({}) as UTSJSONObject,
	})

	// ==================== 依赖注入与主题色 ====================
	const colorStore = useColorStore()
	const colorData = colorStore.getColor()
	const parentContext = inject<StepsContext | null>('ste-steps', null)

	/** 步骤项唯一 ID */
	const stepId = ref<string>('ste-step-' + Math.floor(Math.random() * 10000000).toString())

	// 注册到父级上下文
	onMounted(() => {
		if (parentContext != null) {
			parentContext!.registerStep(stepId.value)
		}
	})

	// 组件卸载时注销
	onUnmounted(() => {
		if (parentContext != null) {
			parentContext!.unregisterStep(stepId.value)
		}
	})

	// ==================== 上下文响应式属性 ====================
	const active = computed((): number => {
		return parentContext != null ? parentContext!.getActive() : 0
	})

	const direction = computed((): string => {
		return parentContext != null ? parentContext!.getDirection() : 'row'
	})

	const dot = computed((): boolean => {
		return parentContext != null ? parentContext!.getDot() : false
	})

	const reverse = computed((): boolean => {
		return parentContext != null ? parentContext!.getReverse() : false
	})

	const lineStyle = computed((): string => {
		return parentContext != null ? parentContext!.getLineStyle() : 'solid'
	})

	const stepIndex = computed((): number => {
		return parentContext != null ? parentContext!.getStepIndex(stepId.value) : 1
	})

	const totalSteps = computed((): number => {
		return parentContext != null ? parentContext!.getTotalSteps() : 1
	})

	const isLast = computed((): boolean => {
		return stepIndex.value == totalSteps.value
	})

	// ==================== 状态机与视觉计算 ====================
	/** 综合判断当前步骤的最终业务状态 */
	const computedStatus = computed((): string => {
		if (props.status != '') {
			return props.status
		}
		// active 从 0 开始，stepIndex 从 1 开始
		if (active.value >= stepIndex.value) {
			return 'finished'
		}
		return 'process'
	})

	/** 是否处于当前活动步骤（进行中聚焦项） */
	const isCurrentActive = computed((): boolean => {
		return active.value + 1 == stepIndex.value
	})

	/** 是否处于已完成或历史经过项 */
	const isPassedOrActive = computed((): boolean => {
		return active.value + 1 >= stepIndex.value
	})

	/**
	 * 将 HTML 实体编码或十六进制 Unicode 转为实际展示字符
	 */
	function formatIconCode(val: string): string {
		if (val.indexOf('&#') >= 0) {
			let cleaned = val.replace('&#', '').replace(';', '').trim()
			let radix = 10
			if (cleaned.startsWith('x') || cleaned.startsWith('X')) {
				cleaned = cleaned.substring(1)
				radix = 16
			}
			const codePoint = parseInt(cleaned, radix)
			if (!isNaN(codePoint) && codePoint > 0) {
				return String.fromCharCode(codePoint)
			}
		}
		return val
	}

	/** 图标 Unicode 展示字符 */
	const displayIcon = computed((): string => {
		if (props.icon != '') {
			return formatIconCode(props.icon)
		}
		if (computedStatus.value == 'finished') {
			return '\ue67a' // 对勾
		}
		if (computedStatus.value == 'error') {
			return '\ue67b' // 叉号
		}
		return ''
	})

	/** 图标颜色 */
	const displayIconColor = computed((): string => {
		if (computedStatus.value == 'error') {
			return '#fa5151'
		}
		if (computedStatus.value == 'finished') {
			return colorData.steThemeColor
		}
		return isPassedOrActive.value ? colorData.steThemeColor : '#cccccc'
	})

	// ==================== 样式计算 ====================
	const cmpRootStyle = computed((): UTSJSONObject => {
		return {} as UTSJSONObject
	})

	/**
	 * 图标容器背景与边框
	 */
	const cmpIconWrapStyle = computed((): UTSJSONObject => {
		const style: UTSJSONObject = {}
		if (dot.value) {
			style['backgroundColor'] = isPassedOrActive.value ? colorData.steThemeColor : '#dddddd'
			return style
		}

		if (computedStatus.value == 'error') {
			style['backgroundColor'] = '#ffffff'
			style['borderColor'] = '#fa5151'
		} else if (computedStatus.value == 'finished') {
			style['backgroundColor'] = '#ffffff'
			style['borderColor'] = colorData.steThemeColor
		} else if (isCurrentActive.value) {
			// 当前活动步：实心高亮背景
			style['backgroundColor'] = colorData.steThemeColor
			style['borderColor'] = colorData.steThemeColor
		} else {
			// 待办步：白底灰边
			style['backgroundColor'] = '#ffffff'
			style['borderColor'] = '#cccccc'
		}
		return style
	})

	/**
	 * 序号数字样式
	 */
	const cmpNumTextStyle = computed((): UTSJSONObject => {
		const style: UTSJSONObject = {}
		if (isCurrentActive.value) {
			style['color'] = '#ffffff'
		} else {
			style['color'] = '#cccccc'
		}
		return style
	})

	/**
	 * 标题文字样式
	 */
	const cmpTitleStyle = computed((): UTSJSONObject => {
		const style: UTSJSONObject = {}
		if (computedStatus.value == 'error') {
			style['color'] = '#fa5151'
		} else if (isPassedOrActive.value) {
			style['color'] = colorData.steThemeColor
		} else {
			style['color'] = '#cccccc'
		}
		return style
	})

	/**
	 * 描述文字样式
	 */
	const cmpDescStyle = computed((): UTSJSONObject => {
		const style: UTSJSONObject = {}
		if (isPassedOrActive.value) {
			style['color'] = '#8f959e'
		} else {
			style['color'] = '#cccccc'
		}
		return style
	})

	/**
	 * 横向左半段连接线样式 (0% ~ 50%)
	 */
	const cmpLineRowLeftStyle = computed((): UTSJSONObject => {
		const style: UTSJSONObject = {}
		const isActive = reverse.value ? (active.value >= stepIndex.value) : (active.value >= stepIndex.value - 1)
		style['borderColor'] = isActive ? colorData.steThemeColor : '#eeeeee'
		style['borderTopStyle'] = lineStyle.value
		return style
	})

	/**
	 * 横向右半段连接线样式 (50% ~ 100%)
	 */
	const cmpLineRowRightStyle = computed((): UTSJSONObject => {
		const style: UTSJSONObject = {}
		const isActive = reverse.value ? (active.value >= stepIndex.value - 1) : (active.value >= stepIndex.value)
		style['borderColor'] = isActive ? colorData.steThemeColor : '#eeeeee'
		style['borderTopStyle'] = lineStyle.value
		return style
	})

	/**
	 * 纵向上半段连接线样式 (顶部 0 到 图标中心 22rpx)
	 */
	const cmpLineColTopStyle = computed((): UTSJSONObject => {
		const style: UTSJSONObject = {}
		const isActive = reverse.value ? (active.value >= stepIndex.value) : (active.value >= stepIndex.value - 1)
		style['borderColor'] = isActive ? colorData.steThemeColor : '#eeeeee'
		style['borderLeftStyle'] = lineStyle.value
		return style
	})

	/**
	 * 纵向下半段连接线样式 (图标中心 22rpx 一路贯通到 底部 0)
	 */
	const cmpLineColBottomStyle = computed((): UTSJSONObject => {
		const style: UTSJSONObject = {}
		const isActive = reverse.value ? (active.value >= stepIndex.value - 1) : (active.value >= stepIndex.value)
		style['borderColor'] = isActive ? colorData.steThemeColor : '#eeeeee'
		style['borderLeftStyle'] = lineStyle.value
		return style
	})

	// ==================== 交互处理 ====================
	function handleClick() {
		if (parentContext != null) {
			parentContext!.onClickStep(stepIndex.value)
		}
	}
</script>

<style scoped>
/* ==================== 横向 (Row) 布局 ==================== */
.ste-step-row-item {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	position: relative;
}

.ste-step-head-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	position: relative;
	width: 100%;
	height: 48rpx;
	margin-bottom: 12rpx;
}

/* 点状头部高度与对齐 */
.head-is-dot {
	height: 28rpx;
	margin-bottom: 8rpx;
}

/* 左半段水平连接线 (0% ~ 50%) */
.ste-step-line-row-left {
	position: absolute;
	top: 23rpx;
	left: 0;
	width: 50%;
	height: 2rpx;
	border-top-width: 2rpx;
	z-index: 1;
	box-sizing: border-box;
}

/* 右半段水平连接线 (50% ~ 100%) */
.ste-step-line-row-right {
	position: absolute;
	top: 23rpx;
	left: 50%;
	width: 50%;
	height: 2rpx;
	border-top-width: 2rpx;
	z-index: 1;
	box-sizing: border-box;
}

.head-is-dot .ste-step-line-row-left,
.head-is-dot .ste-step-line-row-right {
	top: 13rpx;
}

/* 图标包装圆圈 */
.ste-step-icon-wrap {
	width: 44rpx;
	height: 44rpx;
	border-radius: 22rpx;
	border-width: 2rpx;
	border-style: solid;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	position: relative;
	z-index: 2;
	background-color: #ffffff;
	box-sizing: border-box;
}

.icon-is-dot {
	width: 16rpx;
	height: 16rpx;
	border-radius: 8rpx;
	border-width: 0;
}

.ste-step-num-text {
	font-size: 24rpx;
	font-weight: 500;
	line-height: 28rpx;
}

/* 横向文本区域 */
.ste-step-content-row {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 0 8rpx;
}

.ste-step-title-wrap {
	display: flex;
	flex-direction: row;
	justify-content: center;
}

.ste-step-title-text {
	font-size: 28rpx;
	font-weight: 500;
	line-height: 38rpx;
	text-align: center;
}

.ste-step-desc-wrap {
	display: flex;
	flex-direction: row;
	justify-content: center;
	margin-top: 6rpx;
}

.ste-step-desc-text {
	font-size: 24rpx;
	line-height: 32rpx;
	text-align: center;
}

/* ==================== 纵向 (Column) 布局 ==================== */
.ste-step-column-item {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	width: 100%;
	position: relative;
	box-sizing: border-box;
}

/* 垂直上半段线 (顶部 0 到 图标中心 22rpx) */
.ste-step-line-col-top {
	position: absolute;
	top: 0;
	height: 22rpx;
	width: 2rpx;
	left: 23rpx;
	border-left-width: 2rpx;
	z-index: 1;
	box-sizing: border-box;
}

.line-col-is-dot.ste-step-line-col-top {
	height: 16rpx;
	left: 11rpx;
}

/* 垂直下半段线 (图标中心 22rpx 一路贯通到 底部 0) */
.ste-step-line-col-bottom {
	position: absolute;
	top: 22rpx;
	bottom: 0;
	width: 2rpx;
	left: 23rpx;
	border-left-width: 2rpx;
	z-index: 1;
	box-sizing: border-box;
}

.line-col-is-dot.ste-step-line-col-bottom {
	top: 16rpx;
	left: 11rpx;
}

.ste-step-head-column {
	display: flex;
	flex-direction: column;
	align-items: center;
	position: relative;
	margin-right: 24rpx;
	width: 48rpx;
	z-index: 2;
}

.ste-step-head-column.head-is-dot {
	width: 24rpx;
	margin-right: 16rpx;
	padding-top: 8rpx;
}

/* 纵向文本区域 */
.ste-step-content-column {
	display: flex;
	flex-direction: column;
	flex: 1;
	padding-top: 4rpx;
	box-sizing: border-box;
}

/* 非最后一步的底部留白 */
.content-has-bottom-space {
	padding-bottom: 48rpx;
}

.ste-step-content-column .ste-step-title-wrap {
	justify-content: flex-start;
}

.ste-step-content-column .ste-step-title-text {
	text-align: left;
}

.ste-step-content-column .ste-step-desc-wrap {
	justify-content: flex-start;
	margin-top: 8rpx;
}

.ste-step-content-column .ste-step-desc-text {
	text-align: left;
}
</style>
