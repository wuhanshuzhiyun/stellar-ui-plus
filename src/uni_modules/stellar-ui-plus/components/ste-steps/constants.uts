/**
 * @file constants.uts
 * @description ste-steps 步骤条组件属性类型与父子上下文定义
 */

/**
 * 步骤条属性类型
 */
export type StepsProps = {
    /**
     * 当前选中的激活步骤索引（从 0 开始）
     * @default 0
     */
    active ?: number,
    /**
     * 步骤条布局方向：'row' 横向，'column' 竖向
     * @default 'row'
     */
    direction ?: string,
    /**
     * 是否使用点状步骤条
     * @default false
     */
    dot ?: boolean,
    /**
     * 是否反转步骤排布方向
     * @default false
     */
    reverse ?: boolean,
    /**
     * 连接线线条样式（'solid' | 'dashed'）
     * @default 'solid'
     */
    lineStyle ?: string,
    /**
     * 根节点自定义样式
     */
    rootStyle ?: UTSJSONObject,
}

/**
 * 提供给 ste-step 子组件的上下文接口
 */
export type StepsContext = {
    /** 获取当前活动索引 */
    getActive: () => number,
    /** 获取排布方向 */
    getDirection: () => string,
    /** 是否为点状模式 */
    getDot: () => boolean,
    /** 是否反转方向 */
    getReverse: () => boolean,
    /** 获取线条样式 */
    getLineStyle: () => string,
    /** 注册子步骤并返回分配的序号 */
    registerStep: (id: string) => number,
    /** 注销子步骤 */
    unregisterStep: (id: string) => void,
    /** 获取指定子步骤的当前序号 (1-indexed) */
    getStepIndex: (id: string) => number,
    /** 获取当前子步骤总数 */
    getTotalSteps: () => number,
    /** 点击某个步骤 */
    onClickStep: (index: number) => void,
}
