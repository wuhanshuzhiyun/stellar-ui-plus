/**
 * @file constants.uts
 * @description ste-swipe-action-group 单元格组属性类型定义
 */

export type SwipeActionGroupProps = {
    /**
     * 统一滑动模式：'right' / 'left' / 'all'
     * @default 'right'
     */
    mode ?: string,
    /**
     * 打开某一项时是否自动关闭其他项（互斥）
     * @default true
     */
    autoClose ?: boolean,
    /**
     * 统一是否禁用
     * @default false
     */
    disabled ?: boolean,
    /**
     * 统一灵敏度阈值
     * @default 0.35
     */
    swipeThreshold ?: any,
    /**
     * 统一动画时长（ms）
     * @default 300
     */
    duration ?: any,
    /**
     * 统一是否显示左侧图标
     * @default false
     */
    leftIcon ?: boolean,
    /**
     * 统一是否显示右侧图标
     * @default false
     */
    rightIcon ?: boolean,
    /**
     * 根节点自定义样式
     */
    rootStyle ?: UTSJSONObject,
}
