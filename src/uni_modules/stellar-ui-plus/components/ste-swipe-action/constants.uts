/**
 * @file constants.uts
 * @description ste-swipe-action 滑动单元格属性类型与父子上下文定义
 */

/**
 * 滑动单元格属性类型
 */
export type SwipeActionProps = {
    /**
     * 滑动模式：'right' 右侧滑动，'left' 左侧滑动，'all' 左右均可滑动，'none' 禁用滑动
     * @default 'right'
     */
    mode ?: string,
    /**
     * 是否禁用滑动
     * @default false
     */
    disabled ?: boolean,
    /**
     * 灵敏度阈值（0-1 之间的小数，超过该比例自动吸附展开，反之收起）
     * @default 0.35
     */
    swipeThreshold ?: any,
    /**
     * 动画过渡时长（单位 ms）
     * @default 300
     */
    duration ?: any,
    /**
     * 是否在左边缘显示展开/收起指示按钮
     * @default false
     */
    leftIcon ?: boolean,
    /**
     * 是否在右边缘显示展开/收起指示按钮
     * @default false
     */
    rightIcon ?: boolean,
    /**
     * 根节点自定义样式
     */
    rootStyle ?: UTSJSONObject,
}

/**
 * 子项操作句柄
 */
export type SwipeActionItemHandler = {
    /** 获取子项唯一 ID */
    getId: () => string,
    /** 打开指定方向操作区 */
    open: (direction: string) => void,
    /** 关闭操作区 */
    close: () => void,
}

/**
 * 单元格组上下文接口
 */
export type SwipeActionGroupContext = {
    /** 获取组模式 */
    getMode: () => string,
    /** 获取组是否禁用 */
    getDisabled: () => boolean,
    /** 获取组滑动阈值 */
    getSwipeThreshold: () => number,
    /** 获取组动画时长 */
    getDuration: () => number,
    /** 获取组左侧图标配置 */
    getLeftIcon: () => boolean,
    /** 获取组右侧图标配置 */
    getRightIcon: () => boolean,
    /** 获取组是否自动关闭互斥 */
    getAutoClose: () => boolean,
    /** 注册子单元格 */
    registerItem: (item: SwipeActionItemHandler) => void,
    /** 注销子单元格 */
    unregisterItem: (id: string) => void,
    /** 子单元格打开时回调 */
    onItemOpen: (id: string, direction: string) => void,
    /** 子单元格关闭时回调 */
    onItemClose: (id: string) => void,
    /** 关闭除指定 ID 之外的其他单元格 */
    closeOtherItems: (id: string) => void,
}
