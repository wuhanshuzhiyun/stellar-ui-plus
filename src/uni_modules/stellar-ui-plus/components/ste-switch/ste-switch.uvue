<template>
	<view class="ste-switch-root" :style="cmpStyle" @click="handleClick">
		<view class="switch-node" :style="cmpNodeStyle">
			<!-- APP 端简易 loading -->
			<!-- #ifdef APP-ANDROID || APP-IOS -->
			<text v-if="loading" class="loading-text" :style="cmpLoadingTextStyle">...</text>
			<!-- #endif -->
			<!-- H5/MP 端使用 ste-loading 组件 -->
			<!-- #ifndef APP-ANDROID || APP-IOS -->
			<ste-loading v-if="loading" :type="2" :color="modelValue ? cmpActiveColor : inactiveColor" :size="cmpLoadingSize"></ste-loading>
			<!-- #endif -->
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { useColorStore } from '../../store/color.uts'
	import { formatPx } from '../../utils/utils.uts'

	defineOptions({ name: 'ste-switch', options: { virtualHost: true } })

	const colorStore = useColorStore()

	// ============== Props ==============

	type SwitchProps = {
		modelValue ?: boolean,
		disabled ?: boolean,
		readonly ?: boolean,
		size ?: number | string,
		activeColor ?: string,
		inactiveColor ?: string,
		loading ?: boolean,
	}

	const props = withDefaults(defineProps<SwitchProps>(), {
		modelValue: false,
		disabled: false,
		readonly: false,
		size: 52,
		activeColor: '',
		inactiveColor: '#bbbbbb',
		loading: false,
	})

	const emit = defineEmits(['click', 'change', 'update:modelValue'])

	// 异步拦截控制标志
	let cancelNextAction = false

	// ============== 计算属性 ==============

	function getActiveColor() : string {
		if (props.activeColor != '') return props.activeColor
		const colorData = colorStore.getColor()
		return colorData.steThemeColor
	}

	const cmpActiveColor = computed(() : string => getActiveColor())

	/** size 统一转为 number */
	const cmpSize = computed(() : number => {
		const s = props.size
		if (typeof s === 'number') return s as number
		return parseFloat((s as string))
	})

	/** loading 图标尺寸 */
	const cmpLoadingSize = computed(() : number => {
		return cmpSize.value / 2
	})

	/** 开关轨道样式 */
	const cmpStyle = computed(() : UTSJSONObject => {
		const s : UTSJSONObject = {}
		const sz = cmpSize.value
		s['width'] = formatPx(sz * 2 + 4)
		s['height'] = formatPx(sz + 4)
		s['borderRadius'] = formatPx((sz + 4) / 2)
		s['backgroundColor'] = props.modelValue ? cmpActiveColor.value : props.inactiveColor
		s['opacity'] = props.disabled ? '0.6' : '1'
		s['flexDirection'] = 'row'
		s['alignItems'] = 'center'
		return s
	})

	/** 圆形滑块样式 */
	const cmpNodeStyle = computed(() : UTSJSONObject => {
		const s : UTSJSONObject = {}
		const sz = cmpSize.value
		s['width'] = formatPx(sz)
		s['height'] = formatPx(sz)
		if (props.modelValue) {
			s['marginLeft'] = formatPx(sz + 2)
		} else {
			s['marginLeft'] = formatPx(2)
		}
		return s
	})

	/** APP 端 loading 文字样式 */
	const cmpLoadingTextStyle = computed(() : UTSJSONObject => {
		const s : UTSJSONObject = {}
		s['fontSize'] = formatPx(cmpSize.value * 0.4)
		s['color'] = props.modelValue ? cmpActiveColor.value : props.inactiveColor
		return s
	})

	// ============== 事件处理 ==============

	function handleClick() {
		if (props.disabled || props.readonly || props.loading) return
		cancelNextAction = false
		emit('click', props.modelValue)
		if (cancelNextAction) {
			cancelNextAction = false
			return
		}
		const newVal = !props.modelValue
		emit('update:modelValue', newVal)
		emit('change', newVal)
	}

	// ============== 暴露给父组件 ==============

	function cancelPendingAction() {
		cancelNextAction = true
	}

	defineExpose({ cancelPendingAction })
</script>

<style>
	.ste-switch-root {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: flex-start;
	}

	.switch-node {
		border-radius: 50%;
		background-color: #ffffff;
		display: flex;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		transition-property: margin-left;
		transition-duration: 0.3s;
		transition-timing-function: ease;
	}

	.loading-text {
		text-align: center;
	}
</style>
