/**
 * @file constants.uts
 * @description ste-tab 标签子组件属性类型与参数契约定义
 */

/**
 * ste-tab 单个标签面板属性定义
 */
export type TabProps = {
    /**
     * 标签标题文字
     * @default ''
     */
    title?: string,
    /**
     * 标签副标题文字（展示于标题下方）
     * @default ''
     */
    subTitle?: string,
    /**
     * 标签唯一标识符（匹配 tabs 的 active 值；若缺省则按渲染序号分配）
     */
    name?: any,
    /**
     * 是否禁用当前标签（禁用状态下无法点击切换）
     * @default false
     */
    disabled?: boolean,
    /**
     * 徽标内容（支持数字或文字内容）
     * @default 0
     */
    badge?: any,
    /**
     * 是否仅以红点形式显示徽标
     * @default false
     */
    showDot?: boolean,
    /**
     * 当徽标数值为 0 时是否依然显示
     * @default false
     */
    showZeroBadge?: boolean,
    /**
     * 未选中状态的图标或图片路径
     * @default ''
     */
    image?: string,
    /**
     * 选中激活状态的图标或图片路径（若不传则沿用 image）
     * @default ''
     */
    activeImage?: string,
    /**
     * 内置图标名称（优先使用图标组件渲染）
     * @default ''
     */
    icon?: string,
    /**
     * 根节点自定义样式
     */
    rootStyle?: UTSJSONObject,
}
