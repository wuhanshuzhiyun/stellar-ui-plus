<template>
    <!-- 
      Tab 单个页面内容容器
      常规模式下仅激活时按需渲染；手势切屏模式 (swipeable) 下全量挂载排布在滑动轨道中
    -->
    <view
        v-if="shouldRender"
        class="ste-tab-root"
        :style="[computedTabStyle, rootStyle]"
    >
        <slot></slot>
    </view>
</template>

<script setup lang="uts">
    /**
     * @file ste-tab.uvue
     * @description ste-tab 单标签面板组件 - uni-app x / UTS 强类型架构实现
     * 作为 ste-tabs 的子组件，负责提供标签标题、徽标、副标题等元数据，并在激活时挂载展示插槽内容。
     */
    import { ref, computed, inject, onMounted, onUnmounted, watch } from 'vue'
    import { TABS_KEY, TabsContext, TabItemData } from '../ste-tabs/constants.uts'
    import { TOUCH_SWIPE_KEY, TouchSwipeContext } from '../ste-touch-swipe/constants.uts'
    import { TabProps } from './constants.uts'

    defineOptions({
        name: 'ste-tab',
        options: {
            virtualHost: true,
        },
    })

    // ==================== Props 属性与默认值 ====================
    const props = withDefaults(defineProps<TabProps>(), {
        title: '',
        subTitle: '',
        disabled: false,
        badge: 0,
        showDot: false,
        showZeroBadge: false,
        image: '',
        activeImage: '',
        icon: '',
        rootStyle: () => ({}) as UTSJSONObject,
    })

    // ==================== 依赖注入与上下文 ====================
    /** 注入父级 ste-tabs 容器的上下文对象 */
    const tabsContext = inject<TabsContext | null>(TABS_KEY, null)

    /** 注入父级 ste-touch-swipe 手势切屏容器上下文（若当前处于手势滑动模式） */
    const touchSwipeContext = inject<TouchSwipeContext | null>(TOUCH_SWIPE_KEY, null)

    /** 生成当前 Tab 面板的唯一标识 ID，用于父子通信索引寻址 */
    const tabId = ref<string>('ste-tab-' + Math.floor(Math.random() * 10000000).toString())

    /**
     * 构建提交给父级 ste-tabs 标签栏的元数据实体
     * @returns {TabItemData} 格式化后的标签数据
     */
    const buildTabItemData = (): TabItemData => {
        return {
            id: tabId.value,
            title: props.title,
            subTitle: props.subTitle,
            name: props.name != null ? props.name : null,
            disabled: props.disabled,
            badge: props.badge,
            icon: props.icon,
            image: props.image,
            activeImage: props.activeImage,
            show: true,
        } as TabItemData
    }

    /**
     * 响应式判定当前 Tab 是否正处于激活状态
     * 规则：
     * 1. 优先比对 props.name 是否与 tabsContext.getActive() 相等；
     * 2. 若未配置 name，则交由父组件根据子组件索引匹配。
     */
    const isTabActive = computed<boolean>(() : boolean => {
        if (tabsContext == null) {
            return false
        }
        // 显式调用 getActive() 以在 Vue 响应式系统中建立依赖追踪
        const currentActive = tabsContext.getActive()
        return tabsContext.isTabActive(tabId.value, props.name != null ? props.name : null)
    })

    /**
     * 判断当前面板是否应该挂载渲染
     * 若父级启用了 swipeable 手势模式，则全量挂载在滑动轨道中；
     * 若未启用手势模式，则保留按需渲染 (isTabActive)，提升性能。
     */
    const shouldRender = computed<boolean>(() : boolean => {
        if (tabsContext != null && tabsContext.isSwipeable()) {
            return true
        }
        return isTabActive.value
    })

    /**
     * 动态计算面板样式：
     * 若处于 TouchSwipe 手势切屏轨道内，宽度严格限定为单屏视口宽度，杜绝被总轨道拉伸
     */
    const computedTabStyle = computed<UTSJSONObject>(() : UTSJSONObject => {
        const style: UTSJSONObject = {}
        if (touchSwipeContext != null) {
            const w = touchSwipeContext.getContainerWidth()
            if (w > 0) {
                style['width'] = `${w}px`
            }
        }
        return style
    })

    // ==================== 生命周期与注册绑定 ====================
    onMounted(() => {
        if (tabsContext != null) {
            tabsContext.registerTab(buildTabItemData())
        }
    })

    onUnmounted(() => {
        if (tabsContext != null) {
            tabsContext.unregisterTab(tabId.value)
        }
    })

    // 监听关键属性变更，实时同步通知父组件更新标签栏展示
    watch(
        () : string => `${props.title}_${props.subTitle}_${props.disabled}_${props.image}_${props.activeImage}_${props.icon}`,
        () => {
            if (tabsContext != null) {
                tabsContext.updateTab(buildTabItemData())
            }
        }
    )
</script>

<style scoped>
.ste-tab-root {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
}
</style>
