<template>
	<view class="ste-table-checkbox-icon">
		<!-- 禁用状态展示置灰选中框 -->
		<ste-icon
			v-if="props.disabled"
			code="&#xe6ae;"
			:color="displayDisabledColor"
			:size="CHECK_ICON_SIZE"
		/>
		<!-- 只读状态展示浅色对勾选中框 -->
		<ste-icon
			v-else-if="props.readonly"
			code="&#xe6ac;"
			:color="displayReadonlyColor"
			:size="CHECK_ICON_SIZE"
		/>
		<!-- 正常交互状态：选中 / 未选切换 -->
		<template v-else>
			<ste-icon
				v-if="props.checked"
				code="&#xe6ac;"
				:color="displayMainColor"
				:size="CHECK_ICON_SIZE"
			/>
			<ste-icon
				v-else
				code="&#xe6af;"
				:color="displayUnselectedColor"
				:size="CHECK_ICON_SIZE"
			/>
		</template>
	</view>
</template>

<script setup lang="uts">
	/**
	 * @file checkbox-icon.uvue
	 * @description 表格复选框图标展示子组件 - uni-app x / UTS 强类型版本
	 * 负责渲染勾选、未选、禁用与只读等各视觉状态的图标及颜色分配。
	 */
	import { computed } from 'vue'
	import { TableSelectionColorConfig, DEFAULT_SELECTION_COLOR_CONFIG, CHECK_ICON_SIZE } from '../ste-table/constants.uts'

	defineOptions({
		name: 'ste-table-checkbox-icon',
		options: {
			virtualHost: true,
		},
	})

	type CheckboxIconProps = {
		/** 是否处于勾选状态 */
		checked ?: boolean,
		/** 是否处于禁用状态 */
		disabled ?: boolean,
		/** 是否处于只读状态 */
		readonly ?: boolean,
		/** 选择图标自定义调色板配置 */
		iconColorConfig ?: TableSelectionColorConfig,
	}

	const props = withDefaults(defineProps<CheckboxIconProps>(), {
		checked: false,
		disabled: false,
		readonly: false,
		iconColorConfig: () => ({ ...DEFAULT_SELECTION_COLOR_CONFIG }) as TableSelectionColorConfig,
	})

	// ==================== 图标各态颜色计算 ====================
	const displayDisabledColor = computed(() : string => {
		const cfg = props.iconColorConfig
		return cfg.disabled != null && cfg.disabled != '' ? cfg.disabled! : DEFAULT_SELECTION_COLOR_CONFIG.disabled!
	})

	const displayReadonlyColor = computed(() : string => {
		const cfg = props.iconColorConfig
		return cfg.readonly != null && cfg.readonly != '' ? cfg.readonly! : DEFAULT_SELECTION_COLOR_CONFIG.readonly!
	})

	const displayMainColor = computed(() : string => {
		const cfg = props.iconColorConfig
		return cfg.main != null && cfg.main != '' ? cfg.main! : DEFAULT_SELECTION_COLOR_CONFIG.main!
	})

	const displayUnselectedColor = computed(() : string => {
		const cfg = props.iconColorConfig
		return cfg.unSelected != null && cfg.unSelected != '' ? cfg.unSelected! : DEFAULT_SELECTION_COLOR_CONFIG.unSelected!
	})
</script>

<style scoped>
.ste-table-checkbox-icon {
	display: flex;
	align-items: center;
	justify-content: center;
}
</style>
