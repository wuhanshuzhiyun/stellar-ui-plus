/**
 * @file constants.uts
 * @description ste-table-column 单元格列组件属性与类型契约定义
 */

/**
 * ste-table-column 组件属性类型定义
 */
export type TableColumnProps = {
	/**
	 * 特殊列展示类型（可选：'checkbox' 多选框 | 'radio' 单选框 | 'index' 序号列 | '' 常规数据）
	 * @default ''
	 */
	type ?: string,
	/**
	 * 业务自定义标识键名（供 formatter、插槽或特定列行为识别）
	 * @default ''
	 */
	customKey ?: string,
	/**
	 * 表头展示标题
	 * @default ''
	 */
	label ?: string,
	/**
	 * 对应行数据对象的属性字段名
	 * @default ''
	 */
	prop ?: string,
	/**
	 * 列宽度（支持 rpx / px 或纯数字字符串/数值）
	 * @default ''
	 */
	width ?: any,
	/**
	 * 列最小宽度
	 * @default ''
	 */
	minWidth ?: any,
	/**
	 * 数据单元格对齐方式（'left' | 'center' | 'right'）
	 * @default 'left'
	 */
	align ?: string,
	/**
	 * 表头单元格对齐方式（'left' | 'center' | 'right'，默认跟随 align）
	 * @default 'left'
	 */
	headerAlign ?: string,
	/**
	 * 是否开启内容超长时省略显示并长按/点击显示 Tooltip（列级别配置，优先级高于表格级别 isPopover）
	 */
	showPopover ?: boolean | null,
	/**
	 * Popover 截断行数（列级别配置，优先级高于表格级别 popoverLine）
	 */
	popoverLine ?: number | null,
	/**
	 * 外部显式绑定的行数据对象（可选，当模板使用作用域插槽解构 row 时直接传入）
	 */
	row ?: UTSJSONObject | null,
	/**
	 * 外部显式绑定的行索引（可选）
	 */
	rowIndex ?: number | null,
	/**
	 * 根节点自定义行内样式
	 */
	rootStyle ?: UTSJSONObject,
}
