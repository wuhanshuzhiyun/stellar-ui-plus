{
    "name": "ste-table-column",
    "description": "表格列组件，配合 ste-table 使用，定义列的标题、字段属性、对齐方式与自定义插槽渲染。",
    "tutorial": "https://stellar-ui.intecloud.com.cn/?projectName=stellar-ui-plus&menu=%E7%BB%84%E4%BB%B6&active=ste-table",
    "attributes": [
        {
            "name": "label",
            "description": "显示的标题",
            "type": "String",
            "default": ""
        },
        {
            "name": "prop",
            "description": "对应列内容的字段名",
            "type": "String",
            "default": ""
        },
        {
            "name": "type",
            "description": "对应列的类型",
            "type": "String",
            "values": [
                {
                    "name": "checkbox",
                    "description": "多选复选框列"
                },
                {
                    "name": "radio",
                    "description": "单选单选框列"
                },
                {
                    "name": "index",
                    "description": "自动自增行序号列"
                }
            ],
            "default": "",
            "enum": [
                "checkbox",
                "radio",
                "index"
            ]
        },
        {
            "name": "width",
            "description": "对应列的宽度",
            "type": "Number | String",
            "default": ""
        },
        {
            "name": "minWidth",
            "description": "对应列的最小宽度",
            "type": "Number | String",
            "default": ""
        },
        {
            "name": "align",
            "description": "对齐方式",
            "type": "String",
            "default": "left",
            "values": [
                {
                    "name": "left",
                    "description": "左对齐"
                },
                {
                    "name": "center",
                    "description": "居中对齐"
                },
                {
                    "name": "right",
                    "description": "右对齐"
                }
            ],
            "enum": [
                "left",
                "center",
                "right"
            ]
        },
        {
            "name": "headerAlign",
            "description": "表头对齐方式，若不设置则使用表格对齐方式",
            "type": "String",
            "default": "left",
            "values": [
                {
                    "name": "left",
                    "description": "左对齐"
                },
                {
                    "name": "center",
                    "description": "居中对齐"
                },
                {
                    "name": "right",
                    "description": "右对齐"
                }
            ],
            "enum": [
                "left",
                "center",
                "right"
            ]
        },
        {
            "name": "showPopover",
            "description": "文本超长时是否显示 Popover 气泡提示（优先级高于表格级别）",
            "type": "boolean"
        },
        {
            "name": "popoverLine",
            "description": "Popover 提示的触发超出行数（优先级高于表格级别）",
            "type": "number"
        },
        {
            "name": "customKey",
            "description": "自定义唯一 key 值",
            "type": "String",
            "default": ""
        },
        {
            "name": "rootStyle",
            "description": "列根节点原生样式对象[仅UVue支持]",
            "type": "object",
            "default": {}
        },
        {
            "name": "[slot]default",
            "description": "自定义列单元格渲染插槽",
            "params": [
                {
                    "name": "row",
                    "description": "当前行数据对象"
                },
                {
                    "name": "rowIndex",
                    "description": "当前行索引下标"
                },
                {
                    "name": "column",
                    "description": "当前列定义对象"
                }
            ]
        },
        {
            "name": "[slot]empty",
            "description": "当前列单元格数据为空时的自定义展示内容插槽"
        }
    ],
    "uvue_diff": {
        "slots_data": "UVue 端配合 ste-table 使用，支持直接接收 row、rowIndex 并提供原生单元格作用域插槽"
    }
}
