<template>
	<view class="ste-table-popover-root" @longpress="handleLongPress" @click="handleClick">
		<text
			class="ste-table-popover-text"
			:style="cmpTextStyle"
		>{{ props.text }}</text>
	</view>
</template>

<script setup lang="uts">
	/**
	 * @file table-popover.uvue
	 * @description 表格单元格超长省略与 Popover 提示子组件 - uni-app x / UTS 强类型版本
	 * 支持指定截断行数的多行文本省略，并在长按或点击时联动 Tooltip 弹出完整浮层提示。
	 */
	import { computed } from 'vue'

	defineOptions({
		name: 'ste-table-popover',
		options: {
			virtualHost: true,
		},
	})

	type TablePopoverProps = {
		/** 待展示并可能超长的文本内容 */
		text ?: string,
		/** 超长截断最大展示行数 */
		line ?: number,
	}

	const props = withDefaults(defineProps<TablePopoverProps>(), {
		text: '',
		line: 1,
	})

	// ==================== 文本行数与截断样式计算 ====================
	const cmpTextStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		const lines = props.line > 0 ? props.line : 1
		style['textOverflow'] = 'ellipsis'
		style['lines'] = lines
		return style
	})

	/**
	 * 长按或点击触发展示气泡提示
	 */
	function triggerTooltip() {
		if (props.text == '') return
		const options : UTSJSONObject = {
			text: props.text,
			selector: '.ste-table-popover-text',
		}
		uni.$emit('ste:tooltip:show', options)
	}

	function handleLongPress() {
		triggerTooltip()
	}

	function handleClick() {
		triggerTooltip()
	}
</script>

<style scoped>
.ste-table-popover-root {
	width: 100%;
	display: flex;
	flex-direction: row;
	align-items: center;
}

.ste-table-popover-text {
	font-size: 24rpx;
	color: #333333;
	overflow: hidden;
}
</style>
