/**
 * @file constants.uts
 * @description Table 表格组件核心常量、枚举、类型声明与依赖注入上下文契约
 * 遵循 uni-app x / UTS 强静态类型规范，消除动态 any 隐患，支持多端原生编译。
 */

/**
 * 单元格与表头水平对齐方式
 * - 'left': 左对齐
 * - 'center': 居中对齐
 * - 'right': 右对齐
 */
export type TableAlignType = 'left' | 'center' | 'right'

/**
 * 特殊列类型定义
 * - 'checkbox': 多选复选框列
 * - 'radio': 单选框列
 * - 'index': 序号列
 * - '': 普通数据展示列
 */
export type TableSelectColType = 'checkbox' | 'radio' | 'index' | ''

/**
 * 表头全选框状态机枚举
 * - 'none': 全部未选中（空心状态）
 * - 'all': 全部已选中（实心对勾状态）
 * - 'indeterminate': 半选状态（部分选中横线状态）
 */
export type TableAllStateType = 'none' | 'all' | 'indeterminate'

/**
 * 选择器图标各状态颜色配置结构体
 */
export type TableSelectionColorConfig = {
	/** 选中状态主题主色（默认 #3491FA） */
	main ?: string,
	/** 未选中边框/图标颜色（默认 #BBBBBB） */
	unSelected ?: string,
	/** 禁用状态背景色/图标颜色（默认 #E6E6E6） */
	disabled ?: string,
	/** 只读状态图标颜色（默认 rgba(52, 145, 250, 0.4)） */
	readonly ?: string,
}

/**
 * 默认选择图标颜色预设值
 */
export const DEFAULT_SELECTION_COLOR_CONFIG : TableSelectionColorConfig = {
	main: '#3491FA',
	unSelected: '#BBBBBB',
	disabled: '#E6E6E6',
	readonly: 'rgba(52, 145, 250, 0.4)',
}

/** 默认合计行首列文案 */
export const DEFAULT_SUM_TEXT = '合计'

/** 选择图标标准渲染尺寸（单位：rpx） */
export const CHECK_ICON_SIZE = 36

/**
 * 单列表格元数据项定义（内部状态维护与外部 columns 属性通用的标准类型）
 */
export type TableColumnItem = {
	/** 列唯一标识符 */
	id : string,
	/** 列特殊展示类型（'checkbox' | 'radio' | 'index' | ''） */
	type : string,
	/** 业务自定义键名（用于插槽、formatter 区分） */
	customKey : string,
	/** 表头展示文案 */
	label : string,
	/** 对应数据行中对象的属性字段名 */
	prop : string,
	/** 列宽度设定（支持 rpx / px 或纯数字） */
	width : string,
	/** 列最小宽度设定 */
	minWidth : string,
	/** 数据单元格对齐方式（'left' | 'center' | 'right'） */
	align : string,
	/** 表头单元格对齐方式（默认跟随 align 或居左） */
	headerAlign : string,
	/** 当前列是否开启内容超长 Popover 提示（null/未定义时跟随全局 isPopover） */
	showPopover : boolean,
	/** Popover 省略显示行数（未定义时跟随全局 popoverLine） */
	popoverLine : number,
}

/**
 * ste-table 主容器组件属性类型定义
 */
export type TableProps = {
	/**
	 * 表格数据源列表
	 * @default []
	 */
	data ?: Array<UTSJSONObject>,
	/**
	 * 列配置项列表（免模板插槽模式，支持直接传入列定义进行高性能原生渲染）
	 * @default []
	 */
	columns ?: Array<TableColumnItem>,
	/**
	 * 是否开启吸顶效果
	 * @default false
	 */
	sticky ?: boolean,
	/**
	 * 吸顶或固定表头距离视口顶部的偏移量（支持数字或带有单位的字符串）
	 * @default 0
	 */
	offsetTop ?: any,
	/**
	 * 是否显示外边框与列竖线分割线
	 * @default false
	 */
	border ?: boolean,
	/**
	 * 是否开启斑马纹交替行背景色
	 * @default true
	 */
	stripe ?: boolean,
	/**
	 * 单元格数据为空时的默认占位文案
	 * @default '-'
	 */
	emptyText ?: string,
	/**
	 * 是否在表尾显示合计行
	 * @default false
	 */
	showSummary ?: boolean,
	/**
	 * 合计行第一列的描述文案
	 * @default '合计'
	 */
	sumText ?: string,
	/**
	 * 自定义合计计算函数
	 * 入参包含 columns 与 data，返回与 columns 长度匹配的字符串数组
	 */
	summaryMethod ?: ((params : UTSJSONObject) => string[]) | null,
	/**
	 * 行是否可选判断函数：返回 false 时当前行置灰且禁止勾选
	 */
	selectable ?: ((row : UTSJSONObject, index : number) => boolean) | null,
	/**
	 * 行是否只读判断函数：返回 true 时当前行显示只读状态，不可交互变更
	 */
	readable ?: ((row : UTSJSONObject, index : number) => boolean) | null,
	/**
	 * 表头是否固定吸顶
	 * @default false
	 */
	fixed ?: boolean,
	/**
	 * 单元格文案自定义格式化函数
	 */
	formatter ?: ((row : UTSJSONObject, customKey : string) => string) | null,
	/**
	 * 表头文案自定义格式化函数
	 */
	header ?: ((column : TableColumnItem, data : Array<UTSJSONObject>) => string) | null,
	/**
	 * 表格固定高度（设定后表格内容区域将支持滚动，表头自动悬浮吸顶）
	 */
	height ?: any,
	/**
	 * 表格最大高度
	 */
	maxHeight ?: any,
	/**
	 * 表头行自定义样式类名
	 */
	headerRowClassName ?: string,
	/**
	 * 表头行自定义行内样式
	 */
	headerRowStyle ?: UTSJSONObject,
	/**
	 * 表头单元格自定义样式类名
	 */
	headerCellClassName ?: string,
	/**
	 * 表头单元格自定义行内样式
	 */
	headerCellStyle ?: UTSJSONObject,
	/**
	 * 数据行自定义样式类名
	 */
	rowClassName ?: string,
	/**
	 * 数据行自定义行内样式
	 */
	rowStyle ?: UTSJSONObject,
	/**
	 * 数据单元格自定义样式类名
	 */
	cellClassName ?: string,
	/**
	 * 数据单元格自定义行内样式
	 */
	cellStyle ?: UTSJSONObject,
	/**
	 * 是否在点击某行时高亮该行背景
	 * @default false
	 */
	highlightCurrentRow ?: boolean,
	/**
	 * 是否在高亮被复选框勾选中的行背景
	 * @default false
	 */
	highlightSelectionRow ?: boolean,
	/**
	 * 是否显示表头
	 * @default true
	 */
	showHeader ?: boolean,
	/**
	 * 复选框及单选框各状态自定义颜色配置
	 */
	selectionIconColor ?: TableSelectionColorConfig,
	/**
	 * 单元格是否全局开启内容超长时省略显示并在长按/点击时弹出 Tooltip 提示
	 * @default false
	 */
	isPopover ?: boolean,
	/**
	 * 单元格开启 isPopover 时，内容超过多少行才进行截断省略
	 * @default 1
	 */
	popoverLine ?: number,
	/**
	 * 表格根节点自定义样式
	 */
	rootStyle ?: UTSJSONObject,
}

/**
 * ste-table 通过 provide 分发给 ste-table-column 等子组件的上下文接口契约
 */
export type TableContext = {
	/** 注册单列信息，返回其在列中的索引 */
	registerColumn : (col : TableColumnItem) => number,
	/** 卸载注销单列信息 */
	unregisterColumn : (id : string) => void,
	/** 获取选择图标颜色配置 */
	getSelectionColorConfig : () => TableSelectionColorConfig,
	/** 查询指定行是否允许勾选 */
	isRowSelectable : (row : UTSJSONObject, index : number) => boolean,
	/** 查询指定行是否为只读勾选 */
	isRowReadable : (row : UTSJSONObject, index : number) => boolean,
	/** 查询指定行当前是否处于勾选状态 */
	isRowChecked : (rowIndex : number) => boolean,
	/** 触发某行选择状态翻转变更 */
	onRowCheckChange : (row : UTSJSONObject, rowIndex : number) => void,
	/** 触发单元格点击中继事件 */
	onCellClick : (row : UTSJSONObject, col : TableColumnItem) => void,
	/** 获取全局边框设定 */
	getBorder : () => boolean,
	/** 获取空占位文案 */
	getEmptyText : () => string,
	/** 获取全局格式化函数 */
	getFormatter : () => ((row : UTSJSONObject, customKey : string) => string) | null,
	/** 获取全局 Popover 开启状态 */
	getIsPopover : () => boolean,
	/** 获取全局 Popover 行数设定 */
	getPopoverLine : () => number,
	/** 格式化单元格行内样式 */
	getCellStyle : (row : UTSJSONObject, col : TableColumnItem, rowIndex : number, colIndex : number) => UTSJSONObject,
	/** 格式化单元格样式类名 */
	getCellClass : (row : UTSJSONObject, col : TableColumnItem, rowIndex : number, colIndex : number) => string,
	/** 辅助解析获取当前行数据（当插槽未显式传递 row 时提供兜底精准映射） */
	resolveRowData : (rowIndex : number, prop : string) => any | null,
}
