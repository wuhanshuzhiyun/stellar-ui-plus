<template>
    <view
        class="ste-tabs-root"
        :class="['ste-tabs-bar-' + barType]"
        :style="[cmpRootStyle, rootStyle]"
    >
        <!-- 头部标签栏导航区域 -->
        <view class="ste-tabs-header-wrap" :style="cmpHeaderWrapStyle">
            <!-- 标签横向滚动容器 -->
            <scroll-view
                class="ste-tabs-scroll-view"
                direction="horizontal"
                :scroll-x="scrollable"
                :show-scrollbar="false"
                :scroll-left="scrollLeft"
                :scroll-with-animation="true"
            >
                <view
                    class="ste-tabs-nav"
                    :class="[
                        'nav-' + barType,
                        shrink ? 'is-shrink' : 'is-expand'
                    ]"
                >
                    <!-- 循环渲染标签项 -->
                    <view
                        v-for="(item, index) in displayTabs"
                        :key="item.id"
                        class="ste-tabs-item"
                        :class="[
                            item.isActive ? 'is-active' : '',
                            item.disabled || disabled ? 'is-disabled' : '',
                            shrink ? 'item-shrink' : 'item-expand'
                        ]"
                        :style="getItemStyle(item)"
                        @click="handleTabClick(item, index)"
                    >
                        <!-- 图标或自定义图片 -->
                        <ste-icon
                            v-if="item.icon != null && item.icon != ''"
                            :code="item.icon!"
                            :size="16"
                            :color="item.isActive ? effectiveActiveColor : titleInactiveColor"
                            class="ste-tabs-icon"
                        />
                        <image
                            v-else-if="(item.isActive && item.activeImage != null && item.activeImage != '') || (item.image != null && item.image != '')"
                            :src="(item.isActive && item.activeImage != null && item.activeImage != '') ? item.activeImage! : item.image!"
                            class="ste-tabs-image"
                            mode="aspectFit"
                        />

                        <!-- 标签标题与右上角徽标包裹容器 -->
                        <view class="ste-tabs-title-wrap">
                            <text
                                class="ste-tabs-title"
                                :class="[item.isActive ? 'text-active' : 'text-inactive']"
                                :style="getTitleTextStyle(item)"
                            >
                                {{ item.title }}
                            </text>

                            <!-- 徽标展示 -->
                            <view
                                v-if="hasBadge(item)"
                                class="ste-tabs-badge-box"
                            >
                                <ste-badge
                                    :content="item.badge"
                                    :show-dot="item.showDot"
                                    :show-zero="item.showZeroBadge"
                                />
                            </view>
                        </view>

                        <!-- 副标题文案 -->
                        <text
                            v-if="item.subTitle != null && item.subTitle != ''"
                            class="ste-tabs-subtitle"
                            :class="[item.isActive ? 'subtitle-active' : 'subtitle-inactive']"
                            :style="getSubtitleTextStyle(item)"
                        >
                            {{ item.subTitle }}
                        </text>
                    </view>

                    <!-- 底部下划线指示条（仅在 line 模式且 showLine 为 true 时展示） -->
                    <view
                        v-if="barType == 'line' && showLine"
                        class="ste-tabs-line"
                        :style="cmpLineStyle"
                    ></view>
                </view>
            </scroll-view>

            <!-- 头部右侧操作插槽与下拉面板切换按钮 -->
            <view class="ste-tabs-header-right">
                <slot name="header-suffix"></slot>
                <view
                    v-if="pullDown"
                    class="ste-tabs-pulldown-btn"
                    @click="togglePullDown"
                >
                    <ste-icon
                        code="fa-angle-down"
                        :size="16"
                        :color="titleInactiveColor"
                        class="ste-tabs-pulldown-icon"
                        :class="[isPullDownOpen ? 'icon-rotate' : '']"
                    />
                </view>
            </view>
        </view>

        <!-- 下拉展开面板全览浮层 -->
        <view
            v-if="pullDown && isPullDownOpen"
            class="ste-tabs-pulldown-mask"
            @click="closePullDown"
        >
            <view
                class="ste-tabs-pulldown-panel"
                :style="{ backgroundColor: background }"
                @click.stop
            >
                <view class="ste-tabs-pulldown-grid">
                    <view
                        v-for="(item, index) in displayTabs"
                        :key="'pull-' + item.id"
                        class="ste-tabs-pulldown-item"
                        :class="[
                            item.isActive ? 'pull-active' : '',
                            item.disabled || disabled ? 'pull-disabled' : ''
                        ]"
                        :style="getPullDownItemStyle(item)"
                        @click="handleTabClick(item, index)"
                    >
                        <text
                            class="ste-tabs-pulldown-text"
                            :style="{ color: item.isActive ? effectiveActiveColor : titleInactiveColor }"
                        >
                            {{ item.title }}
                        </text>
                    </view>
                </view>
            </view>
        </view>

        <!-- 内容区域：支持滑动切换手势与插槽承载 -->
        <view class="ste-tabs-content">
            <!-- 开启手势切换 (swipeable) 时，套用 ste-touch-swipe 组件承载滑动轨道 -->
            <ste-touch-swipe
                v-if="swipeable && displayTabs.length > 0"
                :index="activeTabIndex"
                :children-length="displayTabs.length"
                :disabled="!swipeable || disabled"
                :disabled-indexs="disabledTabIndices"
                :duration="duration / 1000"
                :height="effectiveSwipeHeight"
                @change="handleSwipeChange"
            >
                <slot></slot>
            </ste-touch-swipe>
            <!-- 常规非滑动模式：普通插槽承载，子组件按需渲染 -->
            <slot v-else></slot>
        </view>
    </view>
</template>

<script setup lang="uts">
    /**
     * @file ste-tabs.uvue
     * @description ste-tabs 标签页组件 - 基于 uni-app x / UTS 深度架构设计
     * 具备下划线线型 (line)、卡片型 (card)、分段器型 (segment) 三种主流设计形态；
     * 跨端 100% 摆脱 CSS 变量依赖，具备平滑居中横向滑动、徽标、副标题、图片、下拉展开面板与手势滑动切换全套能力。
     */
    import { ref, computed, provide, onMounted, nextTick, watch, getCurrentInstance } from 'vue'
    import { useColorStore } from '../../store/color.uts'
    import { getWindowWidth } from '../../utils/utils.uts'
    import { TABS_KEY, TabsContext, TabItemData, TabsProps } from './constants.uts'

    defineOptions({
        name: 'ste-tabs',
        options: {
            virtualHost: true,
        },
    })

    // ==================== 事件 Emits 声明 ====================
    const emit = defineEmits<{
        (e: 'update:active', active: any): void,
        (e: 'click-tab', tab: TabItemData, index: number): void,
        (e: 'change', tab: TabItemData, index: number): void,
    }>()

    // ==================== Props 属性与默认值 ====================
    const props = withDefaults(defineProps<TabsProps>(), {
        active: 0,
        tabList: () => [] as UTSJSONObject[],
        color: '',
        titleInactiveColor: '#666666',
        titleActiveColor: '',
        background: '#ffffff',
        duration: 300,
        lineWidth: 40,
        lineHeight: 3,
        lineScale: 1,
        showLine: true,
        barType: 'line',
        shrink: false,
        scrollable: true,
        swipeable: false,
        pullDown: false,
        disabled: false,
        swipeHeight: '100%',
        rootStyle: () => ({}) as UTSJSONObject,
    })

    // ==================== 响应式数据与状态 ====================
    /** 主题色 Store */
    const colorStore = useColorStore()

    /** 子标签面板动态注册列表 */
    const registeredTabs = ref<TabItemData[]>([])

    /** 内部当前激活的 Tab 标识（支持数字或 name） */
    const currentActive = ref<any>(props.active != null ? props.active! : 0)

    /** 滚动视图水平滚动偏移量 */
    const scrollLeft = ref<number>(0)

    /** 指示下划线当前水平位移 (px) */
    const lineLeft = ref<number>(0)

    /** 指示下划线动态计算像素宽度 (px) */
    const computedLineWidth = ref<number>(20)

    /** 指示条是否完成首次测量就绪（避免未定位时的生硬跳变） */
    const isLineReady = ref<boolean>(false)

    /** 下拉面板当前展开/收起状态 */
    const isPullDownOpen = ref<boolean>(false)

    /** 当前组件上下文实例引用，用于 SelectorQuery 测量 */
    const instance = getCurrentInstance()?.proxy

    // ==================== 跨端主题颜色统一计算 ====================
    /**
     * 计算生效的主题色彩
     * 业务规则：用户传参优先；缺省时回退使用系统主题色 steThemeColor
     */
    const effectiveColor = computed<string>(() : string => {
        if (props.color != '') {
            return props.color
        }
        return colorStore.getColor().steThemeColor
    })

    /**
     * 计算激活文字的主题色彩
     * 业务规则：优先使用 titleActiveColor；若无则继承 effectiveColor
     */
    const effectiveActiveColor = computed<string>(() : string => {
        if (props.titleActiveColor != '') {
            return props.titleActiveColor
        }
        return effectiveColor.value
    })

    // ==================== 标签页数据统一处理 ====================
    /**
     * 统一归一化后的标签页展示列表
     * 支持外部 props.tabList 直接配置，亦支持插槽内部子组件 ste-tab 动态注册
     */
    type InternalTabItem = {
        id: string,
        title: string,
        subTitle: string | null,
        name: any | null,
        disabled: boolean,
        badge: any | null,
        showDot: boolean,
        showZeroBadge: boolean,
        icon: string | null,
        image: string | null,
        activeImage: string | null,
        isActive: boolean,
        originalIndex: number,
    }

    const displayTabs = computed<InternalTabItem[]>(() : InternalTabItem[] => {
        const result: InternalTabItem[] = []
        // 优先使用直接传入的数据源列表
        if (props.tabList != null && props.tabList.length > 0) {
            for (let i = 0; i < props.tabList.length; i++) {
                const item = props.tabList[i]
                const titleStr = item.getString('title') != null ? item.getString('title')! : ''
                const subTitleStr = item.getString('subTitle')
                const nameVal = item.get('name') != null ? item.get('name') : i
                const disabledBool = item.getBoolean('disabled') == true
                const badgeVal = item.get('badge')
                const iconStr = item.getString('icon')
                const imageStr = item.getString('image')
                const activeImageStr = item.getString('activeImage')

                const isActive = (currentActive.value == nameVal) || (typeof currentActive.value === 'number' && currentActive.value == i)

                result.push({
                    id: 'tab-prop-' + i.toString(),
                    title: titleStr,
                    subTitle: subTitleStr,
                    name: nameVal,
                    disabled: disabledBool,
                    badge: badgeVal,
                    icon: iconStr,
                    image: imageStr,
                    activeImage: activeImageStr,
                    isActive: isActive,
                    originalIndex: i,
                } as InternalTabItem)
            }
            return result
        }

        // 使用 ste-tab 收集的子项
        for (let i = 0; i < registeredTabs.value.length; i++) {
            const tab = registeredTabs.value[i]
            const nameVal = tab.name != null ? tab.name : i
            const isActive = (currentActive.value == nameVal) || (typeof currentActive.value === 'number' && currentActive.value == i) || (currentActive.value == tab.id)

            result.push({
                id: tab.id,
                title: tab.title,
                subTitle: tab.subTitle != '' ? tab.subTitle : null,
                name: nameVal,
                disabled: tab.disabled == true,
                badge: tab.badge,
                icon: tab.icon != '' ? tab.icon : null,
                image: tab.image != '' ? tab.image : null,
                activeImage: tab.activeImage != '' ? tab.activeImage : null,
                isActive: isActive,
                originalIndex: i,
            } as InternalTabItem)
        }
        return result
    })

    /** 当前激活 Tab 的内部索引 (0-indexed) */
    const activeTabIndex = computed<number>(() : number => {
        const tabs = displayTabs.value
        for (let i = 0; i < tabs.length; i++) {
            if (tabs[i].isActive) {
                return i
            }
        }
        return 0
    })

    // ==================== 徽标存在性辅助判断 ====================
    /**
     * 判断当前 Tab 是否具备可渲染的徽标内容
     * @param {InternalTabItem} item 标签元数据
     * @returns {boolean} 是否展示徽标
     */
    const hasBadge = (item: InternalTabItem): boolean => {
        if (item.showDot == true) {
            return true
        }
        if (item.badge == null) {
            return false
        }
        if (typeof item.badge === 'number') {
            const num = item.badge as number
            return num > 0 || (item.showZeroBadge == true && num == 0)
        }
        if (typeof item.badge === 'string') {
            return (item.badge as string).length > 0
        }
        return true
    }

    // ==================== 下划线定位与横向滚动测量（提升声明至 provide 之前） ====================
    /**
     * 将尺寸值标准化转换为像素数值 (px)
     * @param {any} val 尺寸配置（数值或带单位字符串）
     * @param {number} fallback 兜底像素值
     * @returns {number} 解析后的像素数值
     */
    function parseSizePx(val: any, fallback: number): number {
        if (val == null) return fallback
        if (typeof val === 'number') {
            const num = val as number
            return num > 0 ? num : fallback
        }
        if (typeof val === 'string') {
            const str = (val as string).trim()
            if (str.endsWith('rpx')) {
                const rpxVal = parseFloat(str.replace('rpx', ''))
                return getWindowWidth() * (rpxVal / 750)
            }
            if (str.endsWith('px')) {
                return parseFloat(str.replace('px', ''))
            }
            const n = parseFloat(str)
            if (!isNaN(n) && n > 0) return n
        }
        return fallback
    }

    /**
     * 执行 DOM 节点测量，平滑定位指示条并居中当前激活项
     */
    function measureActiveTab() {
        if (instance == null) return
        const query = uni.createSelectorQuery().in(instance)

        // 联合查询三个关键节点：滚动视口容器、导航条长轨道、各个标签项
        query.select('.ste-tabs-scroll-view').boundingClientRect()
        query.select('.ste-tabs-nav').boundingClientRect()
        query.selectAll('.ste-tabs-item').boundingClientRect()

        query.exec((results: any[]) => {
            if (results == null || results.length < 3) return
            const scrollRect = results[0] as NodeInfo | null
            const navRect = results[1] as NodeInfo | null
            const itemRects = results[2] as NodeInfo[] | null

            if (navRect == null || itemRects == null || itemRects.length == 0) return

            const curIdx = activeTabIndex.value
            if (curIdx < 0 || curIdx >= itemRects.length) return

            const activeRect = itemRects[curIdx]
            if (activeRect == null || activeRect.width == null) return

            // 提取当前项宽度（非空安全守卫，杜绝 !/ 正则词法歧义）
            const activeWidth = activeRect.width != null ? activeRect.width! : 0

            // 计算下划线宽度
            const targetLineWidth = parseSizePx(props.lineWidth, 20)
            computedLineWidth.value = targetLineWidth

            // 计算下划线居中偏移行距（相对于长轨道左边缘）
            const itemLeftRelative = (activeRect.left != null ? activeRect.left! : 0) - (navRect.left != null ? navRect.left! : 0)
            const centerOffset = itemLeftRelative + (activeWidth - targetLineWidth) / 2
            lineLeft.value = centerOffset
            isLineReady.value = true

            // 滚动视口可视宽度（优先取测量值，兜底取屏幕宽度）
            const viewWidth = (scrollRect != null && scrollRect.width != null && scrollRect.width! > 0)
                ? scrollRect.width!
                : getWindowWidth()

            // 当前激活项相对于导航长轨道的中心点坐标（通过 activeWidth / 2 消除 !/ 词法歧义）
            const itemCenter = itemLeftRelative + activeWidth / 2

            // 物理居中滚动公式：让目标中心与可视视口中心对齐
            const targetScroll = itemCenter - viewWidth / 2

            // 最大可滚动边界控制：不小于 0，不大于 (长轨道总宽 - 视口宽)
            const navTotalWidth = navRect.width != null ? navRect.width! : 0
            const maxScroll = Math.max(0, navTotalWidth - viewWidth)
            const finalScroll = Math.min(maxScroll, Math.max(0, targetScroll))

            // 更新 scrollLeft 驱动 scroll-view 平滑滚动至居中位置
            if (scrollLeft.value == finalScroll) {
                scrollLeft.value = finalScroll + 0.1
                nextTick(() => {
                    scrollLeft.value = finalScroll
                })
            } else {
                scrollLeft.value = finalScroll
            }
        })
    }

    // ==================== 提供上下文 Context ====================
    provide<TabsContext>(TABS_KEY, {
        registerTab: (tab: TabItemData) => {
            const index = registeredTabs.value.findIndex((t: TabItemData): boolean => t.id == tab.id)
            if (index >= 0) {
                registeredTabs.value[index] = tab
            } else {
                registeredTabs.value.push(tab)
            }
            nextTick(() => {
                measureActiveTab()
            })
        },
        updateTab: (tab: TabItemData) => {
            const index = registeredTabs.value.findIndex((t: TabItemData): boolean => t.id == tab.id)
            if (index >= 0) {
                registeredTabs.value[index] = tab
                nextTick(() => {
                    measureActiveTab()
                })
            }
        },
        unregisterTab: (id: string) => {
            const index = registeredTabs.value.findIndex((t: TabItemData): boolean => t.id == id)
            if (index >= 0) {
                registeredTabs.value.splice(index, 1)
                nextTick(() => {
                    measureActiveTab()
                })
            }
        },
        getActive: (): any => currentActive.value != null ? currentActive.value! : 0,
        getColor: (): string => effectiveColor.value,
        getDuration: (): number => props.duration,
        isTabActive: (id: string, name: any | null): boolean => {
            const curActive = currentActive.value != null ? currentActive.value! : 0
            if (name != null) {
                return curActive == name
            }
            for (let i = 0; i < registeredTabs.value.length; i++) {
                const tab = registeredTabs.value[i]
                if (tab.id == id) {
                    const nameVal = tab.name != null ? tab.name : i
                    return (curActive == nameVal) || (typeof curActive === 'number' && curActive == i) || (curActive == tab.id)
                }
            }
            return false
        },
        isSwipeable: (): boolean => props.swipeable,
    } as TabsContext)

    // ==================== 标签点击与切换处理 ====================
    /**
     * 响应用户点击标签项
     * @param {InternalTabItem} item 点击的标签对象
     * @param {number} index 点击的序号
     */
    const handleTabClick = (item: InternalTabItem, index: number) => {
        // 禁用状态拦截
        if (props.disabled || item.disabled) {
            return
        }

        // 下拉面板展开时点击自动收起
        if (isPullDownOpen.value) {
            isPullDownOpen.value = false
        }

        const newActive: any = item.name != null ? item.name! : index
        const isChanged = currentActive.value != newActive

        currentActive.value = newActive
        emit('update:active', newActive)

        // 构造原版向后兼容的 Tab 数据
        const tabData: TabItemData = {
            id: item.id,
            title: item.title,
            subTitle: item.subTitle != null ? item.subTitle! : '',
            name: item.name,
            disabled: item.disabled,
            badge: item.badge,
            icon: item.icon != null ? item.icon! : '',
            image: item.image != null ? item.image! : '',
            activeImage: item.activeImage != null ? item.activeImage! : '',
            show: true,
        }

        emit('click-tab', tabData, index)
        if (isChanged) {
            emit('change', tabData, index)
        }

        nextTick(() => {
            measureActiveTab()
        })
    }

    // ==================== 手势滑动切换 (swipeable) ====================
    /**
     * 提取当前所有被禁用的 Tab 索引集合
     * 用于传递给 ste-touch-swipe 实现手势滑动阻尼与禁止切入
     */
    const disabledTabIndices = computed<number[]>(() : number[] => {
        const list: number[] = []
        const tabs = displayTabs.value
        for (let i = 0; i < tabs.length; i++) {
            if (tabs[i].disabled || props.disabled) {
                list.push(i)
            }
        }
        return list
    })

    /**
     * 计算手势切屏模式下的内容高度
     */
    const effectiveSwipeHeight = computed<any>(() : any => {
        if (props.swipeHeight != null && props.swipeHeight != '') {
            return props.swipeHeight
        }
        return '100%'
    })

    /**
     * 手势滑动切屏完成回调
     * @param {number} newIndex 滑动到的目标面板序号
     */
    const handleSwipeChange = (newIndex: number) => {
        const tabs = displayTabs.value
        if (newIndex >= 0 && newIndex < tabs.length) {
            handleTabClick(tabs[newIndex], newIndex)
        }
    }

    // ==================== 下拉面板折叠控制 ====================
    const togglePullDown = () => {
        isPullDownOpen.value = !isPullDownOpen.value
    }

    const closePullDown = () => {
        isPullDownOpen.value = false
    }

    // ==================== 样式计算属性 ====================
    /** 根容器样式 */
    const cmpRootStyle = computed<UTSJSONObject>(() : UTSJSONObject => {
        const style: UTSJSONObject = {}
        return style
    })

    /** 头部导航包裹条背景与样式 */
    const cmpHeaderWrapStyle = computed<UTSJSONObject>(() : UTSJSONObject => {
        const style: UTSJSONObject = {
            backgroundColor: props.background,
        }
        return style
    })

    /** 单个标签项内联样式计算 */
    const getItemStyle = (item: InternalTabItem): UTSJSONObject => {
        const style: UTSJSONObject = {}
        if (props.barType == 'card') {
            if (item.isActive) {
                style['backgroundColor'] = effectiveColor.value
                style['borderColor'] = effectiveColor.value
            } else {
                style['backgroundColor'] = '#f8f8f8'
                style['borderColor'] = '#e5e5e5'
            }
        } else if (props.barType == 'segment') {
            if (item.isActive) {
                style['backgroundColor'] = '#ffffff'
            } else {
                style['backgroundColor'] = 'transparent'
            }
        }
        return style
    }

    /** 标签文字样式计算 */
    const getTitleTextStyle = (item: InternalTabItem): UTSJSONObject => {
        const style: UTSJSONObject = {}
        if (item.disabled || props.disabled) {
            style['color'] = '#c8c9cc'
        } else if (item.isActive) {
            if (props.barType == 'card') {
                style['color'] = '#ffffff'
            } else {
                style['color'] = effectiveActiveColor.value
            }
        } else {
            style['color'] = props.titleInactiveColor
        }
        return style
    }

    /** 副标题文字样式计算 */
    const getSubtitleTextStyle = (item: InternalTabItem): UTSJSONObject => {
        const style: UTSJSONObject = {}
        if (item.isActive) {
            if (props.barType == 'card') {
                style['color'] = '#ffffff'
                style['opacity'] = 0.85
            } else {
                style['color'] = effectiveActiveColor.value
            }
        } else {
            style['color'] = '#999999'
        }
        return style
    }

    /** 下划线指示条动态变换样式 */
    const cmpLineStyle = computed<UTSJSONObject>(() : UTSJSONObject => {
        const lineHeightPx = parseSizePx(props.lineHeight, 3)
        const dur = props.duration
        const style: UTSJSONObject = {
            width: `${computedLineWidth.value}px`,
            height: `${lineHeightPx}px`,
            borderRadius: `${lineHeightPx / 2}px`,
            backgroundColor: effectiveColor.value,
            transform: `translateX(${lineLeft.value}px) scaleX(${props.lineScale})`,
            transitionDuration: `${dur}ms`,
            opacity: isLineReady.value ? 1 : 0,
        }
        return style
    })

    /** 下拉面板项样式 */
    const getPullDownItemStyle = (item: InternalTabItem): UTSJSONObject => {
        const style: UTSJSONObject = {}
        if (item.isActive) {
            style['borderColor'] = effectiveActiveColor.value
            style['backgroundColor'] = 'rgba(0, 144, 255, 0.08)'
        }
        return style
    }

    // ==================== 响应式侦听与生命周期 ====================
    watch(
        () : any => props.active != null ? props.active! : 0,
        (newVal: any) => {
            currentActive.value = newVal != null ? newVal! : 0
            nextTick(() => {
                measureActiveTab()
            })
        }
    )

    onMounted(() => {
        setTimeout(() => {
            measureActiveTab()
        }, 80)
    })
</script>

