/**
 * @file constants.uts
 * @description ste-toast 轻提示组件 - uni-app x / UTS 强类型契约与常量定义
 */

/**
 * Toast 轻提示显示配置参数强类型
 */
export type ToastOptions = {
	/**
	 * 提示文本内容，支持换行符 \n
	 */
	title ?: string,
	/**
	 * 图标类型：
	 * - 'success'：成功图标（绿色打勾或白色对勾）
	 * - 'error'：失败图标（错误叉号）
	 * - 'loading'：加载中旋转图标（此时 duration 默认设为 0，需手动调用 hideToast 关闭）
	 * - 'none'：无图标（仅展示纯文本）
	 * @default 'success'
	 */
	icon ?: string,
	/**
	 * 自定义图片图标的图片 URL 地址，优先级高于 icon
	 */
	image ?: string,
	/**
	 * 提示停留持续时间（毫秒），默认为 1500ms
	 * 值为 0 时不会自动关闭（如 loading 模式下需手动关闭）
	 * @default 1500
	 */
	duration ?: number,
	/**
	 * 是否显示全屏透明遮罩层（防止在提示期间用户触摸穿透点击页面元素）
	 * @default false
	 */
	mask ?: boolean,
	/**
	 * 是否开启排队队列模式（当连续触发多个 toast 时，后续提示将依次等待前一个提示结束后按序播放）
	 * @default false
	 */
	order ?: boolean,
	/**
	 * 提示成功显示时的回调函数
	 */
	success ?: () => void,
	/**
	 * 提示失败时的回调函数
	 */
	fail ?: () => void,
	/**
	 * 提示完成（无论成功或失败均会触发）的回调函数
	 */
	complete ?: () => void,
	/**
	 * 提示完全关闭/消失后的回调函数
	 */
	close ?: () => void,
}

/**
 * useToast 组合式函数的返回契约
 */
export type UseToastResult = {
	/**
	 * 打开/显示轻提示
	 * @param options 轻提示配置参数
	 */
	showToast : (options : ToastOptions) => void,
	/**
	 * 关闭当前显示的轻提示
	 */
	hideToast : () => void,
}

/**
 * 默认持续显示时长（毫秒）
 */
export const DEFAULT_TOAST_DURATION = 1500

/**
 * 内置图标编码映射表
 */
export const TOAST_ICON_CODE_MAP : UTSJSONObject = {
	'success': '\ue67a',
	'error': '\ue67b',
}
