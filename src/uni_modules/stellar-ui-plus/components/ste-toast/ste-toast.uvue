<template>
	<view v-if="visible" class="ste-toast-container" :class="{ 'ste-toast-has-mask': showMask }">
		<!-- 1. 全屏防触摸穿透遮罩层 -->
		<view v-if="showMask" class="ste-toast-mask" />

		<!-- 2. 屏幕正中卡片内容容器 -->
		<view class="ste-toast-center-wrap">
			<view class="ste-toast-card">
				<!-- 2.1 图标 / 加载中 / 图片展示区 -->
				<view v-if="showIconBox" class="ste-toast-icon-wrap">
					<!-- 自定义图片展示 -->
					<ste-image
						v-if="currentImage != ''"
						:src="currentImage"
						:width="72"
						:height="72"
						display="block"
					/>
					<!-- 加载中动画展示 -->
					<ste-loading
						v-else-if="currentIcon == 'loading'"
						:size="72"
						color="#FFFFFF"
					/>
					<!-- 内置状态图标（success / error）展示 -->
					<ste-icon
						v-else-if="cmpIconCode != ''"
						:code="cmpIconCode"
						:size="cmpIconSize"
						color="#FFFFFF"
					/>
				</view>

				<!-- 2.2 提示文字内容区 -->
				<text v-if="currentTitle != ''" class="ste-toast-title">{{ currentTitle }}</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * @file ste-toast.uvue
	 * @description Toast 轻提示组件 - uni-app x / UTS 纯原生版本
	 * 支持通过 useToast() 组合式函数或 ref 实例调用，提供成功、失败、加载中、自定义图片、遮罩防穿透及队列提示能力。
	 */
	import { ref, computed, onMounted, onUnmounted } from 'vue'
	import {
		ToastOptions,
		DEFAULT_TOAST_DURATION,
		TOAST_ICON_CODE_MAP,
	} from './constants.uts'

	defineOptions({
		name: 'ste-toast',
		options: {
			virtualHost: true,
		},
	})

	// ==================== 响应式状态定义 ====================
	/** 是否处于可见状态 */
	const visible = ref<boolean>(false)

	/** 提示标题文本 */
	const currentTitle = ref<string>('')

	/** 图标类型 */
	const currentIcon = ref<string>('success')

	/** 自定义图片图标 URL */
	const currentImage = ref<string>('')

	/** 停留持续时间（毫秒） */
	const currentDuration = ref<number>(DEFAULT_TOAST_DURATION)

	/** 是否显示全屏防穿透遮罩 */
	const showMask = ref<boolean>(false)

	// ==================== 回调函数与计时句柄 ====================
	let successCb : (() => void) | null = null
	let failCb : (() => void) | null = null
	let completeCb : (() => void) | null = null
	let closeCb : (() => void) | null = null

	/** 自动隐藏定时器句柄 */
	let hideTimer : number | null = null

	/** 队列延时定时器句柄 */
	let queueTimer : number | null = null

	/** 内存记录上一条队列 Toast 预计结束时间戳 */
	let lastQueueEndTime : number = 0

	// ==================== 计算属性 ====================
	/** 图标编码计算 */
	const cmpIconCode = computed(() : string => {
		const iconKey = currentIcon.value
		if (TOAST_ICON_CODE_MAP.getString(iconKey) != null) {
			return TOAST_ICON_CODE_MAP.getString(iconKey)!
		}
		return ''
	})

	/** 图标尺寸计算（error 略作微调保持视觉平衡） */
	const cmpIconSize = computed(() : number => {
		return currentIcon.value == 'error' ? 58 : 72
	})

	/** 是否展示图标包装盒 */
	const showIconBox = computed(() : boolean => {
		if (currentImage.value != '') return true
		if (currentIcon.value == 'loading') return true
		return currentIcon.value != 'none' && currentIcon.value != '' && cmpIconCode.value != ''
	})

	// ==================== 核心方法 ====================
	/**
	 * 关闭并隐藏轻提示
	 */
	function hideToast() {
		if (hideTimer != null) {
			clearTimeout(hideTimer!)
			hideTimer = null
		}
		if (queueTimer != null) {
			clearTimeout(queueTimer!)
			queueTimer = null
		}
		visible.value = false
		lastQueueEndTime = 0

		if (closeCb != null) {
			closeCb!()
			closeCb = null
		}
	}

	/**
	 * 打开并显示轻提示
	 * @param options 轻提示参数配置项
	 */
	function showToast(options : ToastOptions) {
		// 关闭系统底层原生 Toast，避免叠加
		uni.hideToast()

		// 清理当前组件可能正在运行的隐藏与队列计时器
		if (hideTimer != null) {
			clearTimeout(hideTimer!)
			hideTimer = null
		}
		if (queueTimer != null) {
			clearTimeout(queueTimer!)
			queueTimer = null
		}

		const defaultDur = DEFAULT_TOAST_DURATION
		const requestedDur = options.duration ?? defaultDur
		const actualDur = options.icon == 'loading' ? 0 : requestedDur

		const isOrder = options.order == true
		let delayTime = 0
		const now = Date.now()

		if (isOrder) {
			if (lastQueueEndTime > now) {
				delayTime = (lastQueueEndTime - now) as number
			}
			const extraDur = actualDur > 0 ? actualDur : defaultDur
			lastQueueEndTime = now + delayTime + extraDur + 100
		} else {
			lastQueueEndTime = 0
		}

		const executeShow = () => {
			try {
				visible.value = false
				currentTitle.value = options.title ?? ''
				currentIcon.value = options.icon ?? 'success'
				currentImage.value = options.image ?? ''
				currentDuration.value = actualDur
				showMask.value = options.mask == true

				successCb = options.success ?? null
				failCb = options.fail ?? null
				completeCb = options.complete ?? null
				closeCb = options.close ?? null

				visible.value = true

				// 开启倒计时自动关闭（为 0 时如 loading 不自动关闭）
				if (currentDuration.value > 0) {
					hideTimer = setTimeout(() => {
						hideToast()
					}, currentDuration.value)
				}

				if (successCb != null) {
					successCb!()
				}
			} catch (e) {
				if (failCb != null) {
					failCb!()
				}
			}
			if (completeCb != null) {
				completeCb!()
			}
		}

		if (delayTime > 0) {
			queueTimer = setTimeout(() => {
				executeShow()
			}, delayTime)
		} else {
			executeShow()
		}
	}

	// ==================== 全局事件监听与生命周期 ====================
	function handleGlobalShow(rawOptions : any) {
		if (rawOptions != null) {
			const opts = rawOptions as ToastOptions
			showToast(opts)
		}
	}

	function handleGlobalHide() {
		hideToast()
	}

	onMounted(() => {
		uni.$on('ste:toast:show', handleGlobalShow)
		uni.$on('ste:toast:hide', handleGlobalHide)
	})

	onUnmounted(() => {
		uni.$off('ste:toast:show', handleGlobalShow)
		uni.$off('ste:toast:hide', handleGlobalHide)
		if (hideTimer != null) {
			clearTimeout(hideTimer!)
			hideTimer = null
		}
		if (queueTimer != null) {
			clearTimeout(queueTimer!)
			queueTimer = null
		}
	})

	// ==================== Expose 实例方法导出 ====================
	defineExpose({
		showToast,
		hideToast,
	})
</script>

<style scoped>
/* 全屏居中外层容器 */
.ste-toast-container {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	z-index: 9999;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	pointer-events: none;
}

/* 开启遮罩时允许接收点击事件，阻止穿透 */
.ste-toast-has-mask {
	pointer-events: auto;
}

/* 透明遮罩层 */
.ste-toast-mask {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: transparent;
	z-index: 10000;
}

/* 居中包装盒 */
.ste-toast-center-wrap {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	z-index: 10001;
	pointer-events: auto;
}

/* 提示黑色半透明卡片 */
.ste-toast-card {
	max-width: 520rpx;
	background-color: rgba(0, 0, 0, 0.75);
	border-radius: 16rpx;
	padding: 40rpx 48rpx;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

/* 图标包装盒 */
.ste-toast-icon-wrap {
	margin-bottom: 20rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}

/* 提示文字 */
.ste-toast-title {
	font-size: 32rpx;
	font-weight: bold;
	color: #ffffff;
	line-height: 44rpx;
	text-align: center;
}
</style>
