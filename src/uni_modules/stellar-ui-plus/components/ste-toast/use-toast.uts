/**
 * @file use-toast.uts
 * @description ste-toast 轻提示组合式函数 - uni-app x / UTS 版本
 * 通过 uni.$emit 全局事件系统触发页面内的 ste-toast 组件展示或隐藏。
 */
import { ToastOptions, UseToastResult } from './constants.uts'

/**
 * 获得 Toast 控制实例方法
 * @returns 包含 showToast 和 hideToast 的控制对象
 * @example
 * ```uts
 * const toast = useToast()
 * toast.showToast({ title: '操作成功', icon: 'success' } as ToastOptions)
 * ```
 */
export function useToast() : UseToastResult {
	/**
	 * 打开轻提示
	 * @param options Toast 配置项
	 */
	const showToast = (options : ToastOptions) => {
		uni.$emit('ste:toast:show', options as UTSJSONObject)
	}

	/**
	 * 隐藏/关闭轻提示
	 */
	const hideToast = () => {
		uni.$emit('ste:toast:hide')
	}

	return {
		showToast: showToast,
		hideToast: hideToast,
	} as UseToastResult
}
