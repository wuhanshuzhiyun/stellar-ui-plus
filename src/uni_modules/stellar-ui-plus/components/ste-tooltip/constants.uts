/**
 * @file constants.uts
 * @description ste-tooltip 文字提示组件 - uni-app x / UTS 强类型契约与常量定义
 * 提供气泡提示配置项接口、组合式 Hook 契约及方向默认值
 */

import { ComponentPublicInstance } from 'vue'

/**
 * Tooltip 气泡提示展示配置参数强类型
 */
export type TooltipOptions = {
	/**
	 * 提示文本内容
	 */
	text : string,
	/**
	 * 目标元素的选择器（如 '.target-btn' 或 '#my-element'）
	 */
	selector : string,
	/**
	 * 触发元素所在的组件实例上下文（可选）
	 * 若在自定义组件内部使用，建议传入组件实例以限制查询作用域；若在普通页面中使用可留空
	 */
	instance ?: ComponentPublicInstance | null,
	/**
	 * 气泡弹出展示方位：
	 * - 'top'：在目标元素上方弹出，小三角箭头朝下
	 * - 'bottom'：在目标元素下方弹出，小三角箭头朝上
	 * @default 'top'
	 */
	placement ?: string,
	/**
	 * 气泡最大宽度（支持带单位的 CSS 尺寸，如 '60vw'、'280px' 等）
	 * @default '60vw'
	 */
	maxWidth ?: string,
}

/**
 * useTooltip 组合式函数的返回契约
 */
export type UseTooltipResult = {
	/**
	 * 打开并展示文字提示气泡
	 * @param options Tooltip 配置参数
	 */
	showTooltip : (options : TooltipOptions) => void,
	/**
	 * 关闭并隐藏当前显示的文字提示气泡
	 */
	hideTooltip : () => void,
}

/**
 * 默认弹出方向
 */
export const DEFAULT_TOOLTIP_PLACEMENT = 'top'

/**
 * 默认最大宽度
 */
export const DEFAULT_TOOLTIP_MAX_WIDTH = '60vw'

/**
 * 屏幕边缘防溢出安全边距（像素）
 */
export const TOOLTIP_SCREEN_MARGIN = 10

/**
 * 提示淡出动画持续时长（毫秒）
 */
export const TOOLTIP_ANIM_DURATION = 200
