<template>
	<!-- 根容器：设置自适应宽高与相对定位 -->
	<view class="ste-touch-swipe-root" :style="rootStyle">
		<!-- 视口裁剪层：限制超出部分不显示，监听原生手势滑动事件 -->
		<view
			class="ste-touch-swipe-viewport"
			@touchstart.stop="onTouchStart"
			@touchmove.stop.prevent="onTouchMove"
			@touchend.stop="onTouchEnd"
			@touchcancel.stop="onTouchEnd"
		>
			<!-- 滑动内容轨道：根据 direction 切换 flex 排列方向并执行 transform 位移过渡 -->
			<view class="ste-touch-swipe-track" :style="trackStyle">
				<slot></slot>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
/**
 * ste-touch-swipe 手势切屏容器组件
 *
 * 模块职责：
 * 1. 负责多面板单轴滑动切换（支持水平横向与垂直纵向两种方向）；
 * 2. 移除原生引擎不支持的 CSS Grid 与 CSS 变量，全面采用 Flex 布局流与内联动态计算；
 * 3. 具备实时手指跟手滑动、边缘与禁用越界阻尼抑制（0.25 系数）、灵敏度阈值吸附与受控双向绑定 (v-model:index)；
 * 4. 通过 provide 为子组件 ste-touch-swipe-item 提供注册与状态同步上下文。
 */
import { ref, computed, watch, onMounted, getCurrentInstance, provide, nextTick } from 'vue'
import { formatPx } from '../../utils/utils.uts'
import { TOUCH_SWIPE_KEY, TouchSwipeContext, TouchSwipeItemData } from './constants.uts'

/**
 * 组件入参 Props 定义
 */
const props = withDefaults(
	defineProps<{
		/** 当前激活展示的面板索引，支持 v-model:index 双向绑定 */
		index?: number
		/** 滑动切换方向：horizontal 水平方向 | vertical 垂直方向 */
		direction?: string
		/** 容器宽度，支持 rpx、px、百分比或纯数字 */
		width?: any
		/** 容器高度，支持 rpx、px、百分比或纯数字 */
		height?: any
		/** 切换动画过渡时长，单位：秒 */
		duration?: number
		/** 灵敏度阈值（0-1 之间的数值，滑动位移占容器尺寸比例超过该值时触发切换） */
		swipeThreshold?: number
		/** 是否全局禁用手势滑动切换 */
		disabled?: boolean
		/** 自定义面板子项数量（当不使用 ste-touch-swipe-item 子组件时手动传入） */
		childrenLength?: number
		/** 手动指定的禁用索引列表（当不使用 ste-touch-swipe-item 子组件时手动传入） */
		disabledIndexs?: number[]
	}>(),
	{
		index: 0,
		direction: 'horizontal',
		width: '100%',
		height: '100%',
		duration: 0.3,
		swipeThreshold: 0.35,
		disabled: false,
		childrenLength: 0,
		disabledIndexs: () : number[] => [] as number[]
	}
)

/**
 * 组件向外分发事件
 */
const emit = defineEmits<{
	/** 更新激活索引事件，支持 v-model:index */
	(e: 'update:index', index: number): void
	/** 索引切换变更事件 */
	(e: 'change', index: number): void
}>()

/** 当前组件实例引用 */
const instance = getCurrentInstance()

/** 当前激活索引状态 */
const currentIndex = ref<number>(props.index)

/** 容器像素宽度 */
const containerWidth = ref<number>(0)

/** 容器像素高度 */
const containerHeight = ref<number>(0)

/** 是否处于手指拖拽触摸中（拖拽中需关闭过渡动画以保证跟手响应） */
const isDragging = ref<boolean>(false)

/** 实时触摸偏移量（px，跟随手指平移，正数向右/向下，负数向左/向上） */
const touchOffset = ref<number>(0)

/** 记录触摸起始横坐标 */
const touchStartX = ref<number>(0)

/** 记录触摸起始纵坐标 */
const touchStartY = ref<number>(0)

/** 注册的子项列表数据集合 */
const registeredItems = ref<TouchSwipeItemData[]>([])

/**
 * 监听外部 props.index 变化并同步更新组件内部索引
 */
watch(
	() : number => props.index,
	(newIndex: number) => {
		if (newIndex != currentIndex.value) {
			currentIndex.value = newIndex
		}
	}
)

/**
 * 计算面板总数量
 * 优先取用户显式传入的 childrenLength，否则根据注册的子项数组长度推导
 */
const totalCount = computed<number>(() : number => {
	if (props.childrenLength > 0) {
		return props.childrenLength
	}
	return registeredItems.value.length
})

/**
 * 计算当前生效的所有禁用索引列表
 * 聚合 props.disabledIndexs 与每个子项自身的 disabled 属性
 */
const allDisabledIndices = computed<number[]>(() : number[] => {
	const disabledList: number[] = []
	// 合并显式配置的禁用索引
	for (let i = 0; i < props.disabledIndexs.length; i++) {
		const idx = props.disabledIndexs[i]
		if (!disabledList.includes(idx)) {
			disabledList.push(idx)
		}
	}
	// 合并注册子项中的禁用状态
	for (let i = 0; i < registeredItems.value.length; i++) {
		const item = registeredItems.value[i]
		if (item.disabled && !disabledList.includes(i)) {
			disabledList.push(i)
		}
	}
	return disabledList
})

/**
 * 根容器样式绑定
 */
const rootStyle = computed<string>(() : string => {
	const w = formatPx(props.width)
	const h = formatPx(props.height)
	return `width: ${w}; height: ${h};`
})

/**
 * 滑动轨道轨道样式计算
 * 根据方向配置水平或垂直 Flex 流向，并精确计算平移变换与过渡动画
 */
const trackStyle = computed<string>(() : string => {
	const isVertical = props.direction == 'vertical'
	const size = isVertical ? containerHeight.value : containerWidth.value
	const count = totalCount.value > 0 ? totalCount.value : 1

	// 基准位置（以当前索引乘以单屏步长尺寸）
	const baseTranslate = -currentIndex.value * size
	// 叠加手指实时跟手位移
	const currentTranslate = baseTranslate + touchOffset.value

	// 水平或垂直 translate
	const transformProp = isVertical
		? `transform: translateY(${currentTranslate}px);`
		: `transform: translateX(${currentTranslate}px);`

	// 拖拽时时长设为 0ms 实现零延迟跟手，释放切换时按 props.duration 弹性过渡
	const durationVal = isDragging.value ? 0 : props.duration
	const transitionProp = `transition-duration: ${durationVal}s;`

	// 轨道的 Flex 方向与总尺寸计算（水平累加宽度，垂直累加高度）
	let flexProp = ''
	if (isVertical) {
		const totalH = size > 0 ? `${size * count}px` : '100%'
		flexProp = `flex-direction: column; width: 100%; height: ${totalH};`
	} else {
		const totalW = size > 0 ? `${size * count}px` : '100%'
		flexProp = `flex-direction: row; height: 100%; width: ${totalW};`
	}

	return `${flexProp} ${transformProp} ${transitionProp}`
})

/**
 * 测量并更新根容器的实际像素尺寸
 */
function measureContainerSize() {
	if (instance == null) {
		return
	}
	uni.createSelectorQuery()
		.in(instance.proxy)
		.select('.ste-touch-swipe-root')
		.boundingClientRect((rect : any | null) => {
			if (rect != null) {
				const r = rect as NodeInfo
				if (r.width != null && r.width! > 0) {
					containerWidth.value = r.width!
				}
				if (r.height != null && r.height! > 0) {
					containerHeight.value = r.height!
				}
			}
		})
		.exec()
}

/**
 * 注册子组件项
 */
function registerItem(item: TouchSwipeItemData) {
	const exists = registeredItems.value.some((it: TouchSwipeItemData) : boolean => it.id == item.id)
	if (!exists) {
		registeredItems.value.push(item)
	}
}

/**
 * 注销子组件项
 */
function unregisterItem(id: string) {
	const index = registeredItems.value.findIndex((it: TouchSwipeItemData) : boolean => it.id == id)
	if (index >= 0) {
		registeredItems.value.splice(index, 1)
	}
}

/**
 * 更新子组件项的禁用状态
 */
function updateItemDisabled(id: string, disabled: boolean) {
	const item = registeredItems.value.find((it: TouchSwipeItemData) : boolean => it.id == id)
	if (item != null) {
		item.disabled = disabled
	}
}

// 依赖注入：向下广播上下文
provide<TouchSwipeContext>(
	TOUCH_SWIPE_KEY,
	{
		registerItem,
		unregisterItem,
		updateItemDisabled,
		getContainerWidth: () : number => containerWidth.value,
		getContainerHeight: () : number => containerHeight.value,
		getDirection: () : string => props.direction
	} as TouchSwipeContext
)

/**
 * 手势触摸开始处理
 */
function onTouchStart(e: TouchEvent) {
	// 全局禁用时忽略任何手势
	if (props.disabled) {
		return
	}

	// 容器尺寸测量兜底
	if (containerWidth.value == 0 || containerHeight.value == 0) {
		measureContainerSize()
	}

	if (e.touches.length > 0) {
		const touch = e.touches[0]
		touchStartX.value = touch.clientX
		touchStartY.value = touch.clientY
		touchOffset.value = 0
		isDragging.value = true
	}
}

/**
 * 手势触摸移动处理（跟手位移与阻尼控制）
 */
function onTouchMove(e: TouchEvent) {
	if (!isDragging.value || props.disabled) {
		return
	}
	if (e.touches.length == 0) {
		return
	}

	const touch = e.touches[0]
	const deltaX = touch.clientX - touchStartX.value
	const deltaY = touch.clientY - touchStartY.value

	const isVertical = props.direction == 'vertical'
	let delta = isVertical ? deltaY : deltaX

	// 计算当前尝试滑动的目标索引
	let targetIndex = currentIndex.value
	if (delta > 0) {
		// 向右或向下滑动，目标为上一项
		targetIndex = currentIndex.value - 1
	} else if (delta < 0) {
		// 向左或向上滑动，目标为下一项
		targetIndex = currentIndex.value + 1
	}

	// 判断是否越界（首项往右拉、尾项往左拉）
	const isOutOfBounds = targetIndex < 0 || targetIndex >= totalCount.value
	// 判断目标项是否被禁用
	const isTargetDisabled = allDisabledIndices.value.includes(targetIndex)

	// 越界或目标项被禁用时施加 0.25 阻尼衰减，给用户真实的弹性阻力手感
	if (isOutOfBounds || isTargetDisabled) {
		delta = delta * 0.25
	}

	touchOffset.value = delta
}

/**
 * 手势触摸结束处理（阈值吸附与回弹吸附）
 */
function onTouchEnd(e: TouchEvent) {
	if (!isDragging.value || props.disabled) {
		return
	}
	isDragging.value = false

	const isVertical = props.direction == 'vertical'
	const size = isVertical ? containerHeight.value : containerWidth.value
	// 灵敏度切换阈值像素计算
	const thresholdDistance = size * props.swipeThreshold
	const delta = touchOffset.value

	let nextIndex = currentIndex.value
	if (delta < -thresholdDistance) {
		// 向左/向上位移超过阈值，切换至下一项
		nextIndex = currentIndex.value + 1
	} else if (delta > thresholdDistance) {
		// 向右/向偏位移超过阈值，切换至上一项
		nextIndex = currentIndex.value - 1
	}

	// 边界与禁用判定
	const isValidTarget = nextIndex >= 0 && nextIndex < totalCount.value && !allDisabledIndices.value.includes(nextIndex)

	// 重置跟手偏移
	touchOffset.value = 0

	if (isValidTarget && nextIndex != currentIndex.value) {
		// 满足切换条件，生效新索引并通知外部
		currentIndex.value = nextIndex
		emit('update:index', nextIndex)
		emit('change', nextIndex)
	}
}

/**
 * 编程式切换到上一项
 */
function prev() {
	const target = currentIndex.value - 1
	if (target >= 0 && !allDisabledIndices.value.includes(target)) {
		currentIndex.value = target
		emit('update:index', target)
		emit('change', target)
	}
}

/**
 * 编程式切换到下一项
 */
function next() {
	const target = currentIndex.value + 1
	if (target < totalCount.value && !allDisabledIndices.value.includes(target)) {
		currentIndex.value = target
		emit('update:index', target)
		emit('change', target)
	}
}

/**
 * 编程式切换到指定索引
 */
function swipeTo(index: number) {
	if (index >= 0 && index < totalCount.value && !allDisabledIndices.value.includes(index)) {
		currentIndex.value = index
		emit('update:index', index)
		emit('change', index)
	}
}

/**
 * 重新测量容器尺寸（当外部尺寸或显示隐藏动态变更时调用）
 */
function resize() {
	measureContainerSize()
}

/**
 * 挂载生命周期：测量容器初始尺寸
 */
onMounted(() => {
	nextTick(() => {
		measureContainerSize()
	})
})

/**
 * 暴露组件外部操作方法
 */
defineExpose({
	prev,
	next,
	swipeTo,
	resize
})
</script>

<style>
.ste-touch-swipe-root {
	position: relative;
	overflow: hidden;
}

.ste-touch-swipe-viewport {
	width: 100%;
	height: 100%;
	overflow: hidden;
}

.ste-touch-swipe-track {
	display: flex;
	flex-wrap: nowrap;
	transition-property: transform;
	transition-timing-function: cubic-bezier(0.25, 1, 0.5, 1);
}
</style>
