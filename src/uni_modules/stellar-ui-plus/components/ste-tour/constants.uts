/**
 * @file constants.uts
 * @description ste-tour 指引组件 - uni-app x / UTS 强类型契约与常量定义
 */

/**
 * 气泡提示位置类型
 */
export type TourPosition =
	| 'top'
	| 'bottom'
	| 'top-start'
	| 'top-center'
	| 'top-end'
	| 'bottom-start'
	| 'bottom-center'
	| 'bottom-end'

/**
 * 引导单步骤配置强类型
 */
export type TourStep = {
	/**
	 * 步骤描述内容（必填）
	 */
	message : string,
	/**
	 * 目标高亮元素的 DOM/组件 ID（必填，无需带 # 号）
	 */
	target : string,
	/**
	 * 步骤标题（可选）
	 */
	title ?: string,
	/**
	 * 气泡提示位置（可选，若不传则自动根据视口空间计算）
	 * - 'top' | 'bottom' | 'top-start' | 'top-center' | 'top-end' | 'bottom-start' | 'bottom-center' | 'bottom-end'
	 */
	position ?: string,
}

/**
 * 目标节点矩形信息结构
 */
export type TourTargetRect = {
	top : number,
	left : number,
	bottom : number,
	right : number,
	width : number,
	height : number,
}
