<template>
	<view v-if="dataShow" class="ste-tour-root" @click="clickRoot">
		<!-- 1. 目标高亮聚焦框（通过超大外阴影实现全屏镂空暗色遮罩） -->
		<view
			v-if="targetVisible"
			class="ste-tour-view"
			:style="cmpTargetStyle"
			@click.stop="() => {}"
		/>

		<!-- 2. 引导说明气泡卡片 -->
		<view
			v-if="msgVisible"
			class="ste-tour-message"
			:style="cmpMessageStyle"
			@click.stop="() => {}"
		>
			<!-- 2.1 气泡小三角箭头 -->
			<view
				class="message-arrows"
				:class="arrowDirection == 'top' ? 'arrows-top' : 'arrows-bottom'"
				:style="cmpArrowStyle"
			/>

			<!-- 2.2 气泡卡片主体内容 -->
			<view class="message-content">
				<!-- 顶部标题栏 -->
				<view v-if="props.showTitleBar && (cmpCurrentStep?.title ?? '') != ''" class="message-head">
					<text class="head-title">{{ cmpCurrentStep?.title ?? '' }}</text>
					<view class="head-close" @click="close">
						<ste-icon code="&#xe67b;" :size="30" />
					</view>
				</view>

				<!-- 描述文本区 / 自定义插槽 -->
				<view class="message-body">
					<slot :item="cmpCurrentStep">
						<text class="message-text" :style="cmpMessageTextStyle">{{ cmpCurrentStep?.message ?? '' }}</text>
					</slot>
				</view>

				<!-- 底部步骤与操作按钮栏 -->
				<view v-if="cmpShowFooter" class="message-footer">
					<text class="step-num" :style="cmpMessageTextStyle">{{ dataCurrent + 1 }}/{{ props.steps.length }}</text>
					<view class="step-btns">
						<view v-if="cmpShowPrevStep" class="btn-item">
							<ste-button
								:round="false"
								background="#ffffff"
								borderColor="#0090FF"
								color="#0090FF"
								:mode="100"
								@click="onUp"
							>
								{{ props.prevStepTxt }}
							</ste-button>
						</view>
						<view class="btn-item">
							<ste-button
								:round="false"
								:mode="100"
								@click="onNext"
							>
								{{ dataCurrent < props.steps.length - 1 ? props.nextStepTxt : props.completeTxt }}
							</ste-button>
						</view>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * @file ste-tour.uvue
	 * @description Tour 指引组件 - uni-app x / UTS 纯原生版本
	 * 用于在页面中分步高亮聚焦目标元素，并弹出带指向箭头的说明气泡卡片。
	 */
	import { ref, computed, watch, onMounted, onUnmounted } from 'vue'
	import { TourStep } from './constants.uts'
	import { formatPx, getWindowWidth, getWindowHeight } from '../../utils/utils.uts'

	defineOptions({
		name: 'ste-tour',
		options: {
			virtualHost: true,
		},
	})

	// ==================== Props 属性定义 ====================
	type TourProps = {
		/** 是否展示引导组件 */
		show ?: boolean,
		/** 当前步骤索引（从 0 开始） */
		current ?: number,
		/** 步骤配置列表 */
		steps ?: TourStep[],
		/** 气泡偏移量 [x, y]，单位 px */
		offset ?: number[],
		/** 是否展示顶部标题栏 */
		showTitleBar ?: boolean,
		/** 是否展示底部步骤翻页栏 */
		showFooter ?: boolean,
		/** 是否展示暗色背景蒙层 */
		mask ?: boolean,
		/** 点击蒙层是否关闭引导 */
		maskClose ?: boolean,
		maskColse ?: boolean,
		/** 是否展示“上一步”按钮 */
		showPrevStep ?: boolean,
		/** 背景蒙层颜色 */
		background ?: string,
		/** 高亮聚焦框与气泡圆角（rpx 或 px） */
		radius ?: any,
		/** 气泡背景色 */
		messageBg ?: string,
		/** 气泡文字颜色 */
		messageColor ?: string,
		/** 下一步按钮文案 */
		nextStepTxt ?: string,
		/** 上一步按钮文案 */
		prevStepTxt ?: string,
		/** 完成按钮文案 */
		completeTxt ?: string,
	}

	const props = withDefaults(defineProps<TourProps>(), {
		show: false,
		current: 0,
		steps: () : TourStep[] => [] as TourStep[],
		offset: () : number[] => [0, 0] as number[],
		showTitleBar: false,
		showFooter: true,
		mask: true,
		maskClose: true,
		maskColse: true,
		showPrevStep: true,
		background: 'rgba(0,0,0,0.5)',
		radius: 18,
		messageBg: '#ffffff',
		messageColor: '#000000',
		nextStepTxt: '下一步',
		prevStepTxt: '上一步',
		completeTxt: '完成',
	})

	// ==================== Emits 事件定义 ====================
	const emit = defineEmits<{
		(e: 'update:show', show : boolean) : void,
		(e: 'update:current', current : number) : void,
		(e: 'change', current : number) : void,
		(e: 'close') : void,
	}>()

	// ==================== 响应式状态定义 ====================
	const dataShow = ref<boolean>(false)
	const dataCurrent = ref<number>(0)

	// 高亮目标坐标
	const targetTop = ref<number>(0)
	const targetLeft = ref<number>(0)
	const targetWidth = ref<number>(0)
	const targetHeight = ref<number>(0)
	const targetVisible = ref<boolean>(false)

	// 气泡卡片坐标与样式
	const msgTop = ref<number | null>(null)
	const msgBottom = ref<number | null>(null)
	const msgLeft = ref<number | null>(null)
	const msgRight = ref<number | null>(null)
	const msgTransform = ref<string>('')
	const msgVisible = ref<boolean>(false)

	// 箭头小三角坐标与方向
	const arrowTop = ref<number | null>(null)
	const arrowBottom = ref<number | null>(null)
	const arrowLeft = ref<number | null>(null)
	const arrowRight = ref<number | null>(null)
	const arrowDirection = ref<string>('top') // 'top' | 'bottom'

	// 定时测量句柄
	let stepTimer : number | null = null

	// ==================== 计算属性 ====================
	/** 当前激活的步骤对象 */
	const cmpCurrentStep = computed(() : TourStep | null => {
		if (dataCurrent.value >= 0 && dataCurrent.value < props.steps.length) {
			return props.steps[dataCurrent.value]
		}
		return null
	})

	/** 是否展示“上一步”按钮 */
	const cmpShowPrevStep = computed(() : boolean => {
		return props.showPrevStep && dataCurrent.value > 0
	})

	/** 是否展示底部翻页栏 */
	const cmpShowFooter = computed(() : boolean => {
		return props.showFooter && props.steps.length > 1
	})

	/** 高亮聚焦框动态样式 */
	const cmpTargetStyle = computed(() : UTSJSONObject => {
		const radPx = formatPx(props.radius)
		const style : UTSJSONObject = {
			top: `${targetTop.value}px`,
			left: `${targetLeft.value}px`,
			width: `${targetWidth.value}px`,
			height: `${targetHeight.value}px`,
			borderRadius: radPx,
		}
		if (props.mask) {
			style['boxShadow'] = `0 0 0 2500px ${props.background}`
		}
		return style
	})

	/** 气泡主体动态样式 */
	const cmpMessageStyle = computed(() : UTSJSONObject => {
		const radPx = formatPx(props.radius)
		const style : UTSJSONObject = {
			backgroundColor: props.messageBg,
			borderRadius: radPx,
		}
		if (msgTop.value != null) {
			style['top'] = `${msgTop.value}px`
		}
		if (msgBottom.value != null) {
			style['bottom'] = `${msgBottom.value}px`
		}
		if (msgLeft.value != null) {
			style['left'] = `${msgLeft.value}px`
		}
		if (msgRight.value != null) {
			style['right'] = `${msgRight.value}px`
		}
		if (msgTransform.value != '') {
			style['transform'] = msgTransform.value
		}
		if (!props.mask) {
			style['boxShadow'] = '0 0 24rpx 0 rgba(0,0,0,0.15)'
		}
		return style
	})

	/** 气泡小三角动态样式 */
	const cmpArrowStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		if (arrowTop.value != null) {
			style['top'] = `${arrowTop.value}px`
		}
		if (arrowBottom.value != null) {
			style['bottom'] = `${arrowBottom.value}px`
		}
		if (arrowLeft.value != null) {
			style['left'] = `${arrowLeft.value}px`
		}
		if (arrowRight.value != null) {
			style['right'] = `${arrowRight.value}px`
		}

		if (arrowDirection.value == 'top') {
			style['borderBottomColor'] = props.messageBg
		} else {
			style['borderTopColor'] = props.messageBg
		}
		return style
	})

	/** 气泡内文本颜色 */
	const cmpMessageTextStyle = computed(() : UTSJSONObject => {
		return {
			color: props.messageColor,
		} as UTSJSONObject
	})

	// ==================== 核心方法 ====================
	/**
	 * 关闭指引
	 */
	function close() {
		dataShow.value = false
		targetVisible.value = false
		msgVisible.value = false
		if (stepTimer != null) {
			clearTimeout(stepTimer!)
			stepTimer = null
		}
		emit('update:show', false)
		emit('close')
	}

	/**
	 * 点击遮罩背景
	 */
	function clickRoot() {
		const canClose = props.maskClose == true && props.maskColse == true
		if (canClose) {
			close()
		}
	}

	/**
	 * 下一步 / 完成
	 */
	function onNext() {
		if (dataCurrent.value < props.steps.length - 1) {
			dataCurrent.value = dataCurrent.value + 1
			emit('update:current', dataCurrent.value)
			emit('change', dataCurrent.value)
		} else {
			close()
		}
	}

	/**
	 * 上一步
	 */
	function onUp() {
		if (dataCurrent.value > 0) {
			dataCurrent.value = dataCurrent.value - 1
			emit('update:current', dataCurrent.value)
			emit('change', dataCurrent.value)
		}
	}

	/**
	 * 测量目标节点并计算气泡坐标
	 */
	function calculatePosition() {
		if (dataCurrent.value < 0 || dataCurrent.value >= props.steps.length) {
			return
		}
		const step = props.steps[dataCurrent.value]
		const targetId = step.target
		if (targetId == '') {
			return
		}

		if (stepTimer != null) {
			clearTimeout(stepTimer!)
			stepTimer = null
		}

		stepTimer = setTimeout(() => {
			const query = uni.createSelectorQuery()
			query.select('#' + targetId).boundingClientRect((res) => {
				if (res == null) {
					console.error(`[ste-tour] 未找到 ID 为 #${targetId} 的元素`)
					return
				}
				const rect = res as NodeInfo
				const top = rect.top ?? 0
				const left = rect.left ?? 0
				const bottom = rect.bottom ?? 0
				const right = rect.right ?? 0
				const width = rect.width ?? 0
				const height = rect.height ?? 0

				targetTop.value = top
				targetLeft.value = left
				targetWidth.value = width
				targetHeight.value = height
				targetVisible.value = true

				// 视口尺寸计算
				const vw = getWindowWidth()
				const vh = getWindowHeight()
				const _bottom = vh - bottom
				const _right = vw - right

				// 解析 position 方位配置
				const posStr = step.position ?? ''
				const posParts = posStr != '' ? posStr.split('-') : ([] as string[])
				let y = posParts.length > 0 ? posParts[0] : ''
				let x = posParts.length > 1 ? posParts[1] : ''

				// 垂直方向自动判定
				if (y == '') {
					if (top > _bottom) {
						y = 'top'
					} else {
						y = 'bottom'
					}
				}

				// 水平方向自动判定
				if (x == '') {
					if (_right > 30 && _right > left) {
						x = 'start'
					} else if (left > 30) {
						x = 'end'
					} else {
						x = 'center'
					}
				}

				const offsetArr = props.offset
				const _x = offsetArr.length > 0 ? offsetArr[0] : 0
				const _y = offsetArr.length > 1 ? offsetArr[1] : 0
				const arrowsWidth = 10 // 箭头三角形高度

				// 重置气泡与箭头样式坐标
				msgTop.value = null
				msgBottom.value = null
				msgLeft.value = null
				msgRight.value = null
				msgTransform.value = ''

				arrowTop.value = null
				arrowBottom.value = null
				arrowLeft.value = null
				arrowRight.value = null

				if (y == 'top') {
					arrowDirection.value = 'bottom' // 箭头朝下
					msgBottom.value = _bottom + height + _y + arrowsWidth
					arrowBottom.value = -arrowsWidth
				} else {
					arrowDirection.value = 'top' // 箭头朝上
					msgTop.value = bottom + _y + arrowsWidth
					arrowTop.value = -arrowsWidth
				}

				if (x == 'start') {
					msgLeft.value = left + _x
					arrowLeft.value = 24
				} else if (x == 'end') {
					msgRight.value = _right + _x
					arrowRight.value = 24
				} else {
					// 居中
					msgLeft.value = left + (width / 2) + _x
					msgTransform.value = 'translateX(-50%)'
					arrowLeft.value = 24
				}

				msgVisible.value = true
			}).exec()
		}, 60)
	}

	// ==================== 监听与生命周期 ====================
	watch(
		() : boolean => props.show,
		(val : boolean) => {
			dataShow.value = val
			if (val) {
				dataCurrent.value = props.current
				calculatePosition()
			} else {
				targetVisible.value = false
				msgVisible.value = false
			}
		},
		{ immediate: true }
	)

	watch(
		() : number => props.current,
		(val : number) => {
			if (val >= 0 && val < props.steps.length) {
				dataCurrent.value = val
				if (dataShow.value) {
					calculatePosition()
				}
			}
		},
		{ immediate: true }
	)

	watch(
		() : number => dataCurrent.value,
		() => {
			if (dataShow.value) {
				calculatePosition()
			}
		}
	)

	onMounted(() => {
		if (props.show) {
			dataShow.value = true
			calculatePosition()
		}
	})

	onUnmounted(() => {
		if (stepTimer != null) {
			clearTimeout(stepTimer!)
			stepTimer = null
		}
	})
</script>

<style scoped>
/* 全屏指引蒙层根容器 */
.ste-tour-root {
	position: fixed;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	z-index: 1001;
	overflow: hidden;
}

/* 高亮聚焦框（通过全屏 box-shadow 实现镂空背景遮罩） */
.ste-tour-view {
	position: fixed;
	z-index: 1001;
	background-color: transparent;
	pointer-events: none;
}

/* 说明气泡卡片主体 */
.ste-tour-message {
	position: fixed;
	z-index: 1002;
	min-width: 380rpx;
	max-width: 600rpx;
	display: flex;
	flex-direction: column;
}

/* 小三角箭头基础样式 */
.message-arrows {
	position: absolute;
	width: 0;
	height: 0;
	z-index: 1003;
}

/* 箭头朝上（气泡在下方） */
.arrows-top {
	border-left: 14rpx solid transparent;
	border-right: 14rpx solid transparent;
	border-bottom: 14rpx solid #ffffff;
}

/* 箭头朝下（气泡在上方） */
.arrows-bottom {
	border-left: 14rpx solid transparent;
	border-right: 14rpx solid transparent;
	border-top: 14rpx solid #ffffff;
}

/* 内容布局 */
.message-content {
	display: flex;
	flex-direction: column;
	padding: 16rpx 20rpx;
}

/* 头部标题栏 */
.message-head {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 8rpx 6rpx 14rpx 6rpx;
}

.head-title {
	font-size: 30rpx;
	font-weight: bold;
	color: #333333;
}

.head-close {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 44rpx;
	height: 44rpx;
}

/* 描述文本区 */
.message-body {
	padding: 8rpx 6rpx;
}

.message-text {
	font-size: 26rpx;
	line-height: 38rpx;
}

/* 底部操作与步数栏 */
.message-footer {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding-top: 16rpx;
	margin-top: 10rpx;
}

.step-num {
	font-size: 24rpx;
	color: #666666;
}

.step-btns {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.btn-item {
	margin-left: 12rpx;
}
</style>
