<template>
	<view class="ste-tree-root">
		<!-- 遍历扁平化可视节点队列 -->
		<view
			v-for="(node, index) in viewList"
			:key="node.value ?? index"
			class="tree-item"
			:class="{ 'tree-item-open': node.open == true, 'tree-item-has-children': node.hasChildren == true }"
		>
			<!-- 节点单行容器（通过 paddingLeft 实现层级缩进） -->
			<view
				class="tree-item-content"
				:style="{ paddingLeft: `${(node.depth ?? 0) * cmpPaddingNum}rpx` }"
			>
				<view class="tree-item-head">
					<!-- 节点左侧/标题区域（点击触发 click 事件） -->
					<view class="tree-item-left" @click="handleNodeClick(node)">
						<slot :node="node" :depth="node.depth ?? 0">
							<text class="tree-item-title">{{ node.title ?? '' }}</text>
						</slot>
					</view>

					<!-- 节点右侧展开/收起按钮区域 -->
					<view
						v-if="node.hasChildren == true"
						class="tree-item-open-btn"
						@click.stop="handleNodeOpenToggle(node)"
					>
						<slot name="open" :open="node.open == true">
							<view class="open-icon-wrap" :class="{ 'icon-rotated': node.open == true }">
								<ste-icon code="&#xe678;" :size="28" color="#888888" />
							</view>
						</slot>
					</view>
				</view>
			</view>

			<!-- 懒加载菊花动画展示区域 -->
			<view v-if="node.loading == true" class="tree-item-loading">
				<slot name="loading">
					<ste-loading :size="32" color="#0090FF" />
				</slot>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * @file ste-tree.uvue
	 * @description Tree 树形控件 - uni-app x / UTS 纯原生版本
	 * 支持手风琴模式、异步懒加载、默认展开、关键词搜索过滤与多插槽自定义。
	 */
	import { ref, computed, watch, onMounted } from 'vue'
	import {
		SteTreeNode,
		BeforeOpenSuspend,
		BeforeOpenNext,
		BeforeOpenStop,
	} from './constants.uts'

	defineOptions({
		name: 'ste-tree',
		options: {
			virtualHost: true,
		},
	})

	// ==================== Props 属性定义 ====================
	type TreeProps = {
		/** 节点唯一标识字段名 */
		valueKey ?: string,
		/** 节点标题展示字段名 */
		titleKey ?: string,
		/** 子节点数组字段名 */
		childrenKey ?: string,
		/** 树形结构源数据列表 */
		options ?: SteTreeNode[],
		/** 是否开启手风琴模式（展开当前节点时自动收起同级兄弟节点） */
		accordion ?: boolean,
		/** 子节点缩进距离（rpx） */
		childrenPadding ?: any,
		/** 默认展开的节点 value 列表 */
		openNodes ?: string[],
		/** 节点搜索标题关键词 */
		searchTitle ?: string,
	}

	const props = withDefaults(defineProps<TreeProps>(), {
		valueKey: 'value',
		titleKey: 'title',
		childrenKey: 'children',
		options: () : SteTreeNode[] => [] as SteTreeNode[],
		accordion: true,
		childrenPadding: 40,
		openNodes: () : string[] => [] as string[],
		searchTitle: '',
	})

	// ==================== Emits 事件定义 ====================
	const emit = defineEmits<{
		(e: 'click', node : SteTreeNode) : void,
		(
			e: 'beforeOpen',
			node : SteTreeNode,
			suspend : BeforeOpenSuspend,
			next : BeforeOpenNext,
			stop : BeforeOpenStop
		) : void,
		(e: 'open', node : SteTreeNode) : void,
		(e: 'close', node : SteTreeNode) : void,
	}>()

	// ==================== 响应式状态定义 ====================
	/** 格式化后的完整数据树 */
	const dataOptions = ref<SteTreeNode[]>([])

	/** 当前视图树（搜索模式下为过滤后的子树） */
	const viewOptions = ref<SteTreeNode[]>([])

	/** 一维扁平化可视节点队列（当前渲染列表） */
	const viewList = ref<SteTreeNode[]>([])

	/** 搜索防抖定时器 */
	let searchTimer : number | null = null

	// ==================== 计算属性 ====================
	/** 子节点缩进数值换算（rpx） */
	const cmpPaddingNum = computed(() : number => {
		const pad = props.childrenPadding
		if (typeof pad === 'number') {
			return pad as number
		}
		if (typeof pad === 'string') {
			const parsed = parseFloat(pad as string)
			if (!isNaN(parsed)) {
				return parsed
			}
		}
		return 40
	})

	// ==================== 树结构转换与算法工具 ====================
	/**
	 * 递归格式化输入树数据
	 */
	function formatTree(
		tree : SteTreeNode[],
		valKey : string,
		titKey : string,
		childKey : string,
		parentNode : string = '__root__',
		depth : number = 0
	) : SteTreeNode[] {
		const result : SteTreeNode[] = []
		for (let i = 0; i < tree.length; i++) {
			const item = tree[i]
			let val = item.value ?? ''
			let tit = item.title ?? ''

			if (item.raw != null) {
				const rawObj = item.raw!
				if (val == '' && rawObj.getString(valKey) != null) {
					val = rawObj.getString(valKey)!
				}
				if (tit == '' && rawObj.getString(titKey) != null) {
					tit = rawObj.getString(titKey)!
				}
			}
			if (val == '') {
				val = `${parentNode}_${i}`
			}
			if (tit == '') {
				tit = val
			}

			const rawChildren = item.children ?? ([] as SteTreeNode[])
			const hasChild = (item.hasChildren == true) || (rawChildren.length > 0)
			const formattedChildren = rawChildren.length > 0
				? formatTree(rawChildren, valKey, titKey, childKey, val, depth + 1)
				: ([] as SteTreeNode[])

			const node : SteTreeNode = {
				title: tit,
				value: val,
				children: formattedChildren,
				hasChildren: hasChild,
				open: item.open == true,
				loading: item.loading == true,
				depth: depth,
				parentNode: parentNode,
				raw: item.raw,
			}
			result.push(node)
		}
		return result
	}

	/**
	 * 递归扁平化提取当前已展开的可见节点
	 */
	function flattenTree(tree : SteTreeNode[]) : SteTreeNode[] {
		const result : SteTreeNode[] = []
		function _flatten(nodes : SteTreeNode[]) {
			for (let i = 0; i < nodes.length; i++) {
				const node = nodes[i]
				result.push(node)
				if (node.open == true && node.children != null && node.children!.length > 0) {
					_flatten(node.children!)
				}
			}
		}
		_flatten(tree)
		return result
	}

	/**
	 * 在树中递归查找指定 value 的节点
	 */
	function findTreeNode(tree : SteTreeNode[], value : string) : SteTreeNode | null {
		for (let i = 0; i < tree.length; i++) {
			const node = tree[i]
			if (node.value == value) {
				return node
			}
			if (node.children != null && node.children!.length > 0) {
				const res = findTreeNode(node.children!, value)
				if (res != null) {
					return res
				}
			}
		}
		return null
	}

	/**
	 * 关键词搜索过滤树
	 */
	function filterTree(tree : SteTreeNode[], keyword : string) : SteTreeNode[] {
		if (keyword == '') return tree
		const result : SteTreeNode[] = []
		for (let i = 0; i < tree.length; i++) {
			const node = tree[i]
			const matchSelf = (node.title ?? '').indexOf(keyword) >= 0
			let filteredChildren : SteTreeNode[] = []
			if (node.children != null && node.children!.length > 0) {
				filteredChildren = filterTree(node.children!, keyword)
			}
			if (matchSelf || filteredChildren.length > 0) {
				const cloned : SteTreeNode = {
					title: node.title,
					value: node.value,
					children: filteredChildren,
					hasChildren: filteredChildren.length > 0 || node.hasChildren == true,
					open: true, // 搜索匹配时自动展开展示路径
					loading: false,
					depth: node.depth,
					parentNode: node.parentNode,
					raw: node.raw,
				}
				result.push(cloned)
			}
		}
		return result
	}

	// ==================== 核心状态机与控制方法 ====================
	/**
	 * 刷新一维可视渲染列表
	 */
	function renderList() {
		viewList.value = flattenTree(viewOptions.value)
	}

	/**
	 * 设置节点展开或收起状态
	 */
	function setNodeOpen(nodeValue : string, openStatus : boolean) : SteTreeNode | null {
		const node = findTreeNode(viewOptions.value, nodeValue)
		if (node == null) return null

		if (props.accordion && openStatus) {
			// 手风琴模式：收起同级兄弟节点
			for (let i = 0; i < viewList.value.length; i++) {
				const s = viewList.value[i]
				if (s.open == true && s.parentNode == node.parentNode && s.value != node.value) {
					setNodeOpen(s.value ?? '', false)
				}
			}
		}

		// 同步到原全量数据中
		const dataNode = findTreeNode(dataOptions.value, nodeValue)
		if (dataNode != null) {
			dataNode.open = openStatus
		}
		node.open = openStatus
		return node
	}

	/**
	 * 打开/展开指定节点（并递归向上展开所有父级节点）
	 * @param value 节点唯一标识
	 */
	function open(value : string) {
		const node = findTreeNode(viewOptions.value, value)
		if (node == null) return

		setNodeOpen(value, true)

		// 递归向上展开所有父祖先节点
		let currentParent = node.parentNode ?? '__root__'
		while (currentParent != '__root__' && currentParent != '') {
			const parentNode = findTreeNode(viewOptions.value, currentParent)
			if (parentNode != null) {
				setNodeOpen(parentNode.value ?? '', true)
				currentParent = parentNode.parentNode ?? '__root__'
			} else {
				break
			}
		}
		renderList()
	}

	/**
	 * 关闭/收起指定节点
	 * @param value 节点唯一标识
	 */
	function close(value : string) {
		const node = setNodeOpen(value, false)
		if (node == null) return
		emit('close', node)
		renderList()
	}

	/**
	 * 节点搜索方法
	 * @param keyword 搜索关键词
	 */
	function search(keyword : string) {
		if (searchTimer != null) {
			clearTimeout(searchTimer!)
			searchTimer = null
		}
		searchTimer = setTimeout(() => {
			if (keyword == '') {
				viewOptions.value = dataOptions.value
			} else {
				viewOptions.value = filterTree(dataOptions.value, keyword)
			}
			renderList()
		}, 300)
	}

	/**
	 * 初始化全树数据
	 */
	function init() {
		dataOptions.value = formatTree(
			props.options,
			props.valueKey,
			props.titleKey,
			props.childrenKey
		)
		viewOptions.value = dataOptions.value

		if (props.openNodes.length > 0) {
			for (let i = 0; i < props.openNodes.length; i++) {
				open(props.openNodes[i])
			}
		} else {
			renderList()
		}
	}

	// ==================== 视图事件响应 ====================
	/**
	 * 点击节点行
	 */
	function handleNodeClick(node : SteTreeNode) {
		emit('click', node)
	}

	/**
	 * 点击展开/收起按钮
	 */
	function handleNodeOpenToggle(node : SteTreeNode) {
		if (node.open == true) {
			close(node.value ?? '')
		} else {
			// 判定是否需要触发 beforeOpen 懒加载
			if (node.hasChildren == true && (node.children == null || node.children!.length == 0)) {
				let isSuspended = false
				const suspend : BeforeOpenSuspend = () => {
					isSuspended = true
					node.loading = true
				}
				const next : BeforeOpenNext = (newChildren ?: SteTreeNode[]) => {
					node.loading = false
					if (newChildren != null && newChildren!.length > 0) {
						const formatted = formatTree(
							newChildren!,
							props.valueKey,
							props.titleKey,
							props.childrenKey,
							node.value ?? '',
							(node.depth ?? 0) + 1
						)
						node.children = formatted
						node.hasChildren = true
					}
					open(node.value ?? '')
					emit('open', node)
				}
				const stop : BeforeOpenStop = () => {
					node.loading = false
				}

				emit('beforeOpen', node, suspend, next, stop)

				if (!isSuspended) {
					open(node.value ?? '')
					emit('open', node)
				}
			} else {
				open(node.value ?? '')
				emit('open', node)
			}
		}
	}

	// ==================== 监听与生命周期 ====================
	watch(
		() : SteTreeNode[] => props.options,
		() => {
			init()
		},
		{ immediate: true }
	)

	watch(
		() : string => props.searchTitle,
		(newVal : string) => {
			search(newVal)
		}
	)

	onMounted(() => {
		init()
	})

	// ==================== Expose 实例方法导出 ====================
	defineExpose({
		init,
		open,
		close,
		search,
	})
</script>

<style scoped>
/* 树控件根容器 */
.ste-tree-root {
	width: 100%;
	background-color: #ffffff;
	display: flex;
	flex-direction: column;
}

/* 节点外层项 */
.tree-item {
	width: 100%;
	display: flex;
	flex-direction: column;
}

/* 展开时头部可略微呈现卡片浮起阴影 */
.tree-item-open > .tree-item-content > .tree-item-head {
	box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.03);
}

/* 节点单行容器 */
.tree-item-content {
	width: 100%;
	display: flex;
	flex-direction: column;
}

/* 节点行头部（左侧标题 + 右侧展开按钮） */
.tree-item-head {
	width: 100%;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	min-height: 80rpx;
	border-bottom: 1px solid #f2f3f5;
}

/* 节点左侧文本/插槽 */
.tree-item-left {
	flex: 1;
	display: flex;
	flex-direction: row;
	align-items: center;
	padding-left: 20rpx;
	min-height: 80rpx;
}

.tree-item-title {
	font-size: 28rpx;
	font-weight: 500;
	color: #1a1a1a;
	line-height: 40rpx;
}

/* 节点右侧展开/收起按钮 */
.tree-item-open-btn {
	width: 72rpx;
	height: 80rpx;
	display: flex;
	justify-content: center;
	align-items: center;
}

.open-icon-wrap {
	display: flex;
	justify-content: center;
	align-items: center;
	transition: transform 0.25s ease;
}

/* 箭头旋转 180 度动画 */
.icon-rotated {
	transform: rotate(180deg);
}

/* 懒加载菊花展示 */
.tree-item-loading {
	width: 100%;
	height: 72rpx;
	display: flex;
	justify-content: center;
	align-items: center;
}
</style>
