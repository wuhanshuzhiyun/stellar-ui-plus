/**
 * @file props.uts
 * @description ste-user-info 用户信息卡片组件 - uni-app x / UTS 强类型属性与契约定义
 * 提供用户信息（头像、昵称、标签）、业务统计数据列（余额、积分等）、核销码/功能码以及未登录状态引导的统一契约声明。
 */

/**
 * 默认未登录占位头像图片 URL
 */
export const DEFAULT_USER_INFO_LOGIN_AVATAR = 'https://image.whzb.com/chain/StellarUI/%E5%9B%BE%E7%89%87.jpg'

/**
 * 默认未登录引导提示标题
 */
export const DEFAULT_USER_INFO_LOGIN_TITLE = '点击登录'

/**
 * 默认未登录引导操作按钮文案
 */
export const DEFAULT_USER_INFO_LOGIN_BTN_TEXT = '注册/登录'

/**
 * ste-user-info 业务统计数据项结构契约定义
 * @property {string} title 数据统计项标题（如：余额、积分、优惠券等）
 * @property {string} value 数据统计项数值（已登录展示实际值，未登录统一占位 '-'）
 */
export type UserInfoDataItem = {
	/** 数据项标题 */
	title : string,
	/** 数据项数值或文本 */
	value : string,
}

/**
 * ste-user-info 组件 Props 强类型契约定义
 */
export type UserInfoProps = {
	/**
	 * 用户头像图片 URL（已登录状态展示）
	 * @default ''
	 */
	avatar ?: string,
	/**
	 * 用户主昵称文本
	 * @default ''
	 */
	nickname ?: string,
	/**
	 * 是否展示左侧用户信息区域（头像、昵称、等级/说明）
	 * @default true
	 */
	showUserInfo ?: boolean,
	/**
	 * 业务统计数据项列表（最多推荐支持 3 项，超出部分可能影响排版宽度）
	 * @default []
	 */
	list ?: UserInfoDataItem[],
	/**
	 * 功能码/核销码图片 URL
	 * @default ''
	 */
	codeSrc ?: string,
	/**
	 * 功能码标题（如：核销码、会员码）
	 * @default ''
	 */
	codeTitle ?: string,
	/**
	 * 功能码标题文本颜色（留空则默认自动跟随系统主题色）
	 * @default ''
	 */
	codeTitleColor ?: string,
	/**
	 * 是否展示右侧功能码区域
	 * @default true
	 */
	showCode ?: boolean,
	/**
	 * 登录状态：0 为未登录，1 为已登录
	 * @default 1
	 */
	loginStatus ?: number,
	/**
	 * 未登录状态下展示的占位头像图片 URL
	 * @default ''
	 */
	loginSrc ?: string,
	/**
	 * 未登录状态下展示的标题提示文本
	 * @default ''
	 */
	loginTitle ?: string,
	/**
	 * 未登录状态下的副标题说明文案
	 * @default ''
	 */
	loginInfo ?: string,
	/**
	 * 未登录状态下右侧操作按钮文案
	 * @default '注册/登录'
	 */
	loginBtnText ?: string,
	/**
	 * 未登录状态下右侧操作按钮背景色（留空则默认自动跟随系统主题色）
	 * @default ''
	 */
	loginBtnBg ?: string,
	/**
	 * 根节点自定义内联样式映射
	 */
	rootStyle ?: UTSJSONObject,
}
