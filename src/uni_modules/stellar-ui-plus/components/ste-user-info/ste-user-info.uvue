<template>
	<!-- ste-user-info 用户信息卡片根容器 -->
	<view class="ste-user-info-root" data-test="user-info">
		<view class="box" :style="[cmpRootStyle, rootStyle]">
			<!-- 1. 左侧用户信息展示区（头像、昵称、标签/描述或未登录文案） -->
			<view class="user-box" v-if="props.showUserInfo" @click="handleUserClick">
				<!-- 头像展示容器 -->
				<view class="left">
					<ste-image
						:width="92"
						:height="92"
						:src="cmpAvatarSrc"
						radius="50%"
						mode="aspectFill"
					/>
				</view>

				<!-- 文本信息容器 -->
				<view class="right">
					<!-- 已登录状态：展示用户昵称与副标题插槽 -->
					<template v-if="props.loginStatus == 1">
						<text class="name">{{ props.nickname }}</text>
						<view class="desc">
							<slot name="desc"></slot>
						</view>
					</template>

					<!-- 未登录状态：展示未登录提示标题与副文案 -->
					<template v-else>
						<text class="title">{{ cmpLoginTitle }}</text>
						<text class="info" v-if="props.loginInfo != ''">{{ props.loginInfo }}</text>
					</template>
				</view>
			</view>

			<!-- 2. 中间业务统计数据项列表（在未登录且展示用户信息时隐藏，切换为登录按钮） -->
			<view
				class="data-box"
				:style="cmpDataStyle"
				v-if="!(props.showUserInfo && props.loginStatus == 0)"
			>
				<view
					class="item"
					v-for="(item, index) in props.list"
					:key="index"
					@click="handleDataClick(index)"
				>
					<!-- 数值：已登录展示实际值，未登录展示占位符 '-' -->
					<text class="value">{{ props.loginStatus == 1 ? item.value : '-' }}</text>
					<!-- 统计项标题 -->
					<text class="item-title">{{ item.title }}</text>
				</view>
			</view>

			<!-- 3. 数据区域与功能码之间的垂直细分割线 -->
			<view
				class="line"
				v-if="props.showUserInfo && props.showCode && props.loginStatus == 1"
				:style="cmpLineStyle"
			></view>

			<!-- 4. 右侧功能码/核销码展示区 -->
			<view
				class="code-box"
				v-if="props.showCode && !(props.showUserInfo && props.loginStatus == 0)"
				@click="handleCodeClick"
			>
				<view class="code-top">
					<ste-image :src="props.codeSrc" :width="60" :height="60" mode="aspectFit" />
				</view>
				<text class="code-bottom" :style="{ color: cmpCodeTitleColor }">
					{{ props.codeTitle }}
				</text>
			</view>

			<!-- 5. 未登录状态右侧引导操作按钮区 -->
			<view
				v-if="props.showUserInfo && props.loginStatus == 0"
				class="login-btn-wrap"
				@click="handleLoginBtnClick"
			>
				<ste-button
					:background="cmpLoginBtnBg"
					:rootStyle="loginBtnRootStyle"
					@click="handleLoginBtnClick"
				>
					<text class="login-btn-text">{{ cmpLoginBtnText }}</text>
				</ste-button>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	/**
	 * @file ste-user-info.uvue
	 * @description UserInfo 用户信息展示卡片 - uni-app x / UTS 纯原生高性能组件
	 * 整合头像、用户昵称、标签描述、业务统计指标列（余额/积分等）、功能码/核销码以及未登录引导卡片。
	 */
	import { computed } from 'vue'
	import {
		UserInfoProps,
		UserInfoDataItem,
		DEFAULT_USER_INFO_LOGIN_AVATAR,
		DEFAULT_USER_INFO_LOGIN_TITLE,
		DEFAULT_USER_INFO_LOGIN_BTN_TEXT,
	} from './props.uts'
	import { useColorStore } from '../../store/color.uts'

	defineOptions({
		name: 'ste-user-info',
		options: {
			virtualHost: true,
		},
	})

	// ==================== 组件 Props 契约 ====================
	const props = withDefaults(defineProps<UserInfoProps>(), {
		avatar: '',
		nickname: '',
		showUserInfo: true,
		list: () => [] as UserInfoDataItem[],
		codeSrc: '',
		codeTitle: '',
		codeTitleColor: '',
		showCode: true,
		loginStatus: 1,
		loginSrc: '',
		loginTitle: '',
		loginInfo: '',
		loginBtnText: DEFAULT_USER_INFO_LOGIN_BTN_TEXT,
		loginBtnBg: '',
		rootStyle: () => ({} as UTSJSONObject),
	})

	// ==================== 组件 Emits 事件声明 ====================
	const emit = defineEmits<{
		/** 点击左侧用户信息区触发 */
		(e: 'userClick') : void,
		(e: 'user-click') : void,
		/** 点击功能码/核销码区域触发 */
		(e: 'codeClick') : void,
		(e: 'code-click') : void,
		/** 点击业务统计数据项触发，传递项索引 */
		(e: 'dataClick', index: number) : void,
		(e: 'data-click', index: number) : void,
		/** 点击未登录右侧按钮触发 */
		(e: 'loginBtnClick') : void,
		(e: 'login-btn-click') : void,
	}>()

	// ==================== 全局主题色状态 ====================
	const { getColor } = useColorStore()

	/**
	 * 统一获取当前系统主色调，兜底默认值为 #0090FF
	 */
	const currentThemeColor = computed(() : string => {
		const colorConfig = getColor()
		const theme = colorConfig.steThemeColor
		return (theme != '') ? theme : '#0090FF'
	})

	// ==================== 响应式计算属性 ====================

	/**
	 * 当前展示的头像图片路径（登录态使用 avatar，未登录使用 loginSrc，空值兜底默认占位图）
	 */
	const cmpAvatarSrc = computed(() : string => {
		if (props.loginStatus == 1) {
			return props.avatar != '' ? props.avatar : DEFAULT_USER_INFO_LOGIN_AVATAR
		} else {
			return props.loginSrc != '' ? props.loginSrc : DEFAULT_USER_INFO_LOGIN_AVATAR
		}
	})

	/**
	 * 未登录提示标题文案
	 */
	const cmpLoginTitle = computed(() : string => {
		return props.loginTitle != '' ? props.loginTitle : DEFAULT_USER_INFO_LOGIN_TITLE
	})

	/**
	 * 未登录操作按钮文案
	 */
	const cmpLoginBtnText = computed(() : string => {
		return props.loginBtnText != '' ? props.loginBtnText : DEFAULT_USER_INFO_LOGIN_BTN_TEXT
	})

	/**
	 * 未登录按钮背景色
	 */
	const cmpLoginBtnBg = computed(() : string => {
		return props.loginBtnBg != '' ? props.loginBtnBg : currentThemeColor.value
	})

	/**
	 * 功能码标题字体颜色
	 */
	const cmpCodeTitleColor = computed(() : string => {
		return props.codeTitleColor != '' ? props.codeTitleColor : currentThemeColor.value
	})

	/**
	 * 根容器内边距与对齐排版样式
	 */
	const cmpRootStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		if (props.showUserInfo && props.showCode) {
			style['padding'] = '0 24rpx 0 18rpx'
		} else if (!props.showUserInfo && props.showCode) {
			style['padding'] = '0 44rpx 0 52rpx'
		} else if (props.showUserInfo && !props.showCode) {
			style['padding'] = '0 48rpx 0 18rpx'
		}

		if (props.showUserInfo && props.loginStatus == 0) {
			style['justifyContent'] = 'space-between'
		}
		return style
	})

	/**
	 * 业务统计数据容器内部对齐与外边距
	 */
	const cmpDataStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		const listLen = props.list.length

		if (props.showUserInfo && props.showCode) {
			if (listLen <= 1) {
				style['justifyContent'] = 'center'
				style['margin'] = '0 0 0 24rpx'
			} else if (listLen == 2) {
				style['justifyContent'] = 'space-between'
				style['margin'] = '0 0 0 24rpx'
			} else {
				style['justifyContent'] = 'space-between'
				style['margin'] = '0 0 0 12rpx'
			}
		} else if (!props.showUserInfo && props.showCode) {
			style['justifyContent'] = 'space-between'
			style['margin'] = '0 98rpx 0 0'
		} else if (props.showUserInfo && !props.showCode) {
			style['justifyContent'] = 'space-between'
			style['margin'] = '0 0 0 24rpx'
		} else if (!props.showUserInfo && !props.showCode) {
			style['justifyContent'] = 'space-around'
		}

		return style
	})

	/**
	 * 垂直分割线外边距
	 */
	const cmpLineStyle = computed(() : UTSJSONObject => {
		const style : UTSJSONObject = {}
		const listLen = props.list.length
		if (props.showUserInfo && props.showCode) {
			if (listLen <= 2) {
				style['margin'] = '0 40rpx 0 44rpx'
			} else {
				style['margin'] = '0 22rpx 0 28rpx'
			}
		}
		return style
	})

	/**
	 * 登录按钮组件尺寸与外边距配置
	 */
	const loginBtnRootStyle : UTSJSONObject = {
		'width': '184rpx',
		'height': '72rpx',
		'padding': '0',
	}

	// ==================== 交互事件触发方法 ====================

	/**
	 * 用户信息区域点击处理
	 */
	const handleUserClick = () => {
		emit('userClick')
		emit('user-click')
	}

	/**
	 * 数据项点击处理
	 * @param {number} index 点击的数据项序号
	 */
	const handleDataClick = (index : number) => {
		emit('dataClick', index)
		emit('data-click', index)
	}

	/**
	 * 功能码/核销码区域点击处理
	 */
	const handleCodeClick = () => {
		emit('codeClick')
		emit('code-click')
	}

	/**
	 * 未登录操作按钮点击处理
	 */
	const handleLoginBtnClick = () => {
		emit('loginBtnClick')
		emit('login-btn-click')
	}
</script>

<style scoped>
	.ste-user-info-root {
		width: 100%;
		display: flex;
		flex-direction: row;
		justify-content: center;
	}

	.box {
		width: 100%;
		max-width: 702rpx;
		box-sizing: border-box;
		height: 148rpx;
		background-color: #ffffff;
		border-radius: 12rpx;
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	/* 左侧用户信息区域 */
	.user-box {
		display: flex;
		flex-direction: row;
		width: 280rpx;
		align-items: center;
		flex-shrink: 0;
	}

	.left {
		width: 92rpx;
		height: 92rpx;
		background-color: #dddddd;
		border-radius: 46rpx;
		overflow: hidden;
		margin-right: 24rpx;
		flex-shrink: 0;
	}

	.right {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		flex: 1;
		overflow: hidden;
	}

	.name {
		color: #000000;
		font-size: 32rpx;
		font-weight: bold;
		lines: 1;
		text-overflow: ellipsis;
		overflow: hidden;
	}

	.title {
		color: #000000;
		font-size: 32rpx;
		font-weight: bold;
		lines: 1;
		text-overflow: ellipsis;
		overflow: hidden;
	}

	.desc {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-top: 6rpx;
	}

	.info {
		font-size: 24rpx;
		color: #757575;
		margin-top: 6rpx;
		lines: 1;
		text-overflow: ellipsis;
		overflow: hidden;
	}

	/* 中间数据统计项区域 */
	.data-box {
		display: flex;
		flex-direction: row;
		align-items: center;
		flex: 1;
	}

	.item {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		flex: 1;
	}

	.value {
		font-weight: bold;
		font-size: 36rpx;
		color: #000000;
		text-align: center;
		lines: 1;
	}

	.item-title {
		font-size: 28rpx;
		color: #000000;
		text-align: center;
		margin-top: 10rpx;
		lines: 1;
	}

	/* 分割线 */
	.line {
		width: 0rpx;
		height: 50rpx;
		border-left-width: 4rpx;
		border-left-style: solid;
		border-left-color: #f1f1f1;
		flex-shrink: 0;
	}

	/* 右侧功能码/核销码区域 */
	.code-box {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.code-top {
		width: 60rpx;
		height: 60rpx;
		border-radius: 12rpx;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.code-bottom {
		margin-top: 8rpx;
		font-size: 24rpx;
		color: #ec3e1a;
		text-align: center;
		lines: 1;
	}

	/* 未登录右侧按钮区 */
	.login-btn-wrap {
		flex-shrink: 0;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.login-btn-text {
		font-size: 28rpx;
		color: #ffffff;
		text-align: center;
	}
</style>
