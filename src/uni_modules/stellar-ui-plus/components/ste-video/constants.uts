/**
 * @file constants.uts
 * @description ste-video 视频组件 - uni-app x / UTS 强类型契约与常量定义
 */

/**
 * 视频清晰度配置项强类型
 */
export type VideoResolution = {
	/**
	 * 清晰度文本描述（如：'流畅 480P'、'标清 720P'、'高清 1080P'）
	 */
	text : string,
	/**
	 * 对应视频播放源网络地址
	 */
	url : string,
}

/**
 * 视频元数据加载完毕 detail 载荷强类型
 */
export type VideoLoadedMetadataDetail = {
	/**
	 * 视频总时长（秒）
	 */
	duration : number,
	/**
	 * 视频原始宽度
	 */
	width ?: number,
	/**
	 * 视频原始高度
	 */
	height ?: number,
}

/**
 * 视频元数据加载完毕事件强类型
 */
export type VideoLoadedMetadataEvent = {
	type ?: string,
	detail : VideoLoadedMetadataDetail,
}

/**
 * 设置全屏时视频的方向类型
 * 0（正常竖向）, 90（屏幕逆时针90度）, -90（屏幕顺时针90度）
 */
export type VideoDirection = number

/**
 * 视频填充表现形式
 * contain：包含，fill：填充，cover：覆盖
 */
export type VideoObjectFit = string

/**
 * 解码器选择类型
 * hardware：硬解码，software：软解码
 */
export type VideoCodec = string

/**
 * 播放策略类型
 * 0：普通模式，1：平滑播放模式，2：M3U8优化模式
 */
export type VideoPlayStrategy = number
