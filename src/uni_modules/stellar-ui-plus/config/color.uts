// config/color.uts - uni-app x 版本
// 主题色配置，基于 store/color.uts

import { useColorStore } from '../store/color.uts'
import type { ColorValueType } from '../store/color.uts'

const colorStore = useColorStore()

export function useColor() {
	const setColor = (params : UTSJSONObject) => {
		colorStore.setColor(params)
	}

	const getColor = () : ColorValueType => {
		return colorStore.getColor()
	}

	return {
		setColor: setColor,
		getColor: getColor,
	}
}

// 导出默认方法，兼容传统 import useColor from '...' 的默认导入方式
export default useColor

