// config/font-size.uts - uni-app x 版本
// 全局字体大小配置，支持用户通过 scale 动态缩放

import { getWindowWidth } from '../utils/utils.uts'

const storageKey = 'stellar-font-size-config'

type FontSizeConfig = {
	min : number,
	max : number,
	scale : number,
}

let _config : FontSizeConfig = {
	min: 12,
	max: 80,
	scale: 1,
}

let _cachedConfig : FontSizeConfig | null = null

// 响应式字体样式表
let _fontSizeStyle : UTSJSONObject = {}

type ChangeCallback = () => void
let _changes : ChangeCallback[] = []

// 初始化标记
let _initialized = false

function _loadConfig() : FontSizeConfig {
	if (_cachedConfig != null) {
		return _cachedConfig!
	}
	let cfg : FontSizeConfig = {
		min: 12,
		max: 80,
		scale: 1,
	}
	try {
		const stored = uni.getStorageSync(storageKey)
		if (stored != null) {
			if (typeof stored === 'string') {
				const str = stored as string
				if (str.length > 0 && str.charAt(0) === '{') {
					try {
						const parsed = JSON.parse(str) as UTSJSONObject
						const s = parsed
						const sMin = s['min']
						const sMax = s['max']
						const sScale = s['scale']
						if (sMin != null) cfg.min = (sMin as number)
						if (sMax != null) cfg.max = (sMax as number)
						if (sScale != null) cfg.scale = (sScale as number)
					} catch (e) {
						// 降级使用默认值
					}
				}
			} else if (typeof stored === 'object') {
				const s = stored as UTSJSONObject
				const sMin = s['min']
				const sMax = s['max']
				const sScale = s['scale']
				if (sMin != null) cfg.min = (sMin as number)
				if (sMax != null) cfg.max = (sMax as number)
				if (sScale != null) cfg.scale = (sScale as number)
			}
		}
	} catch (e) {
		// 降级使用默认值
	}
	_cachedConfig = cfg
	_config = cfg
	return cfg
}

function _saveConfig() {
	const obj : UTSJSONObject = {
		min: _config.min,
		max: _config.max,
		scale: _config.scale,
	}
	uni.setStorageSync(storageKey, JSON.stringify(obj))
}

function _rpx2px(rpx : number) : string {
	let vw = getWindowWidth()
	if (vw <= 0) {
		vw = 375
	}
	const px = ((vw * rpx * _config.scale) / 750)
	const fixed = Math.round(px * 10000) / 10000
	if (fixed <= 0) {
		// 降级：直接返回 rpx 值（Android 设备最小宽度 320，24rpx ≈ 10px）
		return `${rpx / 750 * 375}px`
	}
	return `${fixed}px`
}

function _rpx2pxNum(rpx : number) : number {
	let vw = getWindowWidth()
	if (vw <= 0) {
		vw = 375
	}
	const result = Math.round(((vw * rpx * _config.scale) / 750) * 10000) / 10000
	return result > 0 ? result : (rpx / 750 * 375)
}

function _setFontSize() {
	const newStyle : UTSJSONObject = {}
	for (let i = _config.min; i <= _config.max; i++) {
		newStyle[`--font-size-${i}`] = _rpx2px(i)
	}
	_fontSizeStyle = newStyle
	_saveConfig()
	// 触发变更回调
	for (let i = 0; i < _changes.length; i++) {
		_changes[i]()
	}
}

function _ensureInit() {
	if (_initialized == false) {
		_loadConfig()
		_setFontSize()
		_initialized = true
	}
}

// === 直接导出的独立函数，UTS 编译器可靠解析 ===

export function normalizeFontSize(rpx : number) : string {
	_ensureInit()
	return _rpx2px(rpx)
}

export function normalizeFontSizeNum(rpx : number) : number {
	_ensureInit()
	return _rpx2pxNum(rpx)
}

export function getFontSizeStyle() : UTSJSONObject {
	_ensureInit()
	return _fontSizeStyle
}

export function getFontScale() : number {
	_ensureInit()
	return _config.scale
}

export function setFontScale(scale : number) {
	_ensureInit()
	_config.scale = scale
	_setFontSize()
}

export function getFontMin() : number {
	_ensureInit()
	return _config.min
}

export function setFontMin(min : number) {
	_ensureInit()
	_config.min = min
	_setFontSize()
}

export function getFontMax() : number {
	_ensureInit()
	return _config.max
}

export function setFontMax(max : number) {
	_ensureInit()
	_config.max = max
	_setFontSize()
}

export function onFontSizeChange(fn : () => void) {
	_changes.push(fn)
}

// 保留 useFontSize 兼容（但内部也改为直接调用导出函数）
export function useFontSize() {
	_ensureInit()
	return {
		getScale: () => getFontScale(),
		setScale: (scale : number) => setFontScale(scale),
		getMin: () => getFontMin(),
		setMin: (min : number) => setFontMin(min),
		getMax: () => getFontMax(),
		setMax: (max : number) => setFontMax(max),
		getFontSizeStyle: () => getFontSizeStyle(),
		normalizeFontSize: (rpx : number) => normalizeFontSize(rpx),
		normalizeFontSizeNum: (rpx : number) => normalizeFontSizeNum(rpx),
		onChange: (fn : () => void) => onFontSizeChange(fn),
	}
}

// 导出默认方法，兼容传统 import useFontSize from '...' 的默认导入方式
export default useFontSize

