export type ColorValueType = {
    steThemeColor : string,
    defaultColor : string,
};

const colorValue : ColorValueType = {
    steThemeColor: '#0090FF',
    defaultColor: '#0090FF',
};

let cachedColor : ColorValueType | null = null;

type ColorStoreResult = {
    getColor : () => ColorValueType,
    setColor : (value : UTSJSONObject) => void,
}

export function useColorStore() : ColorStoreResult {
    const getColor = () : ColorValueType => {
        if (cachedColor != null) {
            return cachedColor!;
        }
        let s : UTSJSONObject | null = null;
        try {
            const stored = uni.getStorageSync('steColor');
            if (stored != null) {
                if (typeof stored === 'string') {
                    const str = stored as string;
                    if (str.length > 0 && str.charAt(0) === '{') {
                        s = JSON.parse(str) as UTSJSONObject;
                    }
                } else if (typeof stored === 'object' && stored instanceof UTSJSONObject) {
                    s = stored as UTSJSONObject;
                }
            }
        } catch (_e) {
            s = null;
        }
        if (s != null) {
            const newColor : ColorValueType = {
                steThemeColor: (s!['steThemeColor'] as string | null) ?? colorValue.steThemeColor,
                defaultColor: (s!['defaultColor'] as string | null) ?? colorValue.defaultColor,
            };
            cachedColor = newColor;
        } else {
            cachedColor = colorValue;
        }
        return cachedColor!;
    };

    const setColor = (value : UTSJSONObject) : void => {
        const current = getColor();
        const newColor : ColorValueType = {
            steThemeColor: (value['steThemeColor'] as string | null) ?? current.steThemeColor,
            defaultColor: (value['defaultColor'] as string | null) ?? current.defaultColor,
        };
        cachedColor = newColor;
        uni.setStorageSync('steColor', cachedColor!);
    };

    const result : ColorStoreResult = {
        getColor: getColor,
        setColor: setColor,
    };
    return result;
}
