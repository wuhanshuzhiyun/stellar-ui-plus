// utils/Color.uts - uni-app x 版本
// 颜色格式转换

const rgbReg = /^rgb\(\s?(\d{1,3})\s?\,\s?(\d{1,3})\s?\,\s?(\d{1,3})\s?\)/
const rgbaReg = /^rgba\(\s?(\d{1,3}\s?\,\s?\d{1,3}\s?\,\s?\d{1,3})\s?\,\s?([\d\.]+)\s?\)/
const hexReg = /^\#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/
const hexaReg = /^\#([0-9a-fA-F]{4}|[0-9a-fA-F]{8})$/

class Color {
    static hex2rgba(hex : string, a : number = 1) : string {
        let str = hex.toLowerCase()
        const result : number[] = []
        let sColor = str.replace(hexReg, '$1')
        if (sColor.length == 3) {
            let joined = ''
            for (let i = 0; i < sColor.length; i++) {
                joined += sColor.slice(i, i + 1) + sColor.slice(i, i + 1)
            }
            sColor = joined
        }
        for (let i = 0; i < 6; i += 2) {
            result.push(parseInt(sColor.slice(i, i + 2), 16))
        }
        return `rgba(${result.join(',')},${a})`
    }

    static hexa2rgba(hexa : string, a : number) : string {
        let str = hexa.toLowerCase()
        const result : number[] = []
        let sColor = str.replace(hexaReg, '$1')
        if (sColor.length == 4) {
            let joined = ''
            for (let i = 0; i < sColor.length; i++) {
                joined += sColor.slice(i, i + 1) + sColor.slice(i, i + 1)
            }
            sColor = joined
        }
        for (let i = 0; i < 6; i += 2) {
            result.push(parseInt(sColor.slice(i, i + 2), 16))
        }
        const alphaStr = (parseInt(sColor.slice(6, 8), 16) / 255).toFixed(2)
        const _a = a != 0 ? a : parseFloat(alphaStr)
        return `rgba(${result.join(',')},${_a})`
    }

    static rgb2rgba(rgb : string, a : number = 1) : string {
        const result : string[] = []
        const m = rgbReg.exec(rgb)
        if (m == null) return rgb
        for (let i = 1; i <= 3; i++) {
            const v = m[i]
            result.push(v != null ? v! : '')
        }
        return `rgba(${result.join(',')},${a})`
    }

    static setRgbaDiaphaneity(rgba : string, a : number) : string {
        const m = rgbaReg.exec(rgba)
        if (m == null) return rgba
        const v1 = m[1]
        const _rgb = v1 != null ? v1! : ''
        const v2 = m[2]
        const _a = a != 0 ? a : parseFloat(v2 != null ? v2! : '1')
        return `rgba(${_rgb},${_a})`
    }

    static formatColor(color : string, a : number) : string {
        if (hexReg.test(color)) return Color.hex2rgba(color, a)
        if (hexaReg.test(color)) return Color.hexa2rgba(color, a)
        if (rgbReg.test(color)) return Color.rgb2rgba(color, a)
        if (rgbaReg.test(color) && a != 0) return Color.setRgbaDiaphaneity(color, a)
        return color
    }
}

export { Color };
export default Color;
