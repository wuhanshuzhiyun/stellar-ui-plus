// utils/System.uts - uni-app x 版本
// 提供系统/设备信息访问，跨端缓存窗口信息

// UTS 中对象字面量只能赋值给 type 定义的对象类型
type WindowInfo = {
    statusBarHeight : number,
    windowHeight : number,
    windowWidth : number,
}

let _cachedWindowInfo : WindowInfo | null = null;

class System {
    static getWindowInfo() : WindowInfo {
        if (_cachedWindowInfo != null) {
            return _cachedWindowInfo!;
        }
        const info = uni.getWindowInfo();
        const newInfo : WindowInfo = {
            statusBarHeight: info.statusBarHeight,
            windowHeight: info.windowHeight,
            windowWidth: info.windowWidth,
        };
        _cachedWindowInfo = newInfo;
        return _cachedWindowInfo!;
    }

    static clearWindowInfoCache() {
        _cachedWindowInfo = null;
    }

    static getWindowWidth() : number {
        return System.getWindowInfo()?.windowWidth ?? 375;
    }

    static getWindowHeight() : number {
        return System.getWindowInfo()?.windowHeight ?? 730;
    }

    static getStatusBarHeight() : number {
        return System.getWindowInfo()?.statusBarHeight ?? 47;
    }
}

export default System;
